index 0000000..3dd795a
--- /dev/null
+++ b/src/systems/audio.ts
@@ -0,0 +1,139 @@
+/**
+ * Procedural audio. No asset downloads, no licensing, tiny payload.
+ * Every sound is synthesised from the same cold, clinical palette:
+ * terminal beeps, hydraulic thuds, a paperclip mentor with a modem voice.
+ */
+
+import { State } from './state';
+
+let ctx: AudioContext | null = null;
+
+function ac(): AudioContext | null {
+  if (typeof window === 'undefined') return null;
+  if (!ctx) {
+    const AC = window.AudioContext || (window as any).webkitAudioContext;
+    if (!AC) return null;
+    ctx = new AC();
+  }
+  if (ctx.state === 'suspended') void ctx.resume();
+  return ctx;
+}
+
+export function unlockAudio(): void {
+  ac();
+}
+
+type Wave = OscillatorType;
+
+function tone(
+  freq: number,
+  dur: number,
+  opts: { type?: Wave; gain?: number; delay?: number; sweep?: number; q?: number } = {},
+): void {
+  if (!State.data.sound) return;
+  const a = ac();
+  if (!a) return;
+  const t0 = a.currentTime + (opts.delay ?? 0);
+  const osc = a.createOscillator();
+  const g = a.createGain();
+  const flt = a.createBiquadFilter();
+  flt.type = 'lowpass';
+  flt.frequency.value = 5200;
+  flt.Q.value = opts.q ?? 0.7;
+  osc.type = opts.type ?? 'sine';
+  osc.frequency.setValueAtTime(freq, t0);
+  if (opts.sweep) osc.frequency.exponentialRampToValueAtTime(Math.max(20, opts.sweep), t0 + dur);
+  const peak = (opts.gain ?? 0.14) * 0.9;
+  g.gain.setValueAtTime(0.0001, t0);
+  g.gain.exponentialRampToValueAtTime(peak, t0 + Math.min(0.02, dur * 0.2));
+  g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
+  osc.connect(flt).connect(g).connect(a.destination);
+  osc.start(t0);
+  osc.stop(t0 + dur + 0.02);
+}
+
+function noise(dur: number, gain = 0.1, hp = 800, delay = 0): void {
+  if (!State.data.sound) return;
+  const a = ac();
+  if (!a) return;
+  const t0 = a.currentTime + delay;
+  const len = Math.max(1, Math.floor(a.sampleRate * dur));
+  const buf = a.createBuffer(1, len, a.sampleRate);
+  const d = buf.getChannelData(0);
+  for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / len);
+  const src = a.createBufferSource();
+  src.buffer = buf;
+  const flt = a.createBiquadFilter();
+  flt.type = 'highpass';
+  flt.frequency.value = hp;
+  const g = a.createGain();
+  g.gain.setValueAtTime(gain, t0);
+  g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
+  src.connect(flt).connect(g).connect(a.destination);
+  src.start(t0);
+}
+
+export const SFX = {
+  tap: () => tone(520, 0.05, { type: 'triangle', gain: 0.06 }),
+  select: () => {
+    tone(660, 0.06, { type: 'square', gain: 0.05 });
+    tone(990, 0.05, { type: 'square', gain: 0.03, delay: 0.04 });
+  },
+  open: () => {
+    tone(300, 0.09, { type: 'sawtooth', gain: 0.05, sweep: 620 });
+    noise(0.06, 0.04, 1800);
+  },
+  keyEvidence: () => {
+    tone(440, 0.08, { type: 'triangle', gain: 0.08 });
+    tone(660, 0.1, { type: 'triangle', gain: 0.07, delay: 0.06 });
+    tone(880, 0.14, { type: 'triangle', gain: 0.06, delay: 0.12 });
+  },
+  deny: () => {
+    tone(180, 0.14, { type: 'square', gain: 0.09, sweep: 90 });
+  },
+  seal: () => {
+    // the t0 stamp — heavy, mechanical, final
+    noise(0.14, 0.16, 400);
+    tone(110, 0.22, { type: 'sawtooth', gain: 0.16, sweep: 55 });
+    tone(70, 0.3, { type: 'sine', gain: 0.14, delay: 0.03 });
+  },
+  reveal: () => {
+    tone(200, 0.5, { type: 'sawtooth', gain: 0.05, sweep: 900, q: 4 });
+    noise(0.5, 0.03, 2400);
+  },
+  tick: () => tone(1400, 0.02, { type: 'square', gain: 0.025 }),
+  good: () => {
+    [523, 659, 784, 1047].forEach((f, i) =>
+      tone(f, 0.16, { type: 'triangle', gain: 0.09, delay: i * 0.075 }),
+    );
+  },
+  perfect: () => {
+    [523, 659, 784, 1047, 1319].forEach((f, i) =>
+      tone(f, 0.24, { type: 'triangle', gain: 0.1, delay: i * 0.08 }),
+    );
+    noise(0.3, 0.05, 3000, 0.1);
+  },
+  bad: () => {
+    tone(220, 0.28, { type: 'sawtooth', gain: 0.11, sweep: 110 });
+    tone(160, 0.35, { type: 'square', gain: 0.07, delay: 0.08, sweep: 70 });
+  },
+  enemy: () => {
+    tone(90, 0.4, { type: 'sawtooth', gain: 0.09, sweep: 60, q: 6 });
+    noise(0.25, 0.05, 300);
+  },
+  /** Skrepka speaks: a tiny analogue modem chirp. He insists it's TTS. */
+  skrepka: (i = 0) => {
+    const base = 700 + (i % 5) * 60;
+    tone(base, 0.035, { type: 'square', gain: 0.035 });
+    tone(base * 1.5, 0.03, { type: 'square', gain: 0.022, delay: 0.03 });
+  },
+  levelUp: () => {
+    [392, 523, 659, 784, 1047].forEach((f, i) =>
+      tone(f, 0.3, { type: 'triangle', gain: 0.1, delay: i * 0.09 }),
+    );
+  },
+  coin: () => {
+    tone(1200, 0.06, { type: 'square', gain: 0.05 });
+    tone(1600, 0.08, { type: 'square', gain: 0.04, delay: 0.05 });
+  },
+};
diff --git a/src/systems/state.ts b/src/systems/state.ts
new file mode 100644
index 0000000..d5f4beb
--- /dev/null
+++ b/src/systems/state.ts
@@ -0,0 +1,195 @@
+import type { SaveData, JournalEntry } from '../core/types';
+import { STARTER_PROTOCOLS } from '../data/protocols';
+
+const KEY = 'signal-arena-save-v1';
+
+/**
+ * Progress is local, versioned and never silently wiped.
+ * Trading Game's audit found progress resets; that's a trust bug, not a
+ * technical one. We treat the save file as a promise.
+ */
+function fresh(): SaveData {
+  return {
+    v: 1,
+    xp: 0,
+    credits: 0,
+    streak: 0,
+    lastPlayDay: null,
+    cleared: {},
+    journal: [],
+    unlockedProtocols: [...STARTER_PROTOCOLS],
+    equipped: [],
+    seenIntro: false,
+    sound: true,
+    runsToday: 0,
+    dayKey: null,
+  };
+}
+
+export function todayKey(): string {
+  const d = new Date();
+  return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
+}
+
+class GameState {
+  data: SaveData = fresh();
+
+  load(): void {
+    try {
+      const raw = localStorage.getItem(KEY);
+      if (raw) {
+        const parsed = JSON.parse(raw) as SaveData;
+        if (parsed && parsed.v === 1) this.data = { ...fresh(), ...parsed };
+      }
+    } catch {
+      /* corrupted save must never brick the app */
+    }
+    // roll the day
+    const t = todayKey();
+    if (this.data.dayKey !== t) {
+      this.data.dayKey = t;
+      this.data.runsToday = 0;
+    }
+    this.save();
+  }
+
+  save(): void {
+    try {
+      localStorage.setItem(KEY, JSON.stringify(this.data));
+    } catch {
+      /* private mode — play on, just don't persist */
+    }
+  }
+
+  reset(): void {
+    this.data = fresh();
+    this.save();
+  }
+
+  // ---------- progression ----------
+
+  get level(): number {
+    // gentle curve: level n needs ~ 260 * n^1.35 total XP
+    let lv = 1;
+    while (this.xpForLevel(lv + 1) <= this.data.xp) lv++;
+    return lv;
+  }
+
+  xpForLevel(n: number): number {
+    if (n <= 1) return 0;
+    return Math.round(260 * Math.pow(n - 1, 1.35));
+  }
+
+  get levelProgress(): number {
+    const lv = this.level;
+    const a = this.xpForLevel(lv);
+    const b = this.xpForLevel(lv + 1);
+    return Math.max(0, Math.min(1, (this.data.xp - a) / Math.max(1, b - a)));
+  }
+
+  get rankName(): string {
+    const lv = this.level;
+    if (lv >= 20) return 'Архитектор решений';
+    if (lv >= 15) return 'Читающий структуру';
+    if (lv >= 11) return 'Холодная голова';
+    if (lv >= 8) return 'Дисциплина I';
+    if (lv >= 5) return 'Выживший';
+    if (lv >= 3) return 'Ученик Скрепки';
+    return 'Свежее мясо';
+  }
+
+  addXP(n: number): { leveled: boolean; from: number; to: number } {
+    const from = this.level;
+    this.data.xp += n;
+    const to = this.level;
+    this.save();
+    return { leveled: to > from, from, to };
+  }
+
+  addCredits(n: number): void {
+    this.data.credits += n;
+    this.save();
+  }
+
+  // ---------- streak: rewards the ANALYSIS, not the click ----------
+  /**
+   * The only honest version of the Duolingo mechanic. A day counts when the
+   * player CLOSES an error in the journal — i.e. does the reflection work.
+   * Opening the app does nothing. Clicking buttons does nothing.
+   */
+  registerAnalysisDay(): boolean {
+    const t = todayKey();
+    if (this.data.lastPlayDay === t) return false;
+    const y = new Date();
+    y.setDate(y.getDate() - 1);
+    const yk = `${y.getFullYear()}-${y.getMonth() + 1}-${y.getDate()}`;
+    this.data.streak = this.data.lastPlayDay === yk ? this.data.streak + 1 : 1;
+    this.data.lastPlayDay = t;
+    this.save();
+    return true;
+  }
+
+  // ---------- cases ----------
+
+  best(caseId: string): number {
+    return this.data.cleared[caseId] ?? -1;
+  }
+
+  isCleared(caseId: string): boolean {
+    return caseId in this.data.cleared;
+  }
+
+  recordCase(caseId: string, score: number): boolean {
+    const prev = this.data.cleared[caseId] ?? -1;
+    const improved = score > prev;
+    if (improved) this.data.cleared[caseId] = score;
+    this.data.runsToday++;
+    this.save();
+    return improved;
+  }
+
+  chapterCleared(ch: number, caseIds: string[]): boolean {
+    return caseIds.every((id) => this.isCleared(id));
+  }
+
+  // ---------- journal ----------
+
+  addJournal(e: JournalEntry): void {
+    this.data.journal.unshift(e);
+    if (this.data.journal.length > 60) this.data.journal.length = 60;
+    this.save();
+  }
+
+  closeError(caseId: string): void {
+    const e = this.data.journal.find((j) => j.caseId === caseId && !j.closed);
+    if (e) {
+      e.closed = true;
+      this.save();
+    }
+  }
+
+  get openErrors(): JournalEntry[] {
+    return this.data.journal.filter((j) => !j.closed && j.errorTag);
+  }
+
+  unlockProtocol(id: string): boolean {
+    if (this.data.unlockedProtocols.includes(id)) return false;
+    this.data.unlockedProtocols.push(id);
+    this.save();
+    return true;
+  }
+
+  // ---------- derived stats for the profile ----------
+
+  get avgDQI(): number {
+    const v = Object.values(this.data.cleared);
+    if (!v.length) return 0;
+    return Math.round(v.reduce((a, b) => a + b, 0) / v.length);
+  }
+
+  get totalCases(): number {
+    return Object.keys(this.data.cleared).length;
+  }
+}
+
+export const State = new GameState();
