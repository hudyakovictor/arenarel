@@ -0,0 +1,101 @@
+/* Renders scene geometry to SVG so the layout can be eyeballed without a browser. */
+import { setupDOM } from './dom-env.mjs';
+setupDOM();
+import { writeFileSync } from 'node:fs';
+const Phaser=(await import('phaser')).default;
+(globalThis as any).Phaser=Phaser;(window as any).Phaser=Phaser;
+const UIPlugin=(await import('phaser4-rex-plugins/templates/ui/ui-plugin.js')).default;
+console.error=()=>{};
+const store:Record<string,string>={};
+(globalThis as any).localStorage={getItem:(k:string)=>store[k]??null,setItem:(k:string,v:string)=>{store[k]=v},removeItem:()=>{},clear:()=>{}};
+
+const S=await Promise.all(['Boot','Intro','Home','Case','Reveal','Result','Journal','Map','Protocols']
+  .map(async n=>(await import(`../src/scenes/${n}Scene`))[`${n}Scene`]));
+const {State}=await import('../src/systems/state');
+const {CASES}=await import('../src/data/cases');
+const {VIEW}=await import('../src/core/theme');
+const game=new Phaser.Game({type:Phaser.HEADLESS,parent:'game',width:VIEW.W,height:VIEW.H,
+  banner:false,audio:{noAudio:true},scene:S as any,
+  plugins:{scene:[{key:'rexUI',plugin:UIPlugin,mapping:'rexUI'}]}});
+const wait=(ms:number)=>new Promise(r=>setTimeout(r,ms));
+await wait(1400);
+const keys=['skrepka','skrepka_bust'];
+for(const e of ['fomo','leverage','headline','revenge','hubris'])keys.push('a_'+e,'c_'+e);
+for(const k of keys) if(!game.textures.exists(k)){try{game.textures.createCanvas(k,64,64);}catch{}}
+State.load(); await wait(200);
+
+const esc=(s:string)=>s.replace(/[<>&]/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;'}[c]!));
+const hex=(n:number)=>'#'+((n>>>0)&0xffffff).toString(16).padStart(6,'0');
+
+function collect(o:any,out:any[]=[],seen=new Set<any>(),d=0){
+  if(!o||d>9)return out;
+  const a=Array.isArray(o.list)?o.list:[];
+  let e:any[]=[]; try{const g=o.getElement?.('items'); if(Array.isArray(g))e=g;}catch{}
+  for(const c of [...a,...e]){
+    if(!c||seen.has(c))continue; seen.add(c);
+    if(c.visible!==false){
+      let b:any=null; try{b=c.getBounds();}catch{}
+      if(b&&b.width>0&&b.height>0){
+        const n=c.constructor?.name||'';
+        out.push({n,b,fill:c.fillColor,stroke:c.strokeColor,alpha:c.alpha??1,
+          text:c.type==='Text'?c.text:null,fs:c.style?.fontSize,color:c.style?.color,
+          tex:c.type==='Image'?c.texture?.key:null});
+      }
+    }
+    collect(c,out,seen,d+1);
+  }
+  return out;
+}
+
+async function shootPhase(caseId:string,phase:string,file:string){
+  game.scene.stop(game.scene.getScenes(true)[0]?.scene.key); await wait(60);
+  game.scene.start('Case',{caseId}); await wait(900);
+  const sc:any=game.scene.getScene('Case');
+  sc.protocolId='p_evidence';
+  sc.showEvidencePhase(); await wait(500);
+  if(phase==='verdict'){ const cc=CASES.find(x=>x.id===caseId)!; sc.opened=cc.evidence.filter(e=>e.decisive).map(e=>e.id); sc.looks=0; sc.showVerdictPhase(); await wait(500); }
+  await dump(sc,file);
+}
+async function dump(sc:any,file:string){
+  const items=collect(sc.children).filter(i=>i.b.x<VIEW.W&&i.b.y<VIEW.H+200&&i.b.x+i.b.width>0);
+  let svg=`<svg xmlns="http://www.w3.org/2000/svg" width="${VIEW.W}" height="${VIEW.H}" viewBox="0 0 ${VIEW.W} ${VIEW.H}"><rect width="100%" height="100%" fill="#04070f"/>`;
+  for(const i of items){ const {b}=i;
+    if(i.text!=null){ const fs=parseInt(i.fs||'14');
+      svg+=`<text x="${b.x.toFixed(1)}" y="${(b.y+fs*0.85).toFixed(1)}" font-family="Inter" font-size="${fs}" fill="${i.color||'#fff'}" opacity="${i.alpha}">${esc(String(i.text).split('\n')[0].slice(0,60))}</text>`;
+    } else if(i.tex){ svg+=`<rect x="${b.x.toFixed(1)}" y="${b.y.toFixed(1)}" width="${b.width.toFixed(1)}" height="${b.height.toFixed(1)}" fill="#1a2c55" stroke="#22d8f5" opacity="0.6"/>`;
+    } else if(i.fill!=null||i.stroke!=null){ svg+=`<rect x="${b.x.toFixed(1)}" y="${b.y.toFixed(1)}" width="${b.width.toFixed(1)}" height="${b.height.toFixed(1)}" fill="${i.fill!=null?hex(i.fill):'none'}" stroke="${i.stroke!=null?hex(i.stroke):'none'}" opacity="${Math.min(1,i.alpha)}" rx="6"/>`; } }
+  svg+=`<rect x="0.5" y="0.5" width="${VIEW.W-1}" height="${VIEW.H-1}" fill="none" stroke="#f5c044"/></svg>`;
+  writeFileSync(file,svg); console.log('wrote',file,items.length,'items');
+}
+async function shoot(key:string,data:any,file:string){
+  game.scene.stop(game.scene.getScenes(true)[0]?.scene.key); await wait(60);
+  game.scene.start(key,data); await wait(1400);
+  const sc:any=game.scene.getScene(key);
+  const items=collect(sc.children).filter(i=>i.b.x<VIEW.W&&i.b.y<VIEW.H+200&&i.b.x+i.b.width>0);
+  let svg=`<svg xmlns="http://www.w3.org/2000/svg" width="${VIEW.W}" height="${VIEW.H}" viewBox="0 0 ${VIEW.W} ${VIEW.H}"><rect width="100%" height="100%" fill="#04070f"/>`;
+  for(const i of items){
+    const {b}=i;
+    if(i.text!=null){
+      const fs=parseInt(i.fs||'14');
+      svg+=`<text x="${b.x.toFixed(1)}" y="${(b.y+fs*0.85).toFixed(1)}" font-family="Inter,sans-serif" font-size="${fs}" fill="${i.color||'#fff'}" opacity="${i.alpha}">${esc(String(i.text).split('\n')[0].slice(0,60))}</text>`;
+    } else if(i.tex){
+      svg+=`<rect x="${b.x.toFixed(1)}" y="${b.y.toFixed(1)}" width="${b.width.toFixed(1)}" height="${b.height.toFixed(1)}" fill="#1a2c55" stroke="#22d8f5" stroke-dasharray="3" opacity="0.6"/><text x="${(b.x+4).toFixed(1)}" y="${(b.y+14).toFixed(1)}" font-size="10" fill="#22d8f5">${esc(i.tex)}</text>`;
+    } else if(i.fill!=null||i.stroke!=null){
+      svg+=`<rect x="${b.x.toFixed(1)}" y="${b.y.toFixed(1)}" width="${b.width.toFixed(1)}" height="${b.height.toFixed(1)}" fill="${i.fill!=null?hex(i.fill):'none'}" stroke="${i.stroke!=null?hex(i.stroke):'none'}" opacity="${Math.min(1,i.alpha)}" rx="6"/>`;
+    }
+  }
+  svg+=`<rect x="0.5" y="0.5" width="${VIEW.W-1}" height="${VIEW.H-1}" fill="none" stroke="#f5c044" stroke-width="1"/></svg>`;
+  writeFileSync(file,svg);
+  console.log('wrote',file,items.length,'items');
+}
+
+const c=CASES[0];
+const v={regime:c.truth.regime,action:c.truth.bestAction,risk:1,confidence:70,
+  openedEvidence:c.evidence.filter(e=>e.decisive).map(e=>e.id),tookBait:false,usedProtocol:true,protocolId:'p_evidence'};
+await shoot('Home',undefined,'/tmp/s_home.svg');
+await shoot('Case',{caseId:c.id},'/tmp/s_case.svg');
+await shoot('Result',{caseId:c.id,verdict:v},'/tmp/s_result.svg');
+await shoot('Map',undefined,'/tmp/s_map.svg');
+await shootPhase(c.id,'evidence','/tmp/s_ev.svg');
+await shootPhase(c.id,'verdict','/tmp/s_vd.svg');
+process.exit(0);
