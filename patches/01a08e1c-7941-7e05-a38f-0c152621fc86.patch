+import Phaser from 'phaser';
+import { COL, DEPTH, VIEW } from '../core/theme';
+
+/**
+ * Living background: a slow ticker of market noise behind everything.
+ * It is deliberately low-contrast — atmosphere, never competition for the
+ * player's attention.
+ */
+export class ArenaBackground {
+  private g: Phaser.GameObjects.Graphics;
+  private lines: { y: number; sp: number; w: number; a: number }[] = [];
+  private grid: Phaser.GameObjects.Graphics;
+  private t = 0;
+
+  constructor(private scene: Phaser.Scene, private tint: number = COL.cyan) {
+    const { W, H } = VIEW;
+
+    scene.add
+      .rectangle(W / 2, H / 2, W, H, COL.bg0)
+      .setDepth(DEPTH.bg);
+
+    // subtle vignette glow
+    const glow = scene.add.graphics().setDepth(DEPTH.bg + 1);
+    glow.fillStyle(tint, 0.055);
+    glow.fillCircle(W * 0.5, -60, 340);
+    glow.fillStyle(COL.purple, 0.04);
+    glow.fillCircle(W * 0.9, H + 80, 300);
+
+    this.grid = scene.add.graphics().setDepth(DEPTH.bg + 2);
+    this.grid.lineStyle(1, COL.line, 0.14);
+    for (let x = 0; x <= W; x += 45) this.grid.lineBetween(x, 0, x, H);
+    for (let y = 0; y <= H; y += 45) this.grid.lineBetween(0, y, W, y);
+
+    this.g = scene.add.graphics().setDepth(DEPTH.bg + 3);
+    for (let i = 0; i < 14; i++) {
+      this.lines.push({
+        y: Math.random() * H,
+        sp: 6 + Math.random() * 22,
+        w: 30 + Math.random() * 150,
+        a: 0.04 + Math.random() * 0.07,
+      });
+    }
+  }
+
+  update(_t: number, dt: number) {
+    this.t += dt;
+    const { W, H } = VIEW;
+    const g = this.g;
+    g.clear();
+    for (const l of this.lines) {
+      l.y += (l.sp * dt) / 1000;
+      if (l.y > H + 10) l.y = -10;
+      const x = ((this.t * l.sp) / 90) % (W + l.w) - l.w;
+      g.fillStyle(this.tint, l.a);
+      g.fillRect(x, l.y, l.w, 1);
+    }
+  }
+
+  setTint(c: number) { this.tint = c; }
+}
