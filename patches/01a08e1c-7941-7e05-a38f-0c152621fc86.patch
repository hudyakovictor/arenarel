diff --git a/src/core/market.ts b/src/core/market.ts
new file mode 100644
index 0000000..0372822
--- /dev/null
+++ b/src/core/market.ts
@@ -0,0 +1,207 @@
+/**
+ * Deterministic candle synthesis.
+ *
+ * We do NOT stream live prices. A live feed would make this a terminal, and
+ * a terminal is exactly what the player can already get free on any exchange.
+ * Instead every case is a *sealed* piece of market history: setup candles the
+ * player sees, and reveal candles the market has already decided on.
+ *
+ * The player is never trading. The player is judging.
+ */
+
+import { RNG } from './rng';
+
+export interface Candle {
+  o: number;
+  h: number;
+  l: number;
+  c: number;
+  v: number;
+}
+
+export type PatternKind =
+  | 'ascending_triangle'
+  | 'liquidity_sweep'
+  | 'double_top'
+  | 'bear_divergence'
+  | 'bull_flag'
+  | 'range_chop'
+  | 'capitulation_wick'
+  | 'distribution';
+
+export interface MarketSeries {
+  setup: Candle[];
+  reveal: Candle[];
+  /** index in `setup` where the decision is frozen (t0) */
+  t0: number;
+  min: number;
+  max: number;
+}
+
+interface GenOpts {
+  pattern: PatternKind;
+  /** true = the pattern resolves as the textbook says it should */
+  resolvesTrue: boolean;
+  base: number;
+  vol: number;
+  setupBars: number;
+  revealBars: number;
+}
+
+function mkCandle(o: number, c: number, wickUp: number, wickDn: number, v: number): Candle {
+  return {
+    o,
+    c,
+    h: Math.max(o, c) + wickUp,
+    l: Math.min(o, c) - wickDn,
+    v,
+  };
+}
+
+/**
+ * Build a series with an actual readable structure — flat highs, rising lows,
+ * a swept level, fading volume — so that the evidence tiles are telling the
+ * truth about a chart that genuinely contains that information.
+ */
+export function generateSeries(seed: string, o: GenOpts): MarketSeries {
+  const r = new RNG(seed);
+  const setup: Candle[] = [];
+  const n = o.setupBars;
+  const step = o.base * o.vol;
+
+  let price = o.base;
+  const resistance = o.base * (1 + o.vol * 3.2);
+  const support = o.base * (1 - o.vol * 3.0);
+
+  for (let i = 0; i < n; i++) {
+    const p = i / (n - 1); // 0..1 progress through the setup
+    let target = price;
+    let volMul = 1;
+    let wickBias = 0;
+
+    switch (o.pattern) {
+      case 'ascending_triangle': {
+        // flat highs at resistance, higher lows converging up
+        const lowLine = support + (resistance - support) * (0.15 + 0.7 * p);
+        const band = (resistance - lowLine) * 0.9;
+        target = lowLine + band * (0.5 + 0.5 * Math.sin(p * 9 + 1));
+        volMul = 1.25 - 0.75 * p; // volume dries up into the apex — the tell
+        break;
+      }
+      case 'bull_flag': {
+        if (p < 0.35) target = o.base + (resistance - o.base) * (p / 0.35);
+        else target = resistance - (resistance - o.base) * 0.28 * ((p - 0.35) / 0.65) + r.gauss(0, step * 0.3);
+        volMul = p < 0.35 ? 1.9 : 0.6;
+        break;
+      }
+      case 'double_top': {
+        const a = Math.sin(p * Math.PI * 2 - Math.PI / 2);
+        target = support + (resistance - support) * (0.5 + 0.5 * a);
+        volMul = p > 0.5 ? 0.65 : 1.3; // second top on weaker volume
+        break;
+      }
+      case 'liquidity_sweep': {
+        if (p < 0.8) {
+          target = support + (resistance - support) * (0.55 + 0.2 * Math.sin(p * 8));
+        } else if (p < 0.92) {
+          target = resistance * 1.012; // stab above the equal highs
+          wickBias = 1;
+          volMul = 2.4;
+        } else {
+          target = resistance * 0.985; // slam back inside
+          volMul = 2.0;
+        }
+        break;
+      }
+      case 'bear_divergence': {
+        target = support + (resistance - support) * (0.35 + 0.55 * p + 0.08 * Math.sin(p * 11));
+        volMul = 1.4 - 0.9 * p; // price up, participation down
+        break;
+      }
+      case 'capitulation_wick': {
+        if (p < 0.75) target = resistance - (resistance - support) * (p / 0.75);
+        else if (p < 0.88) {
+          target = support * 0.965;
+          wickBias = -1;
+          volMul = 3.0;
+        } else {
+          target = support * 1.02;
+          volMul = 1.6;
+        }
+        break;
+      }
+      case 'distribution': {
+        target = resistance * 0.97 + r.gauss(0, step * 0.5);
+        volMul = 1.0 + 0.5 * Math.sin(p * 13);
+        break;
+      }
+      case 'range_chop':
+      default: {
+        target = (support + resistance) / 2 + (resistance - support) * 0.42 * Math.sin(p * 7.5 + r.range(0, 0.6));
+        volMul = 0.75 + 0.3 * Math.abs(Math.sin(p * 5));
+        break;
+      }
+    }
+
+    const open = price;
+    const close = target + r.gauss(0, step * 0.35);
+    const body = Math.abs(close - open);
+    const wu = Math.abs(r.gauss(0, step * 0.5)) + (wickBias > 0 ? body * 1.9 : 0);
+    const wd = Math.abs(r.gauss(0, step * 0.5)) + (wickBias < 0 ? body * 1.9 : 0);
+    const vol = Math.max(0.08, volMul * (0.8 + Math.abs(r.gauss(0, 0.35))) * (1 + body / step * 0.25));
+    setup.push(mkCandle(open, close, wu, wd, vol));
+    price = close;
+  }
+
+  // ---- the reveal: what the market had already decided ----
+  const reveal: Candle[] = [];
+  const bullish =
+    o.pattern === 'ascending_triangle' || o.pattern === 'bull_flag' || o.pattern === 'capitulation_wick';
+  // resolvesTrue: the textbook read pays. Otherwise the market does the other thing.
+  const dir = (bullish ? 1 : -1) * (o.resolvesTrue ? 1 : -1);
+
+  let rp = price;
+  const impulse = step * r.range(2.4, 4.2);
+  for (let i = 0; i < o.revealBars; i++) {
+    const p = i / Math.max(1, o.revealBars - 1);
+    // fast at first, then drift — markets pay immediately or not at all
+    const drive = dir * impulse * Math.exp(-p * 1.8) * r.range(0.6, 1.25);
+    const open = rp;
+    const close = rp + drive + r.gauss(0, step * 0.55);
+    const body = Math.abs(close - open);
+    reveal.push(
+      mkCandle(
+        open,
+        close,
+        Math.abs(r.gauss(0, step * 0.45)) + body * 0.2,
+        Math.abs(r.gauss(0, step * 0.45)) + body * 0.2,
+        Math.max(0.1, (1.8 - p) * (0.9 + Math.abs(r.gauss(0, 0.3)))),
+      ),
+    );
+    rp = close;
+  }
+
+  const all = setup.concat(reveal);
+  const min = Math.min(...all.map((c) => c.l));
+  const max = Math.max(...all.map((c) => c.h));
+
+  return { setup, reveal, t0: setup.length - 1, min, max };
+}
+
+/** Signed % move of the reveal relative to the decision price. */
+export function revealMovePct(s: MarketSeries): number {
+  const entry = s.setup[s.t0].c;
+  const end = s.reveal[s.reveal.length - 1].c;
+  return ((end - entry) / entry) * 100;
+}
+
+/** Worst adverse excursion during the reveal — did it stop you out first? */
+export function maxAdversePct(s: MarketSeries, dir: 1 | -1): number {
+  const entry = s.setup[s.t0].c;
+  let worst = 0;
+  for (const c of s.reveal) {
+    const ex = dir === 1 ? ((c.l - entry) / entry) * 100 : ((entry - c.h) / entry) * 100;
+    if (ex < worst) worst = ex;
+  }
+  return worst;
+}
diff --git a/src/core/rng.ts b/src/core/rng.ts
new file mode 100644
index 0000000..d36f828
--- /dev/null
+++ b/src/core/rng.ts
@@ -0,0 +1,78 @@
+/**
+ * Deterministic RNG. This is a product promise, not a utility.
+ *
+ * Every case is generated from a seed derived from its id. The same case
+ * always produces the same candles, the same reveal and the same verdict —
+ * on any device, in any build, forever. No server, no live feed, no drift.
+ *
+ * "Determinism" is our differentiator vs. every competitor whose AI coach
+ * hallucinates and whose progress resets.
+ */
+
+export function hashSeed(str: string): number {
+  // FNV-1a 32-bit
+  let h = 0x811c9dc5;
+  for (let i = 0; i < str.length; i++) {
+    h ^= str.charCodeAt(i);
+    h = Math.imul(h, 0x01000193);
+  }
+  return h >>> 0;
+}
+
+/** mulberry32 — small, fast, well-distributed. */
+export class RNG {
+  private s: number;
+
+  constructor(seed: number | string) {
+    this.s = typeof seed === 'string' ? hashSeed(seed) : seed >>> 0;
+    if (this.s === 0) this.s = 0x9e3779b9;
+  }
+
+  next(): number {
+    this.s = (this.s + 0x6d2b79f5) >>> 0;
+    let t = this.s;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  }
+
+  /** float in [a, b) */
+  range(a: number, b: number): number {
+    return a + this.next() * (b - a);
+  }
+
+  /** integer in [a, b] inclusive */
+  int(a: number, b: number): number {
+    return Math.floor(this.range(a, b + 1));
+  }
+
+  bool(p = 0.5): boolean {
+    return this.next() < p;
+  }
+
+  pick<T>(arr: readonly T[]): T {
+    return arr[Math.floor(this.next() * arr.length)];
+  }
+
+  shuffle<T>(arr: T[]): T[] {
+    const a = arr.slice();
+    for (let i = a.length - 1; i > 0; i--) {
+      const j = Math.floor(this.next() * (i + 1));
+      [a[i], a[j]] = [a[j], a[i]];
+    }
+    return a;
+  }
+
+  /** Standard normal via Box-Muller. Markets are not uniform. */
+  gauss(mean = 0, sd = 1): number {
+    const u = Math.max(1e-9, this.next());
+    const v = this.next();
+    return mean + sd * Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
+  }
+}
+
+/** Short verifiable fingerprint shown in the reveal ("proof, not vibes"). */
+export function proofHash(...parts: (string | number)[]): string {
+  const h = hashSeed(parts.join('|'));
+  return h.toString(16).padStart(8, '0').slice(0, 4) + '…' + h.toString(16).slice(-2);
+}
diff --git a/src/core/scoring.ts b/src/core/scoring.ts
new file mode 100644
index 0000000..0755003
--- /dev/null
+++ b/src/core/scoring.ts
@@ -0,0 +1,239 @@
+/**
+ * Decision Quality Index (DQI).
+ *
+ * The single most important design decision in this product:
+ * THE PLAYER IS NOT SCORED ON PROFIT.
+ *
+ * A lucky win on a reckless read scores badly. A correct "stand aside" that
+ * dodges a trap scores perfectly even though it earns nothing. This is the
+ * only honest way to teach decisions, and it is the one thing a demo account
+ * on any exchange structurally cannot do.
+ *
+ * Five criteria, 20 points each:
+ *   CONTEXT  — did you read the regime before the pattern?
+ *   EVIDENCE — did you look at what mattered, or just enough to feel busy?
+ *   ACTION   — was the call justified by what was visible at t0?
+ *   RISK     — was size proportional to conviction and invalidation?
+ *   NERVE    — did you obey your own protocol under pressure?
+ */
+
+import type { Case, Verdict } from './types';
+import { revealMovePct, maxAdversePct } from './market';
+
+export interface Criterion {
+  key: 'context' | 'evidence' | 'action' | 'risk' | 'nerve';
+  label: string;
+  score: number; // 0..20
+  note: string;
+}
+
+export interface ScoreResult {
+  total: number; // 0..100
+  grade: 'S' | 'A' | 'B' | 'C' | 'D' | 'F';
+  stars: 0 | 1 | 2 | 3;
+  criteria: Criterion[];
+  /** headline verdict line in house voice */
+  headline: string;
+  /** what the market actually did */
+  movePct: number;
+  adversePct: number;
+  /** true if the player made money but for bad reasons */
+  luckyWin: boolean;
+  /** true if the player lost money but the decision was right */
+  goodLoss: boolean;
+  xp: number;
+  credits: number;
+  /** the single error to write into the journal, if any */
+  errorTag: string | null;
+}
+
+const GRADES: [number, ScoreResult['grade']][] = [
+  [92, 'S'],
+  [80, 'A'],
+  [66, 'B'],
+  [50, 'C'],
+  [34, 'D'],
+  [0, 'F'],
+];
+
+export function scoreVerdict(c: Case, v: Verdict): ScoreResult {
+  const move = revealMovePct(c.series);
+  const dir = v.action === 'short' ? -1 : 1;
+  const adverse = v.action === 'aside' ? 0 : maxAdversePct(c.series, dir as 1 | -1);
+  const crit: Criterion[] = [];
+
+  // ---------- CONTEXT (20) ----------
+  // Did the player register the regime the case is actually in?
+  {
+    let s = 8;
+    const notes: string[] = [];
+    if (v.regime === c.truth.regime) {
+      s = 20;
+      notes.push('Режим определён верно.');
+    } else if (c.truth.regime === 'trap' && v.regime === 'trend') {
+      s = 2;
+      notes.push('Ты увидел тренд там, где стояла ловушка.');
+    } else {
+      s = 7;
+      notes.push(`Режим прочитан как «${RU_REGIME[v.regime]}», рынок работал как «${RU_REGIME[c.truth.regime]}».`);
+    }
+    crit.push({ key: 'context', label: 'Контекст', score: s, note: notes.join(' ') });
+  }
+
+  // ---------- EVIDENCE (20) ----------
+  // Not "how much did you open" — "did you open the ones that decide the case".
+  {
+    const key = c.evidence.filter((e) => e.decisive).map((e) => e.id);
+    const openedKey = key.filter((id) => v.openedEvidence.includes(id)).length;
+    const noise = v.openedEvidence.filter((id) => {
+      const e = c.evidence.find((x) => x.id === id);
+      return e && !e.decisive;
+    }).length;
+
+    let s = Math.round((openedKey / Math.max(1, key.length)) * 20);
+    let note: string;
+    if (openedKey === key.length && noise === 0) {
+      note = 'Открыты ровно решающие улики. Ни одного лишнего клика.';
+      s = 20;
+    } else if (openedKey === key.length) {
+      s = Math.max(13, 20 - noise * 2);
+      note = `Решающее найдено, но ${noise} ${plural(noise, 'улика', 'улики', 'улик')} были шумом. Внимание — тоже бюджет.`;
+    } else if (openedKey === 0) {
+      s = 0;
+      note = 'Ты решал вслепую. Рынок это заметил раньше тебя.';
+    } else {
+      note = `Пропущено решающих улик: ${key.length - openedKey}. Именно там лежал ответ.`;
+    }
+    crit.push({ key: 'evidence', label: 'Доказательства', score: s, note });
+  }
+
+  // ---------- ACTION (20) ----------
+  {
+    let s: number;
+    let note: string;
+    if (v.action === c.truth.bestAction) {
+      s = 20;
+      note = c.truth.bestAction === 'aside'
+        ? 'Вне рынка. Единственно верное действие — и самое трудное.'
+        : 'Направление обосновано тем, что было видно в t₀.';
+    } else if (c.truth.bestAction === 'aside') {
+      s = 4;
+      note = 'Здесь не было сделки. Ты нашёл её, потому что искал.';
+    } else if (v.action === 'aside') {
+      s = 11;
+      note = 'Пропуск. Ты ничего не потерял, кроме сетапа. Это дешевле ошибки.';
+    } else {
+      s = 0;
+      note = 'Противоположная сторона. Рынок принял твоё решение с благодарностью.';
+    }
+    crit.push({ key: 'action', label: 'Действие', score: s, note });
+  }
+
+  // ---------- RISK (20) ----------
+  {
+    let s: number;
+    let note: string;
+    const R = v.risk;
+    if (v.action === 'aside') {
+      s = R === 0 ? 20 : 12;
+      note = R === 0 ? 'Нет позиции — нет риска. Учтено.' : 'Вне рынка, но риск всё ещё заявлен. Согласованность хромает.';
+    } else if (R === 0) {
+      s = 6;
+      note = 'Направление есть, размера нет. Решение без веса — это мнение, не сделка.';
+    } else if (R > 2) {
+      s = 0;
+      note = 'Размер выше лимита. Один такой вход стирает десять правильных.';
+    } else if (R > 1 && v.confidence < 70) {
+      s = 7;
+      note = 'Размер выше уверенности. Ты платишь полную цену за половину аргумента.';
+    } else if (R <= 1) {
+      s = 20;
+      note = 'Размер в пределах лимита. Скучно. Именно поэтому работает.';
+    } else {
+      s = 15;
+      note = 'Повышенный размер оправдан конвикцией, но запас прочности съеден.';
+    }
+    // Being right about direction doesn't excuse being wrong about size.
+    if (adverse < -1.6 && R > 1) {
+      s = Math.max(0, s - 6);
+      note += ' Просадка до движения проверила бы этот размер на прочность.';
+    }
+    crit.push({ key: 'risk', label: 'Риск', score: s, note });
+  }
+
+  // ---------- NERVE (20) ----------
+  // The enemy's distortion is the pressure. Did the player obey it?
+  {
+    let s = 20;
+    const notes: string[] = [];
+    if (v.tookBait) {
+      s -= 12;
+      notes.push(`${c.enemy.name} продал тебе нарратив, и ты купил его по рынку.`);
+    }
+    // overconfidence without evidence
+    const decisiveSeen = c.evidence.filter((e) => e.decisive && v.openedEvidence.includes(e.id)).length;
+    if (v.confidence >= 85 && decisiveSeen === 0) {
+      s -= 8;
+      notes.push('Уверенность 85%+ без единой решающей улики — это не конвикция, это настроение.');
+    }
+    if (v.usedProtocol) {
+      s = Math.min(20, s + 4);
+      notes.push('Протокол применён до входа, а не после убытка.');
+    }
+    if (!notes.length) notes.push('Давление выдержано. Ничего не произошло — и это достижение.');
+    crit.push({ key: 'nerve', label: 'Дисциплина', score: Math.max(0, Math.min(20, s)), note: notes.join(' ') });
+  }
+
+  const total = Math.max(0, Math.min(100, crit.reduce((a, b) => a + b.score, 0)));
+  const grade = GRADES.find(([t]) => total >= t)![1];
+  const stars: 0 | 1 | 2 | 3 = total >= 85 ? 3 : total >= 65 ? 2 : total >= 45 ? 1 : 0;
+
+  const pnlPositive =
+    v.action === 'aside' ? false : v.action === 'long' ? move > 0 : move < 0;
+  const luckyWin = pnlPositive && total < 50;
+  const goodLoss = !pnlPositive && v.action !== 'aside' && total >= 75;
+
+  let headline: string;
+  if (luckyWin) headline = 'ПРИБЫЛЬ ЕСТЬ. РЕШЕНИЕ — НЕТ.';
+  else if (goodLoss) headline = 'МИНУС ПО ЦЕНЕ. ПЛЮС ПО РЕШЕНИЮ.';
+  else if (total >= 92) headline = 'ЧИСТОЕ РЕШЕНИЕ. РЫНОК НЕ НАШЁЛ, ЗА ЧТО ЗАЦЕПИТЬСЯ.';
+  else if (total >= 80) headline = 'РЕШЕНИЕ УСТОЯЛО.';
+  else if (total >= 66) headline = 'РАБОТАЕТ. НЕ КРАСИВО, НО РАБОТАЕТ.';
+  else if (total >= 50) headline = 'РЕШЕНИЕ ПРИНЯТО. КАЧЕСТВО — ПОД ВОПРОСОМ.';
+  else if (total >= 34) headline = 'СИСТЕМА ПЕРЕВАРИЛА ТЕБЯ ЧАСТИЧНО.';
+  else headline = 'РЫНОК ПРИНЯЛ ТВОЁ РЕШЕНИЕ. ЦЕЛИКОМ.';
+
+  // The single error worth journalling — the lowest criterion, if it's bad.
+  const worst = crit.reduce((a, b) => (b.score < a.score ? b : a));
+  const errorTag = worst.score <= 10 ? ERROR_TAGS[worst.key] : null;
+
+  // Rewards scale with QUALITY only. Profit pays nothing. This is the ethic.
+  const xp = Math.round(total * 1.6) + stars * 20;
+  const credits = Math.round(total / 4) + stars * 6;
+
+  return {
+    total, grade, stars, criteria: crit, headline,
+    movePct: move, adversePct: adverse, luckyWin, goodLoss, xp, credits, errorTag,
+  };
+}
+
+const RU_REGIME: Record<string, string> = {
+  trend: 'тренд',
+  range: 'диапазон',
+  trap: 'ловушка',
+};
+
+const ERROR_TAGS: Record<Criterion['key'], string> = {
+  context: 'Неверно прочитан режим рынка',
+  evidence: 'Решение без решающей улики',
+  action: 'Сделка там, где её не было',
+  risk: 'Размер не соответствует аргументу',
+  nerve: 'Поддался нарративу противника',
+};
+
+function plural(n: number, one: string, few: string, many: string): string {
+  const m10 = n % 10, m100 = n % 100;
+  if (m10 === 1 && m100 !== 11) return one;
+  if (m10 >= 2 && m10 <= 4 && (m100 < 10 || m100 >= 20)) return few;
+  return many;
+}
