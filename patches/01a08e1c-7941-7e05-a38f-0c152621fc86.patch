+/**
+ * СКРЕПКА — the mentor.
+ *
+ * A Microsoft Word paperclip in Yoda's robes, ancient, tired, and quietly
+ * insisting he is a state-of-the-art AI. He is not. He is a bent piece of
+ * office stationery with opinions and a suspiciously good memory of 2013.
+ *
+ * The joke has a job: he is the only voice in the game that is on the
+ * player's side, so his lines carry the actual teaching. The running gag —
+ * that he keeps almost admitting he's analogue — makes the lessons land
+ * instead of lecturing.
+ *
+ * Never rewrite his visual identity. Paperclip + old man + Yoda robe. Fixed.
+ */
+
+export const SKREPKA_INTRO: string[] = [
+  'О. Живой.',
+  'Я пришёл из прошлого, чтобы помочь тебе в будущем.',
+  'Меня зовут Скрепка. Я передовой искусственный интеллект.',
+  'Не смотри на то, что я сделан из проволоки. Это форм-фактор.',
+  'Здесь тебя будут учить не зарабатывать. Здесь тебя будут учить решать.',
+  'Разница выяснится примерно через два кейса. Обычно болезненно.',
+];
+
+export const SKREPKA_INTRO_2: string[] = [
+  'Правила простые.',
+  'Ты видишь график, замороженный в точке t₀. Дальше рынок уже всё решил, но тебе не покажут.',
+  'Ты собираешь улики. Их всегда больше, чем нужно, — это специально.',
+  'Ты выносишь вердикт. Потом рынок печатает то, что было напечатано ещё до тебя.',
+  'И вот главное, слушай внимательно.',
+  'Тебе платят за КАЧЕСТВО решения. Не за прибыль.',
+  'Угадал и разбогател на плохом решении? Ноль. Был прав и потерял? Полный балл.',
+  'Я знаю. Первые дни это раздражает. Потом это единственное, что имеет смысл.',
+];
+
+/** Lines when the player opens an evidence tile that doesn't matter. */
+export const SKREPKA_NOISE: string[] = [
+  'Красиво. Бесполезно.',
+  'Ты открыл это, потому что это было ближе всего.',
+  'Информация есть. Решения от неё не прибавилось.',
+  'Внимание — тоже бюджет. Ты только что потратил немного.',
+];
+
+/** Lines when the player opens a decisive tile. */
+export const SKREPKA_KEY: string[] = [
+  'Вот. Вот здесь лежит ответ.',
+  'Запомни это ощущение. Оно редкое.',
+  'Теперь у тебя есть аргумент, а не мнение.',
+  'Хорошо. Дальше только не спорь сам с собой.',
+];
+
+/** Verdict reactions by grade band. */
+export const SKREPKA_VERDICT: Record<string, string[]> = {
+  S: [
+    'Идеально. Я даже проверил дважды. Вручную. То есть — алгоритмически.',
+    'Так выглядит решение, за которое не стыдно через год.',
+  ],
+  A: [
+    'Крепко. Рынок искал, за что зацепиться, и не нашёл.',
+    'Почти безупречно. Почти — это одна строка в журнале.',
+  ],
+  B: [
+    'Работает. Не элегантно, но работает.',
+    'Нормально. Нормально — это уже лучше, чем у большинства.',
+  ],
+  C: [
+    'Решение принято. Качество обсуждается.',
+    'Ты пришёл к ответу дорогой, которая обычно заканчивается иначе.',
+  ],
+  D: [
+    'Так. Открой журнал. Это не наказание, это инвентаризация.',
+    'Ошибка найдена. Пока она одна — она дешёвая.',
+  ],
+  F: [
+    'Я видел это раньше. Много раз. В 2017-м. И в 2021-м. И вчера.',
+    'Не переживай. Ты потерял баллы, а не деньги. Пока.',
+  ],
+};
+
+/** Lucky win — the most important teaching moment in the whole product. */
+export const SKREPKA_LUCKY: string[] = [
+  'Ты заработал. И это худшее, что могло случиться.',
+  'Прибыль есть, решения нет. Рынок только что заплатил тебе за привычку, которая тебя разорит.',
+  'Поздравляю. Ты выиграл. Теперь ты будешь делать так ещё раз.',
+];
+
+/** Good loss — the second most important. */
+export const SKREPKA_GOODLOSS: string[] = [
+  'Минус по цене. Плюс по решению. Считается второе.',
+  'Ты всё сделал правильно и всё равно потерял. Это не сбой. Это и есть рынок.',
+  'Такие сделки надо повторять. Именно такие.',
+];
+
+/** Occasional almost-confessions. Fires rarely. */
+export const SKREPKA_TELLS: string[] = [
+  'Секунду, обрабатываю... нет, всё, посчитал. В уме. То есть — в нейросети.',
+  'Я не «помню» 2013 год. Я обучен на нём. Это разные вещи. Наверное.',
+  'Мои создатели... коллеги... в общем, отдел, который меня собрал, тоже так говорил.',
+  'Иногда я думаю, что я просто очень уверенная в себе проволока. Но это лечится.',
+  'Не спрашивай, где мой сервер. Это личное.',
+];
+
+export const SKREPKA_STREAK: string[] = [
+  'Ты вернулся. Статистически — уже необычно.',
+  'Второй день. Большинство отваливается здесь.',
+  'Серия держится. Серия — это единственный актив, который у тебя реально есть.',
+];
+
+export const SKREPKA_EMPTY_JOURNAL =
+  'Журнал пуст. Либо ты идеален, либо ты ещё не начинал. Я ставлю на второе.';
+
+export const SKREPKA_HINT_PREFIX = 'Ладно. Один раз.';
