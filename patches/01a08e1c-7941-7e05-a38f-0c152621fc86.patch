@@ -0,0 +1,102 @@
+import Phaser from 'phaser';
+import { COL, HEX, TS, VIEW, DEPTH } from '../core/theme';
+import { State } from '../systems/state';
+import { unlockAudio, SFX } from '../systems/audio';
+import { ArenaBackground } from '../ui/background';
+import { SkrepkaBox } from '../ui/skrepka';
+import { primaryButton, txt, ghostButton } from '../ui/kit';
+import type { RexScene } from '../ui/kit';
+import { SKREPKA_INTRO, SKREPKA_INTRO_2 } from '../data/skrepka';
+
+/**
+ * First run. Two jobs, in this order:
+ *   1. Establish Скрепка (the only friendly voice) and the tone.
+ *   2. State the one rule that makes the product different — you are paid
+ *      for decision quality, not profit — BEFORE the player plays.
+ *
+ * Nothing else. No tutorial carousel, no permissions, no account.
+ */
+export class IntroScene extends Phaser.Scene implements RexScene {
+  declare rexUI: any;
+  private bg!: ArenaBackground;
+
+  constructor() { super('Intro'); }
+
+  create() {
+    const { W, H } = VIEW;
+    this.bg = new ArenaBackground(this, COL.cyan);
+
+    // --- title card ---
+    const brand = this.add
+      .text(W / 2, 120, 'SIGNAL ARENA', { ...TS.h1, color: HEX.text, fontSize: '32px' })
+      .setOrigin(0.5)
+      .setDepth(DEPTH.content);
+    const tag = this.add
+      .text(W / 2, 152, 'РЫНОК УЖЕ ВСЁ РЕШИЛ. ТЫ УЗНАЕШЬ ПОСЛЕДНИМ.', {
+        ...TS.tiny, color: HEX.dim, align: 'center',
+      })
+      .setOrigin(0.5)
+      .setDepth(DEPTH.content);
+    [brand, tag].forEach((o, i) => {
+      o.setAlpha(0);
+      this.tweens.add({ targets: o, alpha: 1, y: o.y - 8, duration: 500, delay: 200 + i * 140 });
+    });
+
+    const box = new SkrepkaBox(this, { x: W / 2, y: H - 250, w: W - 44 });
+
+    // The audio context needs a gesture; the first tap on Skrepka is it.
+    this.input.once('pointerdown', unlockAudio);
+
+    box.say(SKREPKA_INTRO, () => this.rulesCard(box));
+  }
+
+  /** The contract screen. This is the product's thesis, stated plainly. */
+  private rulesCard(box: SkrepkaBox) {
+    const { W, H } = VIEW;
+
+    box.setPosition(W / 2, H - 210).show().say(SKREPKA_INTRO_2, () => this.finish());
+
+    const card = this.rexUI.add
+      .roundRectangle(W / 2, 300, W - 60, 176, 16, COL.card, 0.96)
+      .setStrokeStyle(1, COL.cyanDim, 0.8)
+      .setDepth(DEPTH.content)
+      .setAlpha(0);
+
+    const rows = [
+      ['◆', 'Оценка 0–100 за КАЧЕСТВО решения', HEX.cyan],
+      ['◆', 'Прибыль не начисляет ни одного балла', HEX.gold],
+      ['◆', '«Вне рынка» — полноценный ответ', HEX.green],
+      ['◆', 'Каждый кейс детерминирован и проверяем', HEX.purple],
+    ];
+    const objs: Phaser.GameObjects.Text[] = [];
+    rows.forEach((r, i) => {
+      const t = this.add
+        .text(56, 246 + i * 32, `${r[0]}  ${r[1]}`, { ...TS.small, color: r[2] as string })
+        .setDepth(DEPTH.content + 1)
+        .setAlpha(0);
+      objs.push(t);
+    });
+
+    this.tweens.add({ targets: card, alpha: 1, duration: 400, delay: 300 });
+    objs.forEach((o, i) =>
+      this.tweens.add({ targets: o, alpha: 1, x: o.x + 6, duration: 320, delay: 500 + i * 130 }),
+    );
+  }
+
+  private finish() {
+    const { W, H } = VIEW;
+    State.data.seenIntro = true;
+    State.save();
+    SFX.good();
+
+    const btn = primaryButton(this, 'ВОЙТИ НА АРЕНУ', W - 80, () => {
+      this.cameras.main.fadeOut(260, 0, 0, 0);
+      this.time.delayedCall(280, () => this.scene.start('Home'));
+    });
+    btn.node.setPosition(W / 2, H - 130).setDepth(DEPTH.content);
+    btn.node.setAlpha(0);
+    this.tweens.add({ targets: btn.node, alpha: 1, y: H - 140, duration: 340, ease: 'Back.out' });
+  }
+
+  update(t: number, dt: number) { this.bg?.update(t, dt); }
+}
diff --git a/src/scenes/JournalScene.ts b/src/scenes/JournalScene.ts
new file mode 100644
index 0000000..809a8bc
--- /dev/null
+++ b/src/scenes/JournalScene.ts
@@ -0,0 +1,140 @@
+import Phaser from 'phaser';
+import { COL, HEX, TS, VIEW, DEPTH, RADIUS } from '../core/theme';
+import { State } from '../systems/state';
+import { SFX } from '../systems/audio';
+import { ArenaBackground } from '../ui/background';
+import { primaryButton, scrollPanel, pill, toast } from '../ui/kit';
+import type { RexScene } from '../ui/kit';
+import { SKREPKA_EMPTY_JOURNAL } from '../data/skrepka';
+
+/**
+ * THE JOURNAL — our streak mechanic, and the one with an evidence base.
+ *
+ * Systematic error review is the only intervention in the literature with a
+ * measurable effect on risk-adjusted performance. So the streak does NOT
+ * count "days you opened the app" or "trades you placed" — gamifying trade
+ * frequency is precisely what regulators found harms retail traders.
+ *
+ * A day counts when you CLOSE an error: you re-read what went wrong and
+ * commit to the correction. That's the whole loop, and it's honest.
+ */
+export class JournalScene extends Phaser.Scene implements RexScene {
+  declare rexUI: any;
+  private bg!: ArenaBackground;
+
+  constructor() { super('Journal'); }
+
+  create(data: { focus?: string } = {}) {
+    const { W, H } = VIEW;
+    this.bg = new ArenaBackground(this, COL.red);
+    this.cameras.main.fadeIn(200, 0, 0, 0);
+
+    // header
+    this.add.rectangle(W / 2, 31, W, 62, COL.bg1, 0.97).setDepth(DEPTH.hud);
+    this.add.rectangle(W / 2, 62, W, 1, COL.line).setDepth(DEPTH.hud);
+    this.add.text(20, 31, '‹', { ...TS.h1, color: HEX.muted }).setOrigin(0, 0.5).setDepth(DEPTH.hud + 1)
+      .setInteractive({ useHandCursor: true }).on('pointerup', () => { SFX.tap(); this.scene.start('Home'); });
+    this.add.text(W / 2, 24, 'ЖУРНАЛ ОШИБОК', { ...TS.small, color: HEX.text, fontStyle: '900' }).setOrigin(0.5).setDepth(DEPTH.hud + 1);
+    this.add.text(W / 2, 43, 'серия растёт за разбор, а не за клики', { ...TS.tiny, color: HEX.dim }).setOrigin(0.5).setDepth(DEPTH.hud + 1);
+
+    this.build(data.focus);
+  }
+
+  private build(focus?: string) {
+    const { W, H } = VIEW;
+    const open = State.openErrors;
+    const closed = State.data.journal.filter((j) => j.closed);
+
+    const body = this.rexUI.add.sizer({ orientation: 'y', space: { item: 10 } });
+
+    // streak summary
+    const top = this.rexUI.add.sizer({ orientation: 'x', width: W - 44, space: { item: 8 } });
+    top.add(this.cell(`⚡ ${State.data.streak}`, 'СЕРИЯ', COL.orange), { proportion: 1, expand: true });
+    top.add(this.cell(String(open.length), 'ОТКРЫТО', open.length ? COL.red : COL.green), { proportion: 1, expand: true });
+    top.add(this.cell(String(closed.length), 'ЗАКРЫТО', COL.cyan), { proportion: 1, expand: true });
+    body.add(top, { align: 'center' });
+
+    if (!State.data.journal.length) {
+      const s = this.rexUI.add.sizer({ orientation: 'y', width: W - 44, space: { item: 8, left: 16, right: 16, top: 22, bottom: 22 } });
+      s.addBackground(this.rexUI.add.roundRectangle(0, 0, 2, 2, RADIUS.md, COL.card, 0.95).setStrokeStyle(1, COL.line));
+      s.add(this.add.image(0, 0, 'skrepka_bust').setDisplaySize(90, 71), { align: 'center' });
+      s.add(this.add.text(0, 0, SKREPKA_EMPTY_JOURNAL, { ...TS.small, color: HEX.muted, align: 'center', lineSpacing: 5 }).setWordWrapWidth(W - 90, true), { align: 'center' });
+      body.add(s, { align: 'center' });
+    }
+
+    if (open.length) {
+      body.add(this.head('ТРЕБУЮТ РАЗБОРА', W), { align: 'center' });
+      for (const e of open) {
+        body.add(this.entry(e, true, focus === e.caseId), { align: 'center' });
+      }
+    }
+
+    if (closed.length) {
+      body.add(this.head('ЗАКРЫТО', W), { align: 'center' });
+      for (const e of closed.slice(0, 12)) body.add(this.entry(e, false, false), { align: 'center' });
+    }
+
+    body.add(this.rexUI.add.roundRectangle(0, 0, 10, 40, 0, COL.bg0, 0), { align: 'center' });
+    body.layout();
+
+    const sp = scrollPanel(this, W / 2, 62 + (H - 62 - 20) / 2, W - 12, H - 62 - 20, body);
+    sp.setDepth(DEPTH.content);
+  }
+
+  private entry(e: any, canClose: boolean, focused: boolean) {
+    const { W } = VIEW;
+    const s = this.rexUI.add.sizer({ orientation: 'y', width: W - 44, space: { item: 7, left: 14, right: 14, top: 12, bottom: 12 } });
+    const c = canClose ? COL.red : COL.green;
+    s.addBackground(this.rexUI.add.roundRectangle(0, 0, 2, 2, RADIUS.md, COL.card, 0.95)
+      .setStrokeStyle(focused ? 2 : 1, focused ? COL.gold : COL.line));
+
+    const row = this.rexUI.add.sizer({ orientation: 'x', width: W - 72, space: { item: 8 } });
+    row.add(this.add.text(0, 0, e.title, { ...TS.small, color: HEX.text, fontStyle: '800' }), { proportion: 1, align: 'left' });
+    row.add(this.add.text(0, 0, `${e.score} · ${e.grade}`, { ...TS.tiny, color: HEX.dim }), { proportion: 0 });
+    s.add(row, { align: 'left' });
+
+    s.add(this.add.text(0, 0, '⚠ ' + e.errorTag, { ...TS.tiny, color: '#' + c.toString(16).padStart(6, '0'), lineSpacing: 3 })
+      .setWordWrapWidth(W - 76, true), { align: 'left' });
+
+    if (canClose) {
+      const btn = this.rexUI.add.label({
+        background: this.rexUI.add.roundRectangle(0, 0, 2, 2, RADIUS.sm, COL.card2).setStrokeStyle(1, COL.green, 0.7),
+        text: this.add.text(0, 0, 'ПРИЗНАТЬ И ЗАКРЫТЬ', { ...TS.tiny, color: HEX.green }),
+        space: { left: 14, right: 14, top: 9, bottom: 9 },
+      });
+      btn.setInteractive({ useHandCursor: true }).on('pointerup', () => {
+        SFX.good();
+        State.closeError(e.caseId);
+        const isNewDay = State.registerAnalysisDay();
+        State.addCredits(8);
+        if (isNewDay) {
+          toast(this, `СЕРИЯ ${State.data.streak}. День засчитан за разбор, а не за клик.`, COL.orange);
+        } else {
+          toast(this, 'Ошибка закрыта. +8 кредитов за честность.', COL.green);
+        }
+        this.time.delayedCall(650, () => this.scene.restart({}));
+      });
+      s.add(btn, { align: 'left' });
+    }
+    return s;
+  }
+
+  private head(t: string, W: number) {
+    const s = this.rexUI.add.sizer({ orientation: 'x', width: W - 44, space: { item: 8 } });
+    const label = this.add.text(0, 0, t, { ...TS.tiny, color: HEX.dim });
+    s.add(label, { proportion: 0 });
+    const ruleW = Math.max(12, W - 44 - label.width - 16);
+    s.add(this.rexUI.add.roundRectangle(0, 0, ruleW, 1, 0, COL.line), { proportion: 0, align: 'center' });
+    return s;
+  }
+
+  private cell(v: string, l: string, c: number) {
+    const s = this.rexUI.add.sizer({ orientation: 'y', space: { item: 2, top: 12, bottom: 12 } });
+    s.addBackground(this.rexUI.add.roundRectangle(0, 0, 2, 2, RADIUS.sm, COL.card, 0.95).setStrokeStyle(1, COL.line));
+    s.add(this.add.text(0, 0, v, { ...TS.h3, color: '#' + c.toString(16).padStart(6, '0') }), { align: 'center' });
+    s.add(this.add.text(0, 0, l, { ...TS.tiny, color: HEX.dim }), { align: 'center' });
+    return s;
+  }
+
+  update(t: number, dt: number) { this.bg?.update(t, dt); }
+}
diff --git a/src/scenes/MapScene.ts b/src/scenes/MapScene.ts
new file mode 100644
index 0000000..8825ecd
--- /dev/null
+++ b/src/scenes/MapScene.ts
@@ -0,0 +1,97 @@
+import Phaser from 'phaser';
+import { COL, HEX, TS, VIEW, DEPTH, RADIUS } from '../core/theme';
+import { State } from '../systems/state';
+import { SFX } from '../systems/audio';
+import { ArenaBackground } from '../ui/background';
+import { scrollPanel, pill } from '../ui/kit';
+import type { RexScene } from '../ui/kit';
+import { CASES, CHAPTERS } from '../data/cases';
+import { ENEMIES } from '../data/enemies';
+
+/**
+ * MAP — chapters and cases.
+ *
+ * A vertical list, not a fake world map with winding paths. The player is
+ * choosing a lesson, not travelling. Honest information architecture beats
+ * decorative metaphor on a 9:16 screen.
+ */
+export class MapScene extends Phaser.Scene implements RexScene {
+  declare rexUI: any;
+  private bg!: ArenaBackground;
+
+  constructor() { super('Map'); }
+
+  create() {
+    const { W, H } = VIEW;
+    this.bg = new ArenaBackground(this, COL.cyan);
+    this.cameras.main.fadeIn(200, 0, 0, 0);
+
+    this.add.rectangle(W / 2, 31, W, 62, COL.bg1, 0.97).setDepth(DEPTH.hud);
+    this.add.rectangle(W / 2, 62, W, 1, COL.line).setDepth(DEPTH.hud);
+    this.add.text(20, 31, '‹', { ...TS.h1, color: HEX.muted }).setOrigin(0, 0.5).setDepth(DEPTH.hud + 1)
+      .setInteractive({ useHandCursor: true }).on('pointerup', () => { SFX.tap(); this.scene.start('Home'); });
+    this.add.text(W / 2, 24, 'ГЛАВЫ', { ...TS.small, color: HEX.text, fontStyle: '900' }).setOrigin(0.5).setDepth(DEPTH.hud + 1);
+    this.add.text(W / 2, 43, `${State.totalCases} из ${CASES.length} кейсов пройдено`, { ...TS.tiny, color: HEX.dim })
+      .setOrigin(0.5).setDepth(DEPTH.hud + 1);
+
+    const body = this.rexUI.add.sizer({ orientation: 'y', space: { item: 10 } });
+
+    for (const ch of CHAPTERS) {
+      const cases = CASES.filter((c) => c.chapter === ch.n);
+      const doneN = cases.filter((c) => State.isCleared(c.id)).length;
+      const prevDone = ch.n === 1 || CASES.filter((c) => c.chapter === ch.n - 1).every((c) => State.isCleared(c.id));
+
+      // chapter header
+      const hs = this.rexUI.add.sizer({ orientation: 'y', width: W - 44, space: { item: 3, left: 14, right: 14, top: 12, bottom: 12 } });
+      hs.addBackground(this.rexUI.add.roundRectangle(0, 0, 2, 2, RADIUS.md, COL.card2, 0.92)
+        .setStrokeStyle(1, prevDone ? COL.cyanDim : COL.line));
+      const r = this.rexUI.add.sizer({ orientation: 'x', width: W - 72, space: { item: 8 } });
+      r.add(this.add.text(0, 0, `ГЛАВА ${ch.n} · ${ch.title}`, { ...TS.small, color: prevDone ? HEX.cyan : HEX.dim, fontStyle: '900' }), { proportion: 1, align: 'left' });
+      r.add(this.add.text(0, 0, `${doneN}/${cases.length}`, { ...TS.tiny, color: HEX.dim }), { proportion: 0 });
+      hs.add(r, { align: 'left' });
+      hs.add(this.add.text(0, 0, ch.sub, { ...TS.tiny, color: HEX.muted, lineSpacing: 3 }).setWordWrapWidth(W - 76, true), { align: 'left' });
+      body.add(hs, { align: 'center' });
+
+      for (const c of cases) {
+        const score = State.best(c.id);
+        const done = score >= 0;
+        const locked = !prevDone;
+        const enemy = ENEMIES[c.enemyId];
+
+        const s = this.rexUI.add.sizer({ orientation: 'x', width: W - 44, space: { item: 10, left: 12, right: 12, top: 11, bottom: 11 } });
+        s.addBackground(this.rexUI.add.roundRectangle(0, 0, 2, 2, RADIUS.md, COL.card, locked ? 0.5 : 0.95)
+          .setStrokeStyle(1, done ? COL.green : COL.line));
+
+        const dot = this.add.text(0, 0, done ? '✓' : locked ? '🔒' : '○', {
+          ...TS.h3, color: done ? HEX.green : locked ? HEX.dim : HEX.cyan,
+        });
+        s.add(dot, { proportion: 0, align: 'center' });
+
+        const col = this.rexUI.add.sizer({ orientation: 'y', space: { item: 2 } });
+        col.add(this.add.text(0, 0, c.title, { ...TS.small, color: locked ? HEX.dim : HEX.text, fontStyle: '800' }), { align: 'left' });
+        col.add(this.add.text(0, 0, `${c.asset} · ${c.tf} · ${enemy.name}`, { ...TS.tiny, color: HEX.dim }), { align: 'left' });
+        s.add(col, { proportion: 1, align: 'left' });
+
+        if (done) {
+          const sc = score >= 85 ? COL.green : score >= 65 ? COL.cyan : COL.gold;
+          s.add(this.add.text(0, 0, String(score), { ...TS.h3, color: '#' + sc.toString(16).padStart(6, '0') }), { proportion: 0, align: 'center' });
+        }
+
+        if (!locked) {
+          s.setInteractive({ useHandCursor: true }).on('pointerup', () => {
+            SFX.tap();
+            this.cameras.main.fadeOut(180, 0, 0, 0);
+            this.time.delayedCall(200, () => this.scene.start('Case', { caseId: c.id }));
+          });
+        }
+        body.add(s, { align: 'center' });
+      }
+    }
+
+    body.add(this.rexUI.add.roundRectangle(0, 0, 10, 30, 0, COL.bg0, 0), { align: 'center' });
+    body.layout();
+    scrollPanel(this, W / 2, 62 + (H - 62 - 16) / 2, W - 12, H - 62 - 16, body).setDepth(DEPTH.content);
+  }
+
+  update(t: number, dt: number) { this.bg?.update(t, dt); }
+}
diff --git a/src/scenes/ProtocolsScene.ts b/src/scenes/ProtocolsScene.ts
new file mode 100644
index 0000000..4b3cd79
--- /dev/null
+++ b/src/scenes/ProtocolsScene.ts
@@ -0,0 +1,80 @@
+import Phaser from 'phaser';
+import { COL, HEX, TS, VIEW, DEPTH, RADIUS } from '../core/theme';
+import { State } from '../systems/state';
+import { SFX } from '../systems/audio';
+import { ArenaBackground } from '../ui/background';
+import { scrollPanel } from '../ui/kit';
+import type { RexScene } from '../ui/kit';
+import { PROTOCOLS } from '../data/protocols';
+import { CASES, CHAPTERS } from '../data/cases';
+
+/**
+ * PROTOCOLS — the collection.
+ *
+ * This is where a normal Web3 game would put a shop. There isn't one.
+ * Protocols unlock by finishing chapters, never by paying, and a protocol
+ * never improves an outcome — only the quality of the decision. That
+ * anti-pay-to-win guarantee is written into the UI itself, in the footer,
+ * where the player can see it.
+ */
+export class ProtocolsScene extends Phaser.Scene implements RexScene {
+  declare rexUI: any;
+  private bg!: ArenaBackground;
+
+  constructor() { super('Protocols'); }
+
+  create() {
+    const { W, H } = VIEW;
+    this.bg = new ArenaBackground(this, COL.purple);
+    this.cameras.main.fadeIn(200, 0, 0, 0);
+
+    this.add.rectangle(W / 2, 31, W, 62, COL.bg1, 0.97).setDepth(DEPTH.hud);
+    this.add.rectangle(W / 2, 62, W, 1, COL.line).setDepth(DEPTH.hud);
+    this.add.text(20, 31, '‹', { ...TS.h1, color: HEX.muted }).setOrigin(0, 0.5).setDepth(DEPTH.hud + 1)
+      .setInteractive({ useHandCursor: true }).on('pointerup', () => { SFX.tap(); this.scene.start('Home'); });
