new file mode 100644
index 0000000..85aff9a
--- /dev/null
+++ b/src/ui/chart.ts
@@ -0,0 +1,199 @@
+import Phaser from 'phaser';
+import { COL } from '../core/theme';
+import type { Candle, MarketSeries } from '../core/market';
+
+/**
+ * Candle chart drawn with Graphics — no DOM, no chart library, fully
+ * inside the WebGL scene so it can be shaken, masked and tweened like any
+ * other game object.
+ *
+ * It is deliberately NOT interactive: no indicators to add, no timeframe to
+ * flip, no drawing tools. The chart is evidence, not a workstation. That
+ * restraint is the difference between our product and a trading terminal.
+ */
+export interface ChartOpts {
+  x: number;
+  y: number;
+  w: number;
+  h: number;
+  padY?: number;
+}
+
+export class CandleChart {
+  private g: Phaser.GameObjects.Graphics;
+  private gAnnot: Phaser.GameObjects.Graphics;
+  private labels: Phaser.GameObjects.Text[] = [];
+  private o: Required<ChartOpts>;
+  private series: MarketSeries | null = null;
+  private shown = 0;
+  private lo = 0;
+  private hi = 1;
+  private total = 0;
+
+  constructor(private scene: Phaser.Scene, opts: ChartOpts) {
+    this.o = { padY: 14, ...opts } as Required<ChartOpts>;
+    this.g = scene.add.graphics();
+    this.gAnnot = scene.add.graphics();
+  }
+
+  setDepth(d: number) {
+    this.g.setDepth(d);
+    this.gAnnot.setDepth(d + 1);
+    this.labels.forEach((l) => l.setDepth(d + 2));
+    return this;
+  }
+
+  /** Render the setup portion only — the frozen part the player judges. */
+  showSetup(s: MarketSeries) {
+    this.series = s;
+    this.total = s.setup.length + s.reveal.length;
+    this.shown = s.setup.length;
+    const arr = s.setup;
+    this.lo = Math.min(...arr.map((c) => c.l));
+    this.hi = Math.max(...arr.map((c) => c.h));
+    this.pad();
+    this.draw();
+    return this;
+  }
+
+  /** Animate the reveal candles printing one by one. */
+  playReveal(onDone?: () => void, perBar = 90) {
+    if (!this.series) return;
+    const s = this.series;
+    // rescale to fit everything that will be printed
+    const all = s.setup.concat(s.reveal);
+    this.lo = Math.min(...all.map((c) => c.l));
+    this.hi = Math.max(...all.map((c) => c.h));
+    this.pad();
+
+    let i = 0;
+    const step = () => {
+      this.shown = s.setup.length + i + 1;
+      this.draw();
+      i++;
+      if (i < s.reveal.length) this.scene.time.delayedCall(perBar, step);
+      else onDone?.();
+    };
+    this.draw();
+    this.scene.time.delayedCall(perBar, step);
+  }
+
+  private pad() {
+    const span = Math.max(1e-9, this.hi - this.lo);
+    this.lo -= span * 0.06;
+    this.hi += span * 0.06;
+  }
+
+  private px(i: number): number {
+    const cw = this.o.w / Math.max(1, this.total);
+    return this.o.x + i * cw + cw / 2;
+  }
+
+  private py(v: number): number {
+    const p = (v - this.lo) / Math.max(1e-9, this.hi - this.lo);
+    return this.o.y + this.o.h - this.o.padY - p * (this.o.h - this.o.padY * 2);
+  }
+
+  private draw() {
+    if (!this.series) return;
+    const s = this.series;
+    const g = this.g;
+    g.clear();
+    this.labels.forEach((l) => l.destroy());
+    this.labels = [];
+
+    const cw = this.o.w / Math.max(1, this.total);
+    const bodyW = Math.max(1.5, cw * 0.62);
+
+    // ---- grid ----
+    g.lineStyle(1, COL.line, 0.28);
+    for (let k = 0; k <= 4; k++) {
+      const yy = this.o.y + this.o.padY + ((this.o.h - this.o.padY * 2) * k) / 4;
+      g.lineBetween(this.o.x, yy, this.o.x + this.o.w, yy);
+    }
+
+    const arr = s.setup.concat(s.reveal);
+    const t0x = this.px(s.t0);
+
+    // ---- reveal region tint ----
+    if (this.shown > s.setup.length) {
+      g.fillStyle(COL.cyan, 0.05);
+      g.fillRect(t0x, this.o.y, this.o.x + this.o.w - t0x, this.o.h);
+    }
+
+    // ---- candles ----
+    for (let i = 0; i < Math.min(this.shown, arr.length); i++) {
+      const c: Candle = arr[i];
+      const isReveal = i > s.t0;
+      const up = c.c >= c.o;
+      const col = up ? COL.green : COL.red;
+      const alpha = isReveal ? 1 : 0.92;
+      const x = this.px(i);
+
+      g.lineStyle(Math.max(1, bodyW * 0.16), col, alpha * 0.85);
+      g.lineBetween(x, this.py(c.h), x, this.py(c.l));
+
+      const yo = this.py(c.o);
+      const yc = this.py(c.c);
+      const top = Math.min(yo, yc);
+      const hgt = Math.max(1.4, Math.abs(yc - yo));
+      g.fillStyle(col, alpha);
+      g.fillRect(x - bodyW / 2, top, bodyW, hgt);
+    }
+
+    // ---- volume strip ----
+    const vh = this.o.h * 0.16;
+    const vy = this.o.y + this.o.h - vh;
+    const maxV = Math.max(...arr.slice(0, Math.max(1, this.shown)).map((c) => c.v), 0.001);
+    for (let i = 0; i < Math.min(this.shown, arr.length); i++) {
+      const c = arr[i];
+      const x = this.px(i);
+      const bh = (c.v / maxV) * vh * 0.9;
+      g.fillStyle(c.c >= c.o ? COL.green : COL.red, 0.22);
+      g.fillRect(x - bodyW / 2, vy + vh - bh, bodyW, bh);
+    }
+
+    // ---- t0 marker: the seal ----
+    const ga = this.gAnnot;
+    ga.clear();
+    ga.lineStyle(1.5, COL.cyan, 0.65);
+    for (let yy = this.o.y; yy < this.o.y + this.o.h; yy += 8) {
+      ga.lineBetween(t0x, yy, t0x, Math.min(yy + 4, this.o.y + this.o.h));
+    }
+    const lab = this.scene.add
+      .text(t0x + 4, this.o.y + 2, 't₀', {
+        fontFamily: 'ui-monospace, monospace',
+        fontSize: '11px',
+        color: '#22d8f5',
+        fontStyle: '700',
+      })
+      .setDepth(this.g.depth + 2);
+    this.labels.push(lab);
+
+    // ---- last price ----
+    const last = arr[Math.min(this.shown, arr.length) - 1];
+    if (last) {
+      const y = this.py(last.c);
+      const up = this.shown <= s.setup.length ? true : last.c >= s.setup[s.t0].c;
+      const c = this.shown <= s.setup.length ? COL.cyan : up ? COL.green : COL.red;
+      ga.lineStyle(1, c, 0.5);
+      ga.lineBetween(this.o.x, y, this.o.x + this.o.w, y);
+      const pl = this.scene.add
+        .text(this.o.x + this.o.w - 2, y - 8, last.c.toFixed(last.c > 1000 ? 0 : 2), {
+          fontFamily: 'ui-monospace, monospace',
+          fontSize: '11px',
+          color: '#' + c.toString(16).padStart(6, '0'),
+          fontStyle: '700',
+        })
+        .setOrigin(1, 0)
+        .setDepth(this.g.depth + 2);
+      this.labels.push(pl);
+    }
+  }
+
+  destroy() {
+    this.g.destroy();
+    this.gAnnot.destroy();
+    this.labels.forEach((l) => l.destroy());
+  }
+}
diff --git a/src/ui/hud.ts b/src/ui/hud.ts
new file mode 100644
index 0000000..24d77bd
--- /dev/null
+++ b/src/ui/hud.ts
@@ -0,0 +1,86 @@
+import Phaser from 'phaser';
+import { COL, HEX, TS, RADIUS, DEPTH, VIEW } from '../core/theme';
+import { State } from '../systems/state';
+import { SFX } from '../systems/audio';
+import type { RexScene } from './kit';
+import { bar } from './kit';
+
+/**
+ * Top HUD. Four facts, no more:
+ *   level + progress · credits · streak · sound.
+ *
+ * We deliberately do NOT show a balance, a P&L, or an equity curve. There is
+ * no money in this game. Showing fake money would make it a demo account,
+ * and demo accounts are exactly what we refuse to be.
+ */
+export class HUD {
+  private root: Phaser.GameObjects.Container;
+  private lvlText: Phaser.GameObjects.Text;
+  private rankText: Phaser.GameObjects.Text;
+  private xpBar: ReturnType<typeof bar>;
+  private credText: Phaser.GameObjects.Text;
+  private streakText: Phaser.GameObjects.Text;
+  private sndText: Phaser.GameObjects.Text;
+
+  constructor(private scene: RexScene) {
+    const W = VIEW.W;
+    const H = 62;
+    this.root = scene.add.container(0, 0).setDepth(DEPTH.hud);
+
+    const bg = scene.add
+      .rectangle(W / 2, H / 2, W, H, COL.bg1, 0.96)
+      .setStrokeStyle(0);
+    const rule = scene.add.rectangle(W / 2, H, W, 1, COL.line);
+
+    const badge = scene.rexUI.add
+      .roundRectangle(34, H / 2, 40, 40, RADIUS.sm, COL.card2)
+      .setStrokeStyle(1, COL.cyanDim);
+    this.lvlText = scene.add
+      .text(34, H / 2, '1', { ...TS.h3, color: HEX.cyan })
+      .setOrigin(0.5);
+
+    this.rankText = scene.add.text(62, 14, '', { ...TS.tiny, color: HEX.muted });
+    this.xpBar = bar(scene, 150, 7, COL.cyan);
+    this.xpBar.node.setPosition(62 + 75, 38);
+
+    const credIcon = scene.add.text(W - 148, H / 2, '◭', { ...TS.small, color: HEX.gold }).setOrigin(0, 0.5);
+    this.credText = scene.add
+      .text(W - 132, H / 2, '0', { ...TS.small, color: HEX.text, fontStyle: '800' })
+      .setOrigin(0, 0.5);
+
+    const strIcon = scene.add.text(W - 84, H / 2, '⚡', { ...TS.small, color: HEX.orange }).setOrigin(0, 0.5);
+    this.streakText = scene.add
+      .text(W - 66, H / 2, '0', { ...TS.small, color: HEX.text, fontStyle: '800' })
+      .setOrigin(0, 0.5);
+
+    this.sndText = scene.add
+      .text(W - 26, H / 2, State.data.sound ? '♪' : '✕', { ...TS.h3, color: HEX.muted })
+      .setOrigin(0.5)
+      .setInteractive({ useHandCursor: true })
+      .on('pointerup', () => {
+        State.data.sound = !State.data.sound;
+        State.save();
+        this.sndText.setText(State.data.sound ? '♪' : '✕');
+        if (State.data.sound) SFX.tap();
+      });
+
+    this.root.add([
+      bg, rule, badge, this.lvlText, this.rankText, this.xpBar.node,
+      credIcon, this.credText, strIcon, this.streakText, this.sndText,
+    ]);
+    this.refresh(false);
+  }
+
+  refresh(animate = true) {
+    const lv = State.level;
+    this.lvlText.setText(String(lv));
+    this.rankText.setText(`${State.rankName}`);
+    this.xpBar.set(State.levelProgress, animate, this.scene);
+    this.credText.setText(String(State.data.credits));
+    this.streakText.setText(String(State.data.streak));
+    this.sndText.setText(State.data.sound ? '♪' : '✕');
+  }
+
+  setVisible(v: boolean) { this.root.setVisible(v); return this; }
+  get height() { return 62; }
+}
diff --git a/src/ui/kit.ts b/src/ui/kit.ts
new file mode 100644
index 0000000..cc63e6c
--- /dev/null
+++ b/src/ui/kit.ts
@@ -0,0 +1,247 @@
+import Phaser from 'phaser';
+import { COL, HEX, TS, RADIUS, FONT } from '../core/theme';
+import { SFX } from '../systems/audio';
+
+/**
+ * UI kit. Everything on screen is built from these few primitives.
+ *
+ * Rule #2 of the brief: the interface must never feel overloaded. The way we
+ * enforce that is mechanical — a small vocabulary of components with generous
+ * spacing, one accent colour per screen, and a hard limit of one primary
+ * action visible at a time.
+ */
+
+export interface RexScene extends Phaser.Scene {
+  rexUI: any;
+}
+
+export function panel(
+  scene: RexScene,
+  w: number,
+  h: number,
+  opts: { fill?: number; stroke?: number; radius?: number; alpha?: number } = {},
+) {
+  return scene.rexUI.add.roundRectangle(
+    0, 0, w, h,
+    opts.radius ?? RADIUS.md,
+    opts.fill ?? COL.card,
+    opts.alpha ?? 1,
+  ).setStrokeStyle(1, opts.stroke ?? COL.line, 1);
+}
+
+export function txt(scene: Phaser.Scene, s: string, style: any = TS.body, wrap = 0) {
+  const t = scene.add.text(0, 0, s, { ...style });
+  if (wrap) t.setWordWrapWidth(wrap, true);
+  return t;
+}
+
+/** Primary call-to-action. Only one of these on screen, ever. */
+export function primaryButton(
+  scene: RexScene,
+  label: string,
+  w: number,
+  onClick: () => void,
+  opts: { color?: number; enabled?: boolean; height?: number } = {},
+) {
+  const color = opts.color ?? COL.cyan;
+  const h = opts.height ?? 58;
+  const bg = scene.rexUI.add.roundRectangle(0, 0, w, h, RADIUS.md, color);
+  const shadow = scene.rexUI.add.roundRectangle(0, 0, w, h, RADIUS.md, COL.black, 0.9);
+  const label_ = scene.add.text(0, 0, label, { ...TS.btn, color: HEX.black });
+
+  const container = scene.rexUI.add.overlapSizer({ width: w, height: h + 4 });
+  container.add(shadow, { key: 'shadow', align: 'center', offsetY: 4, expand: false });
+  container.add(bg, { key: 'bg', align: 'center', expand: false });
+  container.add(label_, { key: 'label', align: 'center', expand: false });
+  container.layout();
+
+  let enabled = opts.enabled ?? true;
+  const apply = () => {
+    bg.setFillStyle(enabled ? color : COL.line);
+    label_.setColor(enabled ? HEX.black : HEX.dim);
+    container.setAlpha(enabled ? 1 : 0.75);
+  };
+  apply();
+
+  bg.setInteractive({ useHandCursor: true })
+    .on('pointerdown', () => {
+      if (!enabled) { SFX.deny(); return; }
+      SFX.tap();
+      scene.tweens.add({ targets: container, y: container.y + 3, duration: 60, yoyo: true });
+    })
+    .on('pointerup', () => { if (enabled) onClick(); });
+
+  return {
+    node: container,
+    setEnabled(v: boolean) { enabled = v; apply(); return this; },
+    setLabel(s: string) { label_.setText(s); container.layout(); return this; },
+    setColor(c: number) { bg.setFillStyle(enabled ? c : COL.line); return this; },
+    get enabled() { return enabled; },
+  };
+}
+
+/** Secondary / ghost button. */
+export function ghostButton(
+  scene: RexScene,
+  label: string,
+  onClick: () => void,
+  opts: { w?: number; h?: number; color?: number } = {},
+) {
+  const color = opts.color ?? COL.muted;
+  const l = scene.rexUI.add.label({
+    width: opts.w,
+    height: opts.h ?? 42,
+    background: scene.rexUI.add.roundRectangle(0, 0, 2, 2, RADIUS.sm, COL.card2)
+      .setStrokeStyle(1, COL.line2),
+    text: scene.add.text(0, 0, label, { ...TS.small, color: '#' + color.toString(16).padStart(6, '0'), fontStyle: '800' }),
+    space: { left: 16, right: 16, top: 10, bottom: 10 },
+    align: 'center',
+  });
+  l.setInteractive({ useHandCursor: true }).on('pointerup', () => { SFX.tap(); onClick(); });
+  return l;
+}
+
+/** Small status pill. */
+export function pill(scene: RexScene, text: string, color = COL.cyan, fill = COL.card2) {
+  const l = scene.rexUI.add.label({
+    background: scene.rexUI.add.roundRectangle(0, 0, 2, 2, RADIUS.pill, fill)
+      .setStrokeStyle(1, color, 0.5),
+    text: scene.add.text(0, 0, text, {
+      ...TS.tiny,
+      color: '#' + color.toString(16).padStart(6, '0'),
+    }),
+    space: { left: 10, right: 10, top: 5, bottom: 5 },
+  });
+  // Lay out immediately so the pill reports a true width to its parent sizer.
+  return l.layout();
+}
+
+/**
+ * A row of pills that WRAPS instead of overflowing. Pill counts and label
+ * lengths are content-driven, so a fixed horizontal sizer will eventually
+ * push past the 540px frame on some case or locale.
+ */
+export function pillRow(scene: RexScene, w: number, pills: any[]) {
+  const row = scene.rexUI.add.fixWidthSizer({ width: w, space: { item: 6, line: 6 } });
+  for (const p of pills) row.add(p);
+  return row.layout();
+}
+
+/** Thin labelled progress bar. */
+export function bar(scene: RexScene, w: number, h = 8, color = COL.cyan) {
+  const track = scene.rexUI.add.roundRectangle(0, 0, w, h, h / 2, COL.bg0)
+    .setStrokeStyle(1, COL.line);
+  const fill = scene.rexUI.add.roundRectangle(0, 0, w - 2, h - 2, (h - 2) / 2, color);
+  // The fill is scaled from its left edge rather than resized, so a re-layout
+  // by the parent sizer can never stretch it back to full width.
+  fill.setOrigin(0, 0.5);
+  const holder = scene.rexUI.add.overlapSizer({ width: w, height: h });
+  holder.add(track, { align: 'center', expand: false });
+  holder.add(fill, { align: 'left-center', expand: false, padding: { left: 1 } });
+  holder.layout();
+
+  let value = 0;
+  const apply = () => { fill.scaleX = Math.max(0.001, value); };
+  apply();
+
+  return {
+    node: holder,
+    set(p: number, animate = true, scene2?: Phaser.Scene) {
+      value = Math.max(0, Math.min(1, p));
+      if (animate && scene2) {
+        scene2.tweens.add({ targets: fill, scaleX: Math.max(0.001, value), duration: 550, ease: 'Cubic.out' });
+      } else {
+        apply();
+      }
+      return this;
+    },
+    setColor(c: number) { fill.setFillStyle(c); return this; },
+  };
+}
+
+/** Section heading — tiny uppercase label with a rule. */
+export function sectionLabel(scene: RexScene, text: string, w: number) {
+  const s = scene.rexUI.add.sizer({ orientation: 'x', width: w, space: { item: 8 } });
+  const label = scene.add.text(0, 0, text.toUpperCase(), { ...TS.label, color: HEX.dim });
+  s.add(label, { proportion: 0 });
+  const ruleW = Math.max(12, w - label.width - 16);
+  s.add(scene.rexUI.add.roundRectangle(0, 0, ruleW, 1, 0, COL.line), { proportion: 0, align: 'center' });
+  s.layout();
+  return s;
+}
+
+/** Toast — transient, non-blocking, never stacks more than one. */
+let activeToast: any = null;
+export function toast(scene: RexScene, message: string, color = COL.cyan) {
+  if (activeToast) { activeToast.destroy(); activeToast = null; }
+  const cam = scene.cameras.main;
+  const l = scene.rexUI.add.label({
+    background: scene.rexUI.add.roundRectangle(0, 0, 2, 2, RADIUS.sm, COL.card2, 0.98)
+      .setStrokeStyle(1, color, 0.7),
+    text: scene.add.text(0, 0, message, { ...TS.small, color: HEX.text, align: 'center' })
+      .setWordWrapWidth(cam.width - 120, true),
+    space: { left: 16, right: 16, top: 11, bottom: 11 },
+  });
+  l.setPosition(cam.width / 2, cam.height - 130).setDepth(9000).layout();
+  l.setAlpha(0);
+  activeToast = l;
+  scene.tweens.add({ targets: l, alpha: 1, y: l.y - 12, duration: 220, ease: 'Back.out' });
+  scene.time.delayedCall(2400, () => {
+    if (!l.scene) return;
+    scene.tweens.add({
+      targets: l, alpha: 0, y: l.y - 14, duration: 260,
+      onComplete: () => { l.destroy(); if (activeToast === l) activeToast = null; },
+    });
+  });
+  return l;
+}
+
+/** Number that counts up — used for scores so results feel earned. */
+export function countUp(
+  scene: Phaser.Scene,
+  t: Phaser.GameObjects.Text,
+  to: number,
+  duration = 900,
+  fmt: (n: number) => string = (n) => String(Math.round(n)),
+) {
+  const o = { v: 0 };
+  scene.tweens.add({
+    targets: o, v: to, duration, ease: 'Cubic.out',
+    onUpdate: () => t.setText(fmt(o.v)),
+    onComplete: () => t.setText(fmt(to)),
+  });
+}
+
+/** Fullscreen scrim used by modals. */
+export function scrim(scene: Phaser.Scene, alpha = 0.78) {
+  const cam = scene.cameras.main;
+  return scene.add
+    .rectangle(cam.width / 2, cam.height / 2, cam.width, cam.height, COL.black, alpha)
+    .setInteractive();
+}
+
+/** Vertical scroll container sized to the phone frame. */
+export function scrollPanel(
+  scene: RexScene,
+  x: number, y: number, w: number, h: number,
+  child: any,
+) {
+  const p = scene.rexUI.add.scrollablePanel({
+    x, y, width: w, height: h,
+    scrollMode: 0,
+    panel: { child, mask: { padding: 2 } },
+    slider: {
+      track: scene.rexUI.add.roundRectangle(0, 0, 4, 10, 2, COL.line),
+      thumb: scene.rexUI.add.roundRectangle(0, 0, 8, 40, 4, COL.line2),
+      adaptThumbSize: true,
+    },
+    mouseWheelScroller: { focus: false, speed: 0.4 },
+    space: { left: 0, right: 8, top: 0, bottom: 0, panel: 0 },
+  });
+  p.layout();
+  return p;
+}
+
+export function hexOf(c: number): string {
+  return '#' + c.toString(16).padStart(6, '0');
+}
diff --git a/src/ui/skrepka.ts b/src/ui/skrepka.ts
new file mode 100644
index 0000000..c97d98b
--- /dev/null
+++ b/src/ui/skrepka.ts
@@ -0,0 +1,181 @@
+import Phaser from 'phaser';
+import { COL, HEX, TS, RADIUS, DEPTH } from '../core/theme';
+import { SFX } from '../systems/audio';
+import type { RexScene } from './kit';
+
+/**
+ * Скрепка dialogue bubble.
+ *
+ * He types. He never dumps text. The typing is the performance — it's a
+ * paperclip pretending to be a language model, and the tiny modem chirp on
+ * each character is the tell he refuses to acknowledge.
+ */
+export class SkrepkaBox {
+  private root: Phaser.GameObjects.Container;
+  private sprite: Phaser.GameObjects.Image;
+  private bubbleBg: any;
+  private text: Phaser.GameObjects.Text;
+  private cta: Phaser.GameObjects.Text;
+  private lines: string[] = [];
+  private li = 0;
+  private typing = false;
+  private timer?: Phaser.Time.TimerEvent;
+  private onDone?: () => void;
+  private full = '';
+
+  constructor(
+    private scene: RexScene,
+    private opts: { x: number; y: number; w: number; portrait?: boolean } = { x: 0, y: 0, w: 400 },
+  ) {
+    const s = scene;
+    this.root = s.add.container(opts.x, opts.y).setDepth(DEPTH.overlay + 5);
+
+    const bw = opts.w;
+    this.bubbleBg = s.rexUI.add
+      .roundRectangle(0, 0, bw, 132, RADIUS.md, COL.card, 0.98)
+      .setStrokeStyle(1.5, COL.cyanDim, 0.9);
+
+    this.text = s.add
+      .text(0, 0, '', { ...TS.body, color: HEX.text, lineSpacing: 5 })
+      .setWordWrapWidth(bw - 34, true)
+      .setOrigin(0, 0);
+
+    this.cta = s.add
+      .text(0, 0, '▼', { ...TS.tiny, color: HEX.cyan })
+      .setOrigin(1, 1)
+      .setAlpha(0);
+
+    this.sprite = s.add
+      .image(0, 0, 'skrepka')
+      .setOrigin(0.5, 1);
+
+    const ph = opts.portrait === false ? 96 : 168;
+    this.sprite.setDisplaySize(ph * (this.sprite.width / this.sprite.height), ph);
+
+    this.root.add([this.sprite, this.bubbleBg, this.text, this.cta]);
+    this.relayout(132);
+
+    // idle float — he is levitating, obviously
+    s.tweens.add({
+      targets: this.sprite,
+      y: -6,
+      duration: 2400,
+      yoyo: true,
+      repeat: -1,
+      ease: 'Sine.inOut',
+    });
+
+    this.bubbleBg.setInteractive({ useHandCursor: true }).on('pointerup', () => this.advance());
+  }
+
+  private relayout(bh: number) {
+    const bw = this.opts.w;
+    const sx = -bw / 2 + this.sprite.displayWidth / 2 - 6;
+    this.sprite.setPosition(sx, -bh / 2 - 6);
+    this.bubbleBg.setPosition(0, 0).setSize(bw, bh);
+    this.text.setPosition(-bw / 2 + 17, -bh / 2 + 15);
+    this.cta.setPosition(bw / 2 - 14, bh / 2 - 8);
+  }
+
+  /** Fit the bubble to the longest line so it never jumps around mid-speech. */
+  private fitTo(lines: string[]) {
+    const probe = this.scene.add
+      .text(0, 0, '', { ...TS.body, lineSpacing: 5 })
+      .setWordWrapWidth(this.opts.w - 34, true)
+      .setVisible(false);
+    let maxH = 60;
+    for (const l of lines) {
+      probe.setText(l);
+      maxH = Math.max(maxH, probe.height);
+    }
+    probe.destroy();
+    const bh = Math.min(300, maxH + 46);
+    this.relayout(bh);
+    return bh;
+  }
+
+  say(lines: string | string[], onDone?: () => void) {
+    this.lines = Array.isArray(lines) ? lines.slice() : [lines];
+    this.li = 0;
+    this.onDone = onDone;
+    this.fitTo(this.lines);
+    this.root.setScale(0.9).setAlpha(0);
+    this.scene.tweens.add({
+      targets: this.root, scale: 1, alpha: 1, duration: 260, ease: 'Back.out',
+    });
+    this.typeLine();
+    return this;
+  }
+
+  private typeLine() {
+    this.full = this.lines[this.li] ?? '';
+    this.text.setText('');
+    this.cta.setAlpha(0);
+    this.typing = true;
+    let i = 0;
+    this.timer?.remove();
+    this.timer = this.scene.time.addEvent({
+      delay: 22,
+      repeat: this.full.length - 1,
+      callback: () => {
+        i++;
+        this.text.setText(this.full.slice(0, i));
+        if (i % 3 === 0) SFX.skrepka(i);
+        if (i >= this.full.length) this.finishLine();
+      },
+    });
+    if (!this.full.length) this.finishLine();
+  }
+
+  private finishLine() {
+    this.typing = false;
+    const last = this.li >= this.lines.length - 1;
+    this.cta.setText(last ? '●' : '▼').setAlpha(1);
+    this.scene.tweens.add({
+      targets: this.cta, alpha: 0.25, duration: 700, yoyo: true, repeat: -1,
+    });
+  }
+
+  /** Tap: skip typing, or move to the next line. */
+  advance() {
+    SFX.tap();
+    if (this.typing) {
+      this.timer?.remove();
+      this.text.setText(this.full);
+      this.finishLine();
+      return;
+    }
+    if (this.li < this.lines.length - 1) {
+      this.li++;
+      this.scene.tweens.killTweensOf(this.cta);
+      this.typeLine();
+    } else {
+      this.hide(() => this.onDone?.());
+    }
+  }
+
+  hide(cb?: () => void) {
+    this.timer?.remove();
+    this.scene.tweens.add({
+      targets: this.root, alpha: 0, scale: 0.94, duration: 200,
+      onComplete: () => { this.root.setVisible(false); cb?.(); },
+    });
+  }
+
+  show() {
+    this.root.setVisible(true).setAlpha(1).setScale(1);
+    return this;
+  }
+
+  setPosition(x: number, y: number) {
+    this.root.setPosition(x, y);
+    return this;
+  }
+
+  destroy() {
+    this.timer?.remove();
+    this.root.destroy();
+  }
+
+  get container() { return this.root; }
+}
