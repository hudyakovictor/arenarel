+import type { CaseDef } from '../core/types';
+
+/**
+ * CASES — the product.
+ *
+ * Every case is a sealed decision under adversarial pressure. The player sees
+ * a frozen chart, a limited attention budget, and an enemy actively selling a
+ * plausible wrong read. Then the market reveals what it had already decided.
+ *
+ * Rule for authoring: the correct answer must be derivable from the evidence
+ * tiles alone. No case may be a coin flip. If it's a coin flip, it's a casino,
+ * and a casino teaches nothing.
+ */
