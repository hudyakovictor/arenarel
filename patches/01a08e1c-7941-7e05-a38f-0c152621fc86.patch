+    rule: 'Заголовок и толпа не участвуют в решении.',
+    guards: 'Новость как сигнал',
+    color: COL.purple,
+    icon: '◈',
+  },
+  {
+    id: 'p_pause',
+    name: 'ПАУЗА ПОСЛЕ СТОПА',
+    rule: 'После убытка следующий кейс читается с нуля.',
+    guards: 'Желание отыграться',
+    color: COL.gold,
+    icon: '◉',
+  },
+  {
+    id: 'p_invalid',
+    name: 'ТОЧКА ОШИБКИ',
+    rule: 'Не знаешь, где ты неправ — значит ты уже неправ.',
+    guards: 'Вход без инвалидации',
+    color: COL.orange,
+    icon: '◊',
+  },
+  {
+    id: 'p_aside',
+    name: 'ПРАВО НЕ ИГРАТЬ',
+    rule: 'Вне рынка — полноценное решение, а не пропуск хода.',
+    guards: 'Потребность действовать',
+    color: COL.red,
+    icon: '⬣',
+  },
+];
+
+export const PROTOCOL_BY_ID = Object.fromEntries(PROTOCOLS.map((p) => [p.id, p]));
+
+/** Starting loadout — the rest unlock through chapters. */
+export const STARTER_PROTOCOLS = ['p_evidence', 'p_limit', 'p_aside'];
