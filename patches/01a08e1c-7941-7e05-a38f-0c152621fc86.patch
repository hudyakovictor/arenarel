+/* Extracts real geometry from live scenes and audits it against the design rules. */
+import { setupDOM } from './dom-env.mjs';
+setupDOM();
+import { appendFileSync, writeFileSync } from 'node:fs';
+const LOG='/tmp/layout.log'; writeFileSync(LOG,'');
+const log=(...a:any[])=>appendFileSync(LOG,a.map(String).join(' ')+'\n');
+setTimeout(()=>{log('TIMEOUT');process.exit(3);},140000).unref?.();
+
+const Phaser=(await import('phaser')).default;
+(globalThis as any).Phaser=Phaser;(window as any).Phaser=Phaser;
+const UIPlugin=(await import('phaser4-rex-plugins/templates/ui/ui-plugin.js')).default;
+console.error=(...a:any[])=>{const m=a.map(String).join(' ');if(!/focus\(\)/.test(m))log('ERR:',m);};
+
+const store:Record<string,string>={};
+(globalThis as any).localStorage={getItem:(k:string)=>store[k]??null,setItem:(k:string,v:string)=>{store[k]=v},removeItem:(k:string)=>{delete store[k]},clear:()=>{}};
+
+const S=await Promise.all(['Boot','Intro','Home','Case','Reveal','Result','Journal','Map','Protocols']
+  .map(async n=>(await import(`../src/scenes/${n}Scene`))[`${n}Scene`]));
+const {State}=await import('../src/systems/state');
+const {CASES}=await import('../src/data/cases');
+const {VIEW}=await import('../src/core/theme');
+
+const game=new Phaser.Game({type:Phaser.HEADLESS,parent:'game',width:VIEW.W,height:VIEW.H,
+  banner:false,audio:{noAudio:true},scene:S as any,
+  plugins:{scene:[{key:'rexUI',plugin:UIPlugin,mapping:'rexUI'}]}});
+const wait=(ms:number)=>new Promise(r=>setTimeout(r,ms));
+await wait(1400);
+const keys=['skrepka','skrepka_bust'];
+for(const e of ['fomo','leverage','headline','revenge','hubris'])keys.push('a_'+e,'c_'+e);
+for(const k of keys) if(!game.textures.exists(k)){try{game.textures.createCanvas(k,64,64);}catch{}}
+State.load();
+await wait(200);
+
+let pass=0,fail=0;
+const ok=(c:boolean,m:string)=>{c?pass++:(fail++,log('  ✗ '+m));};
+
+const SEEN=new WeakSet<any>();
+function walk(o:any,out:any[]=[],d=0,seen=new Set<any>()):any[]{
+  if(!o||d>8)return out;
+  const a=Array.isArray(o.list)?o.list:[];
+  let e:any=[]; try{ const g=o.getElement?.('items'); if(Array.isArray(g)) e=g; }catch{}
+  const list=[...a,...e];
+  for(const c of list){
+    if(!c||seen.has(c))continue;
+    seen.add(c);
+    if(c.getBounds&&c.visible!==false){
+      try{const b=c.getBounds();if(b.width>0&&b.height>0)out.push({t:c.type||c.constructor?.name,b,o:c});}catch{}
+    }
+    walk(c,out,d+1,seen);
+  }
+  return out;
+}
+
+async function audit(key:string,data?:any){
+  game.scene.stop(game.scene.getScenes(true)[0]?.scene.key);
+  await wait(60);
+  try{game.scene.start(key,data);}catch(e:any){log('start threw '+key+': '+e.message);fail++;return;}
+  await wait(850);
+  const sc:any=game.scene.getScene(key);
+  const objs=walk(sc.children);
+  const texts=objs.filter(o=>o.t==='Text');
+
+  // --- 9:16 containment: nothing may spill horizontally off the frame ---
+  const spill=objs.filter(o=>o.b.x < -8 || o.b.x+o.b.width > VIEW.W+8);
+  if(spill.length){ for(const sp of spill.slice(0,4)){ const o=sp.o; const anc:string[]=[]; let q:any=o; for(let i=0;i<6&&q;i++){ anc.push(q.constructor?.name+(q.rexSizer?'[sz]':'')); q=q.rexSizer?.parent||q.parentContainer; }
+    log(`     spill ${sp.t} x=${Math.round(sp.b.x)} y=${Math.round(sp.b.y)} w=${Math.round(sp.b.width)} h=${Math.round(sp.b.height)} fill=${(o.fillColor||0).toString(16)} radius=${JSON.stringify(o.radius&&o.radius.tl?o.radius.tl.x:o.radius)} chain=${anc.join('<')}`);} }
+  ok(spill.length===0,`${key}: ${spill.length} objects overflow width`);
+
+  // --- vertical: content should fit the 960 frame (scroll panels excepted) ---
+  const belowFold=objs.filter(o=>o.b.y>VIEW.H+40);
+  const hasScroll=!!sc.children.list.find((c:any)=>c.constructor?.name?.includes('ScrollablePanel'));
+  if(!hasScroll){ if(belowFold.length) for(const o of belowFold.slice(0,6)) log(`     below-fold ${o.t} y=${Math.round(o.b.y)} h=${Math.round(o.b.height)} txt=${(o.o.text||'').slice(0,30)}`);
+    ok(belowFold.length===0,`${key}: ${belowFold.length} objects below the fold`); }
+
+  // --- legibility: no text smaller than 10px ---
+  const tiny=texts.filter(o=>parseInt(o.o.style?.fontSize||'14')<10);
+  ok(tiny.length===0,`${key}: ${tiny.length} texts under 10px`);
+
+  // --- restraint (rule #2): a single screen must not be a wall of widgets ---
+  const onScreen=objs.filter(o=>o.b.y+o.b.height>60 && o.b.y<VIEW.H);
+  ok(onScreen.length<170,`${key}: ${onScreen.length} objects in the viewport (<170 keeps it uncluttered)`);
+
+  log(`  ${key}: ${objs.length} objects, ${texts.length} texts, scroll=${hasScroll}`);
+  return objs;
+}
+
+log('== LAYOUT AUDIT ==');
+await audit('Intro');
+await audit('Home');
+await audit('Map');
+await audit('Protocols');
+await audit('Journal');
+const c=CASES[0];
+await audit('Case',{caseId:c.id});
+const v={regime:c.truth.regime,action:c.truth.bestAction,risk:1,confidence:70,
+  openedEvidence:c.evidence.filter(e=>e.decisive).map(e=>e.id),tookBait:false,usedProtocol:true,protocolId:'p_evidence'};
+await audit('Reveal',{caseId:c.id,verdict:v});
+await audit('Result',{caseId:c.id,verdict:v});
+
+log(`\n${pass} passed, ${fail} failed`);
+process.exit(fail?1:0);
