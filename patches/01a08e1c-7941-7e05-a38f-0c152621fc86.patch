+
+/**
+ * THE REVEAL.
+ *
+ * The market prints what it had already decided. We show the proof hash
+ * first — the outcome was sealed before the player answered, and they can
+ * verify that. That single detail is why the player can trust a loss here in
+ * a way they can never trust a black-box AI coach.
+ *
+ * Deliberately short: ~4 seconds. Tension, then cut to the verdict.
+ */
+export class RevealScene extends Phaser.Scene implements RexScene {
+  declare rexUI: any;
+  private bg!: ArenaBackground;
+
+  constructor() { super('Reveal'); }
+
+  create(data: { caseId: string; verdict: Verdict }) {
+    const def = CASE_BY_ID[data.caseId];
+    const enemy = ENEMIES[def.enemyId];
+    const series = generateSeries(`case:${def.id}`, {
+      pattern: def.pattern,
+      resolvesTrue: def.resolvesTrue,
+      base: def.asset.startsWith('BTC') ? 67200 : def.asset.startsWith('ETH') ? 3610 : 168,
+      vol: 0.012,
+      setupBars: 46,
+      revealBars: 18,
+    });
+
+    const { W, H } = VIEW;
+    this.bg = new ArenaBackground(this, enemy.color);
+    this.cameras.main.fadeIn(200, 0, 0, 0);
+
+    this.add.text(W / 2, 70, 'РЫНОК ПЕЧАТАЕТ', { ...TS.h2, color: HEX.text })
+      .setOrigin(0.5).setDepth(DEPTH.content);
+    this.add.text(W / 2, 98, 'то, что было решено до твоего ответа', { ...TS.tiny, color: HEX.dim })
+      .setOrigin(0.5).setDepth(DEPTH.content);
+
+    // --- chart ---
+    const chartH = 260;
+    panel(this, W - 32, chartH + 16, { fill: COL.bg1, stroke: COL.line })
+      .setPosition(W / 2, 130 + (chartH + 16) / 2).setDepth(DEPTH.content);
+    const chart = new CandleChart(this, { x: 24, y: 138, w: W - 48, h: chartH });
+    chart.setDepth(DEPTH.content + 2).showSetup(series);
+
+    // --- proof lines: verifiable determinism, stated plainly ---
+    let y = 130 + chartH + 40;
+    const hash = proofHash('case', def.id, def.pattern, String(def.resolvesTrue));
+    const lines = [
+      `▸ печать кейса ${def.id} … ${hash} ✓`,
+      '▸ исход зафиксирован до твоего ответа ✓',
+      '▸ разворачиваем ленту…',
+    ];
+    const objs: Phaser.GameObjects.Text[] = lines.map((l, i) => {
+      const t = this.add
+        .text(28, y + i * 24, l, { ...TS.mono, fontSize: '12px', color: HEX.dim })
+        .setDepth(DEPTH.content + 1)
+        .setAlpha(0);
+      return t;
+    });
+    objs.forEach((o, i) =>
+      this.tweens.add({
+        targets: o, alpha: 1, duration: 200, delay: 260 + i * 300,
+        onStart: () => SFX.tick(),
+        onComplete: () => o.setColor(i === 2 ? HEX.cyan : HEX.muted),
+      }),
+    );
+
+    // --- play the reveal ---
+    this.time.delayedCall(1150, () => {
+      SFX.reveal();
+      chart.playReveal(() => {
+        this.time.delayedCall(520, () => {
+          this.cameras.main.fadeOut(240, 0, 0, 0);
+          this.time.delayedCall(260, () =>
+            this.scene.start('Result', { caseId: data.caseId, verdict: data.verdict }),
+          );
+        });
+      }, 62);
+    });
+
+    // enemy watching
+    const face = this.add.image(W - 56, H - 58, enemy.avatar)
+      .setDisplaySize(64, 64).setAlpha(0).setDepth(DEPTH.content);
+    this.tweens.add({ targets: face, alpha: 0.85, duration: 500, delay: 1200 });
+  }
+
+  update(t: number, dt: number) { this.bg?.update(t, dt); }
+}
