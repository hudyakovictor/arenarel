new file mode 100644
index 0000000..e89bf2c
--- /dev/null
+++ b/tools/dom-env.mjs
@@ -0,0 +1,75 @@
+// Minimal browser environment good enough to boot Phaser 4 HEADLESS + rexUI.
+import { JSDOM } from 'jsdom';
+
+export function setupDOM() {
+  const dom = new JSDOM('<!DOCTYPE html><body><div id="game"></div></body>',
+    { pretendToBeVisual: true, url: 'http://localhost/' });
+  const g = globalThis;
+  for (const k of Object.getOwnPropertyNames(dom.window)) {
+    if (!(k in g)) { try { g[k] = dom.window[k]; } catch {} }
+  }
+  const nodePerf = globalThis.performance;
+  try { Object.defineProperty(dom.window, 'performance', { value: nodePerf, configurable: true }); } catch {}
+  g.window = dom.window;
+  g.document = dom.window.document;
+  for (const k of ['navigator','location']) {
+    try { Object.defineProperty(g, k, { value: dom.window[k], configurable: true }); } catch {}
+  }
+
+  // --- 2D context stub ---
+  const mkCtx = (canvas) => {
+    const c = {
+      canvas,
+      measureText: (t) => ({
+        width: String(t).length * 7,
+        actualBoundingBoxAscent: 10, actualBoundingBoxDescent: 3,
+        actualBoundingBoxLeft: 0, actualBoundingBoxRight: String(t).length * 7,
+      }),
+      getImageData: (x, y, w = 1, h = 1) => ({ data: new Uint8ClampedArray(Math.max(4, w * h * 4)), width: w, height: h }),
+      createImageData: (w = 1, h = 1) => ({ data: new Uint8ClampedArray(Math.max(4, w * h * 4)), width: w, height: h }),
+      putImageData(){}, createLinearGradient: () => ({ addColorStop(){} }),
+      createRadialGradient: () => ({ addColorStop(){} }), createPattern: () => ({}),
+      getContextAttributes: () => ({ alpha: true }),
+    };
+    return new Proxy(c, {
+      get: (t, p) => (p in t ? t[p] : (typeof p === 'string' ? () => {} : undefined)),
+      set: () => true,
+    });
+  };
+  dom.window.HTMLCanvasElement.prototype.getContext = function (type) {
+    if (type === '2d') { this.__c ||= mkCtx(this); return this.__c; }
+    return null; // no WebGL -> we run HEADLESS
+  };
+  dom.window.HTMLCanvasElement.prototype.toDataURL = () => 'data:image/png;base64,';
+
+  // --- Images resolve instantly so Phaser's boot + loader can complete ---
+  class FakeImage {
+    constructor() {
+      this.width = 512; this.height = 512;
+      this.naturalWidth = 512; this.naturalHeight = 512;
+      this.complete = true; this._src = '';
+      this._l = {};
+    }
+    addEventListener(t, f) { (this._l[t] ||= []).push(f); this._fire(); }
+    removeEventListener() {}
+    set onload(f) { this._onload = f; this._fire(); }
+    get onload() { return this._onload; }
+    set onerror(f) { this._onerror = f; }
+    set src(v) { this._src = v; this._fire(); }
+    get src() { return this._src; }
+    _fire() {
+      if (this._fired) return;
+      queueMicrotask(() => {
+        if (this._fired) return;
+        this._fired = true;
+        this._onload?.({ target: this });
+        (this._l['load'] || []).forEach((f) => f({ target: this }));
+      });
+    }
+  }
+  g.Image = FakeImage; dom.window.Image = FakeImage;
+
+  g.URL.createObjectURL ||= () => 'blob:x';
+  g.matchMedia ||= () => ({ matches:false, addListener(){}, removeListener(){}, addEventListener(){}, removeEventListener(){} });
+  return dom;
+}
diff --git a/tools/ext-loader.mjs b/tools/ext-loader.mjs
new file mode 100644
