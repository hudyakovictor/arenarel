+/**
+ * SIGNAL ARENA — design tokens.
+ * One source of truth for the whole UI. Nothing hardcodes a colour anywhere else.
+ */
+
+export const COL: Record<string, number> & {
+  bg0: number; bg1: number; bg2: number; card: number; card2: number; cardHi: number;
+  line: number; line2: number; cyan: number; cyanDim: number; green: number; greenDim: number;
+  gold: number; goldDim: number; red: number; redDim: number; purple: number; purpleDim: number;
+  orange: number; text: number; muted: number; dim: number; black: number;
+} = {
+  bg0: 0x04070f,
+  bg1: 0x070d1f,
+  bg2: 0x0a1224,
+  card: 0x0d1832,
+  card2: 0x111f42,
+  cardHi: 0x16264f,
+  line: 0x24314f,
+  line2: 0x3a4e78,
+
+  cyan: 0x22d8f5,
+  cyanDim: 0x0e7490,
+  green: 0x34d399,
+  greenDim: 0x0f5132,
+  gold: 0xf5c044,
+  goldDim: 0x6b4e10,
+  red: 0xfb4d6d,
+  redDim: 0x611425,
+  purple: 0xb388ff,
+  purpleDim: 0x3c2a6b,
+  orange: 0xff8a3d,
+
+  text: 0xf2f7ff,
+  muted: 0x8fa1c0,
+  dim: 0x5a6c8a,
+  black: 0x01030a,
+};
+
+export const HEX = Object.fromEntries(
+  Object.entries(COL).map(([k, v]) => [k, '#' + v.toString(16).padStart(6, '0')]),
+) as Record<keyof typeof COL, string>;
+
+/** Design resolution — strict 9:16 portrait. */
+export const VIEW = { W: 540, H: 960 } as const;
+
+export const FONT = {
+  ui: 'Inter, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif',
+  mono: 'ui-monospace, Menlo, Consolas, "Roboto Mono", monospace',
+} as const;
+
+/**
+ * NOTE: `pill` is a real radius, not a sentinel. rexUI's RoundRectangle sizes
+ * its geometry from the radius, so a CSS-style 999 would produce a 1998px-wide
+ * shape and blow straight through the 540px frame.
+ */
+export const RADIUS = { sm: 8, md: 14, lg: 20, pill: 13 } as const;
+
+export const SPACE = { xs: 4, sm: 8, md: 12, lg: 18, xl: 26 } as const;
+
+/** Text style presets — keeps typography consistent and prevents UI bloat. */
+export const TS = {
+  h1: { fontFamily: FONT.ui, fontSize: '30px', color: HEX.text, fontStyle: '900' },
+  h2: { fontFamily: FONT.ui, fontSize: '22px', color: HEX.text, fontStyle: '800' },
+  h3: { fontFamily: FONT.ui, fontSize: '17px', color: HEX.text, fontStyle: '800' },
+  body: { fontFamily: FONT.ui, fontSize: '15px', color: HEX.text },
+  bodyMuted: { fontFamily: FONT.ui, fontSize: '15px', color: HEX.muted },
+  small: { fontFamily: FONT.ui, fontSize: '13px', color: HEX.muted },
+  tiny: { fontFamily: FONT.ui, fontSize: '11px', color: HEX.dim, fontStyle: '800' },
+  label: { fontFamily: FONT.ui, fontSize: '11px', color: HEX.muted, fontStyle: '900' },
+  mono: { fontFamily: FONT.mono, fontSize: '13px', color: HEX.cyan },
+  monoBig: { fontFamily: FONT.mono, fontSize: '26px', color: HEX.cyan, fontStyle: '700' },
+  btn: { fontFamily: FONT.ui, fontSize: '17px', color: HEX.black, fontStyle: '900' },
+} as const;
+
+export const DEPTH = {
+  bg: 0,
+  world: 10,
+  content: 20,
+  hud: 60,
+  overlay: 80,
+  toast: 95,
+  fx: 98,
+} as const;
