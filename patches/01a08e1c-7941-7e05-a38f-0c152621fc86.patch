+import Phaser from 'phaser';
+import { COL, HEX, TS, VIEW, DEPTH, RADIUS } from '../core/theme';
+import { State } from '../systems/state';
+import { SFX, unlockAudio } from '../systems/audio';
+import { ArenaBackground } from '../ui/background';
+import { HUD } from '../ui/hud';
+import { primaryButton, panel, sectionLabel, pill, pillRow, toast, ghostButton } from '../ui/kit';
+import type { RexScene } from '../ui/kit';
+import { CASES, CHAPTERS } from '../data/cases';
+import { ENEMIES } from '../data/enemies';
+import { SKREPKA_STREAK } from '../data/skrepka';
+
+/**
+ * HOME — one screen, one obvious action.
+ *
+ * Rule #2 says the interface must not be overloaded, so the hub shows exactly
+ * three things: what to do next, what you left unfinished, and how you're
+ * doing. Everything else is one tap away and stays out of sight until asked
+ * for.
+ */
+export class HomeScene extends Phaser.Scene implements RexScene {
+  declare rexUI: any;
+  private bg!: ArenaBackground;
+  private hud!: HUD;
+
+  constructor() { super('Home'); }
+
+  create() {
+    const { W, H } = VIEW;
+    this.bg = new ArenaBackground(this, COL.cyan);
+    this.hud = new HUD(this);
+    this.input.once('pointerdown', unlockAudio);
+    this.cameras.main.fadeIn(240, 0, 0, 0);
+
+    const next = this.nextCase();
+    let y = 96;
+
+    // ---------- streak / daily line ----------
+    const openErrs = State.openErrors.length;
+    const streakRow = pillRow(this, W - 40, [
+      pill(this, `⚡ ${State.data.streak}`, COL.orange),
+      pill(this, `DQI ${State.avgDQI || '—'}`, COL.cyan),
+      pill(this, openErrs ? `${openErrs} В ЖУРНАЛЕ` : 'ЖУРНАЛ ЧИСТ', openErrs ? COL.red : COL.green),
+    ]);
+    streakRow.setPosition(W / 2, y + streakRow.height / 2).setDepth(DEPTH.content).layout();
+    y += 46;
+
+    // ---------- the next case: the hero card ----------
+    if (next) {
+      const ch = CHAPTERS.find((c) => c.n === next.chapter)!;
+      const enemy = ENEMIES[next.enemyId];
+      const railY = H - 196;
+      const cardH = railY - y - 20;
+      const card = panel(this, W - 40, cardH, { fill: COL.card, stroke: COL.line2 })
+        .setPosition(W / 2, y + cardH / 2)
+        .setDepth(DEPTH.content);
+
+      // Enemy art fills the upper half of the card and fades into it, so the
+      // hero block carries the screen instead of leaving a hole under it.
+      const artH = 268;
+      const img = this.add
