@@ -0,0 +1,145 @@
+/* Boots the REAL scenes headlessly and drives the full player journey. */
+import { setupDOM } from './dom-env.mjs';
+setupDOM();
+const Phaser = (await import('phaser')).default;
+(globalThis as any).Phaser = Phaser; (window as any).Phaser = Phaser;
+const UIPlugin = (await import('phaser4-rex-plugins/templates/ui/ui-plugin.js')).default;
+
+import { appendFileSync, writeFileSync } from 'node:fs';
+const LOG = '/tmp/ui-test.log';
+writeFileSync(LOG, '');
+const log = (...a: any[]) => { appendFileSync(LOG, a.map(String).join(' ') + '\n'); };
+setTimeout(() => { log('!!! HARD TIMEOUT'); process.exit(3); }, 150000).unref?.();
+
+const errors: string[] = [];
+console.error = (...a: any[]) => {
+  const m = a.map(String).join(' ');
+  if (/Not implemented: Window's focus/.test(m)) return; // jsdom artifact, not our code
+  errors.push(m); log('ERR:', m);
+};
+process.on('uncaughtException', (e) => errors.push('UNCAUGHT: ' + e.stack));
+process.on('unhandledRejection', (e: any) => errors.push('REJECTION: ' + (e?.stack || e)));
+
+log('step: importing scenes');
+const { BootScene } = await import('../src/scenes/BootScene');
+const { IntroScene } = await import('../src/scenes/IntroScene');
+const { HomeScene } = await import('../src/scenes/HomeScene');
+const { CaseScene } = await import('../src/scenes/CaseScene');
+const { RevealScene } = await import('../src/scenes/RevealScene');
+const { ResultScene } = await import('../src/scenes/ResultScene');
+const { JournalScene } = await import('../src/scenes/JournalScene');
+const { MapScene } = await import('../src/scenes/MapScene');
+const { ProtocolsScene } = await import('../src/scenes/ProtocolsScene');
+const { State } = await import('../src/systems/state');
+const { CASES } = await import('../src/data/cases');
+
+// in-memory localStorage so save/load is exercised for real
+const store: Record<string,string> = {};
+(globalThis as any).localStorage = {
+  getItem:(k:string)=>store[k]??null, setItem:(k:string,v:string)=>{store[k]=v;},
+  removeItem:(k:string)=>{delete store[k];}, clear:()=>{for(const k in store)delete store[k];},
+};
+
+let pass = 0, fail = 0;
+const ok = (c: boolean, m: string) => { c ? pass++ : (fail++, log('  ✗ ' + m)); };
+
+log('step: creating game');
+const game = new Phaser.Game({
+  type: Phaser.HEADLESS, parent: 'game', width: 540, height: 960,
+  banner: false, audio: { noAudio: true },
+  scene: [BootScene, IntroScene, HomeScene, CaseScene, RevealScene, ResultScene, JournalScene, MapScene, ProtocolsScene],
+  plugins: { scene: [{ key: 'rexUI', plugin: UIPlugin, mapping: 'rexUI' }] },
+});
+
+const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
+log('step: waiting boot');
+await wait(1500);
+log('step: booted='+game.isBooted+' running='+game.isRunning+' scenes='+game.scene.getScenes(true).map(s=>s.scene.key).join(','));
+
+// Textures won't decode in HEADLESS; register stubs so add.image works.
+log('step: texture stubs');
+const keys=['skrepka','skrepka_bust'];
+for (const e of ['fomo','leverage','headline','revenge','hubris']) keys.push('a_'+e,'c_'+e);
+for (const k of keys) {
+  log('  tex '+k+' exists='+game.textures.exists(k));
+  if (!game.textures.exists(k)) { try { const c = game.textures.createCanvas(k, 8, 8); c?.refresh(); log('   created'); } catch(e:any){ log('   ERR '+e.message); } }
+}
+await wait(300);
+
+async function run(key: string, data?: any) {
+  log('  run() -> '+key);
+  const before = errors.length;
+  game.scene.stop(game.scene.getScenes(true)[0]?.scene.key);
+  await wait(60);
+  try { game.scene.start(key, data); } catch(e:any){ log('  start threw: '+e.stack); }
+  await wait(900);
+  log('  run() done '+key);
+  const sc = game.scene.getScene(key);
+  const active = game.scene.isActive(key);
+  const newErrs = errors.slice(before);
+  ok(!!sc && active, `${key}: scene is active`);
+  ok(newErrs.length === 0, `${key}: no errors  ${newErrs.slice(0,2).join(' | ')}`);
+  // the scene actually built a display list
+  const n = sc ? (sc.children as any).list.length : 0;
+  ok(n > 3, `${key}: rendered ${n} objects`);
+  return sc as any;
+}
+
+log('reached: scene boot');
+log('step: State.load'); State.load(); log('step: loaded');
+await run('Intro');
+await run('Home');
+await run('Map');
+await run('Protocols');
+await run('Journal');
+
+log('\n── FULL CASE FLOW (every case, every phase)');
+for (const c of CASES) {
+  const before = errors.length;
+  const sc: any = await run('Case', { caseId: c.id });
+  // phase 1 -> 2 -> 3 via the real methods
+  try {
+    sc.protocolId = 'p_evidence';
+    sc.showEvidencePhase();
+    await wait(300);
+    ok(errors.length === before, `${c.id}: evidence phase clean`);
+    // open both evidence tiles the way a player would
+    sc.opened = c.evidence.filter((e: any) => e.decisive).map((e: any) => e.id);
+    sc.looks = 0;
+    sc.showVerdictPhase();
+    await wait(300);
+    sc.regime = c.truth.regime; sc.action = c.truth.bestAction; sc.refreshSeal();
+    await wait(120);
+    ok(errors.length === before, `${c.id}: verdict phase clean`);
+  } catch (e: any) { fail++; log(`  ✗ ${c.id}: phase transition threw — ${e.stack}`); }
+
+  const verdict = {
+    regime: c.truth.regime, action: c.truth.bestAction, risk: 1, confidence: 70,
+    openedEvidence: c.evidence.filter((e:any)=>e.decisive).map((e:any)=>e.id),
+    tookBait: false, usedProtocol: true, protocolId: 'p_evidence',
+  };
+  await run('Reveal', { caseId: c.id, verdict });
+  await run('Result', { caseId: c.id, verdict });
+}
+
+log('\n── STATE AFTER FULL CLEAR');
+ok(State.totalCases === CASES.length, `all ${CASES.length} cases recorded (${State.totalCases})`);
+ok(State.data.xp > 0, 'xp accumulated');
+ok(State.level > 1, `levelled up (level ${State.level})`);
+ok(State.data.unlockedProtocols.length > 3, `protocols unlocked (${State.data.unlockedProtocols.length})`);
+
+// persistence round-trip
+State.save();
+const raw = store['signal-arena-save-v1'];
+ok(!!raw, 'save written to storage');
+ok(JSON.parse(raw).cleared && Object.keys(JSON.parse(raw).cleared).length === CASES.length, 'save contains progress');
+
+log('\n── POST-CLEAR SCREENS');
+await run('Home');
+await run('Map');
+await run('Journal');
+await run('Protocols');
+
+log(`\n${pass} passed, ${fail} failed`);
+if (errors.length) { log('\nERRORS:'); errors.slice(0,12).forEach(e=>log('  '+e.slice(0,300))); }
+process.exit(fail || errors.length ? 1 : 0);
