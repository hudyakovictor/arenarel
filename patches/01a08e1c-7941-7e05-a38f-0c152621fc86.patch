@@ -0,0 +1,186 @@
+/* Headless validation of the game's logic. No Phaser, no DOM. */
+import { CASES, CHAPTERS } from '../src/data/cases';
+import { ENEMIES } from '../src/data/enemies';
+import { PROTOCOLS, STARTER_PROTOCOLS } from '../src/data/protocols';
+import { generateSeries, revealMovePct } from '../src/core/market';
+import { scoreVerdict } from '../src/core/scoring';
+import { RNG } from '../src/core/rng';
+import type { Case, Verdict, ActionKind, Regime } from '../src/core/types';
+
+let pass = 0, fail = 0;
+const ok = (c: boolean, m: string) => { c ? pass++ : (fail++, console.log('  ✗ ' + m)); };
+const section = (s: string) => console.log('\n── ' + s);
+
+function build(def: typeof CASES[number]): Case {
+  return {
+    ...def,
+    enemy: ENEMIES[def.enemyId],
+    series: generateSeries(`case:${def.id}`, {
+      pattern: def.pattern, resolvesTrue: def.resolvesTrue,
+      base: def.asset.startsWith('BTC') ? 67200 : def.asset.startsWith('ETH') ? 3610 : 168,
+      vol: 0.012, setupBars: 46, revealBars: 18,
+    }),
+  };
+}
+const built = CASES.map(build);
+
+// ---------------------------------------------------------------- content
+section('CONTENT INTEGRITY');
+ok(CASES.length >= 9, 'at least 9 cases');
+ok(new Set(CASES.map(c=>c.id)).size === CASES.length, 'case ids unique');
+for (const c of CASES) {
+  ok(!!ENEMIES[c.enemyId], `${c.id}: enemy exists`);
+  ok(c.evidence.length === 4, `${c.id}: exactly 4 evidence tiles`);
+  const dec = c.evidence.filter(e=>e.decisive).length;
+  ok(dec >= 1 && dec <= 2, `${c.id}: 1-2 decisive tiles (budget is 2) — got ${dec}`);
+  ok(new Set(c.evidence.map(e=>e.id)).size === 4, `${c.id}: evidence ids unique`);
+  ok(c.truth.lesson.length > 30, `${c.id}: has a real lesson`);
+  ok(c.truth.mechanism.length > 40, `${c.id}: explains the mechanism`);
+  ok(c.hint.length > 10, `${c.id}: has a hint`);
+  ok(c.brief.length > 30, `${c.id}: has a brief`);
+  for (const e of c.evidence) ok(e.read.length > 15, `${c.id}/${e.id}: tile has a reading`);
+}
+for (const ch of CHAPTERS) {
+  ok(CASES.some(c=>c.chapter===ch.n), `chapter ${ch.n} has cases`);
+  ok(PROTOCOLS.some(p=>p.id===ch.unlockProtocol), `chapter ${ch.n} unlock exists`);
+}
+ok(STARTER_PROTOCOLS.every(id=>PROTOCOLS.some(p=>p.id===id)), 'starter protocols exist');
+// every protocol is reachable
+const reachable = new Set([...STARTER_PROTOCOLS, ...CHAPTERS.map(c=>c.unlockProtocol)]);
+ok(PROTOCOLS.every(p=>reachable.has(p.id)), 'every protocol is obtainable');
+
+// ---------------------------------------------------------------- determinism
+section('DETERMINISM (core product promise)');
+for (const def of CASES) {
+  const a = build(def), b = build(def);
+  const sa = JSON.stringify(a.series), sb = JSON.stringify(b.series);
+  ok(sa === sb, `${def.id}: identical series across regenerations`);
+}
+{
+  const r1 = new RNG('x'), r2 = new RNG('x');
+  ok(Array.from({length:50},()=>r1.next()).join() === Array.from({length:50},()=>r2.next()).join(), 'RNG reproducible');
+  const r3 = new RNG('y');
+  ok(new RNG('x').next() !== r3.next(), 'different seeds diverge');
+}
+
+// ---------------------------------------------------------------- market sanity
+section('MARKET SERIES SANITY');
+for (const c of built) {
+  const all = c.series.setup.concat(c.series.reveal);
+  ok(all.every(k=>k.h >= Math.max(k.o,k.c) - 1e-6), `${c.id}: high >= body`);
+  ok(all.every(k=>k.l <= Math.min(k.o,k.c) + 1e-6), `${c.id}: low <= body`);
+  ok(all.every(k=>k.v > 0), `${c.id}: volume positive`);
+  ok(all.every(k=>Number.isFinite(k.o+k.h+k.l+k.c)), `${c.id}: no NaN`);
+  ok(c.series.setup.length === 46 && c.series.reveal.length === 18, `${c.id}: bar counts`);
+  const mv = Math.abs(revealMovePct(c.series));
+  ok(mv > 0.05 && mv < 60, `${c.id}: reveal move plausible (${mv.toFixed(2)}%)`);
+}
+
+// ---------------------------------------------------------------- scoring
+section('SCORING — THE PRODUCT THESIS');
+const mkV = (c: Case, o: Partial<Verdict> = {}): Verdict => ({
+  regime: c.truth.regime, action: c.truth.bestAction, risk: 1, confidence: 70,
+  openedEvidence: c.evidence.filter(e=>e.decisive).map(e=>e.id),
+  tookBait: false, usedProtocol: true, protocolId: 'p_evidence', ...o,
+});
+
+for (const c of built) {
+  const perfect = scoreVerdict(c, mkV(c));
+  ok(perfect.total >= 92, `${c.id}: perfect play scores S (${perfect.total})`);
+  ok(perfect.errorTag === null, `${c.id}: perfect play logs no error`);
+  ok(perfect.stars === 3, `${c.id}: perfect play = 3 stars`);
+
+  const blind = scoreVerdict(c, mkV(c, {
+    openedEvidence: [], confidence: 95, tookBait: true, risk: 2.5,
+    action: c.truth.bestAction === 'aside' ? 'long' : c.truth.bestAction === 'long' ? 'short' : 'long',
+    regime: c.truth.regime === 'trap' ? 'trend' : 'trap',
+  }));
+  ok(blind.total <= 25, `${c.id}: reckless play scores F (${blind.total})`);
+  ok(blind.errorTag !== null, `${c.id}: reckless play logs an error`);
+  ok(blind.total < perfect.total, `${c.id}: ordering holds`);
+
+  // all scores are in range and criteria sum correctly
+  for (const v of [perfect, blind]) {
+    ok(v.total === v.criteria.reduce((a,b)=>a+b.score,0), `${c.id}: criteria sum == total`);
+    ok(v.criteria.every(k=>k.score>=0 && k.score<=20), `${c.id}: criteria in 0..20`);
+    ok(v.criteria.every(k=>k.note.length>10), `${c.id}: every criterion explains itself`);
+    ok(v.xp>0 && v.credits>0, `${c.id}: rewards positive`);
+  }
+}
+
+section('PROFIT MUST NOT PAY');
+{
+  // Two verdicts, same case, identical quality inputs but opposite P&L outcomes.
+  // Rewards must depend ONLY on quality.
+  let checked = 0;
+  for (const c of built) {
+    const good = scoreVerdict(c, mkV(c));
+    // a reckless verdict that happens to be profitable
+    for (const act of ['long','short'] as ActionKind[]) {
+      const v = mkV(c, { action: act, openedEvidence: [], confidence: 95, risk: 2.5, tookBait: true, regime: c.truth.regime === 'trap' ? 'trend':'trap' });
+      const r = scoreVerdict(c, v);
+      const profitable = act === 'long' ? r.movePct > 0 : r.movePct < 0;
+      if (profitable) {
+        ok(r.total < good.total, `${c.id}: profitable-but-reckless scores below correct play`);
+        ok(r.luckyWin, `${c.id}: profitable-but-reckless flagged as lucky win`);
+        ok(r.xp < good.xp, `${c.id}: lucky win pays less XP than good decision`);
+        checked++;
+      }
+    }
+  }
+  ok(checked > 0, `lucky-win path exercised (${checked} cases)`);
+}
+
+section('CORRECT LOSS MUST PAY');
+{
+  let checked = 0;
+  for (const c of built) {
+    if (c.truth.bestAction === 'aside') continue;
+    const r = scoreVerdict(c, mkV(c));
+    const profitable = c.truth.bestAction === 'long' ? r.movePct > 0 : r.movePct < 0;
+    if (!profitable) { ok(r.total >= 75 && r.goodLoss, `${c.id}: correct-but-losing still scores well`); checked++; }
+  }
+  console.log(`  (good-loss cases present: ${checked})`);
+}
+
+section('STAND-ASIDE IS A REAL ANSWER');
+for (const c of built.filter(x=>x.truth.bestAction==='aside')) {
+  const r = scoreVerdict(c, mkV(c, { action:'aside', risk:0 }));
+  ok(r.total >= 92, `${c.id}: correct stand-aside is top-scored (${r.total})`);
+}
+ok(built.filter(x=>x.truth.bestAction==='aside').length >= 3, 'enough stand-aside cases to teach restraint');
+
+section('RISK DISCIPLINE IS ENFORCED');
+for (const c of built.filter(x=>x.truth.bestAction!=='aside')) {
+  const sane = scoreVerdict(c, mkV(c, { risk: 1 }));
+  const over = scoreVerdict(c, mkV(c, { risk: 2.5 }));
+  ok(over.total < sane.total, `${c.id}: oversizing is penalised even when right`);
+}
+
+section('BALANCE / PROGRESSION');
+{
+  // A player answering perfectly should not trivially max out; a poor player should still progress slowly.
+  const perfXP = built.reduce((a,c)=>a+scoreVerdict(c,mkV(c)).xp,0);
+  ok(perfXP > 1500 && perfXP < 4000, `full-clear XP is in a sane band (${perfXP})`);
+  const grades = built.map(c=>scoreVerdict(c,mkV(c)).grade);
+  ok(grades.every(g=>g==='S'), 'perfect play yields S across the board');
+  // distribution check on partial play: opening only 1 of 2 decisive tiles
+  const mids = built.map(c=>{
+    const dec = c.evidence.filter(e=>e.decisive).map(e=>e.id);
+    return scoreVerdict(c, mkV(c, { openedEvidence: dec.slice(0,1), confidence: 60 })).total;
+  });
+  const avg = mids.reduce((a,b)=>a+b,0)/mids.length;
+  ok(avg > 55 && avg < 95, `partial-evidence play lands mid-band (avg ${avg.toFixed(0)})`);
+}
+
+section('NO CASE IS A COIN FLIP');
+for (const c of built) {
+  // The correct answer must be derivable: decisive tiles must exist and
+  // opening them must materially beat not opening them.
+  const withEv = scoreVerdict(c, mkV(c)).total;
+  const without = scoreVerdict(c, mkV(c, { openedEvidence: [] })).total;
+  ok(withEv - without >= 15, `${c.id}: evidence materially changes the score (+${withEv-without})`);
+}
+
+console.log(`\n${pass} passed, ${fail} failed`);
+process.exit(fail ? 1 : 0);
