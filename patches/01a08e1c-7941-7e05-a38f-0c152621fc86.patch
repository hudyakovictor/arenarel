+import Phaser from 'phaser';
+import { COL, HEX, TS, VIEW } from '../core/theme';
+import { State } from '../systems/state';
+import { ENEMY_LIST } from '../data/enemies';
+
+export class BootScene extends Phaser.Scene {
+  constructor() { super('Boot'); }
+
+  preload() {
+    const { W, H } = VIEW;
+    this.cameras.main.setBackgroundColor(COL.bg0);
+
+    const title = this.add
+      .text(W / 2, H / 2 - 60, 'SIGNAL ARENA', {
+        ...TS.h1, color: HEX.text, fontSize: '34px',
+      })
+      .setOrigin(0.5);
+    title.setAlpha(0);
+    this.tweens.add({ targets: title, alpha: 1, duration: 600 });
+
+    this.add
+      .text(W / 2, H / 2 - 24, 'Т Р Е Н А Ж Ё Р   Р Е Ш Е Н И Й', { ...TS.label, color: HEX.dim })
+      .setOrigin(0.5);
+
+    const trackW = 220;
+    this.add.rectangle(W / 2, H / 2 + 30, trackW, 4, COL.line);
+    const fill = this.add.rectangle(W / 2 - trackW / 2, H / 2 + 30, 2, 4, COL.cyan).setOrigin(0, 0.5);
+    const pct = this.add
+      .text(W / 2, H / 2 + 54, '0%', { ...TS.tiny, color: HEX.muted })
+      .setOrigin(0.5);
+
+    this.load.on('progress', (v: number) => {
+      fill.width = Math.max(2, trackW * v);
+      pct.setText(Math.round(v * 100) + '%');
+    });
+
+    // --- assets ---
+    this.load.image('skrepka', 'assets/char/skrepka.png');
+    this.load.image('skrepka_bust', 'assets/char/skrepka_bust.png');
+    const FILES: Record<string, string> = {
+      fomo: 'fomo_wraith', leverage: 'leverage_goblin', headline: 'headline_titan',
+      revenge: 'revenge_wraith', hubris: 'hubris_dragon',
+    };
+    for (const e of ENEMY_LIST) {
+      const f = FILES[e.id];
+      this.load.image(e.avatar, `assets/enemy/${f}_avatar.png`);
+      this.load.image(e.card, `assets/enemy/${f}_card.png`);
+    }
+  }
+
+  create() {
+    State.load();
+    this.scene.start(State.data.seenIntro ? 'Home' : 'Intro');
+  }
+}
