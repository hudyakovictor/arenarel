+      });
+      btn.node.setPosition(W / 2, H - 148).setDepth(DEPTH.content);
+    } else {
+      // all cleared — the honest ending, not a fake infinite grind
+      const c = panel(this, W - 40, 150, { stroke: COL.gold })
+        .setPosition(W / 2, y + 75).setDepth(DEPTH.content);
+      this.add.text(W / 2, y + 40, 'ВСЕ КЕЙСЫ ЗАКРЫТЫ', { ...TS.h2, color: HEX.gold })
+        .setOrigin(0.5).setDepth(DEPTH.content + 1);
+      this.add.text(W / 2, y + 78,
+        'Ты прошёл всё, что у нас есть.\nТеперь возвращайся и улучшай оценки —\nтам, где было «нормально».',
+        { ...TS.small, color: HEX.muted, align: 'center', lineSpacing: 4 })
+        .setOrigin(0.5).setDepth(DEPTH.content + 1);
+      const btn = primaryButton(this, 'ОТКРЫТЬ КАРТУ ГЛАВ', W - 40, () => this.scene.start('Map'), { color: COL.gold });
+      btn.node.setPosition(W / 2, H - 148).setDepth(DEPTH.content);
+    }
+
+    // ---------- secondary nav: quiet, three targets ----------
+    const nav = this.rexUI.add
+      .sizer({ x: W / 2, y: H - 66, width: W - 40, orientation: 'x', space: { item: 10 } })
+      .setDepth(DEPTH.content);
+    const mk = (label: string, sub: string, color: number, go: () => void) => {
+      const s = this.rexUI.add.sizer({ orientation: 'y', space: { item: 2 } });
+      const bgp = this.rexUI.add.roundRectangle(0, 0, 2, 2, RADIUS.md, COL.card2, 0.9)
+        .setStrokeStyle(1, COL.line);
+      s.addBackground(bgp);
+      s.add(this.add.text(0, 0, label, { ...TS.small, color: '#' + color.toString(16).padStart(6, '0'), fontStyle: '900' }), { align: 'center' });
+      s.add(this.add.text(0, 0, sub, { ...TS.tiny, color: HEX.dim }), { align: 'center' });
+      s.setInteractive({ useHandCursor: true }).on('pointerup', () => { SFX.tap(); go(); });
+      return { s, bgp };
+    };
+    const journalCount = State.openErrors.length;
+    const items = [
+      mk('ЖУРНАЛ', journalCount ? `${journalCount} открыто` : 'чисто', journalCount ? COL.red : COL.green, () => this.scene.start('Journal')),
+      mk('ГЛАВЫ', `${State.totalCases}/${CASES.length}`, COL.cyan, () => this.scene.start('Map')),
+      mk('ПРОТОКОЛЫ', `${State.data.unlockedProtocols.length} шт`, COL.purple, () => this.scene.start('Protocols')),
+    ];
+    items.forEach((i) => nav.add(i.s, { proportion: 1, expand: true, padding: { top: 10, bottom: 10 } }));
+    nav.layout();
+
+    // ---------- Skrepka nudge on a returning streak ----------
+    if (State.data.streak >= 2 && State.totalCases > 0) {
+      this.time.delayedCall(700, () =>
+        toast(this, SKREPKA_STREAK[Math.min(SKREPKA_STREAK.length - 1, State.data.streak - 2)], COL.orange),
+      );
+    }
+  }
+
+  /** Next unplayed case, else the lowest-scoring one worth improving. */
+  private nextCase() {
+    const fresh = CASES.find((c) => !State.isCleared(c.id));
+    if (fresh) return fresh;
+    let worst = CASES[0];
+    for (const c of CASES) if (State.best(c.id) < State.best(worst.id)) worst = c;
+    return State.best(worst.id) >= 92 ? null : worst;
+  }
+
+  update(t: number, dt: number) { this.bg?.update(t, dt); }
+}
