+import Phaser from 'phaser';
+import UIPlugin from 'phaser4-rex-plugins/templates/ui/ui-plugin.js';
+
+import { VIEW, COL } from './core/theme';
+import { BootScene } from './scenes/BootScene';
+import { IntroScene } from './scenes/IntroScene';
+import { HomeScene } from './scenes/HomeScene';
+import { CaseScene } from './scenes/CaseScene';
+import { RevealScene } from './scenes/RevealScene';
+import { ResultScene } from './scenes/ResultScene';
+import { JournalScene } from './scenes/JournalScene';
+import { MapScene } from './scenes/MapScene';
+import { ProtocolsScene } from './scenes/ProtocolsScene';
+
+/**
+ * SIGNAL ARENA
+ * Phaser 4 · TypeScript · Vite · rexUI
+ *
+ * Hard constraint #1: 9:16, always. The design resolution is 540×960 and
+ * Phaser.Scale.FIT letterboxes it, so the layout is authored once and is
+ * pixel-identical from a small Android phone to a desktop browser. No
+ * responsive branching, no reflow bugs, no landscape mode.
+ */
+
+// rexUI reads the global Phaser namespace internally.
+(window as any).Phaser = Phaser;
+
+const game = new Phaser.Game({
+  type: Phaser.AUTO,
+  parent: 'game',
+  width: VIEW.W,
+  height: VIEW.H,
+  backgroundColor: COL.bg0,
+  antialias: true,
+  roundPixels: false,
+  scale: {
+    mode: Phaser.Scale.FIT,
+    autoCenter: Phaser.Scale.CENTER_BOTH,
+    width: VIEW.W,
+    height: VIEW.H,
+  },
+  dom: { createContainer: false },
+  banner: false,
+  scene: [
+    BootScene,
+    IntroScene,
+    HomeScene,
+    CaseScene,
+    RevealScene,
+    ResultScene,
+    JournalScene,
+    MapScene,
+    ProtocolsScene,
+  ],
+  plugins: {
+    scene: [{ key: 'rexUI', plugin: UIPlugin, mapping: 'rexUI' }],
+  },
+});
+
+export default game;
