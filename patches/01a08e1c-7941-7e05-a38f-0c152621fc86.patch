@@ -0,0 +1,523 @@
+import Phaser from 'phaser';
+import { COL, HEX, TS, VIEW, DEPTH, RADIUS } from '../core/theme';
+import { State } from '../systems/state';
+import { SFX, unlockAudio } from '../systems/audio';
+import { ArenaBackground } from '../ui/background';
+import { CandleChart } from '../ui/chart';
+import { primaryButton, panel, pill, toast, txt } from '../ui/kit';
+import type { RexScene } from '../ui/kit';
+import { CASE_BY_ID } from '../data/cases';
+import { ENEMIES } from '../data/enemies';
+import { PROTOCOL_BY_ID, PROTOCOLS } from '../data/protocols';
+import { SKREPKA_NOISE, SKREPKA_KEY, SKREPKA_HINT_PREFIX } from '../data/skrepka';
+import { generateSeries } from '../core/market';
+import { RNG } from '../core/rng';
+import type { Case, Regime, ActionKind, Verdict } from '../core/types';
+
+/**
+ * THE CASE — the entire game loop lives here.
+ *
+ *   1. PROTOCOL  — pre-commit to one rule before you see anything.
+ *   2. EVIDENCE  — a strictly limited attention budget. This is the core
+ *                  mechanic: you cannot look at everything, so you must
+ *                  decide what matters before you know the answer.
+ *   3. VERDICT   — regime + action + size + confidence, sealed at t₀.
+ *
+ * The attention budget is what stops this being a terminal. On a demo account
+ * you can stare at every indicator forever and still learn nothing. Here,
+ * choosing where to look IS the skill being trained.
+ */
+
+const BUDGET = 2; // decisive tiles are always ≤ 2 — the case is always solvable
+
+type Phase = 'protocol' | 'evidence' | 'verdict';
+
+export class CaseScene extends Phaser.Scene implements RexScene {
+  declare rexUI: any;
+  private bg!: ArenaBackground;
+  private c!: Case;
+  private phase: Phase = 'protocol';
+
+  // layer roots so we can swap phases without rebuilding the scene
+  private layer!: Phaser.GameObjects.Container;
+  private chart?: CandleChart;
+
+  // verdict state
+  private opened: string[] = [];
+  private looks = BUDGET;
+  private regime: Regime | null = null;
+  private action: ActionKind | null = null;
+  private risk = 1;
+  private confidence = 60;
+  private protocolId: string | null = null;
+  private tookBait = false;
+  private baitShown = false;
+
+  constructor() { super('Case'); }
+
+  create(data: { caseId: string }) {
+    const def = CASE_BY_ID[data.caseId];
+    const enemy = ENEMIES[def.enemyId];
+    const series = generateSeries(`case:${def.id}`, {
+      pattern: def.pattern,
+      resolvesTrue: def.resolvesTrue,
+      base: def.asset.startsWith('BTC') ? 67200 : def.asset.startsWith('ETH') ? 3610 : 168,
+      vol: 0.012,
+      setupBars: 46,
+      revealBars: 18,
+    });
+    this.c = { ...def, enemy, series };
+
+    this.opened = [];
+    this.looks = BUDGET;
+    this.regime = null;
+    this.action = null;
+    this.risk = 1;
+    this.confidence = 60;
+    this.protocolId = null;
+    this.tookBait = false;
+    this.baitShown = false;
+
+    this.bg = new ArenaBackground(this, enemy.color);
+    this.input.once('pointerdown', unlockAudio);
+    this.cameras.main.fadeIn(220, 0, 0, 0);
+
+    this.layer = this.add.container(0, 0).setDepth(DEPTH.content);
+    this.buildHeader();
+    this.showProtocolPhase();
+  }
+
+  // ================= header (shared across phases) =================
+  private headerTitle!: Phaser.GameObjects.Text;
+  private stepPips: Phaser.GameObjects.Rectangle[] = [];
+
+  private buildHeader() {
+    const { W } = VIEW;
+    const h = 64;
+    this.add.rectangle(W / 2, h / 2, W, h, COL.bg1, 0.96).setDepth(DEPTH.hud);
+    this.add.rectangle(W / 2, h, W, 1, COL.line).setDepth(DEPTH.hud);
+
+    this.add.text(20, 22, '‹', { ...TS.h1, color: HEX.muted })
+      .setOrigin(0, 0.5).setDepth(DEPTH.hud + 1)
+      .setInteractive({ useHandCursor: true })
+      .on('pointerup', () => { SFX.tap(); this.scene.start('Home'); });
+
+    this.headerTitle = this.add
+      .text(W / 2, 22, this.c.title.toUpperCase(), { ...TS.small, color: HEX.text, fontStyle: '900' })
+      .setOrigin(0.5).setDepth(DEPTH.hud + 1);
+
+    this.add.text(W / 2, 42, `${this.c.asset} · ${this.c.tf} · ЗАМОРОЖЕНО В t₀`, { ...TS.tiny, color: HEX.dim })
+      .setOrigin(0.5).setDepth(DEPTH.hud + 1);
+
+    for (let i = 0; i < 3; i++) {
+      const r = this.add.rectangle(W - 68 + i * 16, 22, 10, 3, COL.line).setDepth(DEPTH.hud + 1);
+      this.stepPips.push(r);
+    }
+    this.setStep(0);
+  }
+
+  private setStep(i: number) {
+    this.stepPips.forEach((p, k) => p.setFillStyle(k <= i ? COL.cyan : COL.line));
+  }
+
+  private clearLayer() {
+    this.layer.removeAll(true);
+    this.chart?.destroy();
+    this.chart = undefined;
+  }
+
+  // ================= PHASE 1: PROTOCOL =================
+  private showProtocolPhase() {
+    this.phase = 'protocol';
+    this.setStep(0);
+    this.clearLayer();
+    const { W, H } = VIEW;
+
+    const avail = PROTOCOLS.filter((p) => State.data.unlockedProtocols.includes(p.id));
+
+    // Vertical rhythm is computed, not guessed, so the block stays optically
+    // centred whether the player owns 3 protocols or all 6.
+    const cardH = 64;
+    const gap = 9;
+    const listH = avail.length * cardH + (avail.length - 1) * gap;
+    const introH = 96;
+    const footH = 110;
+    const top = 64;
+    const free = H - top - footH;
+    let y = top + Math.max(10, (free - listH - introH) / 2);
+
+    this.layer.add(
+      this.add.text(W / 2, y, 'ШАГ 1 · ПРЕДВАРИТЕЛЬНОЕ ОБЯЗАТЕЛЬСТВО', { ...TS.tiny, color: HEX.cyan }).setOrigin(0.5),
+    );
+    y += 22;
+    this.layer.add(
+      this.add.text(W / 2, y,
+        'Выбери правило до того, как увидишь график.\nПотом менять поздно — в этом весь смысл.',
+        { ...TS.small, color: HEX.muted, align: 'center', lineSpacing: 5 }).setOrigin(0.5, 0),
+    );
+    y += 62;
+
+    const cards: { bg: any }[] = [];
+    avail.forEach((p, i) => {
+      const cy = y + i * (cardH + gap) + cardH / 2;
+      const bg = this.rexUI.add
+        .roundRectangle(W / 2, cy, W - 40, cardH, RADIUS.md, COL.card)
+        .setStrokeStyle(1, COL.line);
+      const icon = this.add.text(44, cy, p.icon, {
+        ...TS.h2, color: '#' + p.color.toString(16).padStart(6, '0'),
+      }).setOrigin(0, 0.5);
+      const name = this.add.text(78, cy - 13, p.name, { ...TS.small, color: HEX.text, fontStyle: '900' });
+      const rule = this.add.text(78, cy + 4, p.rule, { ...TS.tiny, color: HEX.muted })
+        .setWordWrapWidth(W - 140, true);
+      this.layer.add([bg, icon, name, rule]);
+      cards.push({ bg });
+
+      bg.setInteractive({ useHandCursor: true }).on('pointerup', () => {
+        SFX.select();
+        this.protocolId = p.id;
+        cards.forEach((c) => c.bg.setStrokeStyle(1, COL.line).setFillStyle(COL.card));
+        bg.setStrokeStyle(2, p.color).setFillStyle(COL.cardHi);
+        go.setEnabled(true).setLabel('ЗАФИКСИРОВАТЬ · ' + p.name);
+        this.bg.setTint(p.color);
+      });
+
+      bg.setAlpha(0);
+      [icon, name, rule].forEach((o) => o.setAlpha(0));
+      this.tweens.add({ targets: [bg, icon, name, rule], alpha: 1, duration: 260, delay: 70 + i * 70 });
+    });
+
+    // Скрепка watches from the corner — present, not in the way.
+    const sk = this.add.image(W - 52, H - footH - 26, 'skrepka').setOrigin(0.5, 1).setAlpha(0.22);
+    sk.setDisplaySize(76 * (sk.width / sk.height), 76);
+    this.layer.add(sk);
+    this.tweens.add({ targets: sk, y: sk.y - 5, duration: 2600, yoyo: true, repeat: -1, ease: 'Sine.inOut' });
+
+    const go = primaryButton(this, 'ВЫБЕРИ ПРАВИЛО', W - 40, () => this.showEvidencePhase(), { enabled: false });
+    go.node.setPosition(W / 2, H - 62);
+    this.layer.add(go.node);
+  }
+
+  // ================= PHASE 2: EVIDENCE =================
+  private looksText!: Phaser.GameObjects.Text;
+  private notesText!: Phaser.GameObjects.Text;
+
+  /** Mirror the opened evidence into the working-memory panel. */
+  private refreshNotes() {
+    if (!this.notesText) return;
+    if (!this.opened.length) return;
+    const lines = this.opened.map((id) => {
+      const e = this.c.evidence.find((x) => x.id === id)!;
+      return `${e.icon}  ${e.label}: ${e.value}`;
+    });
+    this.notesText.setText(lines.join('\n\n')).setColor(HEX.text);
+  }
+
+  private showEvidencePhase() {
+    this.phase = 'evidence';
+    this.setStep(1);
+    this.clearLayer();
+    const { W, H } = VIEW;
+
+    // --- chart ---
+    const chartH = 210;
+    const cardBg = panel(this, W - 32, chartH + 16, { fill: COL.bg1, stroke: COL.line })
+      .setPosition(W / 2, 82 + (chartH + 16) / 2);
+    this.layer.add(cardBg);
+    this.chart = new CandleChart(this, { x: 24, y: 88, w: W - 48, h: chartH });
+    this.chart.setDepth(DEPTH.content + 2).showSetup(this.c.series);
+
+    let y = 82 + chartH + 30;
+
+    // --- enemy bait line: pressure, delivered once ---
+    const enemy = this.c.enemy;
+    const baitBg = this.rexUI.add
+      .roundRectangle(W / 2, y + 30, W - 32, 56, RADIUS.md, COL.card2, 0.95)
+      .setStrokeStyle(1, enemy.color, 0.6);
+    // Pre-cut circular PNG: Phaser 4 dropped geometry masks under WebGL.
+    const face = this.add.image(42, y + 30, enemy.avatar).setDisplaySize(38, 38).setAlpha(0.95);
+    const baitTxt = this.add
+      .text(70, y + 12, `«${enemy.bait}»`, { ...TS.tiny, color: HEX.text, fontStyle: 'italic', lineSpacing: 3 })
+      .setWordWrapWidth(W - 116, true);
+    this.layer.add([baitBg, face, baitTxt]);
+    y += 72;
+
+    // --- attention budget ---
+    const hdr = this.add.text(24, y, 'ШАГ 2 · БЮДЖЕТ ВНИМАНИЯ', { ...TS.tiny, color: HEX.cyan });
+    this.looksText = this.add
+      .text(W - 24, y, `ОСТАЛОСЬ ${this.looks}`, { ...TS.tiny, color: HEX.gold })
+      .setOrigin(1, 0);
+    this.layer.add([hdr, this.looksText]);
+    y += 18;
+    const sub = this.add.text(24, y,
+      'Открыть можно только две улики. Рынок не даст посмотреть всё — и не даст на это времени.',
+      { ...TS.tiny, color: HEX.dim, lineSpacing: 3 }).setWordWrapWidth(W - 48, true);
+    this.layer.add(sub);
+    y += 34;
+
+    // --- evidence grid 2x2 ---
+    const gw = (W - 48) / 2;
+    const gh = 92;
+    this.c.evidence.forEach((e, i) => {
+      const col = i % 2, row = (i / 2) | 0;
+      const ex = 24 + col * (gw + 8) + gw / 2;
+      const ey = y + row * (gh + 8) + gh / 2;
+
+      const bg = this.rexUI.add.roundRectangle(ex, ey, gw, gh, RADIUS.md, COL.card)
+        .setStrokeStyle(1, COL.line);
+      const icon = this.add.text(ex - gw / 2 + 12, ey - gh / 2 + 10, e.icon, { ...TS.h3, color: HEX.dim });
+      const lbl = this.add.text(ex - gw / 2 + 36, ey - gh / 2 + 14, e.label.toUpperCase(), { ...TS.tiny, color: HEX.muted });
+      const lock = this.add.text(ex, ey + 12, 'ОТКРЫТЬ', { ...TS.tiny, color: HEX.cyan }).setOrigin(0.5);
+      const val = this.add.text(ex - gw / 2 + 12, ey - gh / 2 + 34, '', { ...TS.tiny, color: HEX.text, lineSpacing: 3 })
+        .setWordWrapWidth(gw - 24, true).setVisible(false);
+      this.layer.add([bg, icon, lbl, lock, val]);
+
+      bg.setInteractive({ useHandCursor: true }).on('pointerup', () => {
+        if (this.opened.includes(e.id)) return;
+        if (this.looks <= 0) {
+          SFX.deny();
+          toast(this, 'ВНИМАНИЕ ИСЧЕРПАНО. Решай тем, что уже видел.', COL.red);
+          this.cameras.main.shake(90, 0.004);
+          return;
+        }
+        this.opened.push(e.id);
+        this.looks--;
+        this.looksText.setText(`ОСТАЛОСЬ ${this.looks}`)
+          .setColor(this.looks ? HEX.gold : HEX.red);
+
+        e.decisive ? SFX.keyEvidence() : SFX.open();
+        lock.setVisible(false);
+        val.setText(`${e.value}\n\n${e.read}`).setVisible(true).setAlpha(0);
+        this.tweens.add({ targets: val, alpha: 1, duration: 260 });
+        bg.setFillStyle(COL.cardHi).setStrokeStyle(1.5, e.decisive ? COL.cyan : COL.line2);
+        icon.setColor(e.decisive ? HEX.cyan : HEX.muted);
+
+        const r = new RNG(`${this.c.id}:${e.id}`);
+        toast(this, r.pick(e.decisive ? SKREPKA_KEY : SKREPKA_NOISE), e.decisive ? COL.cyan : COL.dim);
+
+        this.refreshNotes();
+        if (this.looks === 0) go.setEnabled(true).setLabel('ПЕРЕЙТИ К ВЕРДИКТУ');
+      });
+    });
+    y += gh * 2 + 16 + 12;
+
+    y += 14;
+
+    // --- what you actually know so far ---
+    // The gap under the grid becomes the player's working memory: as tiles
+    // open, the readings collect here, so the verdict is made against a
+    // visible record instead of whatever they happen to remember.
+    this.layer.add(this.add.text(24, y, 'ЧТО У ТЕБЯ ЕСТЬ', { ...TS.tiny, color: HEX.dim }));
+    y += 20;
+    const notesBg = this.rexUI.add
+      .roundRectangle(W / 2, y + 74, W - 48, 148, RADIUS.md, COL.bg1, 0.75)
+      .setStrokeStyle(1, COL.line);
+    this.notesText = this.add
+      .text(38, y + 14, 'Пока ничего. Ты смотришь на график и надеешься. Это не метод.', {
+        ...TS.tiny, color: HEX.dim, lineSpacing: 6,
+      })
+      .setWordWrapWidth(W - 74, true);
+    this.layer.add([notesBg, this.notesText]);
+    y += 158;
+
+    // --- hint (free, but Skrepka judges you) ---
+    const go = primaryButton(this, 'ПЕРЕЙТИ К ВЕРДИКТУ', W - 40, () => this.showVerdictPhase(), { enabled: true });
+    go.node.setPosition(W / 2, H - 46);
+    this.layer.add(go.node);
+  }
+
+  // ================= PHASE 3: VERDICT =================
+  private showVerdictPhase() {
+    this.phase = 'verdict';
+    this.setStep(2);
+    this.clearLayer();
+    const { W, H } = VIEW;
+
+    // compact chart — still visible, still frozen
+    const chartH = 132;
+    const cb = panel(this, W - 32, chartH + 12, { fill: COL.bg1, stroke: COL.line })
+      .setPosition(W / 2, 80 + (chartH + 12) / 2);
+    this.layer.add(cb);
+    this.chart = new CandleChart(this, { x: 24, y: 84, w: W - 48, h: chartH, padY: 8 });
+    this.chart.setDepth(DEPTH.content + 2).showSetup(this.c.series);
+
+    let y = 80 + chartH + 24;
+
+    // --- 1. regime ---
+    y = this.choiceRow(y, 'РЕЖИМ РЫНКА', [
+      ['trend', 'ТРЕНД', COL.green],
+      ['range', 'ДИАПАЗОН', COL.cyan],
+      ['trap', 'ЛОВУШКА', COL.red],
+    ], (v) => { this.regime = v as Regime; this.refreshSeal(); });
+
+    // --- 2. action ---
+    y = this.choiceRow(y, this.c.question.toUpperCase(), [
+      ['long', 'ЛОНГ', COL.green],
+      ['short', 'ШОРТ', COL.red],
+      ['aside', 'ВНЕ РЫНКА', COL.gold],
+    ], (v) => {
+      this.action = v as ActionKind;
+      // The bait lands only if the player picks the enemy's preferred side.
+      if (!this.baitShown) {
+        const wants = this.c.truth.bestAction === 'aside' ? ['long', 'short'] : [];
+        if (wants.includes(v)) {
+          this.tookBait = true;
+          this.baitShown = true;
+          SFX.enemy();
+          toast(this, `${this.c.enemy.name}: «Правильно. Действуй.»`, this.c.enemy.color);
+          this.cameras.main.shake(120, 0.003);
+        }
+      }
+      this.refreshSeal();
+    });
+
+    // --- 3. risk ---
+    y = this.choiceRow(y, 'РАЗМЕР РИСКА', [
+      ['0', '0%', COL.muted],
+      ['0.5', '0.5%', COL.green],
+      ['1', '1%', COL.cyan],
+      ['2', '2%+', COL.red],
+    ], (v) => {
+      this.risk = parseFloat(v);
+      const p = this.protocolId ? PROTOCOL_BY_ID[this.protocolId] : null;
+      if (p?.id === 'p_limit' && this.risk > 1) {
+        SFX.deny();
+        toast(this, 'ТЫ САМ ПОДПИСАЛ ЛИМИТ 1%. Нарушение зафиксировано.', COL.red);
+      }
+      this.refreshSeal();
+    }, 1);
+
+    // --- 4. confidence slider ---
+    const cl = this.add.text(24, y, 'УВЕРЕННОСТЬ', { ...TS.tiny, color: HEX.dim });
+    const cv = this.add.text(W - 24, y, '60%', { ...TS.tiny, color: HEX.cyan }).setOrigin(1, 0);
+    this.layer.add([cl, cv]);
+    y += 20;
+    const track = this.rexUI.add.roundRectangle(W / 2, y + 8, W - 48, 6, 3, COL.bg0).setStrokeStyle(1, COL.line);
+    const fillB = this.rexUI.add.roundRectangle(0, y + 8, 1, 6, 3, COL.cyan);
+    const knob = this.rexUI.add.roundRectangle(0, y + 8, 22, 22, 11, COL.cyan).setStrokeStyle(2, COL.bg0);
+    this.layer.add([track, fillB, knob]);
+    const x0 = 24, x1 = W - 24;
+    const setConf = (px: number) => {
+      const cx = Phaser.Math.Clamp(px, x0, x1);
+      this.confidence = Math.round(((cx - x0) / (x1 - x0)) * 100);
+      knob.setPosition(cx, y + 8);
+      fillB.setPosition(x0 + (cx - x0) / 2, y + 8);
+      fillB.displayWidth = Math.max(1, cx - x0);
+      cv.setText(this.confidence + '%')
+        .setColor(this.confidence >= 85 ? HEX.gold : HEX.cyan);
+    };
+    setConf(x0 + (x1 - x0) * 0.6);
+    track.setInteractive({ useHandCursor: true }).on('pointerdown', (p: any) => { SFX.tick(); setConf(p.x); });
+    knob.setInteractive({ useHandCursor: true, draggable: true });
+    this.input.setDraggable(knob);
+    this.input.on('drag', (_p: any, o: any, dx: number) => { if (o === knob) { setConf(dx); } });
+    y += 32;
+
+    y += 6;
+
+    // --- the evidence you actually bought, restated at the moment of choice ---
+    // Without this the player decides from memory, and "I forgot what the
+    // volume said" is not the lesson we are trying to teach.
+    this.layer.add(this.add.text(24, y, 'НА ЧЁМ ТЫ ОСНОВЫВАЕШЬСЯ', { ...TS.tiny, color: HEX.dim }));
+    y += 18;
+    const recapH = Math.max(64, H - 118 - y);
+    const recapBg = this.rexUI.add
+      .roundRectangle(W / 2, y + recapH / 2, W - 48, recapH, RADIUS.md, COL.bg1, 0.75)
+      .setStrokeStyle(1, COL.line);
+    const recap = this.opened.length
+      ? this.opened
+          .map((id) => {
+            const e = this.c.evidence.find((x) => x.id === id)!;
+            return `${e.icon}  ${e.label} — ${e.value}\n     ${e.read}`;
+          })
+          .join('\n\n')
+      : 'Ты не открыл ни одной улики.\nРешение принимается на ощущениях. Оценка это учтёт.';
+    const recapTxt = this.add
+      .text(38, y + 12, recap, {
+        ...TS.tiny,
+        color: this.opened.length ? HEX.muted : HEX.red,
+        lineSpacing: 5,
+      })
+      .setWordWrapWidth(W - 74, true);
+    this.layer.add([recapBg, recapTxt]);
+
+    // --- the seal ---
+    this.sealBtn = primaryButton(this, 'ВЫБЕРИ РЕЖИМ И ДЕЙСТВИЕ', W - 40, () => this.seal(), {
+      enabled: false, color: COL.red,
+    });
+    this.sealBtn.node.setPosition(W / 2, H - 52);
+    this.layer.add(this.sealBtn.node);
+  }
+
+  private sealBtn!: ReturnType<typeof primaryButton>;
+
+  private refreshSeal() {
+    if (!this.sealBtn) return;
+    const ok = this.regime !== null && this.action !== null;
+    this.sealBtn.setEnabled(ok).setLabel(ok ? '⛔  ЗАПЕЧАТАТЬ РЕШЕНИЕ' : 'ВЫБЕРИ РЕЖИМ И ДЕЙСТВИЕ');
+  }
+
+  /** Compact segmented control. Returns the new y. */
+  private choiceRow(
+    y: number,
+    label: string,
+    opts: [string, string, number][],
+    onPick: (v: string) => void,
+    defaultIdx = -1,
+  ): number {
+    const { W } = VIEW;
+    this.layer.add(this.add.text(24, y, label, { ...TS.tiny, color: HEX.dim }).setWordWrapWidth(W - 48, true));
+    y += 20;
+    const gap = 7;
+    const cw = (W - 48 - gap * (opts.length - 1)) / opts.length;
+    const h = 42;
+    const cells: any[] = [];
+    opts.forEach(([val, text, color], i) => {
+      const cx = 24 + i * (cw + gap) + cw / 2;
+      const bg = this.rexUI.add.roundRectangle(cx, y + h / 2, cw, h, RADIUS.sm, COL.card)
+        .setStrokeStyle(1, COL.line);
+      const t = this.add.text(cx, y + h / 2, text, { ...TS.tiny, color: HEX.muted, fontSize: '12px' }).setOrigin(0.5);
+      this.layer.add([bg, t]);
+      cells.push({ bg, t, color });
+      bg.setInteractive({ useHandCursor: true }).on('pointerup', () => {
+        SFX.select();
+        cells.forEach((c) => { c.bg.setFillStyle(COL.card).setStrokeStyle(1, COL.line); c.t.setColor(HEX.muted); });
+        bg.setFillStyle(COL.cardHi).setStrokeStyle(2, color);
+        t.setColor('#' + color.toString(16).padStart(6, '0'));
+        onPick(val);
+      });
+    });
+    if (defaultIdx >= 0) {
+      const c = cells[defaultIdx];
+      c.bg.setFillStyle(COL.cardHi).setStrokeStyle(2, c.color);
+      c.t.setColor('#' + c.color.toString(16).padStart(6, '0'));
+    }
+    return y + h + 16;
+  }
+
+  // ================= SEAL =================
+  private seal() {
+    SFX.seal();
+    this.cameras.main.shake(180, 0.006);
+    this.cameras.main.flash(120, 34, 216, 245, false);
+
+    const verdict: Verdict = {
+      regime: this.regime!,
+      action: this.action!,
+      risk: this.risk,
+      confidence: this.confidence,
+      openedEvidence: this.opened.slice(),
+      tookBait: this.tookBait,
+      usedProtocol: this.protocolId !== null,
+      protocolId: this.protocolId,
+    };
+
+    this.time.delayedCall(320, () => {
+      this.cameras.main.fadeOut(240, 0, 0, 0);
+      this.time.delayedCall(260, () =>
+        this.scene.start('Reveal', { caseId: this.c.id, verdict }),
+      );
+    });
+  }
+
+  update(t: number, dt: number) { this.bg?.update(t, dt); }
+}
