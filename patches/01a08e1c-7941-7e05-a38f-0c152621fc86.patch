+      stack.push(this.add.text(tx, y + artH + 34, `${next.asset} · ${next.tf}`, { ...TS.mono, fontSize: '12px' }).setDepth(DEPTH.content + 3));
+      const brief = this.add
+        .text(tx, y + artH + 60, next.brief, { ...TS.small, color: HEX.muted, lineSpacing: 5 })
+        .setWordWrapWidth(W - 84, true)
