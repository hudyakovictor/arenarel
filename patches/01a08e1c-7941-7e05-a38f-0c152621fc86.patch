+import type { MarketSeries, PatternKind } from './market';
+
+export type Regime = 'trend' | 'range' | 'trap';
+export type ActionKind = 'long' | 'short' | 'aside';
+
+export interface EnemyDef {
+  id: string;
+  name: string;
+  title: string;
+  /** pre-cut circular avatar (Phaser 4 has no WebGL geometry masks) */
+  avatar: string;
+  /** pre-cut rounded card art */
+  card: string;
+  /** the cognitive distortion this enemy weaponises */
+  distortion: string;
+  /** the line it whispers during the case */
+  bait: string;
+  /** what it says when it wins */
+  onWin: string;
+  /** what it says when it loses */
+  onLose: string;
+  color: number;
+}
+
+export interface EvidenceTile {
+  id: string;
+  icon: string;
+  label: string;
+  /** what the player reads once it's open */
+  value: string;
+  /** does this tile actually decide the case? */
+  decisive: boolean;
+  /** one-line reading in house voice */
+  read: string;
+}
+
+export interface CaseTruth {
+  regime: Regime;
+  bestAction: ActionKind;
+  /** the lesson, delivered after the verdict */
+  lesson: string;
+  /** what the pattern was really doing */
+  mechanism: string;
+}
+
+export interface CaseDef {
+  id: string;
+  chapter: number;
+  index: number;
+  title: string;
+  asset: string;
+  tf: string;
+  pattern: PatternKind;
+  resolvesTrue: boolean;
+  enemyId: string;
+  brief: string;
+  question: string;
+  evidence: EvidenceTile[];
+  truth: CaseTruth;
+  /** mentor hint, only shown if requested — costs nothing but pride */
+  hint: string;
+}
+
+export interface Case extends CaseDef {
+  enemy: EnemyDef;
+  series: MarketSeries;
+}
+
+export interface Verdict {
+  regime: Regime;
+  action: ActionKind;
+  risk: number; // % of budget: 0, 0.5, 1, 2
+  confidence: number; // 0..100
+  openedEvidence: string[];
+  tookBait: boolean;
+  usedProtocol: boolean;
+  protocolId: string | null;
+}
+
+export interface ProtocolCard {
+  id: string;
+  name: string;
+  rule: string;
+  /** which failure mode it defends against */
+  guards: string;
+  color: number;
+  icon: string;
+}
+
+export interface JournalEntry {
+  caseId: string;
+  title: string;
+  score: number;
+  grade: string;
+  errorTag: string | null;
+  at: number;
+  closed: boolean;
+}
+
+export interface SaveData {
+  v: number;
+  xp: number;
+  credits: number;
+  streak: number;
+  lastPlayDay: string | null;
+  cleared: Record<string, number>; // caseId -> best score
+  journal: JournalEntry[];
+  unlockedProtocols: string[];
+  equipped: string[];
+  seenIntro: boolean;
+  sound: boolean;
+  runsToday: number;
+  dayKey: string | null;
+}
