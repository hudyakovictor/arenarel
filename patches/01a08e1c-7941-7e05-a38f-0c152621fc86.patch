+<!DOCTYPE html>
+<html lang="ru">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
+<meta name="theme-color" content="#04070F">
+<meta name="description" content="SIGNAL ARENA — тренажёр решений. Оценка за качество решения, а не за прибыль.">
+<meta name="apple-mobile-web-app-capable" content="yes">
+<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
+<title>SIGNAL ARENA — тренажёр решений</title>
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800;900&display=swap" rel="stylesheet">
+<style>
+  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
+  html,body{
+    height:100%;width:100%;overflow:hidden;background:#01030A;
+    font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;
+    touch-action:manipulation;user-select:none;-webkit-user-select:none;
+    overscroll-behavior:none;
+  }
+  #game{
+    position:fixed;inset:0;display:flex;align-items:center;justify-content:center;
+    background:
+      radial-gradient(700px 500px at 50% -10%, rgba(34,216,245,.10), transparent 60%),
+      radial-gradient(600px 500px at 90% 110%, rgba(179,136,255,.08), transparent 60%),
+      #01030A;
+  }
+  #game canvas{
+    display:block;
+    box-shadow:0 30px 90px rgba(0,0,0,.85), 0 0 80px rgba(34,216,245,.07);
+  }
+  /* On desktop the 9:16 canvas reads as a device — reinforces the mobile-first product. */
+  @media (min-width:560px) and (min-height:700px){
+    #game canvas{ border-radius:26px; }
+  }
+  #boot{
+    position:fixed;inset:0;display:grid;place-items:center;z-index:5;
+    color:#5A6C8A;font-size:12px;letter-spacing:.22em;font-weight:800;
+    transition:opacity .4s;pointer-events:none;
+  }
+</style>
+</head>
+<body>
+<div id="game"></div>
+<div id="boot">ЗАГРУЗКА АРЕНЫ…</div>
+<script>
+  // Hide the pre-boot label as soon as the WebGL canvas exists.
+  const _b = document.getElementById('boot');
+  const _o = new MutationObserver(() => {
+    if (document.querySelector('#game canvas')) { _b.style.opacity = '0'; _o.disconnect(); }
+  });
+  _o.observe(document.getElementById('game'), { childList: true });
+</script>
+<script type="module" src="/src/main.ts"></script>
+</body>
+</html>
