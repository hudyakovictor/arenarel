+    for (let i = start; i <= end; i++) {
+      const value = values[i];
+      const px = x + i * (w / (values.length - 1));
+      const py = y + h - value * h;
+      if (i === start) g.moveTo(px, py);
+      else g.lineTo(px, py);
+    }
+    g.strokePath();
+  }
