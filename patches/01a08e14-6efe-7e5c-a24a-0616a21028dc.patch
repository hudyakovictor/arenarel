+++ b/src/styles.css
@@ -0,0 +1,67 @@
+* {
+  box-sizing: border-box;
+}
+
+html,
+body,
+#app {
+  width: 100%;
+  height: 100%;
+  margin: 0;
+  overflow: hidden;
+  background: #01030a;
+  color: #f2f7ff;
+  touch-action: none;
+  user-select: none;
+  -webkit-user-select: none;
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
+
+#app {
+  min-height: 100dvh;
+  display: grid;
+  place-items: center;
+  background:
+    radial-gradient(900px 700px at 50% -18%, rgba(34, 216, 245, 0.12), transparent 58%),
+    radial-gradient(760px 620px at 95% 112%, rgba(179, 136, 255, 0.1), transparent 62%),
+    linear-gradient(180deg, #020511 0%, #01030a 100%);
+}
+
+#game-shell {
+  width: min(100vw, 520px);
+  aspect-ratio: 9 / 16;
+  max-height: 100dvh;
+  display: grid;
+  place-items: center;
+  position: relative;
+}
+
+#game-container {
+  width: 100%;
+  height: 100%;
+  display: grid;
+  place-items: center;
+}
+
+canvas {
+  width: 100% !important;
+  height: 100% !important;
+  display: block;
+  border-radius: clamp(0px, 5vw, 38px);
+  box-shadow:
+    0 0 0 1px rgba(130, 165, 210, 0.18),
+    0 28px 90px rgba(0, 0, 0, 0.74),
+    0 0 80px rgba(34, 216, 245, 0.07);
+}
+
+@media (max-width: 520px) {
+  #game-shell {
+    width: 100vw;
+    height: 100dvh;
+    max-height: none;
+  }
+
+  canvas {
+    border-radius: 0;
+  }
+}
