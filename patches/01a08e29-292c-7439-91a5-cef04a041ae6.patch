+/**
+ * BaseScene — общий каркас экрана: фон прибора, обработка событий шины, переходы.
+ * Наследники реализуют build() и, при необходимости, onResumeState().
+ */
+
+import Phaser from 'phaser';
+import { backdrop, toast } from '../../ui/kit';
+import { bus } from '../../core/EventBus';
+import { store } from '../../core/store';
+import { audio } from '../../core/audio';
+import { COLORS, EASE } from '../theme';
+import { TIME } from '../design';
+
+export abstract class BaseScene extends Phaser.Scene {
+  protected root!: Phaser.GameObjects.Container;
+  private cleanups: (() => void)[] = [];
+
+  create(): void {
+    this.backdropColor();
+    this.root = this.add.container(0, 0);
+    this.bindBus();
+    this.build();
+  }
+
+  /** Подложка: сетка самописца, свечения, вигнетка. Каждая сцена может переопределить акцент. */
+  protected accent(): number {
+    return COLORS.cyan;
+  }
+
+  private backdropColor(): void {
+    backdrop(this, this.accent());
+  }
+
+  private bindBus(): void {
+    const offToast = bus.on('toast', ({ text, tone }) => toast(this, text, tone ?? 'info'));
+    const offSkrepka = bus.on('skrepka:say', ({ line, mood }) => this.onSkrepka(line, mood));
+    this.cleanups.push(offToast, offSkrepka, () => {
+      /* nothing */
+    });
+    this.events.once(Phaser.Scenes.Events.SHUTDOWN, () => {
+      for (const fn of this.cleanups) fn();
+      this.cleanups = [];
+    });
+  }
+
+  /** Регистрирует функцию очистки, которая выполнится при закрытии сцены. */
+  protected onCleanup(fn: () => void): void {
+    this.cleanups.push(fn);
+  }
+
+  protected onSkrepka(_line: string, _mood?: string): void {
+    // Переопределяется сценами, где есть окно Скрепки.
+  }
+
+  /** Плавный переход между сценами: без резких склеек, но и без задержек. */
+  protected go(sceneKey: string, data?: Record<string, unknown>): void {
+    if (store.state.settings.reduceMotion) {
+      this.scene.start(sceneKey, data);
+      return;
+    }
+    this.cameras.main.fadeOut(TIME.fast, 1, 3, 10);
+    this.cameras.main.once(Phaser.Cameras.Scene2D.Events.FADE_OUT_COMPLETE, () => {
+      this.scene.start(sceneKey, data);
+    });
+  }
+
+  protected fadeInCamera(): void {
+    if (store.state.settings.reduceMotion) return;
+    this.cameras.main.fadeIn(TIME.scene, 1, 3, 10);
+  }
+
+  /** Анимация появления группы объектов. */
+  protected animateIn(targets: Phaser.GameObjects.GameObject[], stagger = 60, fromY = 16): void {
+    if (store.state.settings.reduceMotion) return;
+    targets.forEach((target, index) => {
+      const obj = target as unknown as { y: number; alpha: number };
+      const targetY = obj.y;
+      obj.alpha = 0;
+      obj.y = targetY + fromY;
+      this.tweens.add({
+        targets: target,
+        alpha: 1,
+        y: targetY,
+        duration: TIME.slow,
+        delay: index * stagger,
+        ease: EASE.out,
+      });
+    });
+  }
+
+  protected tapSound(): void {
+    audio.play('click');
+  }
+
+  protected abstract build(): void;
+}
