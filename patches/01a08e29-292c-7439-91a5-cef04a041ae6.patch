+/** Полоса прогресса (XP, энергия, серия). */
+export function meter(
+  scene: Phaser.Scene,
+  x: number,
+  y: number,
+  w: number,
+  h: number,
+  value: number,
+  color: number,
+  opts: { bgColor?: number; depth?: number } = {},
+): MeterHandle {
+  const container = scene.add.container(x, y);
+  container.setDepth(opts.depth ?? 0);
+  const bg = scene.add.rectangle(0, 0, w, h, opts.bgColor ?? 0x0a1330, 1).setOrigin(0, 0.5);
+  bg.setStrokeStyle(1, COLORS.line, 0.25);
+  const fillWidth = Math.max(2, w * Phaser.Math.Clamp(value, 0, 1));
+  const fill = scene.add.rectangle(1, 0, fillWidth, h - 3, color, 1).setOrigin(0, 0.5);
+  const glow = scene.add.image(fillWidth, 0, 'tex_glow').setDisplaySize(26, h * 3);
+  glow.setTint(color);
+  glow.setAlpha(0.55);
+  glow.setBlendMode(Phaser.BlendModes.ADD);
+  container.add([bg, fill, glow]);
+  return {
+    container,
+    setValue: (next: number, animate = true) => {
+      const target = Math.max(2, w * Phaser.Math.Clamp(next, 0, 1));
+      if (!animate || reduceMotion()) {
+        fill.width = target;
+        fill.displayWidth = target;
+        glow.setX(target);
+        return;
+      }
+      scene.tweens.add({
+        targets: [fill],
+        displayWidth: target,
+        duration: TIME.slow,
+        ease: EASE.out,
+      });
+      scene.tweens.add({ targets: glow, x: target, duration: TIME.slow, ease: EASE.out });
+    },
+    setColor: (next: number) => {
+      fill.setFillStyle(next, 1);
+      glow.setTint(next);
+    },
+  };
+}
