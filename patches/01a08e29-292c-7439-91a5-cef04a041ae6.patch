+    badge?: string;
+    locked?: boolean;
+  },
+): CardTileHandle {
+  const { w, h } = opts;
+  const container = scene.add.container(opts.x, opts.y);
+  const artHeight = opts.compact ? h * 0.52 : h * 0.46;
+  const radius = RADIUS.small + 4;
+
+  const bg = rex(scene).add.roundRectangle(0, 0, w, h, radius, COLORS.card2, 0.96) as RexShape;
+  bg.setStrokeStyle(opts.selected ? 2.5 : 1.4, opts.selected ? opts.accent : COLORS.line, opts.selected ? 1 : ALPHA.lineStrong);
+  container.add(bg as unknown as Phaser.GameObjects.GameObject);
+
+  const art = safeImage(scene, 0, -h / 2 + artHeight / 2 + 6, opts.art, opts.accent, '◈') as SafeArt;
+  if (art instanceof Phaser.GameObjects.Image) {
+    fitCover(art, w - 12, artHeight - 6);
+    art.setAlpha(opts.locked ? 0.25 : 0.95);
+  } else {
+    art.setPosition(0, -h / 2 + artHeight / 2 + 6);
+  }
+  container.add(art as unknown as Phaser.GameObjects.GameObject);
+
+  const band = scene.add.rectangle(0, -h / 2 + artHeight + 9, w - 12, 2, opts.accent, 0.85).setOrigin(0.5, 0.5);
+  container.add(band);
+
+  const nameY = -h / 2 + artHeight + 20;
+  const name = scene.add
+    .text(0, nameY, opts.name, {
+      fontFamily: FONT.display,
+      fontSize: opts.compact ? '9px' : '10px',
+      color: '#f2f7ff',
+      align: 'center',
+      wordWrap: { width: w - 14, useAdvancedWrap: true },
+    })
+    .setOrigin(0.5, 0);
+  container.add(name);
+
+  if (!opts.compact && opts.text) {
+    const body = scene.add
+      .text(0, nameY + 24, opts.text, {
+        fontFamily: FONT.ui,
+        fontSize: '9px',
+        color: CSS.muted,
+        align: 'center',
+        wordWrap: { width: w - 16, useAdvancedWrap: true },
+        lineSpacing: 2,
+      })
+      .setOrigin(0.5, 0);
+    container.add(body);
+  }
+
+  if (opts.badge) {
+    const badge = scene.add
+      .text(-w / 2 + 10, h / 2 - 12, opts.badge, {
+        fontFamily: FONT.ui,
+        fontSize: '8px',
+        color: `#${opts.accent.toString(16).padStart(6, '0')}`,
+        fontStyle: '700',
+      })
+      .setOrigin(0, 1);
+    container.add(badge);
+  }
+
+  if (opts.onTap && !opts.locked) {
+    container.setSize(w, h);
+    container.setInteractive(
+      new Phaser.Geom.Rectangle(-w / 2, -h / 2, w, h),
+      Phaser.Geom.Rectangle.Contains,
+    );
+    container.on('pointerup', () => {
+      if (store.state.settings.reduceMotion) {
+        opts.onTap?.();
+        return;
+      }
+      container.setScale(0.96);
+      scene.tweens.add({ targets: container, scale: 1, duration: 140, ease: EASE.back });
+      opts.onTap?.();
+    });
+  }
+
+  const setSelected = (value: boolean) => {
+    bg.setStrokeStyle(value ? 2.5 : 1.4, value ? opts.accent : COLORS.line, value ? 1 : ALPHA.lineStrong);
+    bg.setFillStyle(value ? shift(COLORS.card2, 0.08) : COLORS.card2, 0.96);
+  };
+
+  return { container, setSelected, destroy: () => container.destroy(true) };
+}
