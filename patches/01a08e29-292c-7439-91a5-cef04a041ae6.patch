+/**
+ * Дымовой тест сцен: игра должна целиком собраться и пережить проход по всем экранам
+ * без исключений. Запускается в jsdom с заглушкой canvas — без браузера.
+ */
+
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { setupDom } from '../support/jsdom-env.mjs';
+
+setupDom();
+
+const Phaser = (await import('phaser')).default;
+
+// HEADLESS-рендерер не умеет обновлять canvas-текстуры: пиксели не нужны,
+// проверяем логику сцен, а не картинку.
+(Phaser.Textures.CanvasTexture.prototype as unknown as { refresh: () => void }).refresh = () => undefined;
+const { createGameConfig } = await import('../../src/game/config');
+const { BootScene } = await import('../../src/game/scenes/BootScene');
+const { TitleScene } = await import('../../src/game/scenes/TitleScene');
+const { HubScene } = await import('../../src/game/scenes/HubScene');
+const { HuntScene } = await import('../../src/game/scenes/HuntScene');
+const { CodexScene } = await import('../../src/game/scenes/CodexScene');
+const { DeckScene } = await import('../../src/game/scenes/DeckScene');
+const { ProfileScene } = await import('../../src/game/scenes/ProfileScene');
+const { ShopScene } = await import('../../src/game/scenes/ShopScene');
+const { SettingsScene } = await import('../../src/game/scenes/SettingsScene');
+const { LessonScene } = await import('../../src/game/scenes/LessonScene');
+const { generateTextures } = await import('../../src/game/textures');
+const { ensureArtFallbacks } = await import('../../src/game/procedural');
+const { store } = await import('../../src/core/store');
+
+/** Сцена-подготовка: рисует процедурные текстуры вместо загрузки внешних ассетов. */
+class PrepareScene extends Phaser.Scene {
+  constructor() {
+    super('prepare');
+  }
+
+  create(): void {
+    generateTextures(this);
+    ensureArtFallbacks(this);
+    this.scene.start('title');
+  }
+}
+
+const errors: string[] = [];
+const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+let game: Phaser.Game;
+
+async function startScene(key: string, data?: Record<string, unknown>): Promise<Phaser.Scene> {
+  const scene = game.scene.getScene(key);
+  expect(scene, `сцена ${key} не зарегистрирована`).toBeTruthy();
+  game.scene.stop(key);
+  game.scene.start(key, data);
+  await wait(120);
+  return scene;
+}
+
+describe('сборка игры', () => {
+  beforeAll(async () => {
+    store.init();
+    const config = createGameConfig([
+      PrepareScene,
+      BootScene,
+      TitleScene,
+      HubScene,
+      HuntScene,
+      CodexScene,
+      DeckScene,
+      ProfileScene,
+      ShopScene,
+      SettingsScene,
+      LessonScene,
+    ]);
+    config.type = Phaser.HEADLESS;
+    config.audio = { noAudio: true };
+    game = new Phaser.Game(config);
+    game.events.on(Phaser.Core.Events.BLUR, () => undefined);
+    await wait(400);
+    game.scene.start('prepare');
+    await wait(400);
+    Phaser.Core.Events.BLEND;
+    game.events.on('error', (error: unknown) => errors.push(String(error)));
+    window.addEventListener('error', (event) => errors.push(String((event as ErrorEvent).message)));
+  });
+
+  afterAll(() => {
+    game?.destroy(true);
+  });
+
+  it('сцены регистрируются и запускаются', async () => {
+    for (const key of ['title', 'hub', 'codex', 'deck', 'profile', 'shop', 'settings', 'lesson']) {
+      const scene = await startScene(key);
+      expect(scene.scene.isActive() || scene.sys.isActive()).toBe(true);
+    }
+  });
+
+  it('охота проходит все фазы без падения', async () => {
+    const scene = await startScene('hunt', { mode: 'story', scenarioId: 'h01' }) as unknown as {
+      setPhase?: (phase: string) => void;
+      run?: Record<string, unknown>;
+      finishHunt?: () => void;
+      scene: Phaser.Scenes.ScenePlugin;
+    };
+    expect(scene.run).toBeTruthy();
+    // Игрок открывает улики, выбирает стойку, ставит печать риска и печать t₀.
+    const internal = scene as unknown as {
+      run: { developedClueIds: string[]; protocolId: string | null; risk: string | null; seal: string | null };
+      scenario: { clueIds: string[] };
+      setPhase: (phase: string) => void;
+      finishHunt: () => void;
+    };
+    internal.run.developedClueIds = internal.scenario.clueIds.slice(0, 3);
+    internal.run.protocolId = 'protocol_evidence_only';
+    internal.run.risk = 'standard';
+    internal.run.seal = 'wait';
+    for (const phase of ['brief', 'clues', 'protocol', 'seal', 'whispers', 'verdict']) {
+      internal.setPhase(phase);
+      await wait(60);
+    }
+    const huntsBefore = store.state.profile.hunts;
+    internal.finishHunt();
+    await wait(200);
+    expect(store.state.profile.hunts).toBe(huntsBefore + 1);
+    expect(store.state.history.length).toBeGreaterThan(0);
+  });
+
+  it('на экранах не возникает исключений', async () => {
+    expect(errors, errors.join('\n')).toHaveLength(0);
+  });
+});
