+/**
+ * ProfileScene — профиль охотника: кто ты на самом деле, судя по твоим решениям.
+ * Три вкладки, потому что бухгалтерия — не игра.
+ */
+
+import Phaser from 'phaser';
+import { BaseScene } from './BaseScene';
+import { button, heading, meter, panel, paragraph, statPill } from '../../ui/kit';
+import { bottomNav, pager, topBar } from '../../ui/parts';
+import { COLORS, CSS, FONT } from '../theme';
+import { CENTER, DEPTH, SAFE } from '../design';
+import { store } from '../../core/store';
+import { nextRank, rankForXp, rankProgress } from '../../data/ranks';
+import { ACHIEVEMENTS } from '../../data/achievements';
+import { entityById } from '../../data/entities';
+import { cardById } from '../../data/cards';
+import { SEASON } from '../../data/season';
+import type { Seal } from '../../core/types';
+
+type Tab = 'stats' | 'history' | 'signs';
+
+const TABS: { key: Tab; label: string }[] = [
+  { key: 'stats', label: 'СТАТИСТИКА' },
+  { key: 'history', label: 'АРХИВ' },
+  { key: 'signs', label: 'ЗНАКИ' },
+];
+
+const SEAL_LABEL: Record<Seal, string> = { wait: 'ЖДАТЬ', enter: 'ВОЙТИ', exit: 'ВЫЙТИ' };
+
+export class ProfileScene extends BaseScene {
+
+  constructor() {
+    super('profile');
+  }
+  private tab: Tab = 'stats';
+  private page = 0;
+  private content?: Phaser.GameObjects.Container;
+
+  protected override accent(): number {
+    return COLORS.green;
+  }
+
+  protected override build(): void {
+    topBar(this);
+    bottomNav(this, 'profile');
+    this.content = this.add.container(0, 0).setDepth(DEPTH.content);
+    this.onCleanup(store.subscribe(() => this.render()));
+    this.render();
+    this.fadeInCamera();
+  }
+
+  private render(): void {
+    const root = this.content;
+    if (!root) return;
+    root.removeAll(true);
+    const profile = store.state.profile;
+    const rank = rankForXp(profile.xp);
+
+    const name = heading(this, SAFE.left, 92, profile.name, { size: 14, color: COLORS.text });
+    const title = paragraph(this, SAFE.left, 112, `РАНГ ${roman(rank.rank)} · ${rank.title} — ${rank.perk}`, {
+      size: 9,
+      color: COLORS.dim,
+      width: this.scale.width - 40,
+    });
+    title.setOrigin(0, 0);
+    root.add([name, title]);
+
+    const progress = rankProgress(profile.xp);
+    const xpMeter = meter(this, SAFE.left, 138, this.scale.width - 92, 6, progress, rank.color);
+    const next = nextRank(rank.rank);
+    const xpText = this.add
