+      passPanel.add(active);
+    } else {
+      const buy = button(this, {
+        x: 0,
+        y: 48,
+        w: width - 100,
+        h: 46,
+        text: `${ARCHIVE_PASS_COST} SIGNAL · ${ARCHIVE_PASS_DAYS} ДНЕЙ`,
+        variant: 'gold',
+        fontSize: 11,
+        onTap: async () => {
+          const ok = await confirmDialog(this, {
+            title: 'АРХИВНЫЙ ДОСТУП',
+            text: `Списать ${ARCHIVE_PASS_COST} SIGNAL и открыть архив на ${ARCHIVE_PASS_DAYS} дней?`,
+            confirmLabel: 'ОТКРЫТЬ',
+          });
+          if (!ok) return;
+          if (store.purchaseArchivePass()) {
+            audio.play('seal');
+            toast(this, 'АРХИВ ОТКРЫТ', 'good');
+          } else {
+            toast(this, 'НЕДОСТАТОЧНО SIGNAL', 'bad');
+          }
+        },
+      });
+      passPanel.add(buy.container);
+    }
+    root.add(passPanel);
+
+    const ethics = panel(this, { x: CENTER.x, y: 420, w: width - 36, h: 108, fill: COLORS.bg2, fillAlpha: 0.84 });
+    const ethicsTitle = heading(this, -((width - 36) / 2) + 16, -38, 'ЧЕСТНАЯ ВИТРИНА', { size: 10, color: COLORS.green });
+    const ethicsLines = [
+      '• Никаких «усилений», предсказаний и подсказок улик.',
+      '• Нет лутбоксов: цена видна до нажатия.',
+      '• Нет таймеров давления и «осталось 3 места».',
+    ].join('\n');
+    const ethicsBody = paragraph(this, -((width - 36) / 2) + 16, -18, ethicsLines, { size: 9, color: COLORS.muted, width: width - 76, lineSpacing: 5 });
+    ethicsBody.setOrigin(0, 0);
+    ethicsPanelChildren(ethics, ethicsTitle, ethicsBody);
+    root.add(ethics);
+
+    const signalNote = paragraph(this, CENTER.x, 500, 'SIGNAL зарабатывается только охотой: он не покупается за деньги и не продаётся обратно.', {
+      size: 9,
+      color: COLORS.dim,
+      align: 'center',
+      width: width - 70,
+      lineSpacing: 4,
+    });
+    signalNote.setOrigin(0.5, 0);
+    root.add(signalNote);
+  }
+}
+
+function ethicsPanelChildren(panel_: Phaser.GameObjects.Container, title: Phaser.GameObjects.Text, body: Phaser.GameObjects.Text): void {
+  panel_.add([title, body]);
+}
+
+function shortSlot(slot: CosmeticSlot): string {
+  switch (slot) {
+    case 'theme':
+      return 'ТЕМА';
+    case 'frame':
+      return 'РАМКА';
+    case 'stamp':
+      return 'ПЕЧАТЬ';
+    case 'tape':
+      return 'ЛЕНТА';
+    case 'skrepka':
+      return 'ОКНО';
+    default:
+      return SLOT_LABEL[slot];
+  }
+}
+
+function isEquipped(item: CosmeticDef): boolean {
+  const cosmetics = store.state.cosmetics;
+  if (item.slot === 'theme') return cosmetics.theme === item.id;
+  if (item.slot === 'frame') return cosmetics.frame === item.id;
+  if (item.slot === 'stamp') return cosmetics.stamp === item.id;
+  if (item.slot === 'skrepka') return cosmetics.skrepka === item.id;
+  return false;
+}
