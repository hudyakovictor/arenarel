@@ -0,0 +1,191 @@
+/**
+ * theme.ts — дизайн-токены SIGNAL ARENA.
+ * Палитра, типографика, радиусы, тени. Все сцены берут цвета и стили только отсюда.
+ */
+
+import Phaser from 'phaser';
+
+export const COLORS = {
+  bg0: 0x01030a,
+  bg1: 0x04070f,
+  bg2: 0x070d1f,
+  card: 0x0d1832,
+  card2: 0x111f42,
+  card3: 0x16274f,
+  line: 0x82a5d2,
+  cyan: 0x22d8f5,
+  teal: 0x0e7490,
+  green: 0x34d399,
+  gold: 0xf5c044,
+  red: 0xfb4d6d,
+  purple: 0xb388ff,
+  orange: 0xff9f4a,
+  text: 0xf2f7ff,
+  muted: 0x8fa1c0,
+  dim: 0x5a6c8a,
+  black: 0x000000,
+  white: 0xffffff,
+} as const;
+
+export const CSS = {
+  bg0: '#01030a',
+  bg1: '#04070f',
+  bg2: '#070d1f',
+  card: '#0d1832',
+  card2: '#111f42',
+  cyan: '#22d8f5',
+  teal: '#0e7490',
+  green: '#34d399',
+  gold: '#f5c044',
+  red: '#fb4d6d',
+  purple: '#b388ff',
+  orange: '#ff9f4a',
+  text: '#f2f7ff',
+  muted: '#8fa1c0',
+  dim: '#5a6c8a',
+  white: '#ffffff',
+} as const;
+
+export const FONT = {
+  display: '"Russo One", "Manrope", system-ui, sans-serif',
+  ui: '"Manrope", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif',
+  mono: '"JetBrains Mono", ui-monospace, Menlo, Consolas, monospace',
+} as const;
+
+/** Размеры шрифта в дизайн-пикселях. */
+export const FS = {
+  mega: 40,
+  h1: 30,
+  h2: 22,
+  h3: 17,
+  body: 14,
+  small: 12,
+  micro: 10,
+  mono: 12,
+  monoBig: 15,
+} as const;
+
+export const RADIUS = {
+  card: 22,
+  panel: 18,
+  button: 14,
+  chip: 99,
+  small: 10,
+} as const;
+
+export const ALPHA = {
+  surface: 0.92,
+  surfaceSoft: 0.72,
+  line: 0.16,
+  lineStrong: 0.3,
+  dim: 0.55,
+} as const;
+
+export type TextStyleKey =
+  | 'mega'
+  | 'h1'
+  | 'h2'
+  | 'h3'
+  | 'body'
+  | 'bodyBold'
+  | 'small'
+  | 'smallBold'
+  | 'micro'
+  | 'mono'
+  | 'monoBig'
+  | 'button'
+  | 'label';
+
+interface StyleDef {
+  fontFamily: string;
+  fontSize: string;
+  color: string;
+  fontStyle?: string;
+}
+
+const px = (n: number) => `${n}px`;
+
+export const TEXT_STYLES: Record<TextStyleKey, StyleDef> = {
+  mega: { fontFamily: FONT.display, fontSize: px(FS.mega), color: CSS.text },
+  h1: { fontFamily: FONT.display, fontSize: px(FS.h1), color: CSS.text },
+  h2: { fontFamily: FONT.display, fontSize: px(FS.h2), color: CSS.text },
+  h3: { fontFamily: FONT.display, fontSize: px(FS.h3), color: CSS.text },
+  body: { fontFamily: FONT.ui, fontSize: px(FS.body), color: CSS.muted },
+  bodyBold: { fontFamily: FONT.ui, fontSize: px(FS.body), color: CSS.text, fontStyle: '700' },
+  small: { fontFamily: FONT.ui, fontSize: px(FS.small), color: CSS.muted },
+  smallBold: { fontFamily: FONT.ui, fontSize: px(FS.small), color: CSS.text, fontStyle: '700' },
+  micro: { fontFamily: FONT.ui, fontSize: px(FS.micro), color: CSS.dim, fontStyle: '700' },
+  mono: { fontFamily: FONT.mono, fontSize: px(FS.mono), color: CSS.cyan },
+  monoBig: { fontFamily: FONT.mono, fontSize: px(FS.monoBig), color: CSS.cyan },
+  button: { fontFamily: FONT.display, fontSize: px(15), color: CSS.text },
+  label: { fontFamily: FONT.ui, fontSize: px(FS.micro), color: CSS.dim, fontStyle: '700' },
+};
+
+/** Готовый Phaser-стиль текста. */
+export function textStyle(
+  key: TextStyleKey,
+  overrides: Partial<Phaser.Types.GameObjects.Text.TextStyle> = {},
+): Phaser.Types.GameObjects.Text.TextStyle {
+  const base = TEXT_STYLES[key];
+  return {
+    fontFamily: base.fontFamily,
+    fontSize: base.fontSize,
+    color: base.color,
+    fontStyle: base.fontStyle,
+    ...overrides,
+  } as Phaser.Types.GameObjects.Text.TextStyle;
+}
+
+/** HEX-строка из числа (для CSS-градиентов в canvas-текстурах). */
+export function hex(color: number): string {
+  return `#${color.toString(16).padStart(6, '0')}`;
+}
+
+/** Прозрачный вариант цвета. */
+export function rgba(color: number, alpha: number): string {
+  const r = (color >> 16) & 0xff;
+  const g = (color >> 8) & 0xff;
+  const b = color & 0xff;
+  return `rgba(${r},${g},${b},${alpha})`;
+}
+
+/** Тонкая настройка цвета: t>0 — ближе к белому, t<0 — ближе к чёрному. */
+export function shift(color: number, t: number): number {
+  const k = Phaser.Math.Clamp(Math.abs(t), 0, 1);
+  const target = t >= 0 ? 0xffffff : 0x000000;
+  const mix = (channel: number, targetChannel: number) => Math.round(channel + (targetChannel - channel) * k);
+  const r = mix((color >> 16) & 0xff, (target >> 16) & 0xff);
+  const g = mix((color >> 8) & 0xff, (target >> 8) & 0xff);
+  const b = mix(color & 0xff, target & 0xff);
+  return (r << 16) | (g << 8) | b;
+}
+
+/** Смешать два цвета. */
+export function mix(colorA: number, colorB: number, t: number): number {
+  const k = Phaser.Math.Clamp(t, 0, 1);
+  const f = (a: number, b: number) => Math.round(a + (b - a) * k);
+  return (
+    (f((colorA >> 16) & 0xff, (colorB >> 16) & 0xff) << 16) |
+    (f((colorA >> 8) & 0xff, (colorB >> 8) & 0xff) << 8) |
+    f(colorA & 0xff, colorB & 0xff)
+  );
+}
+
+/** Плавность по умолчанию для всех твинов. */
+export const EASE = {
+  out: 'Cubic.easeOut',
+  in: 'Cubic.easeIn',
+  inOut: 'Cubic.easeInOut',
+  back: 'Back.easeOut',
+  sine: 'Sine.easeInOut',
+  expo: 'Expo.easeOut',
+} as const;
+
+/** Цвета рангов/сущностей. */
+export const RARITY = {
+  minor: { color: COLORS.muted, label: 'МИНОРНАЯ' },
+  major: { color: COLORS.cyan, label: 'КРУПНАЯ' },
+  raid: { color: COLORS.purple, label: 'РЕЙДОВАЯ' },
+} as const;
+
+export type RarityKey = keyof typeof RARITY;
