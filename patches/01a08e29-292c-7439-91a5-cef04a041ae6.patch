diff --git a/src/game/procedural.ts b/src/game/procedural.ts
new file mode 100644
index 0000000..2129dc8
--- /dev/null
+++ b/src/game/procedural.ts
@@ -0,0 +1,398 @@
+/**
+ * procedural.ts — аварийная арт-система.
+ * Если сгенерированный арт не попал в сборку, игра рисует сущностей, Скрепку и карты кодом.
+ * Ни один экран не должен показывать пустоту: прибор обязан работать даже без плёнки.
+ */
+
+import Phaser from 'phaser';
+import { CARDS, CARD_CLASS_COLOR } from '../data/cards';
+import { ENTITIES } from '../data/entities';
+import { COLORS, rgba } from './theme';
+
+export const CARD_ATLAS = 'cards';
+
+export function ensureArtFallbacks(scene: Phaser.Scene): void {
+  ensureCardAtlas(scene);
+  ensureEntites(scene);
+  ensureSkrepka(scene);
+}
+
+function canvasTexture(scene: Phaser.Scene, key: string, width: number, height: number): CanvasRenderingContext2D | null {
+  if (scene.textures.exists(key)) {
+    const existing = scene.textures.get(key);
+    if (existing instanceof Phaser.Textures.CanvasTexture) {
+      return existing.getContext();
+    }
+    return null;
+  }
+  const created = scene.textures.createCanvas(key, width, height);
+  return created ? created.getContext() : null;
+}
+
+/** Атлас карт: сетка 4 колонки × 8 строк с кадрами по именам арта. */
+function ensureCardAtlas(scene: Phaser.Scene): void {
+  if (scene.textures.exists(CARD_ATLAS) && (scene.textures.get(CARD_ATLAS) as Phaser.Textures.Texture).frameTotal > 1) {
+    return;
+  }
+  const cellW = 120;
+  const cellH = 160;
+  const cols = 4;
+  const rows = Math.ceil(CARDS.length / cols);
+  const width = cellW * cols;
+  const height = cellH * rows;
+  const ctx = canvasTexture(scene, CARD_ATLAS, width, height);
+  if (!ctx) return;
+  ctx.clearRect(0, 0, width, height);
+
+  CARDS.forEach((card, index) => {
+    const cx = (index % cols) * cellW;
+    const cy = Math.floor(index / cols) * cellH;
+    const accent = CARD_CLASS_COLOR[card.cardClass];
+    ctx.save();
+    ctx.translate(cx, cy);
+    // фон
+    const grad = ctx.createLinearGradient(0, 0, cellW, cellH);
+    grad.addColorStop(0, rgba(COLORS.card3, 1));
+    grad.addColorStop(1, rgba(COLORS.bg2, 1));
+    ctx.fillStyle = grad;
+    roundRect(ctx, 4, 4, cellW - 8, cellH - 8, 12);
+    ctx.fill();
+    ctx.strokeStyle = rgba(accent, 0.75);
+    ctx.lineWidth = 2;
+    roundRect(ctx, 4, 4, cellW - 8, cellH - 8, 12);
+    ctx.stroke();
+    // символ класса
+    ctx.fillStyle = rgba(accent, 0.9);
+    ctx.font = '700 30px "Russo One", sans-serif';
+    ctx.textAlign = 'center';
+    ctx.fillText(classGlyph(card.cardClass), cellW / 2, cellH / 2 + 6);
+    // подпись
+    ctx.fillStyle = rgba(COLORS.text, 0.85);
+    ctx.font = '700 9px "Manrope", sans-serif';
+    wrapText(ctx, card.short, cellW / 2, cellH - 30, cellW - 22, 11);
+    ctx.restore();
+  });
+
+  const texture = scene.textures.get(CARD_ATLAS) as Phaser.Textures.CanvasTexture;
+  texture.refresh();
+  CARDS.forEach((card, index) => {
+    const cx = (index % cols) * cellW;
+    const cy = Math.floor(index / cols) * cellH;
+    if (!texture.has(card.art)) {
+      texture.add(card.art, 0, cx + 4, cy + 4, cellW - 8, cellH - 8);
+    }
+  });
+}
+
+function classGlyph(cardClass: string): string {
+  switch (cardClass) {
+    case 'reading':
+      return '◉';
+    case 'defense':
+      return '⛨';
+    case 'decision':
+      return '⧗';
+    default:
+      return '✦';
+  }
+}
+
+function wrapText(
+  ctx: CanvasRenderingContext2D,
+  text: string,
+  x: number,
+  y: number,
+  maxWidth: number,
+  lineHeight: number,
+): void {
+  const words = text.split(' ');
+  let line = '';
+  let cursorY = y;
+  for (const word of words) {
+    const probe = line ? `${line} ${word}` : word;
+    if (ctx.measureText(probe).width > maxWidth && line) {
+      ctx.fillText(line, x, cursorY);
+      line = word;
+      cursorY += lineHeight;
+    } else {
+      line = probe;
+    }
+  }
+  if (line) ctx.fillText(line, x, cursorY);
+}
+
+/** Портреты сущностей: свой силуэт для каждой — не «заглушка», а полноценный минорный арт. */
+function ensureEntites(scene: Phaser.Scene): void {
+  for (const entity of ENTITIES) {
+    if (scene.textures.exists(entity.art)) continue;
+    const size = 256;
+    const ctx = canvasTexture(scene, entity.art, size, size);
+    if (!ctx) continue;
+    ctx.clearRect(0, 0, size, size);
+    const accent = entity.color;
+    const grad = ctx.createRadialGradient(size / 2, size / 2, 8, size / 2, size / 2, size * 0.6);
+    grad.addColorStop(0, rgba(accent, 0.5));
+    grad.addColorStop(0.55, rgba(COLORS.bg2, 0.9));
+    grad.addColorStop(1, rgba(COLORS.bg0, 0));
+    ctx.fillStyle = grad;
+    ctx.fillRect(0, 0, size, size);
+
+    ctx.fillStyle = rgba(COLORS.bg1, 0.96);
+    ctx.strokeStyle = rgba(accent, 0.85);
+    ctx.lineWidth = 3;
+    const cx = size / 2;
+    const cy = size / 2 + 6;
+    const seed = entity.id.length * 7 + entity.threat;
+    ctx.beginPath();
+    switch (entity.id) {
+      case 'fomo_wraith':
+      case 'echo_of_fomo':
+        ghostPath(ctx, cx, cy, 92, seed);
+        break;
+      case 'leverage_goblin':
+      case 'spark_gremlin':
+        goblinPath(ctx, cx, cy, 86, seed);
+        break;
+      case 'revenge_wraith':
+      case 'candle_moth':
+        flamePath(ctx, cx, cy, 88, seed);
+        break;
+      case 'hubris_dragon':
+        dragonPath(ctx, cx, cy, 94, seed);
+        break;
+      case 'headline_titan':
+        titanPath(ctx, cx, cy, 96, seed);
+        break;
+      default:
+        blobPath(ctx, cx, cy, 84, seed);
+    }
+    ctx.closePath();
+    ctx.fill();
+    ctx.stroke();
+
+    // глаза
+    ctx.fillStyle = rgba(accent, 1);
+    ctx.beginPath();
+    ctx.arc(cx - 22, cy - 18, 6, 0, Math.PI * 2);
+    ctx.arc(cx + 22, cy - 18, 6, 0, Math.PI * 2);
+    ctx.fill();
+
+    const texture = scene.textures.get(entity.art) as Phaser.Textures.CanvasTexture;
+    texture.refresh();
+  }
+}
+
+function noisy(seed: number, i: number, amp: number): number {
+  const v = Math.sin((seed + i) * 12.9898) * 43758.5453;
+  return (v - Math.floor(v) - 0.5) * 2 * amp;
+}
+
+function ghostPath(ctx: CanvasRenderingContext2D, cx: number, cy: number, r: number, seed: number): void {
+  ctx.moveTo(cx - r, cy + r * 0.4);
+  ctx.quadraticCurveTo(cx - r, cy - r, cx, cy - r);
+  ctx.quadraticCurveTo(cx + r, cy - r, cx + r, cy + r * 0.4);
+  for (let i = 0; i <= 6; i++) {
+    const x = cx + r - (i * (2 * r)) / 6;
+    const y = cy + r * 0.4 + (i % 2 === 0 ? 12 : 0) + noisy(seed, i, 5);
+    ctx.lineTo(x, y);
+  }
+}
+
+function goblinPath(ctx: CanvasRenderingContext2D, cx: number, cy: number, r: number, seed: number): void {
+  ctx.moveTo(cx - r * 0.9, cy + r * 0.8);
+  ctx.lineTo(cx - r * 0.55, cy - r * 0.4);
+  ctx.lineTo(cx - r * 1.1, cy - r * 0.95 + noisy(seed, 1, 8));
+  ctx.lineTo(cx - r * 0.35, cy - r * 0.82);
+  ctx.lineTo(cx, cy - r * 1.1);
+  ctx.lineTo(cx + r * 0.35, cy - r * 0.82);
+  ctx.lineTo(cx + r * 1.1, cy - r * 0.95 + noisy(seed, 2, 8));
+  ctx.lineTo(cx + r * 0.55, cy - r * 0.4);
+  ctx.lineTo(cx + r * 0.9, cy + r * 0.8);
+}
+
+function flamePath(ctx: CanvasRenderingContext2D, cx: number, cy: number, r: number, seed: number): void {
+  ctx.moveTo(cx - r * 0.75, cy + r * 0.85);
+  ctx.quadraticCurveTo(cx - r * 0.2, cy - r * 0.1, cx - r * 0.35, cy - r * 0.95 + noisy(seed, 3, 8));
+  ctx.quadraticCurveTo(cx, cy - r * 0.4, cx + r * 0.35, cy - r * 0.95 + noisy(seed, 4, 8));
+  ctx.quadraticCurveTo(cx + r * 0.2, cy - r * 0.1, cx + r * 0.75, cy + r * 0.85);
+}
+
+function dragonPath(ctx: CanvasRenderingContext2D, cx: number, cy: number, r: number, seed: number): void {
+  ctx.moveTo(cx - r, cy + r * 0.7);
+  ctx.lineTo(cx - r * 0.6, cy - r * 0.2);
+  ctx.lineTo(cx - r * 1.15, cy - r * 0.55 + noisy(seed, 5, 10));
+  ctx.lineTo(cx - r * 0.4, cy - r * 0.7);
+  ctx.lineTo(cx, cy - r * 1.15);
+  ctx.lineTo(cx + r * 0.4, cy - r * 0.7);
+  ctx.lineTo(cx + r * 1.15, cy - r * 0.55 + noisy(seed, 6, 10));
+  ctx.lineTo(cx + r * 0.6, cy - r * 0.2);
+  ctx.lineTo(cx + r, cy + r * 0.7);
+}
+
+function titanPath(ctx: CanvasRenderingContext2D, cx: number, cy: number, r: number, seed: number): void {
+  ctx.moveTo(cx - r, cy + r);
+  ctx.lineTo(cx - r * 0.75, cy - r * 0.55);
+  ctx.lineTo(cx - r * 0.35, cy - r * 1.05 + noisy(seed, 7, 6));
+  ctx.lineTo(cx + r * 0.35, cy - r * 1.05 + noisy(seed, 8, 6));
+  ctx.lineTo(cx + r * 0.75, cy - r * 0.55);
+  ctx.lineTo(cx + r, cy + r);
+}
+
+function blobPath(ctx: CanvasRenderingContext2D, cx: number, cy: number, r: number, seed: number): void {
+  ctx.moveTo(cx - r, cy + r * 0.6);
+  for (let i = 0; i <= 12; i++) {
+    const angle = (i / 12) * Math.PI * 2;
+    const radius = r * (0.75 + 0.25 * Math.sin(seed + i * 1.7));
+    ctx.lineTo(cx + Math.cos(angle) * radius, cy + Math.sin(angle) * radius * 0.95);
+  }
+}
+
+/**
+ * Скрепка — аналоговый ассистент. Образ неизменен: металлическая скрепка,
+ * в одеянии старого наставника, лицо пожилого человека с густыми бровями.
+ * Здесь — процедурная версия на случай отсутствия основного арта.
+ */
+function ensureSkrepka(scene: Phaser.Scene): void {
+  const variants: { key: string; mood: string; brow: number }[] = [
+    { key: 'skrepka_idle', mood: 'idle', brow: 0 },
+    { key: 'skrepka_talk', mood: 'talk', brow: 2 },
+    { key: 'skrepka_alarm', mood: 'alarm', brow: 6 },
+    { key: 'skrepka_proud', mood: 'proud', brow: -3 },
+  ];
+  for (const variant of variants) {
+    if (scene.textures.exists(variant.key)) continue;
+    const size = 256;
+    const ctx = canvasTexture(scene, variant.key, size, size);
+    if (!ctx) continue;
+    ctx.clearRect(0, 0, size, size);
+    drawSkrepka(ctx, size, variant.mood, variant.brow);
+    const texture = scene.textures.get(variant.key) as Phaser.Textures.CanvasTexture;
+    texture.refresh();
+  }
+}
+
+function drawSkrepka(ctx: CanvasRenderingContext2D, size: number, mood: string, brow: number): void {
+  const cx = size / 2;
+  const cy = size / 2;
+  const metal = ctx.createLinearGradient(cx - 60, cy - 90, cx + 60, cy + 90);
+  metal.addColorStop(0, '#e8eef7');
+  metal.addColorStop(0.4, '#9fb1c9');
+  metal.addColorStop(0.62, '#5f7288');
+  metal.addColorStop(1, '#c8d6e6');
+
+  // мантия наставника
+  ctx.beginPath();
+  ctx.moveTo(cx - 78, cy + 96);
+  ctx.quadraticCurveTo(cx - 66, cy + 6, cx - 30, cy - 34);
+  ctx.lineTo(cx + 30, cy - 34);
+  ctx.quadraticCurveTo(cx + 66, cy + 6, cx + 78, cy + 96);
+  ctx.closePath();
+  ctx.fillStyle = 'rgba(13,24,50,0.97)';
+  ctx.fill();
+  ctx.strokeStyle = 'rgba(34,216,245,0.55)';
+  ctx.lineWidth = 3;
+  ctx.stroke();
+
+  // капюшон
+  ctx.beginPath();
+  ctx.moveTo(cx - 60, cy - 6);
+  ctx.quadraticCurveTo(cx, cy - 118, cx + 60, cy - 6);
+  ctx.quadraticCurveTo(cx, cy - 44, cx - 60, cy - 6);
+  ctx.closePath();
+  ctx.fillStyle = 'rgba(9,18,38,0.98)';
+  ctx.fill();
+  ctx.stroke();
+
+  // тело-скрепка
+  ctx.lineWidth = 12;
+  ctx.lineCap = 'round';
+  ctx.strokeStyle = metal;
+  ctx.beginPath();
+  ctx.moveTo(cx - 44, cy + 78);
+  ctx.lineTo(cx - 44, cy - 46);
+  ctx.quadraticCurveTo(cx - 44, cy - 74, cx - 16, cy - 74);
+  ctx.quadraticCurveTo(cx + 12, cy - 74, cx + 12, cy - 46);
+  ctx.lineTo(cx + 12, cy + 30);
+  ctx.quadraticCurveTo(cx + 12, cy + 52, cx + 34, cy + 52);
+  ctx.quadraticCurveTo(cx + 56, cy + 52, cx + 56, cy + 26);
+  ctx.lineTo(cx + 56, cy - 40);
+  ctx.stroke();
+
+  // лицо
+  ctx.beginPath();
+  ctx.ellipse(cx, cy - 22, 40, 46, 0, 0, Math.PI * 2);
+  ctx.fillStyle = '#cbd6e6';
+  ctx.fill();
+  ctx.strokeStyle = 'rgba(90,108,138,0.9)';
+  ctx.lineWidth = 2;
+  ctx.stroke();
+
+  // морщины
+  ctx.strokeStyle = 'rgba(90,108,138,0.6)';
+  ctx.lineWidth = 1.6;
+  ctx.beginPath();
+  ctx.moveTo(cx - 26, cy - 40);
+  ctx.lineTo(cx - 6, cy - 38);
+  ctx.moveTo(cx + 6, cy - 38);
+  ctx.lineTo(cx + 26, cy - 40);
+  ctx.stroke();
+
+  // глаза
+  const eyeOpen = mood === 'alarm' ? 11 : 8;
+  ctx.fillStyle = '#04070f';
+  ctx.beginPath();
+  ctx.ellipse(cx - 15, cy - 24, 6, eyeOpen * 0.6, 0, 0, Math.PI * 2);
+  ctx.ellipse(cx + 15, cy - 24, 6, eyeOpen * 0.6, 0, 0, Math.PI * 2);
+  ctx.fill();
+  ctx.fillStyle = mood === 'alarm' ? 'rgba(251,77,109,0.95)' : 'rgba(52,211,153,0.95)';
+  ctx.beginPath();
+  ctx.arc(cx - 15, cy - 24, 2.6, 0, Math.PI * 2);
+  ctx.arc(cx + 15, cy - 24, 2.6, 0, Math.PI * 2);
+  ctx.fill();
+
+  // брови — главный признак характера
+  ctx.strokeStyle = '#8b98ab';
+  ctx.lineWidth = 6;
+  ctx.beginPath();
+  ctx.moveTo(cx - 28, cy - 36 - brow);
+  ctx.lineTo(cx - 6, cy - 42 + brow);
+  ctx.moveTo(cx + 6, cy - 42 + brow);
+  ctx.lineTo(cx + 28, cy - 36 - brow);
+  ctx.stroke();
+
+  // рот
+  ctx.strokeStyle = 'rgba(30,41,59,0.9)';
+  ctx.lineWidth = 2.4;
+  ctx.beginPath();
+  if (mood === 'proud') {
+    ctx.arc(cx, cy - 4, 13, 0.15 * Math.PI, 0.85 * Math.PI);
+  } else if (mood === 'alarm') {
+    ctx.arc(cx, cy + 12, 9, 1.15 * Math.PI, 1.85 * Math.PI);
+  } else {
+    ctx.moveTo(cx - 12, cy + 4);
+    ctx.lineTo(cx + 12, cy + 2);
+  }
+  ctx.stroke();
+}
+
+export function roundRect(
+  ctx: CanvasRenderingContext2D,
+  x: number,
+  y: number,
+  w: number,
+  h: number,
+  r: number,
+): void {
+  const radius = Math.min(r, w / 2, h / 2);
+  ctx.beginPath();
+  ctx.moveTo(x + radius, y);
+  ctx.lineTo(x + w - radius, y);
+  ctx.quadraticCurveTo(x + w, y, x + w, y + radius);
+  ctx.lineTo(x + w, y + h - radius);
+  ctx.quadraticCurveTo(x + w, y + h, x + w - radius, y + h);
+  ctx.lineTo(x + radius, y + h);
+  ctx.quadraticCurveTo(x, y + h, x, y + h - radius);
+  ctx.lineTo(x, y + radius);
+  ctx.quadraticCurveTo(x, y, x + radius, y);
+  ctx.closePath();
+}
