+export function entityPortrait(
+  scene: Phaser.Scene,
+  opts: { x: number; y: number; size: number; art: string; color: number; revealed?: boolean; rank?: string; frameTexture?: string },
+): Phaser.GameObjects.Container {
+  const container = scene.add.container(opts.x, opts.y);
+  const size = opts.size;
+  const inner = size - 8;
+
+  if (opts.frameTexture && scene.textures.exists(opts.frameTexture)) {
+    const frame = scene.add.image(0, 0, opts.frameTexture).setDisplaySize(size + 14, size + 14);
+    container.add(frame);
+  }
+
+  const glow = scene.add.image(0, 0, 'tex_glow').setDisplaySize(size * 1.5, size * 1.5);
+  glow.setTint(opts.color);
+  glow.setAlpha(opts.revealed ? 0.36 : 0.16);
+  glow.setBlendMode(Phaser.BlendModes.ADD);
+  container.add(glow);
+
+  const art = safeImage(scene, 0, 0, opts.art, COLORS.card2, '◈') as SafeArt;
+  if (art instanceof Phaser.GameObjects.Image) {
+    fitCover(art, inner, inner);
+    art.setAlpha(opts.revealed === false ? 0.35 : 1);
+  } else {
+    art.setScale(inner / 64);
+  }
+  container.add(art as unknown as Phaser.GameObjects.GameObject);
+
+  const ring = rex(scene).add.roundRectangle(0, 0, size, size, RADIUS.small + 6, 0x000000, 0) as RexShape;
+  ring.setStrokeStyle(2, opts.color, opts.revealed === false ? 0.35 : 0.85);
+  container.add(ring as unknown as Phaser.GameObjects.GameObject);
+
+  if (opts.revealed === false) {
+    const veil = scene.add.rectangle(0, 0, size - 6, size - 6, COLORS.bg0, 0.55);
+    container.add(veil);
+    const mark = scene.add
+      .text(0, 0, '?', { fontFamily: FONT.display, fontSize: `${Math.round(size * 0.4)}px`, color: '#5a6c8a' })
+      .setOrigin(0.5)
+      .setAlpha(0.9);
+    container.add(mark);
+  }
+
+  return container;
+}
