+ * Все сцены работают в дизайн-разрешении 450×800 и масштабируются движком (Phaser.Scale.FIT).
+ */
+
+export const DESIGN_WIDTH = 450;
+export const DESIGN_HEIGHT = 800;
+
+/** Отношение сторон, к которому приводится игровое полотно. */
+export const ASPECT = DESIGN_WIDTH / DESIGN_HEIGHT; // 0.5625 = 9:16
+
+/** Безопасные зоны (вырезы/жесты) в дизайн-пикселях. */
+export const SAFE = {
+  top: 14,
+  bottom: 14,
+  left: 14,
+  right: 14,
+} as const;
+
+/** Внутренние отступы контента. */
+export const PAD = {
+  x: 18,
+  top: 12,
+  bottom: 12,
+} as const;
+
+/** Слои отрисовки. */
+export const DEPTH = {
+  background: -1000,
+  ambient: -900,
+  content: 0,
+  cards: 100,
+  overlayDim: 800,
+  overlay: 900,
+  hud: 1000,
+  dialog: 1300,
+  toast: 1500,
+  veil: 1900,
+} as const;
+
+/** Длительности таймингов (мс) — единый ритм интерфейса. */
+export const TIME = {
+  tap: 90,
+  fast: 160,
+  base: 240,
+  scene: 320,
+  slow: 520,
+  reveal: 900,
+  whisper: 4200,
+} as const;
