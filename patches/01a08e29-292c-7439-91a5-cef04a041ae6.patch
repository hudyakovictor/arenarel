+/* global.css — минимальная обвязка страницы. Вся игра живёт внутри canvas. */
+
+:root {
+  --sa-cyan: #22d8f5;
+  --sa-bg: #04070f;
+}
+
+html,
+body {
+  overscroll-behavior: none;
+  background: #01030a;
+}
+
+#game-root {
+  position: absolute;
+  inset: 0;
+}
+
+canvas {
+  image-rendering: auto;
+}
+
+/* Отключаем выделение и вызов контекстного меню в игровом поле */
