+/**
+ * achievements.ts — достижения охотника. Каждое имеет измеримую метрику,
+ * поэтому не бывает «достижений за нажатие кнопки».
+ */
+
+import type { SaveData } from '../core/types';
+
+export interface AchievementDef {
+  id: string;
+  title: string;
+  description: string;
+  icon: string;
+  /** Числовые пороги, каждый следующий уровень считается отдельно. */
+  levels: number[];
+  reward: { xp?: number; signal?: number }[];
+  measure: (state: SaveData) => number;
+}
+
+const revealedEntities = (state: SaveData) => Object.values(state.codex).filter((c) => c.revealed).length;
+const perfectHunts = (state: SaveData) => state.history.filter((h) => h.dqi >= 85).length;
+const waitSeals = (state: SaveData) => state.profile.seals.wait ?? 0;
+
+export const ACHIEVEMENTS: AchievementDef[] = [
+  {
+    id: 'first_hunt',
+    title: 'ПЕРВЫЙ СЛЕД',
+    description: 'Провести первую охоту',
+    icon: 'step',
+    levels: [1, 5, 20],
+    reward: [{ xp: 30 }, { xp: 80, signal: 40 }, { xp: 200, signal: 120 }],
+    measure: (s) => s.profile.hunts,
+  },
+  {
+    id: 'codex',
+    title: 'СОБИРАТЕЛЬ ТЕНЕЙ',
+    description: 'Вскрыть сущностей в кодексе',
+    icon: 'book',
+    levels: [1, 3, 6, 10],
+    reward: [{ xp: 50 }, { xp: 120, signal: 60 }, { xp: 260, signal: 130 }, { xp: 500, signal: 300 }],
+    measure: revealedEntities,
+  },
+  {
+    id: 'clean_cases',
+    title: 'ЧИСТЫЕ ДЕЛА',
+    description: 'Завершить охоты с качеством 85+',
+    icon: 'seal',
+    levels: [1, 5, 15],
+    reward: [{ xp: 120, signal: 80 }, { xp: 320, signal: 180 }, { xp: 700, signal: 400 }],
+    measure: perfectHunts,
+  },
+  {
+    id: 'discipline',
+    title: 'ЖЕЛЕЗНАЯ ВЫДЕРЖКА',
+    description: 'Устоять под атаками шума',
+    icon: 'shield',
+    levels: [10, 50, 150],
+    reward: [{ xp: 60, signal: 30 }, { xp: 180, signal: 90 }, { xp: 420, signal: 220 }],
+    measure: (s) => s.profile.holds,
+  },
+  {
+    id: 'patience',
+    title: 'УМЕНИЕ НЕ ВОЙТИ',
+    description: 'Выбирать печать «ЖДАТЬ»',
+    icon: 'hourglass',
+    levels: [1, 10, 30],
+    reward: [{ xp: 40 }, { xp: 150, signal: 70 }, { xp: 380, signal: 190 }],
+    measure: waitSeals,
+  },
+  {
+    id: 'streak',
+    title: 'СЕРИЯ ОХОТ',
+    description: 'Дней подряд на охоте',
+    icon: 'fire',
+    levels: [3, 7, 14, 30],
+    reward: [{ xp: 80, signal: 40 }, { xp: 200, signal: 100 }, { xp: 420, signal: 220 }, { xp: 900, signal: 500 }],
+    measure: (s) => s.profile.bestStreak,
+  },
+  {
+    id: 'deck',
+    title: 'АРСЕНАЛ ПРОТОКОЛОВ',
+    description: 'Открыть карты',
+    icon: 'cards',
+    levels: [4, 8, 14, 20],
+    reward: [{ xp: 60 }, { xp: 140, signal: 60 }, { xp: 300, signal: 150 }, { xp: 620, signal: 320 }],
+    measure: (s) => s.deck.length,
+  },
+  {
+    id: 'veteran',
+    title: 'ВЕТЕРАН АРЕНЫ',
+    description: 'Провести охоты',
+    icon: 'star',
+    levels: [10, 30, 70, 150],
+    reward: [{ xp: 90, signal: 50 }, { xp: 240, signal: 120 }, { xp: 560, signal: 280 }, { xp: 1200, signal: 600 }],
+    measure: (s) => s.profile.hunts,
+  },
+];
+
+export const ACHIEVEMENTS_BY_ID: Record<string, AchievementDef> = Object.fromEntries(
+  ACHIEVEMENTS.map((a) => [a.id, a]),
+);
+
+/** Итоговый уровень достижения 0..levels.length. */
+export function achievementLevel(state: SaveData, def: AchievementDef): number {
+  return state.achievements[def.id] ?? 0;
+}
