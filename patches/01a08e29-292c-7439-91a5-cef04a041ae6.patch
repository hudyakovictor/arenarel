+  // ─────────────────────────── АКТ IV-b: ШУМ ───────────────────────────
+
+  private renderWhispers(): void {
+    const width = this.scale.width;
+    const root = this.phaseRoot!;
+    root.add(this.phaseHeader());
+
+    this.waves = waveformView(this, { x: CENTER.x, y: 190, w: width - 36, h: 200, accent: COLORS.cyan });
+    root.add(this.waves.container);
+    this.waves.setData(this.scenario.waveform);
+    this.waves.printPre(1500);
+    this.time.delayedCall(1600, () => this.waves?.stamp());
+    this.time.delayedCall(2050, () => this.waves?.printPost(this.run.seal as Seal, 600, 0, 0.3));
+
+    this.whisperIndex = 0;
+    this.time.delayedCall(2200, () => this.showWhisper());
+
+    const line = skrepkaLine('whisper', this.scenario.id);
+    this.time.delayedCall(1500, () => this.skrepka?.say(line.text, 'alarm', 3400));
+    audio.play('whisper');
+  }
+
+  private showWhisper(): void {
+    if (this.phase !== 'whispers') return;
+    const width = this.scale.width;
+    const events = this.scenario.noise;
+    if (this.whisperIndex >= events.length) {
+      this.finishHunt();
+      return;
+    }
+    const event = events[this.whisperIndex]!;
+    const root = this.phaseRoot!;
+    const entity = entityById(this.scenario.entityId);
+    const stance = cardById(this.run.protocolId);
+    const bonusTime = stance?.effect.whisperTimeBonus ?? 0;
+    const total = TIME.whisper + bonusTime;
+
+    const container = this.add.container(0, 0);
+    const panelMain = panel(this, {
+      x: CENTER.x,
+      y: 470,
+      w: width - 36,
+      h: 250,
+      fill: COLORS.card,
+      glow: COLORS.red,
+      glowAlpha: 0.12,
+      stroke: COLORS.red,
+      strokeAlpha: 0.4,
+    });
+    container.add(panelMain);
+
+    const counter = chip(this, -((width - 36) / 2) + 62, -108, `АТАКА ${this.whisperIndex + 1} / ${events.length}`, COLORS.red, { fontSize: 9 });
+    panelMain.add(counter.container);
+
+    const portrait = this.add.image((width - 36) / 2 - 48, -62, entity?.art ?? 'tex_placeholder').setDisplaySize(58, 58).setTint(entity?.color ?? COLORS.red);
+    portrait.setAlpha(0.85);
+    panelMain.add(portrait);
+
+    const whisper = this.add.text(-((width - 36) / 2) + 18, -86, `«${event.whisper}»`, {
+      fontFamily: FONT.ui,
+      fontSize: '12px',
+      color: CSS.text,
+      wordWrap: { width: width - 140, useAdvancedWrap: true },
+      lineSpacing: 4,
+    });
+    panelMain.add(whisper);
+
+    // Полоса времени: решение нужно принять, пока она не пуста
+    const timerBg = this.add.rectangle(-((width - 36) / 2) + 18, -40, width - 74, 4, 0x22314f, 1).setOrigin(0, 0.5);
+    const timerFill = this.add.rectangle(-((width - 36) / 2) + 18, -40, width - 74, 4, COLORS.red, 1).setOrigin(0, 0.5);
+    panelMain.add([timerBg, timerFill]);
+
+    const holdBtn = button(this, {
+      x: -(width - 36) / 4 - 4,
+      y: 62,
+      w: (width - 64) / 2,
+      h: 60,
+      text: event.holdLabel,
+      variant: 'primary',
+      fontSize: 11,
+      onTap: () => this.answerWhisper(event, event.correct === 'hold'),
+    });
+    const breakBtn = button(this, {
+      x: (width - 36) / 4 + 4,
+      y: 62,
+      w: (width - 64) / 2,
+      h: 60,
+      text: event.breakLabel,
+      variant: 'danger',
+      fontSize: 11,
+      onTap: () => this.answerWhisper(event, event.correct === 'break'),
+    });
+    panelMain.add([holdBtn.container, breakBtn.container]);
+    root.add(container);
+
+    if (!store.state.settings.reduceMotion) {
+      container.setAlpha(0);
+      this.tweens.add({ targets: container, alpha: 1, duration: 240, ease: EASE.out });
+    }
+
+    const counterValue = { v: 1 };
+    this.tweens.add({
+      targets: counterValue,
+      v: 0,
+      duration: total,
+      ease: 'Linear',
+      onUpdate: () => {
+        timerFill.displayWidth = Math.max(0, (width - 74) * counterValue.v);
+        if (counterValue.v < 0.3) timerFill.setFillStyle(COLORS.gold, 1);
+      },
+    });
+
+    this.whisperTimer?.remove();
+    this.whisperTimer = this.time.delayedCall(total, () => {
+      // Молчание — тоже ответ: оно не спасает и не ломает протокол.
+      this.answerWhisper(event, false, true);
+    });
+  }
+
+  private answerWhisper(event: NoiseEvent, correct: boolean, silent = false): void {
+    if (this.phase !== 'whispers') return;
+    this.whisperTimer?.remove();
+    this.whisperTimer = undefined;
+    if (!silent) {
+      audio.play(correct ? 'good' : 'bad');
+      haptics.vibrate(correct ? 'good' : 'hit');
+    }
+    this.responses.push({ event, correct });
+    if (correct) this.run.held += 1;
+    else {
+      this.run.broke += 1;
+      if (this.run.brokenAt === null) this.run.brokenAt = this.whisperIndex;
+    }
+
+    const fraction = (this.whisperIndex + 1) / this.scenario.noise.length;
+    this.waves?.printPost(this.run.seal as Seal, 420, fraction - 1 / this.scenario.noise.length, fraction);
+    if (!correct && this.run.brokenAt !== null) {
+      this.waves?.setPlayerLine(alternateWaveform(this.scenario.waveform, this.run.seal ?? 'wait', `${this.scenario.id}:broke`), COLORS.red);
+    }
+
+    const broken = !correct && !silent;
+    if (broken) {
+      toast(this, 'ПРОТОКОЛ СЛОМАН', 'bad');
+      this.cameras.main.shake(180, 0.004);
+    } else if (correct) {
+      toast(this, 'ПРОТОКОЛ ВЫДЕРЖАН', 'good');
+    }
+
+    this.whisperIndex += 1;
+    this.time.delayedCall(720, () => this.showWhisper());
+  }
+
+  // ─────────────────────────── АКТ V: РАЗБОР ───────────────────────────
+
+  private finishHunt(): void {
+    const dqi = computeDqi({
+      scenario: this.scenario,
+      developedClueIds: this.run.developedClueIds,
+      stanceId: this.run.protocolId,
+      hand: store.state.hand,
+      risk: this.run.risk,
+      seal: this.run.seal,
+      responses: this.responses,
+      previousHuntFailed: this.previousHuntFailed,
+    });
+
+    const outcome = store.completeHunt({ run: this.run, dqi, mode: this.mode });
+    advanceWeekly(store.state, this.mode);
+    if (this.mode === 'daily') store.state.flags[`daily_done_${store.todayKey()}`] = 1;
+    store.state.flags.hunts_played_total = Number(store.state.flags.hunts_played_total ?? 0) + 1;
+    emitAnalytics('hunt_finished', {
+      id: this.scenario.id,
+      dqi: dqi.total,
+      seal: this.run.seal,
+      risk: this.run.risk,
+      revealed: dqi.revealed,
+      held: this.run.held,
+      broke: this.run.broke,
+    });
+
+    this.lastExplain = dqi;
+    this.lastOutcome = outcome;
+    this.setPhase('verdict');
+  }
+
+  private lastExplain?: DqiExplain;
+
+  private renderVerdict(): void {
+    const width = this.scale.width;
+    const root = this.phaseRoot!;
+    root.add(this.phaseHeader());
+    const dqi = this.lastExplain;
+    if (!dqi) return;
+
+    const grade = dqiGrade(dqi.total);
+    const entity = entityById(this.scenario.entityId);
+    const toneColor = grade.tone === 'gold' ? COLORS.gold : grade.tone === 'good' ? COLORS.green : grade.tone === 'warn' ? COLORS.orange : COLORS.red;
+
+    // Итог: цифра + вердикт
+    const summary = panel(this, {
+      x: CENTER.x,
+      y: 176,
+      w: width - 36,
+      h: 168,
+      fill: COLORS.card,
+      glow: toneColor,
+      glowAlpha: 0.14,
+    });
+    root.add(summary);
+
+    const scoreText = this.add
+      .text(-((width - 36) / 2) + 84, -18, `${dqi.total}`, { fontFamily: FONT.display, fontSize: '52px', color: `#${toneColor.toString(16).padStart(6, '0')}` })
+      .setOrigin(0.5);
+    const scoreLabel = this.add
+      .text(-((width - 36) / 2) + 84, 26, 'КАЧЕСТВО РЕШЕНИЯ', { fontFamily: FONT.ui, fontSize: '8px', color: CSS.dim, fontStyle: '700' })
+      .setOrigin(0.5);
+    const gradeText = this.add.text(-((width - 36) / 2) + 160, -40, grade.label, {
+      fontFamily: FONT.display,
+      fontSize: '15px',
+      color: `#${toneColor.toString(16).padStart(6, '0')}`,
+    });
+    const gradeBody = this.add.text(-((width - 36) / 2) + 160, -18, grade.text, {
+      fontFamily: FONT.ui,
+      fontSize: '10px',
+      color: CSS.muted,
+      wordWrap: { width: width - 220, useAdvancedWrap: true },
+      lineSpacing: 3,
+    });
+    const sealRow = this.add.text(-((width - 36) / 2) + 160, 26, `ПЕЧАТЬ ${sealText(this.run.seal)} · ${riskLabel(this.run.risk)}`, {
+      fontFamily: FONT.mono,
+      fontSize: '10px',
+      color: CSS.text,
+    });
+    const heldRow = this.add.text(-((width - 36) / 2) + 160, 44, `ВЫДЕРЖАНО ${this.run.held} / ${this.scenario.noise.length} АТАК`, {
+      fontFamily: FONT.mono,
+      fontSize: '10px',
+      color: this.run.broke === 0 ? CSS.green : CSS.red,
+    });
+    summary.add([scoreText, scoreLabel, gradeText, gradeBody, sealRow, heldRow]);
+
+    // Портрет сущности: вскрытие или тень
+    const portraitX = (width - 36) / 2 - 44;
+    const portrait = this.add.container(portraitX, 10);
+    const art = this.add
+      .image(0, 0, entity?.art ?? 'tex_placeholder')
+      .setDisplaySize(60, 60)
+      .setAlpha(dqi.revealed ? 1 : 0.35)
+      .setTint(dqi.revealed ? 0xffffff : 0x0a1330);
+    const ring = this.add.circle(0, 0, 32, 0x000000, 0).setStrokeStyle(1.6, dqi.revealed ? toneColor : COLORS.dim, 0.8);
+    const nameText = this.add
+      .text(0, 40, dqi.revealed ? entity?.name ?? '' : 'ТЕНЬ', {
+        fontFamily: FONT.ui,
+        fontSize: '8px',
+        color: dqi.revealed ? CSS.text : CSS.dim,
+        fontStyle: '700',
+        align: 'center',
+        wordWrap: { width: 100 },
+      })
+      .setOrigin(0.5, 0);
+    portrait.add([art, ring, nameText]);
+    summary.add(portrait);
+
+    if (dqi.revealed) {
+      haptics.vibrate('reveal');
+    }
+
+    // Критерии
+    const criteriaPanel = panel(this, { x: CENTER.x, y: 300, w: width - 36, h: 250, fill: COLORS.bg2, fillAlpha: 0.86 });
+    root.add(criteriaPanel);
+    const criteriaTitle = heading(this, -((width - 36) / 2) + 16, -112, 'РАЗБОР · 5 КРИТЕРИЕВ', { size: 10, color: COLORS.muted });
+    criteriaPanel.add(criteriaTitle);
+
+    const criteria = dqi.criteria;
+    criteria.forEach((criterion, index) => {
+      const y = -88 + index * 46;
+      const row = this.add.container(-((width - 36) / 2) + 16, y);
+      const label = this.add.text(0, 0, criterion.label, { fontFamily: FONT.ui, fontSize: '10px', color: CSS.muted, fontStyle: '700' });
+      const value = this.add
+        .text(width - 68, 0, `${criterion.value}/${criterion.max}`, {
+          fontFamily: FONT.mono,
+          fontSize: '10px',
+          color: `#${scoreColor(criterion.value, criterion.max).toString(16).padStart(6, '0')}`,
+        })
+        .setOrigin(1, 0);
+      const barBg = this.add.rectangle(0, 18, width - 84, 5, 0x0a1330, 1).setOrigin(0, 0.5);
+      const bar = this.add.rectangle(0, 18, 2, 5, scoreColor(criterion.value, criterion.max), 1).setOrigin(0, 0.5);
+      row.add([label, value, barBg, bar]);
+      criteriaPanel.add(row);
+      const target = Math.max(2, ((width - 84) * criterion.value) / criterion.max);
+      if (store.state.settings.reduceMotion) bar.displayWidth = target;
+      else this.tweens.add({ targets: bar, displayWidth: target, duration: 460, delay: 120 + index * 90, ease: EASE.out });
+    });
+
+    // Исход истории
+    const outcome = this.scenario.outcomes[this.run.seal ?? 'wait'];
+    const outcomePanel = panel(this, { x: CENTER.x, y: 448, w: width - 36, h: 96, fill: COLORS.card2, fillAlpha: 0.9 });
+    root.add(outcomePanel);
+    const outcomeTitle = this.add.text(-((width - 36) / 2) + 16, -32, outcome.title, {
+      fontFamily: FONT.display,
+      fontSize: '12px',
+      color: `#${(dqi.revealed ? COLORS.cyan : COLORS.muted).toString(16).padStart(6, '0')}`,
+    });
+    const outcomeBody = this.add.text(-((width - 36) / 2) + 16, -12, dqi.revealed ? outcome.body : 'Сущность ушла в тень. Ты видел только исход, не причину.', {
+      fontFamily: FONT.ui,
+      fontSize: '10px',
+      color: CSS.muted,
+      wordWrap: { width: width - 74, useAdvancedWrap: true },
+      lineSpacing: 3,
+    });
+    outcomePanel.add([outcomeTitle, outcomeBody]);
+    if (this.run.broke > 0) {
+      const broken = this.add.text(-((width - 36) / 2) + 16, 26, `СЛОМ: ${this.scenario.brokenText}`, {
+        fontFamily: FONT.ui,
+        fontSize: '9px',
+        color: CSS.red,
+        wordWrap: { width: width - 74, useAdvancedWrap: true },
+      });
+      outcomePanel.add(broken);
+    }
+
+    // Награды
+    const rewardPanel = panel(this, { x: CENTER.x, y: 552, w: width - 36, h: 62, fill: COLORS.bg1, fillAlpha: 0.9 });
+    root.add(rewardPanel);
+    const xpText = this.add
+      .text(-(width - 36) / 4, 0, `+${this.lastOutcome?.xp ?? 0} XP`, { fontFamily: FONT.display, fontSize: '16px', color: CSS.cyan })
+      .setOrigin(0.5);
+    const signalText = this.add
+      .text((width - 36) / 4, 0, `+${this.lastOutcome?.signal ?? 0} SIGNAL`, { fontFamily: FONT.display, fontSize: '16px', color: CSS.gold })
+      .setOrigin(0.5);
+    rewardPanel.add([xpText, signalText]);
+
+    // Кнопки
+    const nextBtn = button(this, {
+      x: CENTER.x,
+      y: this.scale.height - 118,
+      w: width - 64,
+      h: 54,
+      text: this.mode === 'story' ? 'СЛЕДУЮЩЕЕ ДЕЛО' : 'В ХАБ',
+      variant: 'primary',
+      onTap: () => {
+        if (this.mode === 'story') {
+          this.go('hunt', { mode: 'story', scenarioId: nextStoryId() });
+        } else {
+          this.go('hub');
+        }
+      },
+    });
+    const repeatBtn = button(this, {
+      x: CENTER.x,
+      y: this.scale.height - 60,
+      w: width - 64,
+      h: 44,
+      text: 'ПОВТОРИТЬ ОХОТУ (АРХИВ)',
+      variant: 'ghost',
+      fontSize: 11,
+      onTap: () => this.go('hunt', { mode: 'free', scenarioId: this.scenario.id }),
+    });
+    root.add([nextBtn.container, repeatBtn.container]);
+
+    const line = skrepkaForDqi(dqi.total, `${this.scenario.id}:${dqi.total}`);
+    this.time.delayedCall(600, () => this.skrepka?.say(line.text, line.mood, 5200));
+
+    // Тост о вскрытии и редкости
+    if (dqi.revealed && entity) {
+      toast(this, `КОДЕКС: ${entity.name}`, 'gold');
+    } else {
+      toast(this, 'НУЖНО 55+ ДЛЯ ВСКРЫТИЯ', 'bad');
+    }
+    if (this.lastOutcome?.rankUp) {
+      this.time.delayedCall(1200, () => {
+        toast(this, `НОВЫЙ РАНГ: ${this.lastOutcome?.rankUp?.title}`, 'gold');
+        audio.play('levelup');
+      });
+    }
+  }
+
+  private lastOutcome?: ReturnType<typeof store.completeHunt>;
+}
+
+function phaseText(phase: string): string {
+  switch (phase) {
+    case 'euphoria':
+      return 'ЭЙФОРИЯ';
+    case 'panic':
+      return 'ПАНИКА';
+    case 'chop':
+      return 'ФЛЭТ';
+    case 'accumulation':
+      return 'НАКОПЛЕНИЕ';
+    case 'markup':
+      return 'РОСТ';
+    case 'markdown':
+      return 'ПАДЕНИЕ';
+    default:
+      return 'НЕЯСНО';
+  }
+}
+
+function phaseColor(phase: string): number {
+  switch (phase) {
+    case 'euphoria':
+      return COLORS.gold;
+    case 'panic':
+      return COLORS.red;
+    case 'chop':
+      return COLORS.muted;
+    case 'accumulation':
+    case 'markup':
+      return COLORS.green;
+    case 'markdown':
+      return COLORS.red;
+    default:
+      return COLORS.muted;
+  }
+}
+
+function clueKindColor(kind: string): number {
+  switch (kind) {
+    case 'structure':
+      return COLORS.cyan;
+    case 'volume':
+      return COLORS.green;
+    case 'crowd':
+      return COLORS.gold;
+    case 'news':
+      return COLORS.orange;
+    case 'risk':
+      return COLORS.red;
+    default:
+      return COLORS.muted;
+  }
+}
+
+function scoreColor(value: number, max: number): number {
+  const ratio = value / max;
+  if (ratio >= 0.85) return COLORS.green;
+  if (ratio >= 0.6) return COLORS.cyan;
+  if (ratio >= 0.35) return COLORS.gold;
+  return COLORS.red;
+}
+
+function sealText(seal: Seal | null): string {
+  if (seal === 'enter') return 'ВОЙТИ';
+  if (seal === 'exit') return 'ВЫЙТИ';
+  return 'ЖДАТЬ';
+}
+
+function nextStoryId(): string {
+  return nextStoryScenario(store.state).id;
+}
