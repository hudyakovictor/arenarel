+/**
+ * analytics.ts — локальный журнал событий.
+ *
+ * Принципиально: события не покидают устройство. Никакой сети, никаких трекеров,
+ * никаких идентификаторов. Журнал существует, чтобы игрок мог сам посмотреть,
+ * как принимал решения, и чтобы отладка не требовала внешних сервисов.
+ */
+
+export interface AnalyticsEvent {
+  name: string;
+  at: number;
+  payload?: Record<string, unknown>;
+}
+
+const LIMIT = 200;
+
+class Analytics {
+  private enabled = true;
+  private readonly events: AnalyticsEvent[] = [];
+  private session = Date.now();
+
+  setEnabled(value: boolean): void {
+    this.enabled = value;
+    if (!value) this.events.length = 0;
+  }
+
+  get isEnabled(): boolean {
+    return this.enabled;
+  }
+
+  get sessionId(): number {
+    return this.session;
+  }
+
+  track(name: string, payload?: Record<string, unknown>): void {
+    if (!this.enabled) return;
+    this.events.push({ name, at: Date.now(), payload });
+    if (this.events.length > LIMIT) this.events.splice(0, this.events.length - LIMIT);
+  }
+
+  list(): readonly AnalyticsEvent[] {
+    return this.events;
+  }
+
+  count(name: string): number {
+    return this.events.filter((event) => event.name === name).length;
+  }
+
+  export(): string {
+    return JSON.stringify({ session: this.session, events: this.events }, null, 2);
+  }
+
+  clear(): void {
+    this.events.length = 0;
+    this.session = Date.now();
+  }
+}
+
+export const analytics = new Analytics();
