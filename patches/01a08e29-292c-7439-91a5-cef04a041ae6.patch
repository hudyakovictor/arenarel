+/**
+ * i18n.ts — тексты интерфейса.
+ *
+ * Игра написана по-русски, и её голос — часть продукта: панк-таблоидная сатира.
+ * Поэтому английский слой покрывает интерфейс, но не подменяет интонацию дел.
+ */
+
+export type Lang = 'ru' | 'en';
+
+type Dict = Record<string, string>;
+
+const RU: Dict = {
+  'app.title': 'SIGNAL ARENA',
+  'app.tagline': 'НЕ ТЕРМИНАЛ. НЕ БИРЖА. ОХОТА.',
+  'nav.hunt': 'ОХОТА',
+  'nav.codex': 'КОДЕКС',
+  'nav.deck': 'КОЛОДА',
+  'nav.profile': 'ПРОФИЛЬ',
+  'action.start': 'НАЧАТЬ ОХОТУ',
+  'action.continue': 'ПРОДОЛЖИТЬ ДЕЛО',
+  'action.claim': 'ЗАБРАТЬ',
+  'action.next': 'ДАЛЬШЕ',
+  'action.back': 'НАЗАД',
+  'action.close': 'ЗАКРЫТЬ',
+  'hunt.clues': 'СЛЕД',
+  'hunt.protocol': 'ПРОТОКОЛ',
+  'hunt.seal': 'ПЕЧАТЬ t₀',
+  'hunt.whispers': 'ШУМ',
+  'hunt.verdict': 'РАЗБОР',
+  'hunt.energy_out': 'ЭНЕРГИЯ ИСЧЕРПАНА',
+  'verdict.perfect': 'ЧИСТОЕ ДЕЛО',
+  'verdict.clean': 'УБЕДИТЕЛЬНО',
+  'verdict.weak': 'ВСКРЫТИЕ',
+  'verdict.fail': 'ПРОВАЛ',
+  'codex.empty': 'Кодекс пуст. Сущности ещё не названы.',
+  'deck.hand': 'РУКА',
+  'shop.ethics': 'Купленное не влияет на решения. Это принципиально.',
+  'about.clip': 'Скрепка не является искусственным интеллектом.',
+};
+
+const EN: Dict = {
+  'app.title': 'SIGNAL ARENA',
+  'app.tagline': 'NOT A TERMINAL. NOT AN EXCHANGE. A HUNT.',
+  'nav.hunt': 'HUNT',
+  'nav.codex': 'CODEX',
+  'nav.deck': 'DECK',
+  'nav.profile': 'PROFILE',
+  'action.start': 'START HUNT',
+  'action.continue': 'RESUME CASE',
+  'action.claim': 'CLAIM',
+  'action.next': 'NEXT',
+  'action.back': 'BACK',
+  'action.close': 'CLOSE',
+  'hunt.clues': 'TRAIL',
+  'hunt.protocol': 'STANCE',
+  'hunt.seal': 'SEAL t₀',
+  'hunt.whispers': 'NOISE',
+  'hunt.verdict': 'DEBRIEF',
+  'hunt.energy_out': 'ENERGY DEPLETED',
+  'verdict.perfect': 'CLEAN CASE',
+  'verdict.clean': 'CONVINCING',
+  'verdict.weak': 'UNCOVERED',
+  'verdict.fail': 'FAILURE',
+  'codex.empty': 'The codex is empty. No entity has been named yet.',
+  'deck.hand': 'HAND',
+  'shop.ethics': 'Nothing you buy affects your decisions. That is the point.',
+  'about.clip': 'Clippy is not artificial intelligence.',
+};
+
+const DICTS: Record<Lang, Dict> = { ru: RU, en: EN };
+
+let current: Lang = 'ru';
+
+export function setLang(lang: Lang): void {
+  current = DICTS[lang] ? lang : 'ru';
+}
+
+export function getLang(): Lang {
+  return current;
+}
+
+/** Перевод по ключу. Если строки нет — возвращаем русскую основу (или ключ). */
+export function t(key: string, params?: Record<string, string | number>): string {
+  const dict = DICTS[current];
+  let value = dict[key] ?? RU[key] ?? key;
+  if (params) {
+    for (const [name, replacement] of Object.entries(params)) {
+      value = value.replace(new RegExp(`\\{${name}\\}`, 'g'), String(replacement));
+    }
+  }
+  return value;
+}
+
+/** Контент дел и разборов существует только по-русски — говорим об этом честно. */
+export function contentLangNote(): string {
+  return current === 'ru' ? '' : 'Case files are written in Russian.';
+}
+
+export const LANG_LABEL: Record<Lang, string> = { ru: 'RU', en: 'EN' };
