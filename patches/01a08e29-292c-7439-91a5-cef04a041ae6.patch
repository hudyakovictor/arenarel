+/**
+ * config.ts — конфигурация Phaser 4.
+ * Вертикаль 9:16, дизайн-разрешение 450×800, плагин RexUI под ключом rexUI.
+ */
+
+import Phaser from 'phaser';
+import { DESIGN_HEIGHT, DESIGN_WIDTH } from './design';
+import { COLORS } from './theme';
+
+// Рантайм-плагин RexUI поставляется без экспортируемых типов — контракт описан в src/ui/rex.ts.
+// @ts-ignore — модуль есть в сборке, типов у него нет
+import UIPlugin from 'phaser4-rex-plugins/templates/ui/ui-plugin.js';
+
+export function createGameConfig(
+  scenes: Phaser.Types.Scenes.SceneType[],
+): Phaser.Types.Core.GameConfig {
+  return {
+    type: Phaser.AUTO,
+    parent: 'game-root',
+    width: DESIGN_WIDTH,
+    height: DESIGN_HEIGHT,
+    backgroundColor: COLORS.bg0,
+    banner: false,
+    disableContextMenu: true,
+    pixelArt: false,
+    antialias: true,
+    roundPixels: false,
+    audio: {
+      disableWebAudio: false,
+      noAudio: false,
+    },
+    scale: {
+      mode: Phaser.Scale.FIT,
+      autoCenter: Phaser.Scale.CENTER_BOTH,
+      width: DESIGN_WIDTH,
+      height: DESIGN_HEIGHT,
+      expandParent: false,
+    },
+    input: {
+      activePointers: 3,
+      touch: { capture: true },
+      smoothFactor: 0.15,
+    },
+    render: {
+      powerPreference: 'high-performance',
+      antialias: true,
+      desynchronized: true,
+    },
+    fps: {
+      target: 60,
+      min: 30,
+    },
+    scene: scenes,
+    plugins: {
+      scene: [
+        {
+          key: 'rexUI',
+          plugin: UIPlugin as unknown as typeof Phaser.Plugins.ScenePlugin,
+          mapping: 'rexUI',
+        },
+      ],
+    },
+  };
+}
