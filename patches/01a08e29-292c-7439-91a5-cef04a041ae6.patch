+/** Фоновая подложка всех сцен: сетка самописца, свечения, вигнетка, лёгкий шум. */
+export function backdrop(scene: Phaser.Scene, accent: number = COLORS.cyan): Phaser.GameObjects.Container {
+  const container = scene.add.container(0, 0).setDepth(-1000);
+  const { width, height } = scene.scale;
+  const base = scene.add.rectangle(width / 2, height / 2, width, height, COLORS.bg1).setOrigin(0.5);
+  container.add(base);
+
+  const gradient = scene.add.graphics();
+  gradient.fillGradientStyle(COLORS.bg2, COLORS.bg2, COLORS.bg0, COLORS.bg0, 0.85, 0.85, 0.95, 0.95);
+  gradient.fillRect(0, 0, width, height);
+  container.add(gradient);
+
+  const grid = scene.add.tileSprite(width / 2, height / 2, width, height, 'tex_grid');
+  grid.setAlpha(0.5);
+  container.add(grid);
+
+  const glowTop = scene.add.image(width / 2, -60, 'tex_glow').setDisplaySize(width * 1.7, height * 0.6);
+  glowTop.setTint(accent);
+  glowTop.setAlpha(0.14);
+  glowTop.setBlendMode(Phaser.BlendModes.ADD);
+  container.add(glowTop);
+
+  const glowBottom = scene.add.image(width * 0.85, height + 40, 'tex_glow').setDisplaySize(width * 1.4, height * 0.55);
+  glowBottom.setTint(COLORS.purple);
+  glowBottom.setAlpha(0.1);
+  glowBottom.setBlendMode(Phaser.BlendModes.ADD);
+  container.add(glowBottom);
+
+  const noise = scene.add.tileSprite(width / 2, height / 2, width, height, 'tex_noise');
+  noise.setAlpha(0.35);
+  container.add(noise);
+
+  const vignette = scene.add.image(width / 2, height / 2, 'tex_vignette').setDisplaySize(width, height);
+  vignette.setAlpha(0.9);
+  container.add(vignette);
+
+  if (!reduceMotion()) {
+    scene.tweens.add({
+      targets: grid,
+      tilePositionY: 48,
+      duration: 6000,
+      repeat: -1,
+      ease: 'Linear',
+    });
+  }
+  return container;
+}
