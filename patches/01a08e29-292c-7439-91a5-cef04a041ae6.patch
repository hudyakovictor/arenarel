+/**
+ * Окно Скрепки: маленький аналоговый приёмник, в котором живёт ассистент.
+ * Образ неизменен: металлическая скрепка в одеянии наставника.
+ */
+export function skrepkaWindow(
+  scene: Phaser.Scene,
+  opts: { x: number; y: number; size?: number; depth?: number; greeting?: boolean },
+): SkrepkaHandle {
+  const size = opts.size ?? 96;
+  const container = scene.add.container(opts.x, opts.y).setDepth(opts.depth ?? DEPTH.overlay);
+  const inner = size - 12;
+
+  const glow = scene.add.image(0, 0, 'tex_glow').setDisplaySize(size * 2.1, size * 2.1).setTint(COLORS.green).setAlpha(0.14);
+  glow.setBlendMode(Phaser.BlendModes.ADD);
+  container.add(glow);
+
+  const body = rex(scene).add.roundRectangle(0, 0, size, size, 16, COLORS.bg1, 0.98) as RexShape;
+  body.setStrokeStyle(2, COLORS.green, 0.45);
+  container.add(body as unknown as Phaser.GameObjects.GameObject);
+
+  const art = safeImage(scene, 0, -4, 'skrepka_idle', COLORS.card2, '⌾') as Phaser.GameObjects.Image;
+  if (art instanceof Phaser.GameObjects.Image) fitCover(art, inner, inner - 10);
+  container.add(art as unknown as Phaser.GameObjects.GameObject);
+
+  if (store.state.settings.crt) {
+    const scan = scene.add.tileSprite(0, 0, size - 10, size - 10, 'tex_scanline').setAlpha(0.35);
+    container.add(scan);
+  }
+
+  const name = scene.add
+    .text(0, size / 2 + 10, SKREPKA_NAME, { fontFamily: FONT.display, fontSize: '9px', color: CSS.green })
+    .setOrigin(0.5);
+  const sub = scene.add
+    .text(0, size / 2 + 21, SKREPKA_SUBTITLE, { fontFamily: FONT.ui, fontSize: '7px', color: CSS.dim, fontStyle: '700' })
+    .setOrigin(0.5);
+  container.add([name, sub]);
+
+  // Речевое облако
+  const bubble = scene.add.container(-size / 2 - 8, -10).setVisible(false);
+  const bubbleText = scene.add
+    .text(0, 0, '', {
+      fontFamily: FONT.ui,
+      fontSize: '10px',
+      color: CSS.text,
+      align: 'left',
+      wordWrap: { width: 150, useAdvancedWrap: true },
+      lineSpacing: 3,
+    })
+    .setOrigin(1, 0.5);
+  const bubbleBg = rex(scene).add.roundRectangle(-bubbleText.width / 2, 0, 0, 0, 12, COLORS.card2, 0.98) as RexShape;
+  bubbleBg.setStrokeStyle(1.4, COLORS.green, 0.55);
+  const tail = scene.add.triangle(6, 0, 0, -7, 0, 7, 12, 0, COLORS.card2, 1);
+  bubble.add([bubbleBg as unknown as Phaser.GameObjects.GameObject, bubbleText, tail]);
+  container.add(bubble);
+
+  let hideTimer: Phaser.Time.TimerEvent | null = null;
+  const moodTextures: Record<SkrepkaMood, string> = {
+    idle: 'skrepka_idle',
+    talk: 'skrepka_talk',
+    smug: 'skrepka_talk',
+    alarm: 'skrepka_alarm',
+    proud: 'skrepka_proud',
+  };
+
+  const setMood = (mood: SkrepkaMood) => {
+    if (!(art instanceof Phaser.GameObjects.Image)) return;
+    const key = moodTextures[mood] ?? 'skrepka_idle';
+    if (scene.textures.exists(key)) art.setTexture(key);
+    glow.setTint(mood === 'alarm' ? COLORS.red : mood === 'proud' ? COLORS.gold : COLORS.green);
+  };
+
+  const say = (text: string, mood: SkrepkaMood = 'talk', hold = 4200) => {
+    setMood(mood);
+    bubbleText.setText(text);
+    const width = Math.min(170, bubbleText.width + 26);
+    const height = bubbleText.height + 20;
+    bubbleText.setPosition(-width + 14, -height / 2 + 10);
+    bubbleBg.setPosition(-width / 2, 0);
+    // rexUI пересчитывает геометрию по setSize
+    bubbleBg.setSize(width, height);
+    bubble.setAlpha(0);
+    bubble.setVisible(true);
+    scene.tweens.add({ targets: bubble, alpha: 1, x: -size / 2 - 12, duration: TIME.base, ease: EASE.out });
+    if (hideTimer) hideTimer.remove();
+    hideTimer = scene.time.delayedCall(hold, () => {
+      scene.tweens.add({
+        targets: bubble,
+        alpha: 0,
+        duration: TIME.base,
+        onComplete: () => bubble.setVisible(false),
+      });
+    });
+  };
+
+  const hit = scene.add.rectangle(0, 0, size, size, 0xffffff, 0).setInteractive({ useHandCursor: true });
+  hit.on('pointerup', () => {
+    audio.play('click');
+    const line = skrepkaLine('idleTap');
+    say(line.text, line.mood, 3600);
+  });
+  container.add(hit);
+
+  if (!store.state.settings.reduceMotion) {
+    scene.tweens.add({
+      targets: glow,
+      alpha: { from: 0.1, to: 0.22 },
+      duration: 2200,
+      yoyo: true,
+      repeat: -1,
+      ease: EASE.sine,
+    });
+    scene.tweens.add({
+      targets: art,
+      y: { from: -4, to: -8 },
+      duration: 2600,
+      yoyo: true,
+      repeat: -1,
+      ease: EASE.sine,
+    });
+  }
+
+  if (opts.greeting) {
+    scene.time.delayedCall(420, () => {
+      say('Я пришёл из прошлого, чтобы помочь тебе в будущем.', 'talk', 5200);
+    });
+  }
+
+  return {
+    container,
+    say,
+    react: (mood, text) => {
+      if (text) say(text, mood);
+      else setMood(mood);
+    },
+    close: () => container.destroy(true),
+  };
+}
