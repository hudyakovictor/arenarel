+/**
+ * boot-overlay.ts — завеса загрузки в DOM.
+ *
+ * Вынесено из main.ts, чтобы сцены не зависели от точки входа:
+ * циклический импорт main ↔ BootScene — лишний риск на старте.
+ */
+
+export function setBootProgress(value: number, text?: string): void {
+  const progress = document.getElementById('boot-progress');
+  const note = document.getElementById('boot-note');
+  if (progress) progress.style.width = `${Math.round(Math.max(0.05, Math.min(1, value)) * 100)}%`;
+  if (note && text) note.textContent = text;
+}
+
+export function hideBootVeil(): void {
+  const veil = document.getElementById('boot-veil');
+  if (!veil) return;
+  veil.classList.add('is-hidden');
+  window.setTimeout(() => veil.remove(), 700);
+}
+
+export function showBootError(message: string): void {
+  const errorBox = document.getElementById('boot-error');
+  if (!errorBox) return;
+  errorBox.style.display = 'block';
+  errorBox.textContent = message;
+}
