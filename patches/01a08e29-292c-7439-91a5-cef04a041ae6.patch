@@ -0,0 +1,198 @@
+/**
+ * textures.ts — процедурные текстуры. Ноль внешних ассетов для фона и эффектов:
+ * свечение, сетка самописца, шум, скан-линии, вигнетка, тени сущностей.
+ * Всё рисуется один раз при загрузке и живёт в кэше Phaser.
+ */
+
+import Phaser from 'phaser';
+import { COLORS, rgba } from './theme';
+
+export const TEX = {
+  glow: 'tex_glow',
+  dot: 'tex_dot',
+  grid: 'tex_grid',
+  scanline: 'tex_scanline',
+  noise: 'tex_noise',
+  vignette: 'tex_vignette',
+  shadowBlob: 'tex_shadow_blob',
+  placeholder: 'tex_placeholder',
+  stampRing: 'tex_stamp_ring',
+  paperStrip: 'tex_paper_strip',
+} as const;
+
+function createCanvas(scene: Phaser.Scene, key: string, width: number, height: number): CanvasRenderingContext2D | null {
+  if (scene.textures.exists(key)) scene.textures.remove(key);
+  const texture = scene.textures.createCanvas(key, width, height);
+  if (!texture) return null;
+  return texture.getContext();
+}
+
+function refresh(scene: Phaser.Scene, key: string): void {
+  (scene.textures.get(key) as Phaser.Textures.CanvasTexture).refresh();
+}
+
+export function generateTextures(scene: Phaser.Scene): void {
+  radialGlow(scene);
+  dot(scene);
+  grid(scene);
+  scanlines(scene);
+  noise(scene);
+  vignette(scene);
+  shadowBlob(scene);
+  placeholder(scene);
+  stampRing(scene);
+  paperStrip(scene);
+}
+
+function radialGlow(scene: Phaser.Scene): void {
+  const size = 256;
+  const ctx = createCanvas(scene, TEX.glow, size, size);
+  if (!ctx) return;
+  const gradient = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
+  gradient.addColorStop(0, 'rgba(255,255,255,0.95)');
+  gradient.addColorStop(0.35, 'rgba(255,255,255,0.35)');
+  gradient.addColorStop(0.7, 'rgba(255,255,255,0.08)');
+  gradient.addColorStop(1, 'rgba(255,255,255,0)');
+  ctx.fillStyle = gradient;
+  ctx.fillRect(0, 0, size, size);
+  refresh(scene, TEX.glow);
+}
+
+function dot(scene: Phaser.Scene): void {
+  const size = 16;
+  const ctx = createCanvas(scene, TEX.dot, size, size);
+  if (!ctx) return;
+  const gradient = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
+  gradient.addColorStop(0, 'rgba(255,255,255,1)');
+  gradient.addColorStop(1, 'rgba(255,255,255,0)');
+  ctx.fillStyle = gradient;
+  ctx.fillRect(0, 0, size, size);
+  refresh(scene, TEX.dot);
+}
+
+function grid(scene: Phaser.Scene): void {
+  const size = 48;
+  const ctx = createCanvas(scene, TEX.grid, size, size);
+  if (!ctx) return;
+  ctx.clearRect(0, 0, size, size);
+  ctx.strokeStyle = rgba(0x82a5d2, 0.12);
+  ctx.lineWidth = 1;
+  ctx.beginPath();
+  ctx.moveTo(0, 0.5);
+  ctx.lineTo(size, 0.5);
+  ctx.moveTo(0.5, 0);
+  ctx.lineTo(0.5, size);
+  ctx.stroke();
+  ctx.fillStyle = rgba(0x22d8f5, 0.14);
+  ctx.beginPath();
+  ctx.arc(0, 0, 1.2, 0, Math.PI * 2);
+  ctx.fill();
+  refresh(scene, TEX.grid);
+}
+
+function scanlines(scene: Phaser.Scene): void {
+  const size = 6;
+  const ctx = createCanvas(scene, TEX.scanline, 8, size);
+  if (!ctx) return;
+  ctx.clearRect(0, 0, 8, size);
+  ctx.fillStyle = 'rgba(0,0,0,0.32)';
+  ctx.fillRect(0, 0, 8, 2);
+  refresh(scene, TEX.scanline);
+}
+
+function noise(scene: Phaser.Scene): void {
+  const size = 128;
+  const ctx = createCanvas(scene, TEX.noise, size, size);
+  if (!ctx) return;
+  const image = ctx.createImageData(size, size);
+  for (let i = 0; i < image.data.length; i += 4) {
+    const v = Math.floor(Math.random() * 255);
+    image.data[i] = v;
+    image.data[i + 1] = v;
+    image.data[i + 2] = v;
+    image.data[i + 3] = Math.random() < 0.5 ? 0 : 12;
+  }
+  ctx.putImageData(image, 0, 0);
+  refresh(scene, TEX.noise);
+}
+
+function vignette(scene: Phaser.Scene): void {
+  const w = 256;
+  const h = 456;
+  const ctx = createCanvas(scene, TEX.vignette, w, h);
+  if (!ctx) return;
+  const gradient = ctx.createRadialGradient(w / 2, h / 2, h * 0.18, w / 2, h / 2, h * 0.62);
+  gradient.addColorStop(0, 'rgba(0,0,0,0)');
+  gradient.addColorStop(0.7, 'rgba(0,0,0,0.35)');
+  gradient.addColorStop(1, 'rgba(0,0,0,0.85)');
+  ctx.fillStyle = gradient;
+  ctx.fillRect(0, 0, w, h);
+  refresh(scene, TEX.vignette);
+}
+
+function shadowBlob(scene: Phaser.Scene): void {
+  const size = 128;
+  const ctx = createCanvas(scene, TEX.shadowBlob, size, size);
+  if (!ctx) return;
+  const gradient = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
+  gradient.addColorStop(0, 'rgba(4,7,15,0.9)');
+  gradient.addColorStop(0.55, 'rgba(4,7,15,0.45)');
+  gradient.addColorStop(1, 'rgba(4,7,15,0)');
+  ctx.fillStyle = gradient;
+  ctx.fillRect(0, 0, size, size);
+  refresh(scene, TEX.shadowBlob);
+}
+
+function placeholder(scene: Phaser.Scene): void {
+  const w = 128;
+  const h = 128;
+  const ctx = createCanvas(scene, TEX.placeholder, w, h);
+  if (!ctx) return;
+  ctx.fillStyle = rgba(COLORS.card2, 1);
+  ctx.fillRect(0, 0, w, h);
+  ctx.strokeStyle = rgba(0x82a5d2, 0.35);
+  ctx.lineWidth = 2;
+  ctx.strokeRect(1, 1, w - 2, h - 2);
+  ctx.fillStyle = rgba(0x8fa1c0, 0.8);
+  ctx.font = '700 14px "Manrope", sans-serif';
+  ctx.textAlign = 'center';
+  ctx.fillText('НЕТ АРТА', w / 2, h / 2 + 5);
+  refresh(scene, TEX.placeholder);
+}
+
+function stampRing(scene: Phaser.Scene): void {
+  const size = 220;
+  const ctx = createCanvas(scene, TEX.stampRing, size, size);
+  if (!ctx) return;
+  ctx.clearRect(0, 0, size, size);
+  ctx.strokeStyle = rgba(0xfb4d6d, 0.85);
+  ctx.lineWidth = 5;
+  ctx.beginPath();
+  ctx.arc(size / 2, size / 2, size / 2 - 12, 0, Math.PI * 2);
+  ctx.stroke();
+  ctx.lineWidth = 2;
+  ctx.beginPath();
+  ctx.arc(size / 2, size / 2, size / 2 - 24, 0, Math.PI * 2);
+  ctx.stroke();
+  ctx.font = '700 13px "Manrope", sans-serif';
+  ctx.fillStyle = rgba(0xfb4d6d, 0.9);
+  ctx.textAlign = 'center';
+  ctx.fillText('ПЕЧАТЬ ВРЕМЕНИ', size / 2, 34);
+  ctx.fillText('t₀ ЗАФИКСИРОВАНО', size / 2, size - 24);
+  refresh(scene, TEX.stampRing);
+}
+
+function paperStrip(scene: Phaser.Scene): void {
+  const w = 64;
+  const h = 64;
+  const ctx = createCanvas(scene, TEX.paperStrip, w, h);
+  if (!ctx) return;
+  ctx.fillStyle = rgba(0xf2f7ff, 0.06);
+  ctx.fillRect(0, 0, w, h);
+  ctx.strokeStyle = rgba(0x22d8f5, 0.25);
+  ctx.beginPath();
+  ctx.moveTo(0, h - 1.5);
+  ctx.lineTo(w, h - 1.5);
+  ctx.stroke();
+  refresh(scene, TEX.paperStrip);
+}
