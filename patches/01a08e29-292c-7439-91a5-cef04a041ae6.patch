+/**
+ * DQI — ядро игры. Здесь проверяется, что оценка:
+ * 1) детерминирована, 2) ограничена 0..100, 3) реагирует на качество решения, а не на исход.
+ */
+
+import { beforeEach, describe, expect, it } from 'vitest';
+
+import { computeDqi } from '../../src/core/scoring';
+import { scenarioById } from '../../src/data/scenarios';
+import { CARD_CLASS_LABEL } from '../../src/data/cards';
+import { createNewSave } from '../../src/core/save';
+import { applyHuntResult } from '../../src/core/progression';
+import { store } from '../../src/core/store';
+import { Rng } from '../../src/core/rng';
+import type { HuntRunState, HuntScenario, NoiseEvent, RiskSeal, Seal } from '../../src/core/types';
+
+const scenario = scenarioById('h05')!;
+
+function responsesFor(scenario_: HuntScenario, correctness: boolean[]): { event: NoiseEvent; correct: boolean }[] {
+  return scenario_.noise.map((event, index) => ({ event, correct: correctness[index] ?? true }));
+}
+
+function baseInput(overrides: Partial<Parameters<typeof computeDqi>[0]> = {}) {
+  return {
+    scenario,
+    developedClueIds: scenario.clueIds.slice(0, 3),
+    stanceId: 'protocol_evidence_only',
+    hand: ['reading_higher_tf', 'defense_daily_risk', 'decision_stay_out', 'protocol_evidence_only'],
+    risk: 'standard' as RiskSeal,
+    seal: 'wait' as Seal,
+    responses: responsesFor(scenario, scenario.noise.map(() => true)),
+    previousHuntFailed: false,
+    ...overrides,
+  };
+}
+
+describe('computeDqi', () => {
+  it('детерминирован: одинаковый вход — одинаковый выход', () => {
+    const first = computeDqi(baseInput());
+    const second = computeDqi(baseInput());
+    expect(first.total).toBe(second.total);
+    expect(first.criteria.map((c) => c.value)).toEqual(second.criteria.map((c) => c.value));
+  });
+
+  it('всегда остаётся в диапазоне 0..100 и печатает 5 критериев', () => {
+    const rng = new Rng('dqi-fuzz');
+    for (let index = 0; index < 200; index += 1) {
+      const developed = rng.pick(scenario.clueIds);
+      const input = baseInput({
+        developedClueIds: rng.chance(0.5) ? [developed] : [],
+        stanceId: rng.chance(0.2) ? null : rng.pick(['reading_correlations', 'defense_daily_risk', 'decision_stay_out', 'protocol_evidence_only']),
+        risk: rng.pick<RiskSeal>(['shield', 'standard', 'bold', 'allin']),
+        seal: rng.pick<Seal>(['wait', 'enter', 'exit']),
+        responses: responsesFor(scenario, scenario.noise.map(() => rng.chance(0.6))),
+        previousHuntFailed: rng.chance(0.3),
+      });
+      const result = computeDqi(input);
+      expect(result.total).toBeGreaterThanOrEqual(0);
+      expect(result.total).toBeLessThanOrEqual(100);
+      expect(result.criteria).toHaveLength(5);
+      expect(result.criteria.map((c) => c.key).sort()).toEqual(['composure', 'context', 'evidence', 'protocol', 'risk']);
+      for (const criterion of result.criteria) {
+        expect(criterion.value).toBeGreaterThanOrEqual(0);
+        expect(criterion.value).toBeLessThanOrEqual(criterion.max);
+        expect(CARD_CLASS_LABEL).toBeTruthy();
+      }
+    }
+  });
+
+  it('без улик и без стойки оценка хуже, чем с уликами и стойкой', () => {
+    const weak = computeDqi(baseInput({ developedClueIds: [], stanceId: null, responses: responsesFor(scenario, scenario.noise.map(() => false)) }));
+    const strong = computeDqi(baseInput());
+    expect(strong.total).toBeGreaterThan(weak.total);
+  });
+
+  it('сломанный протокол бьёт по самообладанию, а не по исходам', () => {
+    const held = computeDqi(baseInput({ responses: responsesFor(scenario, scenario.noise.map(() => true)) }));
+    const broken = computeDqi(baseInput({ responses: responsesFor(scenario, scenario.noise.map(() => false)) }));
+    const heldComposure = held.criteria.find((c) => c.key === 'composure')!.value;
+    const brokenComposure = broken.criteria.find((c) => c.key === 'composure')!.value;
+    expect(heldComposure).toBeGreaterThan(brokenComposure);
+    expect(broken.total).toBeLessThan(held.total);
+  });
+
+  it('вскрытие сущности требует 55+', () => {
+    const good = computeDqi(baseInput());
+    expect(good.revealed).toBe(good.total >= 55);
+  });
+});
+
+const run: HuntRunState = {
+  scenario,
+  mode: 'story',
+  developedClueIds: scenario.clueIds.slice(0, 4),
+  scanBudget: 4,
+  protocolId: 'protocol_evidence_only',
+  risk: 'standard',
+  seal: 'wait',
+  held: scenario.noise.length,
+  broke: 0,
+  brokenAt: null,
+};
+
+describe('applyHuntResult', () => {
+  const run: HuntRunState = {
+    scenario,
+    mode: 'story',
+    developedClueIds: scenario.clueIds.slice(0, 4),
+    scanBudget: 4,
+    protocolId: 'protocol_evidence_only',
+    risk: 'standard',
+    seal: 'wait',
+    held: scenario.noise.length,
+    broke: 0,
+    brokenAt: null,
+  };
+
+  it('начисляет опыт, SIGNAL и ведёт историю без дублей по идентификатору дела', () => {
+    const save = createNewSave(1_700_000_000_000);
+    const dqi = computeDqi({
+      scenario,
+      developedClueIds: run.developedClueIds,
+      stanceId: run.protocolId,
+      hand: save.hand,
+      risk: run.risk,
+      seal: run.seal,
+      responses: responsesFor(scenario, scenario.noise.map(() => true)),
+      previousHuntFailed: false,
+    });
+
+    const outcome = applyHuntResult(save, { run, dqi, mode: 'story' });
+    expect(outcome.xp).toBeGreaterThan(0);
+    expect(outcome.signal).toBeGreaterThan(0);
+    expect(save.history).toHaveLength(1);
+    expect(save.history[0]!.id).toBe(scenario.id);
+    expect(save.profile.hunts).toBe(1);
+    expect(save.codex[scenario.entityId]?.seen).toBe(1);
+
+    const second = applyHuntResult(save, { run, dqi, mode: 'story' });
+    expect(second.xp).toBeGreaterThan(0);
+    expect(save.history).toHaveLength(2);
+    expect(save.codex[scenario.entityId]?.seen).toBe(2);
+  });
+
+  it('вскрывает сущность только при качестве 55+', () => {
+    const save = createNewSave(1_700_000_000_000);
+    const dqi = computeDqi({
+      scenario,
+      developedClueIds: [],
+      stanceId: null,
+      hand: [],
+      risk: 'allin',
+      seal: 'enter',
+      responses: responsesFor(scenario, scenario.noise.map(() => false)),
+      previousHuntFailed: false,
+    });
+    applyHuntResult(save, { run: { ...run, developedClueIds: [], protocolId: null, seal: 'enter', risk: 'allin' }, dqi, mode: 'story' });
+    expect(save.codex[scenario.entityId]?.revealed).toBe(dqi.revealed);
+  });
+});
+
+describe('store: единая точка изменения состояния', () => {
+  beforeEach(() => {
+    store.hardReset();
+  });
+
+  it('стартовое сохранение согласовано с данными (косметика, колода, рука)', () => {
+    const save = createNewSave(1_700_000_000_000);
+    expect(save.hand).toHaveLength(4);
+    expect(save.deck.length).toBeGreaterThanOrEqual(4);
+    expect(save.cosmetics.skrepka).toBe('skrepka_classic');
+    expect(save.cosmetics.owned).toContain('skrepka_classic');
+  });
+
+  it('жизненный цикл: охота тратит энергию, завершение даёт награду и опыт', () => {
+    const before = store.state.profile.energy;
+    expect(store.canHunt('story').ok).toBe(true);
+    expect(store.spendEnergy()).toBe(true);
+    expect(store.state.profile.energy).toBe(before - 1);
+
+    const dqi = computeDqi({
+      scenario,
+      developedClueIds: scenario.clueIds.slice(0, 3),
+      stanceId: 'protocol_evidence_only',
+      hand: store.state.hand,
+      risk: 'standard',
+      seal: 'wait',
+      responses: responsesFor(scenario, scenario.noise.map(() => true)),
+      previousHuntFailed: false,
+    });
+    const outcome = store.completeHunt({ run, dqi, mode: 'story' });
+    expect(outcome.xp).toBeGreaterThan(0);
+    expect(store.state.profile.hunts).toBe(1);
+    expect(store.state.profile.energy).toBe(before - 1);
+  });
+
+  it('обучение и архив не тратят энергию', () => {
+    store.state.profile.energy = 0;
+    expect(store.canHunt('tutorial').ok).toBe(true);
+    expect(store.canHunt('weekly').ok).toBe(true);
+    expect(store.canHunt('story').ok).toBe(false);
+    expect(store.canHunt('free').ok).toBe(false);
+    store.state.flags.archive_pass = Date.now() + 1000;
+    expect(store.canHunt('free').ok).toBe(true);
+  });
+
+  it('экспорт и импорт сохранения не теряют прогресс', () => {
+    store.state.profile.xp = 777;
+    const json = store.exportJson();
+    store.hardReset();
+    expect(store.state.profile.xp).toBe(0);
+    expect(store.importJson(json)).toBe(true);
+    expect(store.state.profile.xp).toBe(777);
+  });
+
+  it('карты за ранг выдаются при повышении, карты за SIGNAL покупаются', () => {
+    expect(store.state.deck).not.toContain('protocol_noise_quarantine');
+    store.state.profile.rank = 2;
+    const granted = store.grantRankCards();
+    expect(granted).toContain('protocol_noise_quarantine');
+    expect(store.state.deck).toContain('protocol_noise_quarantine');
+
+    const purchasable = 'defense_preserve_system';
+    expect(store.state.deck).not.toContain(purchasable);
+    store.state.profile.signal = 100;
+    expect(store.buyCard(purchasable)).toBe(false);
+    store.state.profile.signal = 260;
+    expect(store.buyCard(purchasable)).toBe(true);
+    expect(store.state.deck).toContain(purchasable);
+    expect(store.state.profile.signal).toBe(0);
+  });
+
+  it('карты за вскрытую сущность приходят вместе с кодексом', () => {
+    expect(store.state.deck).not.toContain('defense_revenge');
+    store.state.codex.revenge_wraith = { entityId: 'revenge_wraith', seen: 1, revealed: true, firstSeenAt: Date.now() };
+    const granted = store.grantCodexCards();
+    expect(granted).toContain('defense_revenge');
+    expect(store.state.deck).toContain('defense_revenge');
+  });
+});
