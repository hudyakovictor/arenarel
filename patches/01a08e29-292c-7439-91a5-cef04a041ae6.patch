@@ -0,0 +1,104 @@
+/**
+ * modes — правила доступа к охотам.
+ *
+ * Логика: сюжет идёт по ступеням (tier1 → tier2 → tier3), ежедневная охота
+ * детерминирована датой, недельная — последовательность из трёх дел.
+ * Никакого Math.random в потоке охоты: только Rng с явным сидом.
+ */
+
+import { Rng, dayKey, weekKey } from './rng';
+import { SCENARIOS, scenarioById } from '../data/scenarios';
+import type { HuntMode, HuntScenario, SaveData } from './types';
+
+export const MODE_LABEL: Record<HuntMode, string> = {
+  tutorial: 'ОБУЧЕНИЕ',
+  story: 'ДЕЛО',
+  daily: 'ЕЖЕДНЕВНАЯ ОХОТА',
+  weekly: 'ДЕЛО НЕДЕЛИ',
+  free: 'АРХИВ',
+};
+
+const tier1 = () => SCENARIOS.filter((scenario) => scenario.tier === 1);
+const tier2 = () => SCENARIOS.filter((scenario) => scenario.tier === 2);
+const tier3 = () => SCENARIOS.filter((scenario) => scenario.tier === 3);
+
+/** Следующее сюжетное дело: пока не пройдены — по порядку, дальше по рангу. */
+export function nextStoryScenario(state: SaveData): HuntScenario {
+  const completed = new Set(state.history.map((record) => record.id));
+  const first = tier1().find((scenario) => !completed.has(scenario.id));
+  if (first) return first;
+
+  const rank = state.profile.rank;
+  const pool = rank <= 2 ? tier2() : [...tier2(), ...tier3()];
+  const unseen = pool.filter((scenario) => !completed.has(scenario.id));
+  if (unseen.length) return unseen[0]!;
+
+  const hunts = state.profile.hunts;
+  return pool[hunts % pool.length]!;
+}
+
+/** Ключ ежедневной охоты: одинаковый для всех игроков и не меняется в течение дня. */
+export function dailyScenarioKey(day = dayKey()): string {
+  return new Rng(`daily-pick:${day}`).pick(tier2().concat(tier3())).id;
+}
+
+export function dailyScenario(day = dayKey()): HuntScenario {
+  return scenarioById(dailyScenarioKey(day)) ?? tier2()[0]!;
+}
+
+/** Недельная последовательность: два дела tier2 и одно tier3. */
+export function weeklySequence(key = weekKey()): HuntScenario[] {
+  const rng = new Rng(`weekly:${key}`);
+  const second = rng.pick(tier2());
+  const first = rng.pick(tier2().filter((scenario) => scenario.id !== second.id));
+  const third = rng.pick(tier3());
+  return [first, second, third];
+}
+
+/** Сколько из трёх дел недели пройдено. */
+export function weeklyProgress(state: SaveData, key = weekKey()): { index: number; total: number; scenario: HuntScenario } {
+  const sequence = weeklySequence(key);
+  const storedKey = String(state.flags.weekly_key ?? '');
+  const storedIndex = storedKey === key ? Number(state.flags.weekly_index ?? 0) : 0;
+  const index = Number.isFinite(storedIndex) ? Math.max(0, Math.min(sequence.length - 1, storedIndex)) : 0;
+  return { index, total: sequence.length, scenario: sequence[index]! };
+}
+
+/** Фиксирует пройденное недельное дело. Возвращает true, если неделя закрыта. */
+export function advanceWeekly(state: SaveData, mode: HuntMode, key = weekKey()): boolean {
+  if (mode !== 'weekly') return false;
+  const { index, total } = weeklyProgress(state, key);
+  const next = index + 1;
+  state.flags.weekly_key = key;
+  state.flags.weekly_index = next;
+  if (next >= total) {
+    state.flags.weekly_done = key;
+    return true;
+  }
+  return false;
+}
+
+/** Дела, доступные в архиве: всё, что игрок уже проходил. */
+export function archiveScenarios(state: SaveData): HuntScenario[] {
+  const seen = new Set<string>();
+  const list: HuntScenario[] = [];
+  for (const record of [...state.history].reverse()) {
+    if (seen.has(record.id)) continue;
+    const scenario = scenarioById(record.id);
+    if (scenario) {
+      seen.add(record.id);
+      list.push(scenario);
+    }
+  }
+  return list;
+}
+
+/** Сколько охот открыто сегодня (лимит энергии + бесплатные режимы). */
+export function availableHunts(state: SaveData): { free: number; total: number; weeklyLeft: number } {
+  const weekly = weeklyProgress(state);
+  return {
+    free: state.profile.energy,
+    total: state.profile.energy + 2,
+    weeklyLeft: Math.max(0, weekly.total - weekly.index),
+  };
+}
diff --git a/src/core/progression.ts b/src/core/progression.ts
new file mode 100644
index 0000000..5b378d0
--- /dev/null
+++ b/src/core/progression.ts
@@ -0,0 +1,272 @@
+/**
+ * progression.ts — всё, что меняется после охоты: опыт, ранг, энергия, серия,
+ * задания, достижения и кодекс. Одна точка изменения состояния — одна правда.
+ */
+
+import type { DqiResult, HuntMode, HuntRecord, HuntScenario, PlayerProfile, QuestProgress, RiskSeal, SaveData, Seal } from './types';
+import type { DqiExplain } from './scoring';
+import { RANKS, energyForRank, rankForXp, type RankDef } from '../data/ranks';
+import { ACHIEVEMENTS, type AchievementDef } from '../data/achievements';
+import { QUESTS_BY_ID, rollDailyQuests } from '../data/quests';
+import { dayKey } from './rng';
+import { MODE_LABEL } from './modes';
+
+export interface HuntRewardInput {
+  run: {
+    scenario: Pick<HuntScenario, 'id' | 'entityId' | 'xp' | 'signal'>;
+    mode: HuntMode;
+    developedClueIds: string[];
+    protocolId: string | null;
+    risk: RiskSeal | null;
+    seal: Seal | null;
+    held: number;
+    broke: number;
+  };
+  dqi: DqiExplain;
+  mode: HuntMode;
+}
+
+export interface HuntOutcome {
+  xp: number;
+  signal: number;
+  dqi: number;
+  revealed: boolean;
+  rankUp: RankDef | null;
+  streak: number;
+  streakBonus: number;
+  questsCompleted: string[];
+  achievementsUnlocked: AchievementDef[];
+  record: HuntRecord;
+  /** Карты, открытые по итогам охоты (ранг или вскрытая сущность). */
+  grantedCards: string[];
+}
+
+const MODE_XP: Record<HuntMode, number> = {
+  tutorial: 0.5,
+  story: 1,
+  daily: 1.5,
+  weekly: 1.75,
+  free: 0.8,
+};
+
+/** Награда за охоту: множитель режима · качество решения · серия. */
+export function huntReward(scenarioXp: number, scenarioSignal: number, dqi: DqiResult, mode: HuntMode, streak: number, signalMultiplier = 1): { xp: number; signal: number; streakBonus: number } {
+  const modeMult = MODE_XP[mode];
+  const quality = 0.4 + (dqi.total / 100) * 0.9;
+  const streakMult = Math.min(1.5, 1 + 0.05 * Math.max(0, streak - 1));
+  const xp = Math.round(scenarioXp * modeMult * quality * streakMult);
+  const signal = Math.round(scenarioSignal * (0.5 + dqi.total / 100) * (mode === 'daily' ? 2 : mode === 'weekly' ? 2.2 : 1) * signalMultiplier * (mode === 'tutorial' ? 0 : 1));
+  const streakBonus = streak >= 3 ? 20 : 0;
+  return { xp: xp + streakBonus, signal, streakBonus };
+}
+
+export function dqiGrade(dqi: number): { label: string; tone: 'bad' | 'warn' | 'good' | 'gold'; text: string } {
+  if (dqi >= 85)
+    return { label: 'ЧИСТОЕ ДЕЛО', tone: 'gold', text: 'Рынок заметил. Рынок недоволен.' };
+  if (dqi >= 70)
+    return { label: 'УБЕДИТЕЛЬНО', tone: 'good', text: 'Сущность вскрыта. Протокол выдержан.' };
+  if (dqi >= 55)
+    return { label: 'ВСКРЫТИЕ', tone: 'good', text: 'Ты видел причину, а не только исход. Это редкость.' };
+  if (dqi >= 40)
+    return { label: 'СЛАБО', tone: 'warn', text: 'Формально — охота. По сути — ставка.' };
+  return { label: 'ПРОВАЛ', tone: 'bad', text: 'Продано то, что не продаётся: собственное правило.' };
+}
+
+export function huntTitleFor(mode: HuntMode): string {
+  return MODE_LABEL[mode];
+}
+
+/** Обновление серии: считается по дням, а не по числу охот. */
+export function touchStreak(profile: PlayerProfile, today = dayKey()): number {
+  if (profile.lastHuntDay !== today) {
+    const previous = profile.lastHuntDay ? new Date(`${profile.lastHuntDay}T00:00:00Z`).getTime() : 0;
+    const current = new Date(`${today}T00:00:00Z`).getTime();
+    const diffDays = previous ? Math.round((current - previous) / 86400000) : 0;
+    profile.streak = diffDays === 1 ? profile.streak + 1 : 1;
+  }
+  profile.lastHuntDay = today;
+  profile.bestStreak = Math.max(profile.bestStreak, profile.streak);
+  return profile.streak;
+}
+
+/** Энергия: обновляется по дневному ключу, докупается за SIGNAL. */
+export function refreshEnergy(profile: PlayerProfile, now = new Date()): void {
+  const today = dayKey(now);
+  const cap = energyForRank(profile.rank);
+  if (profile.energyDay !== today) {
+    profile.energyDay = today;
+    profile.energy = cap;
+  }
+  profile.energy = Math.min(profile.energy, Math.max(cap, profile.energy));
+}
+
+export const ENERGY_REFILL_COST = 120;
+
+export function energyCap(profile: PlayerProfile): number {
+  return energyForRank(profile.rank);
+}
+
+/** Ежедневные задания: прогресс двигается только результатами охот. */
+export function ensureDailyQuests(state: SaveData, now = new Date()): void {
+  const today = dayKey(now);
+  if (state.quests.day === today && state.quests.items.length > 0) return;
+  state.quests = {
+    day: today,
+    items: rollDailyQuests(today).map<QuestProgress>((quest) => ({ id: quest.id, progress: 0, done: false, claimed: false })),
+  };
+}
+
+function advanceQuests(state: SaveData, record: HuntRecord, dqi: DqiExplain, today: string): string[] {
+  ensureDailyQuests(state, new Date(`${today}T00:00:00Z`));
+  const completed: string[] = [];
+  for (const item of state.quests.items) {
+    if (item.claimed || item.done) continue;
+    const quest = QUESTS_BY_ID[item.id];
+    if (!quest) continue;
+    switch (quest.kind) {
+      case 'hunt':
+        item.progress += 1;
+        break;
+      case 'dqi':
+        if (dqi.total >= 55) item.progress += 1;
+        break;
+      case 'reveal':
+        if (dqi.revealed) item.progress += 1;
+        break;
+      case 'hold':
+        item.progress += record.held;
+        break;
+      case 'clue':
+        if (record.mode === 'daily') item.progress += 1;
+        break;
+      case 'signal':
+        item.progress += Math.max(1, Math.round(record.dqi / 20));
+        break;
+    }
+    if (item.progress >= quest.target) {
+      item.done = true;
+      completed.push(quest.id);
+    }
+  }
+  return completed;
+}
+
+export function claimQuestIn(state: SaveData, questId: string): boolean {
+  const item = state.quests.items.find((entry) => entry.id === questId);
+  const quest = QUESTS_BY_ID[questId];
+  if (!item || !quest || !item.done || item.claimed) return false;
+  item.claimed = true;
+  state.profile.xp += quest.reward.xp;
+  state.profile.signal += quest.reward.signal;
+  return true;
+}
+
+/** Достижения: уровни считаются по измеримой метрике. */
+export function evaluateAchievements(state: SaveData): AchievementDef[] {
+  const unlocked: AchievementDef[] = [];
+  for (const def of ACHIEVEMENTS) {
+    const measured = def.measure(state);
+    let level = 0;
+    for (const threshold of def.levels) {
+      if (measured >= threshold) level += 1;
+    }
+    const current = state.achievements[def.id] ?? 0;
+    if (level > current) {
+      state.achievements[def.id] = level;
+      const reward = def.reward[level - 1];
+      if (reward) {
+        state.profile.xp += reward.xp ?? 0;
+        state.profile.signal += reward.signal ?? 0;
+      }
+      unlocked.push(def);
+    }
+  }
+  return unlocked;
+}
+
+/** Единственная точка изменения состояния после охоты. */
+export function applyHuntResult(state: SaveData, input: HuntRewardInput): HuntOutcome {
+  const { run, dqi, mode } = input;
+  const profile = state.profile;
+  const now = Date.now();
+  const today = dayKey(new Date(now));
+  const rankBefore = profile.rank;
+
+  const streak = touchStreak(profile, today);
+  const reward = huntReward(run.scenario.xp, run.scenario.signal, dqi, mode, streak, dqi.signalMultiplier);
+
+  profile.xp += reward.xp;
+  profile.signal += reward.signal;
+  profile.hunts += 1;
+  profile.sumDqi += dqi.total;
+  profile.bestDqi = Math.max(profile.bestDqi, dqi.total);
+  profile.cluesDeveloped += run.developedClueIds.length;
+  profile.holds += run.held;
+  profile.breaks += run.broke;
+  if (run.protocolId) profile.cardsPlayed[run.protocolId] = (profile.cardsPlayed[run.protocolId] ?? 0) + 1;
+  if (run.seal) profile.seals[run.seal as Seal] = (profile.seals[run.seal as Seal] ?? 0) + 1;
+  if (dqi.revealed) profile.reveals += 1;
+
+  const newRank = rankForXp(profile.xp);
+  profile.rank = newRank.rank;
+  // Энергия списывается в момент входа в охоту (store.spendEnergy), не в разборе.
+  const rankUp = profile.rank > rankBefore ? newRank : null;
+
+  // Кодекс: сущность может быть вскрыта только при 55+, но встреча засчитывается всегда.
+  const entry = state.codex[run.scenario.entityId] ?? {
+    entityId: run.scenario.entityId,
+    seen: 0,
+    revealed: false,
+    firstSeenAt: now,
+  };
+  entry.seen += 1;
+  if (dqi.revealed) {
+    entry.revealed = true;
+    entry.revealedAt = entry.revealedAt ?? now;
+  }
+  state.codex[run.scenario.entityId] = entry;
+
+  const record: HuntRecord = {
+    id: run.scenario.id,
+    at: now,
+    dqi: dqi.total,
+    seal: (run.seal ?? 'wait') as Seal,
+    risk: run.risk ?? 'standard',
+    protocol: run.protocolId ?? 'none',
+    entityId: run.scenario.entityId,
+    revealed: dqi.revealed,
+    mode,
+    held: run.held,
+    broke: run.broke,
+  };
+  state.history = [...state.history.slice(-79), record];
+
+  // Сезонный опыт
+  if (state.season) state.season.xp += reward.xp;
+
+  const questsCompleted = advanceQuests(state, record, dqi, today);
+  const achievementsUnlocked = evaluateAchievements(state);
+
+  return {
+    xp: reward.xp,
+    signal: reward.signal,
+    dqi: dqi.total,
+    revealed: dqi.revealed,
+    rankUp,
+    streak,
+    streakBonus: reward.streakBonus,
+    questsCompleted,
+    achievementsUnlocked,
+    record,
+    grantedCards: [],
+  };
+}
+
+/** Человеческая подпись прогресса до следующего ранга. */
+export function rankHint(profile: PlayerProfile): string {
+  const rank = rankForXp(profile.xp);
+  const next = RANKS.find((entry) => entry.rank === rank.rank + 1);
+  if (!next) return 'Выше только легенда. Держи уровень.';
+  const left = Math.max(0, next.xp - profile.xp);
+  return `до ${next.title}: ${left} XP`;
+}
