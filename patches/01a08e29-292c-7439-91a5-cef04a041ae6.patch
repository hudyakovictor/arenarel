+++ b/src/core/audio.ts
@@ -0,0 +1,170 @@
+/**
+ * audio.ts — звук прибора.
+ *
+ * Важное решение: ни одного звукового файла. Всё синтезируется из осцилляторов,
+ * поэтому игра весит меньше, работает офлайн и звучит как аналоговый самописец,
+ * а не как стоковая библиотека.
+ */
+
+export type SfxName =
+  | 'tap'
+  | 'click'
+  | 'back'
+  | 'good'
+  | 'bad'
+  | 'seal'
+  | 'stamp'
+  | 'reveal'
+  | 'levelup'
+  | 'whisper'
+  | 'scan'
+  | 'hold'
+  | 'error'
+  | 'unlock';
+
+interface SfxDef {
+  freq: number;
+  to: number;
+  duration: number;
+  type: OscillatorType;
+  gain: number;
+  noise?: number;
+}
+
+const SFX: Record<SfxName, SfxDef> = {
+  tap: { freq: 660, to: 520, duration: 0.05, type: 'square', gain: 0.16 },
+  click: { freq: 420, to: 640, duration: 0.06, type: 'triangle', gain: 0.16 },
+  back: { freq: 380, to: 240, duration: 0.12, type: 'triangle', gain: 0.14 },
+  good: { freq: 520, to: 880, duration: 0.18, type: 'sine', gain: 0.2 },
+  bad: { freq: 220, to: 120, duration: 0.24, type: 'sawtooth', gain: 0.16, noise: 0.14 },
+  seal: { freq: 140, to: 70, duration: 0.5, type: 'sawtooth', gain: 0.22, noise: 0.3 },
+  stamp: { freq: 90, to: 60, duration: 0.18, type: 'square', gain: 0.26, noise: 0.4 },
+  reveal: { freq: 300, to: 1500, duration: 0.5, type: 'sine', gain: 0.16 },
+  levelup: { freq: 440, to: 1320, duration: 0.6, type: 'triangle', gain: 0.2 },
+  whisper: { freq: 180, to: 320, duration: 0.35, type: 'sine', gain: 0.12, noise: 0.18 },
+  scan: { freq: 900, to: 1200, duration: 0.14, type: 'square', gain: 0.1 },
+  hold: { freq: 300, to: 300, duration: 0.1, type: 'square', gain: 0.1 },
+  error: { freq: 160, to: 160, duration: 0.3, type: 'square', gain: 0.16 },
+  unlock: { freq: 600, to: 900, duration: 0.35, type: 'triangle', gain: 0.18 },
+};
+
+class AudioEngine {
+  private ctx: AudioContext | null = null;
+  private master: GainNode | null = null;
+  private ambientGain: GainNode | null = null;
+  private ambient: OscillatorNode[] = [];
+  private unlocked = false;
+  private volume = 0.8;
+  private musicVolume = 0.45;
+  private supported = true;
+
+  constructor() {
+    if (typeof window === 'undefined') this.supported = false;
+  }
+
+  /** Первый жест пользователя — единственный способ получить звук в браузере. */
+  unlock(): void {
+    if (!this.supported) return;
+    try {
+      if (!this.ctx) {
+        const Ctor = window.AudioContext ?? (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
+        if (!Ctor) {
+          this.supported = false;
+          return;
+        }
+        this.ctx = new Ctor();
+        this.master = this.ctx.createGain();
+        this.master.gain.value = this.volume;
+        this.master.connect(this.ctx.destination);
+      }
+      if (this.ctx.state === 'suspended') void this.ctx.resume();
+      this.unlocked = true;
+    } catch {
+      this.supported = false;
+    }
+  }
+
+  setVolumes(sound: number, music: number): void {
+    this.volume = Math.max(0, Math.min(1, sound));
+    this.musicVolume = Math.max(0, Math.min(1, music));
+    if (this.master) this.master.gain.value = this.volume;
+    if (this.ambientGain) this.ambientGain.gain.value = this.musicVolume * 0.08;
+  }
+
+  play(name: SfxName | string): void {
+    if (!this.supported || !this.unlocked || !this.ctx || !this.master) return;
+    const def = SFX[name as SfxName];
+    if (!def) return;
+    try {
+      const now = this.ctx.currentTime;
+      const osc = this.ctx.createOscillator();
+      const gain = this.ctx.createGain();
+      osc.type = def.type;
+      osc.frequency.setValueAtTime(def.freq, now);
+      osc.frequency.exponentialRampToValueAtTime(Math.max(30, def.to), now + def.duration);
+      gain.gain.setValueAtTime(0.0001, now);
+      gain.gain.exponentialRampToValueAtTime(Math.max(0.0002, def.gain), now + 0.012);
+      gain.gain.exponentialRampToValueAtTime(0.0001, now + def.duration);
+      osc.connect(gain);
+      gain.connect(this.master);
+      osc.start(now);
+      osc.stop(now + def.duration + 0.05);
+
+      if (def.noise) {
+        const noise = this.ctx.createBufferSource();
+        const buffer = this.ctx.createBuffer(1, Math.floor(this.ctx.sampleRate * def.duration), this.ctx.sampleRate);
+        const channel = buffer.getChannelData(0);
+        for (let index = 0; index < channel.length; index += 1) {
+          channel[index] = (Math.random() * 2 - 1) * (1 - index / channel.length);
+        }
+        noise.buffer = buffer;
+        const noiseGain = this.ctx.createGain();
+        noiseGain.gain.value = def.noise * this.volume;
+        noise.connect(noiseGain);
+        noiseGain.connect(this.master);
+        noise.start(now);
+      }
+    } catch {
+      // звук — не повод ломать охоту
+    }
+  }
+
+  /** Фоновый гул приёмника: две расстроенные синусоиды и медленная пульсация. */
+  startAmbient(): void {
+    if (!this.supported || !this.unlocked || !this.ctx || !this.master || this.ambient.length) return;
+    try {
+      this.ambientGain = this.ctx.createGain();
+      this.ambientGain.gain.value = this.musicVolume * 0.08;
+      const filter = this.ctx.createBiquadFilter();
+      filter.type = 'lowpass';
+      filter.frequency.value = 320;
+      for (const freq of [55, 55.6, 82.5]) {
+        const osc = this.ctx.createOscillator();
+        osc.type = 'sine';
+        osc.frequency.value = freq;
+        osc.connect(filter);
+        osc.start();
+        this.ambient.push(osc);
+      }
+      filter.connect(this.ambientGain);
+      this.ambientGain.connect(this.master);
+    } catch {
+      // тишина допустима
+    }
+  }
+
+  stopAmbient(): void {
+    for (const osc of this.ambient) {
+      try {
+        osc.stop();
+      } catch {
+        // уже остановлен
+      }
+    }
+    this.ambient = [];
+    this.ambientGain?.disconnect();
+    this.ambientGain = null;
+  }
+}
+
+export const audio = new AudioEngine();
