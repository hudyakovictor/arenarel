+/**
+ * quests.ts — ежедневные задания. Ровно три, без бесконечных списков:
+ * интерфейс не должен превращаться в бухгалтерию.
+ */
+
+import type { QuestDef } from '../core/types';
+import { Rng } from '../core/rng';
+
+export const QUESTS: QuestDef[] = [
+  { id: 'q_hunt_2', kind: 'hunt', title: 'Провести 2 охоты', target: 2, reward: { xp: 60, signal: 40 } },
+  { id: 'q_hunt_3', kind: 'hunt', title: 'Провести 3 охоты', target: 3, reward: { xp: 90, signal: 60 } },
+  { id: 'q_dqi_55', kind: 'dqi', title: 'Качество решения 55+', target: 1, reward: { xp: 70, signal: 50 } },
+  { id: 'q_dqi_70', kind: 'dqi', title: 'Качество решения 70+', target: 1, reward: { xp: 120, signal: 80 } },
+  { id: 'q_reveal_1', kind: 'reveal', title: 'Вскрыть сущность', target: 1, reward: { xp: 110, signal: 70 } },
+  { id: 'q_reveal_2', kind: 'reveal', title: 'Вскрыть 2 сущности', target: 2, reward: { xp: 180, signal: 120 } },
+  { id: 'q_hold_6', kind: 'hold', title: 'Выдержать 6 атак шума', target: 6, reward: { xp: 80, signal: 55 } },
+  { id: 'q_hold_9', kind: 'hold', title: 'Выдержать 9 атак шума', target: 9, reward: { xp: 130, signal: 90 } },
+  { id: 'q_clue_daily', kind: 'clue', title: 'Сыграть ежедневную охоту', target: 1, reward: { xp: 140, signal: 100 } },
+  { id: 'q_signal_3', kind: 'signal', title: 'Заработать 3 SIGNAL-печати', target: 3, reward: { xp: 50, signal: 35 } },
+];
+
+export const QUESTS_BY_ID: Record<string, QuestDef> = Object.fromEntries(QUESTS.map((q) => [q.id, q]));
+
+/** Три задания на день, одинаковые для всех игроков (детерминированно по дате). */
+export function rollDailyQuests(day: string): QuestDef[] {
+  const rng = new Rng(`quests:${day}`);
+  const pool = rng.shuffle(QUESTS);
+  const picked: QuestDef[] = [];
+  const usedKinds = new Set<string>();
+  for (const q of pool) {
+    if (picked.length >= 3) break;
+    if (usedKinds.has(q.kind)) continue;
+    usedKinds.add(q.kind);
+    picked.push(q);
+  }
+  const fallback = pool.filter((q) => !picked.includes(q));
+  while (picked.length < 3 && fallback.length) picked.push(fallback.shift()!);
+  return picked.slice(0, 3);
+}
