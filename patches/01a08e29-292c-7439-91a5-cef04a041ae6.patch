+/**
+ * icons.ts — векторные иконки, нарисованные кодом.
+ * Никаких иконочных шрифтов: одинаковый вид на всех платформах, полный контроль над толщиной линий.
+ */
+
+import Phaser from 'phaser';
+import { COLORS } from '../game/theme';
+
+export type IconKind =
+  | 'target'
+  | 'book'
+  | 'cards'
+  | 'profile'
+  | 'gear'
+  | 'flame'
+  | 'bolt'
+  | 'coin'
+  | 'lock'
+  | 'clock'
+  | 'chevron'
+  | 'seal'
+  | 'scan'
+  | 'energy'
+  | 'signal'
+  | 'check'
+  | 'cross'
+  | 'hourglass'
+  | 'arrow-right';
+
+export function icon(
+  scene: Phaser.Scene,
+  kind: IconKind,
+  size = 20,
+  color: number = COLORS.cyan,
+  thickness = 2,
+): Phaser.GameObjects.Container {
+  const container = scene.add.container(0, 0);
+  const g = scene.add.graphics();
+  g.lineStyle(thickness, color, 1);
+  g.fillStyle(color, 1);
+  const s = size / 2;
+
+  switch (kind) {
+    case 'target':
+      g.strokeCircle(0, 0, s);
+      g.strokeCircle(0, 0, s * 0.45);
+      g.lineBetween(-s * 1.25, 0, -s * 0.6, 0);
+      g.lineBetween(s * 0.6, 0, s * 1.25, 0);
+      g.lineBetween(0, -s * 1.25, 0, -s * 0.6);
+      g.lineBetween(0, s * 0.6, 0, s * 1.25);
+      break;
+    case 'book':
+      g.strokeRoundedRect(-s, -s * 0.85, size, size * 0.9, 3);
+      g.lineBetween(-s * 0.45, -s * 0.85, -s * 0.45, s * 0.9);
+      g.lineBetween(-s * 0.2, -s * 0.3, s * 0.7, -s * 0.3);
+      g.lineBetween(-s * 0.2, s * 0.1, s * 0.7, s * 0.1);
+      break;
+    case 'cards':
+      g.strokeRoundedRect(-s * 0.85, -s * 0.8, size * 0.62, size * 0.95, 3);
+      g.strokeRoundedRect(-s * 0.35, -s * 0.55, size * 0.62, size * 0.95, 3);
+      break;
+    case 'profile':
+      g.strokeCircle(0, -s * 0.35, s * 0.42);
+      g.beginPath();
+      g.arc(0, s * 0.95, s * 0.78, Math.PI * 1.15, Math.PI * 1.85);
+      g.strokePath();
+      break;
+    case 'gear':
+      g.strokeCircle(0, 0, s * 0.55);
+      for (let i = 0; i < 8; i++) {
+        const a = (i / 8) * Math.PI * 2;
+        g.lineBetween(Math.cos(a) * s * 0.75, Math.sin(a) * s * 0.75, Math.cos(a) * s, Math.sin(a) * s);
+      }
+      break;
+    case 'flame':
+      g.beginPath();
+      g.moveTo(0, -s);
+      g.lineTo(s * 0.7, s * 0.35);
+      g.lineTo(0, s);
+      g.lineTo(-s * 0.7, s * 0.35);
+      g.closePath();
+      g.strokePath();
+      break;
+    case 'bolt':
+      g.beginPath();
+      g.moveTo(-s * 0.3, -s);
+      g.lineTo(s * 0.35, -s * 0.15);
+      g.lineTo(-s * 0.1, -s * 0.1);
+      g.lineTo(s * 0.3, s);
+      g.lineTo(-s * 0.4, s * 0.1);
+      g.lineTo(0, s * 0.05);
+      g.closePath();
+      g.fillPath();
+      break;
+    case 'coin':
+      g.strokeCircle(0, 0, s);
+      g.strokeCircle(0, 0, s * 0.6);
+      break;
+    case 'lock':
+      g.strokeRoundedRect(-s * 0.75, -s * 0.1, size * 0.75, size * 0.6, 3);
+      g.beginPath();
+      g.arc(0, -s * 0.1, s * 0.42, Math.PI, 0);
+      g.strokePath();
+      break;
+    case 'clock':
+      g.strokeCircle(0, 0, s);
+      g.lineBetween(0, 0, 0, -s * 0.6);
+      g.lineBetween(0, 0, s * 0.45, s * 0.25);
+      break;
+    case 'chevron':
+      g.beginPath();
+      g.moveTo(s * 0.5, -s * 0.6);
+      g.lineTo(-s * 0.3, 0);
+      g.lineTo(s * 0.5, s * 0.6);
+      g.strokePath();
+      break;
+    case 'arrow-right':
+      g.lineBetween(-s * 0.8, 0, s * 0.6, 0);
+      g.lineBetween(s * 0.15, -s * 0.45, s * 0.6, 0);
+      g.lineBetween(s * 0.15, s * 0.45, s * 0.6, 0);
+      break;
+    case 'seal':
+      g.strokeCircle(0, 0, s);
+      g.strokeCircle(0, 0, s * 0.66);
+      g.lineBetween(-s * 0.66, 0, s * 0.66, 0);
+      break;
+    case 'scan':
+      g.strokeCircle(-s * 0.2, -s * 0.2, s * 0.72);
+      g.lineBetween(s * 0.35, s * 0.35, s * 1.05, s * 1.05);
+      break;
+    case 'energy':
+      g.strokeRoundedRect(-s * 0.5, -s * 0.95, size * 0.5, size * 0.95, 2);
+      g.fillRect(-s * 0.25, -s * 0.2, size * 0.26, size * 0.55);
+      break;
+    case 'signal':
+      for (let i = 0; i < 4; i++) {
+        const x = -s + i * (size / 4) * 0.9;
+        const h = (i + 1) / 4;
+        g.lineBetween(x, s * 0.8, x, s * 0.8 - size * h * 0.9);
+      }
+      break;
+    case 'check':
+      g.beginPath();
+      g.moveTo(-s * 0.75, 0);
+      g.lineTo(-s * 0.1, s * 0.6);
+      g.lineTo(s * 0.8, -s * 0.6);
+      g.strokePath();
+      break;
+    case 'cross':
+      g.lineBetween(-s * 0.7, -s * 0.7, s * 0.7, s * 0.7);
+      g.lineBetween(s * 0.7, -s * 0.7, -s * 0.7, s * 0.7);
+      break;
+    case 'hourglass':
+      g.beginPath();
+      g.moveTo(-s * 0.7, -s * 0.9);
+      g.lineTo(s * 0.7, -s * 0.9);
+      g.lineTo(-s * 0.7, s * 0.9);
+      g.lineTo(s * 0.7, s * 0.9);
+      g.closePath();
+      g.strokePath();
+      break;
+  }
+
+  container.add(g);
+  return container;
+}
