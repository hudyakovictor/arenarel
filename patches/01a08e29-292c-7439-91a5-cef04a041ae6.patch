@@ -0,0 +1,322 @@
+/**
+ * CodexScene — кодекс охотника: сущности, архив улик, счётчики.
+ * Пустой кодекс — половина игры. Здесь закрываются имена.
+ */
+
+import Phaser from 'phaser';
+import { BaseScene } from './BaseScene';
+import { button, chip, heading, panel, paragraph } from '../../ui/kit';
+import { bottomNav, pager, topBar } from '../../ui/parts';
+import { icon } from '../../ui/icons';
+import { COLORS, CSS, FONT } from '../theme';
+import { CENTER, DEPTH } from '../design';
+import { store } from '../../core/store';
+import { ENTITIES, entityById, type EntityDef } from '../../data/entities';
+import { CLUES_BY_ID, CLUE_KIND_LABEL } from '../../data/clues';
+import { scenarioById } from '../../data/scenarios';
+import type { Clue, HuntRecord } from '../../core/types';
+import { cardById } from '../../data/cards';
+
+
+type Tab = 'entities' | 'clues';
+
+const TABS: { key: Tab; label: string }[] = [
+  { key: 'entities', label: 'СУЩНОСТИ' },
+  { key: 'clues', label: 'УЛИКИ' },
+];
+
+type ClueKind = Clue['kind'];
+const CLUE_KINDS: ClueKind[] = ['structure', 'volume', 'crowd', 'news', 'risk'];
+
+function cardName(id: string): string {
+  return cardById(id)?.name ?? id;
+}
+
+export class CodexScene extends BaseScene {
+
+  constructor() {
+    super('codex');
+  }
+  private tab: Tab = 'entities';
+  private page = 0;
+  private content?: Phaser.GameObjects.Container;
+
+  protected override accent(): number {
+    return COLORS.purple;
+  }
+
+  protected override build(): void {
+    this.fadeInCamera();
+    topBar(this);
+    bottomNav(this, 'codex');
+    this.content = this.add.container(0, 0).setDepth(DEPTH.content);
+    this.onCleanup(store.subscribe(() => this.render()));
+    this.render();
+  }
+
+  private render(): void {
+    const root = this.content;
+    if (!root) return;
+    root.removeAll(true);
+    this.renderTabs(root);
+    if (this.tab === 'entities') this.renderEntities(root);
+    else this.renderClues(root);
+  }
+
+  private renderTabs(root: Phaser.GameObjects.Container): void {
+    const width = this.scale.width;
+    const y = 96;
+    TABS.forEach((tab, index) => {
+      const w = (width - 40) / TABS.length;
+      const x = 20 + w * index + w / 2;
+      const active = this.tab === tab.key;
+      const bg = this.add.rectangle(x, y, w - 8, 36, active ? COLORS.card2 : COLORS.bg2, active ? 1 : 0.7).setStrokeStyle(1.2, active ? COLORS.purple : COLORS.line, active ? 0.7 : 0.2);
+      const label = this.add
+        .text(x, y, tab.label, { fontFamily: FONT.ui, fontSize: '11px', color: active ? CSS.text : CSS.dim, fontStyle: '700' })
+        .setOrigin(0.5);
+      bg.setInteractive({ useHandCursor: true });
+      bg.on('pointerup', () => {
+        if (this.tab === tab.key) return;
+        this.tab = tab.key;
+        this.render();
+      });
+      root!.add([bg, label]);
+    });
+  }
+
+  private revealedEntities(): EntityDef[] {
+    return Object.values(store.state.codex)
+      .filter((entry) => entry.revealed)
+      .map((entry) => entityById(entry.entityId))
+      .filter((entity): entity is EntityDef => Boolean(entity));
+  }
+
+  private renderEntities(root: Phaser.GameObjects.Container): void {
+    const width = this.scale.width;
+    const revealed = this.revealedEntities();
+    const header = heading(this, CENTER.x, 142, `ВСКРЫТО ${revealed.length} / ${ENTITIES.length}`, { size: 10, color: COLORS.muted, align: 'center' });
+    root!.add(header);
+
+    const columns = 3;
+    const rowsPerPage = 2;
+    const perPage = columns * rowsPerPage;
+    const cardW = (width - 32 - (columns - 1) * 10) / columns;
+    const cardH = cardW + 34;
+    const pages = Math.max(1, Math.ceil(ENTITIES.length / perPage));
+    if (this.page >= pages) this.page = pages - 1;
+    ENTITIES.slice(this.page * perPage, (this.page + 1) * perPage).forEach((entity, index) => {
+      const entry = store.state.codex[entity.id];
+      const isRevealed = Boolean(entry?.revealed);
+      const col = index % columns;
+      const rowIndex = Math.floor(index / columns);
+      const x = 16 + cardW / 2 + col * (cardW + 10);
+      const y = 196 + rowIndex * (cardH + 12) + cardH / 2;
+      const tile = panel(this, {
+        x,
+        y,
+        w: cardW,
+        h: cardH,
+        radius: 14,
+        fill: isRevealed ? COLORS.card2 : COLORS.bg2,
+        fillAlpha: isRevealed ? 0.95 : 0.7,
+        stroke: isRevealed ? entity.color : COLORS.line,
+        strokeAlpha: isRevealed ? 0.6 : 0.16,
+      });
+
+      const art = this.add
+        .image(0, -12, entity.art)
+        .setDisplaySize(cardW - 24, cardW - 24)
+        .setAlpha(isRevealed ? 1 : 0.28)
+        .setTint(isRevealed ? 0xffffff : 0x000000);
+      const name = this.add
+        .text(0, cardH / 2 - 18, isRevealed ? entity.name : '???', {
+          fontFamily: FONT.ui,
+          fontSize: '9px',
+          color: isRevealed ? CSS.text : CSS.dim,
+          fontStyle: '700',
+          align: 'center',
+          wordWrap: { width: cardW - 12 },
+        })
+        .setOrigin(0.5);
+      const lock = isRevealed
+        ? null
+        : icon(this, 'lock', 14, COLORS.dim, 2).setPosition(cardW / 2 - 16, cardH / 2 - 16);
+      tile.add([art, name]);
+      if (lock) tile.add(lock);
+      tile.setInteractive(new Phaser.Geom.Rectangle(-cardW / 2, -cardH / 2, cardW, cardH), Phaser.Geom.Rectangle.Contains);
+      tile.on('pointerup', () => {
+        if (entry?.revealed) this.openEntity(entity);
+      });
+      root!.add(tile);
+    });
+
+    const pagerY = 196 + rowsPerPage * (cardH + 12) + 4;
+    root!.add(
+      pager(this, {
+        x: CENTER.x,
+        y: pagerY,
+        page: this.page,
+        pages,
+        color: COLORS.purple,
+        onChange: (page) => {
+          this.page = page;
+          this.render();
+        },
+      }),
+    );
+  }
+
+  private openEntity(entity: EntityDef): void {
+    if (this.dialogOpen) return;
+    this.dialogOpen = true;
+    const width = this.scale.width;
+    const veil = this.add.rectangle(CENTER.x, CENTER.y, width, this.scale.height, 0x000000, 0.72).setDepth(DEPTH.dialog).setInteractive();
+    const sheet = this.add.container(CENTER.x, CENTER.y).setDepth(DEPTH.dialog + 1);
+    const body = panel(this, {
+      x: 0,
+      y: 0,
+      w: width - 40,
+      h: 480,
+      fill: COLORS.card,
+      glow: entity.color,
+      glowAlpha: 0.18,
+      stroke: entity.color,
+      strokeAlpha: 0.5,
+    });
+    const art = this.add.image(0, -150, entity.art).setDisplaySize(132, 132);
+    const ring = this.add.circle(0, -150, 74, 0x000000, 0).setStrokeStyle(1.6, entity.color, 0.75);
+    const name = this.add
+      .text(0, -66, entity.name, { fontFamily: FONT.display, fontSize: '18px', color: CSS.text, align: 'center' })
+      .setOrigin(0.5);
+    const cls = chip(this, 0, -42, entity.code, entity.color, { fontSize: 9 });
+    const severity = this.add
+      .text(0, -18, `УГРОЗА ${entity.threat}/5 · ${entity.rank === 'major' ? 'КРУПНАЯ' : 'МЕЛКАЯ'}`, {
+        fontFamily: FONT.mono,
+        fontSize: '10px',
+        color: CSS.dim,
+      })
+      .setOrigin(0.5);
+    const story = this.add.text(-(width - 40) / 2 + 22, 6, entity.lore, {
+      fontFamily: FONT.ui,
+      fontSize: '10px',
+      color: CSS.muted,
+      wordWrap: { width: width - 84, useAdvancedWrap: true },
+      lineSpacing: 4,
+    });
+    const tell = this.add.text(-(width - 40) / 2 + 22, 96, `ПРИЗНАКИ\n${entity.symptoms.map((s) => `• ${s}`).join('\n')}`, {
+      fontFamily: FONT.ui,
+      fontSize: '10px',
+      color: CSS.cyan,
+      wordWrap: { width: width - 84, useAdvancedWrap: true },
+      lineSpacing: 4,
+    });
+    const counter = this.add.text(-(width - 40) / 2 + 22, 172, `ПРОТИВОЯДИЕ · ${cardName(entity.weakness)}\nКОРМИТ · ${cardName(entity.feedsOn)}`, {
+      fontFamily: FONT.ui,
+      fontSize: '10px',
+      color: CSS.gold,
+      wordWrap: { width: width - 84, useAdvancedWrap: true },
+      lineSpacing: 4,
+    });
+    body.add([art, ring, name, cls.container, severity, story, tell, counter]);
+    sheet.add(body);
+
+    const close = button(this, {
+      x: 0,
+      y: 196,
+      w: width - 100,
+      h: 48,
+      text: 'ЗАКРЫТЬ',
+      variant: 'soft',
+      onTap: () => dismiss(),
+    });
+    sheet.add(close.container);
+
+    const dismiss = (): void => {
+      veil.destroy();
+      sheet.destroy(true);
+      this.dialogOpen = false;
+    };
+    veil.on('pointerup', dismiss);
+    this.animateIn([body], 0, 20);
+  }
+
+  private dialogOpen = false;
+
+  private renderClues(root: Phaser.GameObjects.Container): void {
+    const width = this.scale.width;
+    const history = store.state.history;
+    const seen = new Set<string>();
+    if (history.length) {
+      // Улики, затронутые в охоте, помечаются как «прочитанные»
+      for (const record of history) {
+        const scenarioClues = clueIdsForHunt(record);
+        scenarioClues.forEach((id) => seen.add(id));
+      }
+    }
+    const header = heading(this, CENTER.x, 142, `АРХИВ УЛИК · ${seen.size} ЗАМЕЧЕНО`, { size: 10, color: COLORS.muted, align: 'center' });
+    root!.add(header);
+
+    let y = 176;
+    CLUE_KINDS.forEach((kind) => {
+      const all = Object.values(CLUES_BY_ID).filter((clue) => clue.kind === kind);
+      const found = all.filter((clue) => seen.has(clue.id));
+      const color = clueColor(kind);
+      const bar = panel(this, { x: CENTER.x, y: y + 34, w: width - 36, h: 68, radius: 14, fill: COLORS.bg2, fillAlpha: 0.8 });
+      const label = this.add.text(-(width - 36) / 2 + 16, -12, CLUE_KIND_LABEL[kind], {
+        fontFamily: FONT.ui,
+        fontSize: '11px',
+        color: `#${color.toString(16).padStart(6, '0')}`,
+        fontStyle: '700',
+      });
+      const count = this.add
+        .text((width - 36) / 2 - 16, -12, `${found.length} / ${all.length}`, { fontFamily: FONT.mono, fontSize: '11px', color: CSS.text })
+        .setOrigin(1, 0);
+      const barBg = this.add.rectangle(-(width - 36) / 2 + 16, 14, width - 68, 6, 0x0a1330, 1).setOrigin(0, 0.5);
+      const barFill = this.add
+        .rectangle(-(width - 36) / 2 + 16, 14, Math.max(3, ((width - 68) * found.length) / Math.max(1, all.length)), 6, color, 1)
+        .setOrigin(0, 0.5);
+      const sample = found.length
+        ? this.add.text(-(width - 36) / 2 + 16, 26, `последняя: ${found[found.length - 1]!.text}`, {
+            fontFamily: FONT.ui,
+            fontSize: '8px',
+            color: CSS.dim,
+            wordWrap: { width: width - 68, useAdvancedWrap: true },
+          })
+        : this.add.text(-(width - 36) / 2 + 16, 26, 'нет данных', { fontFamily: FONT.ui, fontSize: '8px', color: CSS.dim });
+      bar.add([label, count, barBg, barFill, sample]);
+      root!.add(bar);
+      y += 78;
+    });
+
+    const note = paragraph(this, CENTER.x, y + 6, 'Улика считается замеченной, когда она открыта в охоте. Всего 50.', {
+      size: 9,
+      color: COLORS.dim,
+      align: 'center',
+      width: width - 60,
+    });
+    note.setOrigin(0.5, 0);
+    root!.add(note);
+  }
+
+}
+
+function clueColor(kind: ClueKind): number {
+  switch (kind) {
+    case 'structure':
+      return COLORS.cyan;
+    case 'volume':
+      return COLORS.green;
+    case 'crowd':
+      return COLORS.gold;
+    case 'news':
+      return COLORS.orange;
+    case 'risk':
+      return COLORS.red;
+    default:
+      return COLORS.muted;
+  }
+}
+
+function clueIdsForHunt(record: HuntRecord): string[] {
+  return scenarioById(record.id)?.clueIds ?? [];
+}
