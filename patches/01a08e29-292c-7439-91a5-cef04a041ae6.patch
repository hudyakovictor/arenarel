+/**
+ * ranks.ts — пять рангов охотника. Ранг открывает карты, режимы и одну лишнюю охоту в день.
+ */
+
+export interface RankDef {
+  rank: number;
+  id: string;
+  title: string;
+  xp: number;
+  tagline: string;
+  perk: string;
+  color: number;
+}
+
+export const RANKS: RankDef[] = [
+  {
+    rank: 1,
+    id: 'novice',
+    title: 'НОВИЧОК',
+    xp: 0,
+    tagline: 'Рынок ещё не знает твоего имени. Это ненадолго.',
+    perk: '5 охот в день',
+    color: 0x8fa1c0,
+  },
+  {
+    rank: 2,
+    id: 'hunter',
+    title: 'ОХОТНИК',
+    xp: 450,
+    tagline: 'Ты научился отличать сигнал от шума. Иногда.',
+    perk: '+1 слот колоды, 6 охот в день',
+    color: 0x22d8f5,
+  },
+  {
+    rank: 3,
+    id: 'analyst',
+    title: 'АНАЛИТИК',
+    xp: 1400,
+    tagline: 'Ты читаешь не график, а намерения тех, кто его рисует.',
+    perk: 'Карты чтения II уровня, 7 охот в день',
+    color: 0x34d399,
+  },
+  {
+    rank: 4,
+    id: 'strategist',
+    title: 'СТРАТЕГ',
+    xp: 3200,
+    tagline: 'Ты знаешь, что лучшая сделка — та, которую не открыл.',
+    perk: 'Карты решения II уровня, 8 охот в день',
+    color: 0xf5c044,
+  },
+  {
+    rank: 5,
+    id: 'legend',
+    title: 'ЛЕГЕНДА АРЕНЫ',
+    xp: 6800,
+    tagline: 'Сущности узнают тебя и прячутся первыми.',
+    perk: 'Рейдовые охоты, безлимит охот, золотая рамка кодекса',
+    color: 0xb388ff,
+  },
+];
+
+export function rankForXp(xp: number): RankDef {
+  let current = RANKS[0]!;
+  for (const r of RANKS) if (xp >= r.xp) current = r;
+  return current;
+}
+
+export function nextRank(rank: number): RankDef | null {
+  return RANKS.find((r) => r.rank === rank + 1) ?? null;
+}
+
+/** Прогресс до следующего звания, 0..1. */
+export function rankProgress(xp: number): number {
+  const current = rankForXp(xp);
+  const next = nextRank(current.rank);
+  if (!next) return 1;
+  const span = next.xp - current.xp;
+  return span <= 0 ? 1 : Math.max(0, Math.min(1, (xp - current.xp) / span));
+}
+
+/** Сколько охот в день доступно на ранге. */
+export function energyForRank(rank: number): number {
+  return 4 + rank;
+}
