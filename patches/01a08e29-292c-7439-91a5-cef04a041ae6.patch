+/**
+ * DeckScene — колода охотника: 33 протокола, рука из четырёх карт.
+ * Карты не покупают прибыль. Они меняют то, как оценивается твоё решение.
+ */
+
+import Phaser from 'phaser';
+import { BaseScene } from './BaseScene';
+import { button, cardTile, chip, heading, paragraph, toast } from '../../ui/kit';
+import { bottomNav, pager, topBar } from '../../ui/parts';
+import { icon } from '../../ui/icons';
+import { COLORS, CSS, EASE, FONT } from '../theme';
+import { CENTER, DEPTH, SAFE } from '../design';
+import { store } from '../../core/store';
+import { CARDS, CARDS_BY_ID, CARD_CLASS_COLOR, CARD_CLASS_LABEL, type CardDef } from '../../data/cards';
+
+const CARDS_PER_HAND = 4;
+const ROWS_PER_PAGE = 5;
+import type { CardClass } from '../../core/types';
+
+type Filter = 'all' | CardClass;
+
+const FILTERS: { key: Filter; label: string }[] = [
+  { key: 'all', label: 'ВСЕ' },
+  { key: 'reading', label: CARD_CLASS_LABEL.reading },
+  { key: 'defense', label: CARD_CLASS_LABEL.defense },
+  { key: 'decision', label: CARD_CLASS_LABEL.decision },
+  { key: 'protocol', label: CARD_CLASS_LABEL.protocol },
+];
+
+export class DeckScene extends BaseScene {
+
+  constructor() {
+    super('deck');
+  }
+  private filter: Filter = 'all';
+  private page = 0;
+  private content?: Phaser.GameObjects.Container;
+
+  protected override accent(): number {
+    return COLORS.gold;
+  }
+
+  protected override build(): void {
+    topBar(this);
+    bottomNav(this, 'deck');
+    this.content = this.add.container(0, 0).setDepth(DEPTH.content);
+    this.onCleanup(store.subscribe(() => this.render()));
+    this.render();
+    this.fadeInCamera();
+  }
+
+  private owned(card: CardDef): boolean {
+    return store.state.deck.includes(card.id) || store.state.hand.includes(card.id);
+  }
+
+  private render(): void {
+    const root = this.content;
+    if (!root) return;
+    root.removeAll(true);
+    this.renderHeader(root);
+    this.renderFilters(root);
+    this.renderList(root);
+    this.renderHand(root);
+  }
+
+  private renderHeader(root: Phaser.GameObjects.Container): void {
+    const width = this.scale.width;
+    const ownedCount = CARDS.filter((card) => this.owned(card)).length;
+    const title = heading(this, SAFE.left, 92, 'КОЛОДА', { size: 13, color: COLORS.text });
+    const sub = paragraph(this, SAFE.left, 110, `открыто ${ownedCount} / ${CARDS.length} · в руке ${store.state.hand.length} / ${CARDS_PER_HAND}`, {
+      size: 9,
+      color: COLORS.dim,
+      width: width - 40,
+    });
+    sub.setOrigin(0, 0);
+    root!.add([title, sub]);
+  }
+
+  private renderFilters(root: Phaser.GameObjects.Container): void {
+    const width = this.scale.width;
+    const y = 168;
+    const gap = 6;
+    const w = (width - 32 - gap * (FILTERS.length - 1)) / FILTERS.length;
+    FILTERS.forEach((filter, index) => {
+      const x = 16 + w * index + w / 2 + gap * index;
+      const active = this.filter === filter.key;
+      const color = filter.key === 'all' ? COLORS.gold : CARD_CLASS_COLOR[filter.key as CardClass];
+      const bg = this.add.rectangle(x, y, w, 30, active ? COLORS.card2 : COLORS.bg2, active ? 1 : 0.7).setStrokeStyle(1, active ? color : COLORS.line, active ? 0.7 : 0.18);
+      const label = this.add
+        .text(x, y, filter.label, { fontFamily: FONT.ui, fontSize: '8px', color: active ? CSS.text : CSS.dim, fontStyle: '700' })
+        .setOrigin(0.5);
+      bg.setInteractive({ useHandCursor: true });
+      bg.on('pointerup', () => {
+        if (this.filter === filter.key) return;
+        this.filter = filter.key;
+        this.page = 0;
+        this.render();
+      });
+      root!.add([bg, label]);
+    });
+  }
+
+  private renderList(root: Phaser.GameObjects.Container): void {
+    const width = this.scale.width;
+    const list = CARDS.filter((card) => this.filter === 'all' || card.cardClass === this.filter);
+    const top = 244;
+    const rowH = 66;
+    const pages = Math.max(1, Math.ceil(list.length / ROWS_PER_PAGE));
+    if (this.page >= pages) this.page = pages - 1;
+    const slice = list.slice(this.page * ROWS_PER_PAGE, (this.page + 1) * ROWS_PER_PAGE);
+
+    slice.forEach((card, index) => {
+      const owned = this.owned(card);
+      const inHand = store.state.hand.includes(card.id);
+      const y = top + index * (rowH + 8) + rowH / 2;
+      const w = width - 32;
+      const color = CARD_CLASS_COLOR[card.cardClass];
+      const row = this.add.container(16 + w / 2, y);
+      const bg = this.add
+        .rectangle(0, 0, w, rowH, owned ? COLORS.card : COLORS.bg2, owned ? 0.88 : 0.62)
+        .setStrokeStyle(inHand ? 1.6 : 1, inHand ? color : COLORS.line, inHand ? 0.8 : 0.16);
+      const stripe = this.add.rectangle(-w / 2 + 3, 0, 5, rowH - 14, color, owned ? 0.9 : 0.25);
+      const name = this.add.text(-w / 2 + 18, -22, card.name, { fontFamily: FONT.ui, fontSize: '11px', color: owned ? CSS.text : CSS.dim, fontStyle: '700' });
+      const cls = this.add.text(-w / 2 + 18, -6, `${CARD_CLASS_LABEL[card.cardClass]}${card.unlock && !owned ? ` · ${unlockText(card)}` : ''}`, {
+        fontFamily: FONT.ui,
+        fontSize: '8px',
+        color: CSS.dim,
+      });
+      const effect = this.add.text(-w / 2 + 18, 8, card.text, {
+        fontFamily: FONT.ui,
+        fontSize: '8px',
+        color: owned ? CSS.muted : CSS.dim,
+        wordWrap: { width: w - 130, useAdvancedWrap: true },
+      });
+      row.add([bg, stripe, name, cls, effect]);
+
+      if (inHand) {
+        const inHandChip = chip(this, w / 2 - 48, 0, 'В РУКЕ', color, { fontSize: 8 });
+        row.add(inHandChip.container);
+      } else if (owned) {
+        const toggle = button(this, {
+          x: w / 2 - 46,
+          y: 0,
+          w: 76,
+          h: 36,
+          text: 'В РУКУ',
+          variant: 'soft',
+          fontSize: 9,
+          onTap: () => {
+            store.toggleHandCard(card.id);
+            toast(this, `${card.short} в руке`, 'info');
+          },
+        });
+        row.add(toggle.container);
+      } else {
+        const lock = icon(this, 'lock', 14, COLORS.dim, 2).setPosition(w / 2 - 34, -6);
+        row.add(lock);
+        if (card.unlock?.type === 'signal') {
+          const cost = this.add
+            .text(w / 2 - 20, 12, `${card.unlock.cost} SIGNAL`, { fontFamily: FONT.mono, fontSize: '8px', color: CSS.gold })
+            .setOrigin(1, 0);
+          row.add(cost);
+        } else if (card.unlock?.type === 'rank') {
+          const rank = this.add
+            .text(w / 2 - 20, 12, `РАНГ ${card.unlock.rank}`, { fontFamily: FONT.mono, fontSize: '8px', color: CSS.dim })
+            .setOrigin(1, 0);
+          row.add(rank);
+        }
+      }
+
+      bg.setInteractive(new Phaser.Geom.Rectangle(-w / 2, -rowH / 2, w, rowH), Phaser.Geom.Rectangle.Contains);
+      bg.on('pointerup', () => this.openCard(card));
+      root!.add(row);
+    });
+
+    if (!list.length) {
+      const empty = paragraph(this, CENTER.x, top + 40, 'Ничего не найдено', { size: 10, color: COLORS.dim, align: 'center' });
+      empty.setOrigin(0.5);
+      root!.add(empty);
+    }
+
+    const pagerY = top + ROWS_PER_PAGE * (rowH + 8) + 6;
+    root!.add(
+      pager(this, { x: CENTER.x, y: pagerY, page: this.page, pages, color: COLORS.gold, onChange: (page) => { this.page = page; this.render(); } }),
+    );
+  }
+
+  private renderHand(root: Phaser.GameObjects.Container): void {
+    const width = this.scale.width;
+    const y = this.scale.height - 116;
+    const label = heading(this, SAFE.left, y - 30, 'РУКА', { size: 10, color: COLORS.muted });
+    root!.add(label);
+    const hand = store.state.hand;
+    const cardW = Math.min(84, (width - 48 - 3 * 8) / 4);
+    hand.slice(0, CARDS_PER_HAND).forEach((cardId, index) => {
+      const card = CARDS_BY_ID[cardId];
+      if (!card) return;
+      const x = 24 + cardW / 2 + index * (cardW + 8);
+      const tile = cardTile(this, {
+        x,
+        y,
+        w: cardW,
+        h: 62,
+        art: card.art,
+        name: card.short,
+        cardClass: card.cardClass,
+        accent: CARD_CLASS_COLOR[card.cardClass],
+        compact: true,
+        onTap: () => this.openCard(card),
+      });
+      root!.add(tile.container);
+    });
+    if (hand.length < CARDS_PER_HAND) {
+      const hint = this.add
+        .text(width - SAFE.right, y, 'добери карту\nв колоде', { fontFamily: FONT.ui, fontSize: '9px', color: CSS.dim, align: 'right', lineSpacing: 2 })
+        .setOrigin(1, 0.5);
+      root!.add(hint);
+    }
+  }
+
+  private openCard(card: CardDef): void {
+    if (this.dialogOpen) return;
+    this.dialogOpen = true;
+    const width = this.scale.width;
+    const owned = this.owned(card);
+    const color = CARD_CLASS_COLOR[card.cardClass];
+    const veil = this.add.rectangle(CENTER.x, CENTER.y, width, this.scale.height, 0x000000, 0.74).setDepth(DEPTH.dialog).setInteractive();
+    const sheet = this.add.container(CENTER.x, CENTER.y - 20).setDepth(DEPTH.dialog + 1);
+    const body = cardTile(this, {
+      x: 0,
+      y: 0,
+      w: width - 80,
+      h: 260,
+      art: card.art,
+      name: card.name,
+      cardClass: card.cardClass,
+      accent: color,
+      text: card.text,
+      selected: true,
+    });
+    sheet.add(body.container);
+    const extra = paragraph(this, 0, 140, owned ? 'В КОЛОДЕ' : unlockText(card) || 'КАРТА ЗАКРЫТА', {
+      size: 10,
+      color: owned ? COLORS.green : COLORS.gold,
+      align: 'center',
+      width: width - 60,
+    });
+    extra.setOrigin(0.5);
+    sheet.add(extra);
+
+    const actions: Phaser.GameObjects.Container[] = [];
+    if (!owned && card.unlock?.type === 'signal') {
+      const buy = button(this, {
+        x: -70,
+        y: 180,
+        w: 128,
+        h: 46,
+        text: `${card.unlock.cost} SIGNAL`,
+        variant: 'gold',
+        fontSize: 11,
+        onTap: () => {
+          if (store.buyCard(card.id)) {
+            toast(this, 'КАРТА ОТКРЫТА', 'gold');
+            dismiss();
+          } else {
+            toast(this, 'НЕДОСТАТОЧНО SIGNAL', 'bad');
+          }
+        },
+      });
+      actions.push(buy.container);
+    }
+    const close = button(this, {
+      x: actions.length ? 70 : 0,
+      y: 180,
+      w: 128,
+      h: 46,
+      text: 'ЗАКРЫТЬ',
+      variant: 'soft',
+      onTap: () => dismiss(),
+    });
+    actions.push(close.container);
+    sheet.add(actions);
+
+    const dismiss = (): void => {
+      veil.destroy();
+      sheet.destroy(true);
+      this.dialogOpen = false;
+    };
+    veil.on('pointerup', dismiss);
+    this.animateIn([body.container], 0, 18);
+    if (!store.state.settings.reduceMotion) this.tweens.add({ targets: body.container, scaleX: 1, scaleY: 1, duration: 200, ease: EASE.back });
+  }
+
+  private dialogOpen = false;
+}
+
+function unlockText(card: CardDef): string {
+  if (!card.unlock) return '';
+  if (card.unlock.type === 'rank') return `РАНГ ${card.unlock.rank}`;
+  if (card.unlock.type === 'signal') return `${card.unlock.cost} SIGNAL`;
+  return 'ИЗ КОДЕКСА';
+}
