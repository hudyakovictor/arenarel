+/** Обрезка изображения «по площади» — без масок, за счёт кропа. */
+export function fitCover(image: Phaser.GameObjects.Image, width: number, height: number): void {
+  const texW = image.width || 1;
+  const texH = image.height || 1;
+  const scale = Math.max(width / texW, height / texH);
+  image.setScale(scale);
+  const cropW = width / scale;
+  const cropH = height / scale;
+  image.setCrop((texW - cropW) / 2, (texH - cropH) / 2, cropW, cropH);
+}
