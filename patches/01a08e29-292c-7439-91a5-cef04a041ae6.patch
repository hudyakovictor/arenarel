+import { JSDOM } from 'jsdom';
+
+export function setupDom() {
+  const dom = new JSDOM(
+    '<!doctype html><html><body><div id="app"></div><div id="game-root"></div>'
+    + '<div id="boot-veil"></div><div id="boot-progress"></div><div id="boot-note"></div><div id="boot-error"></div>'
+    + '</body></html>', {
+    pretendToBeVisual: true, url: 'https://localhost/'
+  });
+  const w = dom.window;
+  globalThis.window = w;
+  for (const k of ['Element','HTMLElement','HTMLDivElement','HTMLImageElement','HTMLCanvasElement','HTMLVideoElement','Node','Event','EventTarget','MouseEvent','TouchEvent','KeyboardEvent','PointerEvent','CustomEvent','DOMParser','XMLHttpRequest','Image','ImageData','Blob','URL','screen','location','getComputedStyle','CSS','OffscreenCanvas']) {
+    if (w[k] !== undefined) { try { Object.defineProperty(globalThis, k, { value: w[k], configurable: true, writable: true }); } catch {} }
+  }
+  Object.defineProperty(globalThis, 'navigator', { value: w.navigator, configurable: true });
+  globalThis.document = w.document;
+  globalThis.localStorage = w.localStorage;
+  globalThis.requestAnimationFrame = (cb) => setTimeout(() => cb(Date.now()), 16);
+  globalThis.cancelAnimationFrame = (id) => clearTimeout(id);
+  // keep node's performance
+
+  // minimal canvas 2d stub
+  const noop = () => {};
+  class FakeImageData { constructor(data, width, height) { this.data = data; this.width = width; this.height = height; } }
+  function makeCtx(canvas) {
+    return {
+      canvas,
+      fillStyle: '#000', strokeStyle: '#000', globalAlpha: 1, globalCompositeOperation: 'source-over',
+      lineWidth: 1, lineCap: 'butt', lineJoin: 'miter', miterLimit: 10, font: '10px sans-serif',
+      textAlign: 'start', textBaseline: 'alphabetic', shadowBlur: 0, shadowColor: '#000',
+      shadowOffsetX: 0, shadowOffsetY: 0, imageSmoothingEnabled: true, filter: 'none',
+      save: noop, restore: noop, scale: noop, rotate: noop, translate: noop, transform: noop,
+      setTransform: noop, resetTransform: noop, clearRect: noop, fillRect: noop, strokeRect: noop,
+      beginPath: noop, closePath: noop, moveTo: noop, lineTo: noop, bezierCurveTo: noop,
+      quadraticCurveTo: noop, arc: noop, arcTo: noop, ellipse: noop, rect: noop, roundRect: noop,
+      fill: noop, stroke: noop, clip: noop, fillText: noop, strokeText: noop, measureText: () => ({ width: 10, actualBoundingBoxAscent: 8, actualBoundingBoxDescent: 2 }),
+      drawImage: noop, createLinearGradient: () => ({ addColorStop: noop }), createRadialGradient: () => ({ addColorStop: noop }),
+      createPattern: () => null, putImageData: noop,
+      getImageData: (x, y, wd, ht) => new FakeImageData(new Uint8ClampedArray(Math.max(1, wd * ht * 4)), wd, ht),
+      createImageData: (wd, ht) => new FakeImageData(new Uint8ClampedArray(Math.max(1, wd * ht * 4)), wd, ht),
+      getContextAttributes: () => ({ alpha: true }),
+    };
+  }
+  w.HTMLCanvasElement.prototype.getContext = function (type) {
+    if (type === '2d') return makeCtx(this);
+    return null;
+  };
+  Object.defineProperty(globalThis, 'ImageData', { value: FakeImageData, configurable: true, writable: true });
+  // images never load in jsdom: fire 'load' on src assignment
+  const proto = w.HTMLImageElement.prototype;
+  const srcDesc = Object.getOwnPropertyDescriptor(proto, 'src');
+  if (srcDesc) {
+    Object.defineProperty(proto, 'src', {
+      configurable: true,
+      get() { return srcDesc.get.call(this); },
+      set(v) {
+        srcDesc.set.call(this, v);
+        setTimeout(() => { try { this.dispatchEvent(new w.Event('load')); } catch {} }, 0);
+      },
+    });
+  }
+  for (const prop of ['naturalWidth', 'naturalHeight', 'width', 'height']) {
+    const d = Object.getOwnPropertyDescriptor(proto, prop);
+    if (!d) continue;
+    Object.defineProperty(proto, prop, {
+      configurable: true,
+      get() { const v = d.get ? d.get.call(this) : 1; return v || 1; },
+      set(v) { if (d.set) d.set.call(this, v); },
+    });
+  }
+  // Phaser ждёт matchMedia и devicePixelRatio в браузерных сценариях
+  if (!w.matchMedia) {
+    w.matchMedia = () => ({ matches: false, addListener: () => {}, removeListener: () => {}, addEventListener: () => {}, removeEventListener: () => {} });
+  }
+  Object.defineProperty(globalThis, 'matchMedia', { value: w.matchMedia, configurable: true, writable: true });
+  globalThis.devicePixelRatio = 1;
+  w.devicePixelRatio = 1;
+  return dom;
+}
