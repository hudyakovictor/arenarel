+    .setOrigin(0.5);
+  const padX = 10;
+  const width = label.width + padX * 2 + (opts.icon ? 16 : 0);
+  const height = fontSize + 14;
+  const bg = scene.add.rectangle(opts.filled ? 0 : 0, 0, width, height, color, opts.filled ? 0.95 : 0.14).setOrigin(0.5);
+  bg.setStrokeStyle(1, color, opts.filled ? 0.2 : 0.45);
+  container.add([bg, label]);
+  if (opts.icon) {
+    const icon = scene.add.text(-label.width / 2 - 12, 0, opts.icon, { fontFamily: FONT.ui, fontSize: `${fontSize}px`, color: `#${color.toString(16).padStart(6, '0')}` }).setOrigin(0.5);
