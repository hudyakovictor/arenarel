+/**
+ * EventBus.ts — типизированная шина событий приложения.
+ * Сцены общаются через неё, а не через прямые ссылки: это позволяет
+ * перезапускать охоту, не теряя состояние профиля.
+ */
+
+import type { HuntMode, SkrepkaMood } from './types';
+
+export type BusEvents = {
+  'state:changed': void;
+  'profile:levelup': { rank: number };
+  'hunt:started': { huntId: string; mode: HuntMode };
+  'hunt:finished': { huntId: string; dqi: number; revealed: boolean };
+  'codex:unlocked': { entityId: string };
+  'card:unlocked': { cardId: string };
+  'quest:completed': { questId: string };
+  'achievement:unlocked': { achievementId: string };
+  'toast': { text: string; tone?: 'info' | 'good' | 'bad' | 'gold' };
+  'skrepka:say': { line: string; mood?: SkrepkaMood };
+  'sfx': { name: string };
+  'analytics': { name: string; payload?: Record<string, unknown> };
+};
+
+type Handler<T> = (payload: T) => void;
+
+class TypedBus {
+  private readonly map = new Map<string, Set<Handler<never>>>();
+
+  on<K extends keyof BusEvents>(event: K, handler: Handler<BusEvents[K]>): () => void {
+    let set = this.map.get(event as string);
+    if (!set) {
+      set = new Set();
+      this.map.set(event as string, set);
+    }
+    set.add(handler as Handler<never>);
+    return () => this.off(event, handler);
+  }
+
+  once<K extends keyof BusEvents>(event: K, handler: Handler<BusEvents[K]>): () => void {
+    const off = this.on(event, (payload) => {
+      off();
+      handler(payload);
+    });
+    return off;
+  }
+
+  off<K extends keyof BusEvents>(event: K, handler: Handler<BusEvents[K]>): void {
+    this.map.get(event as string)?.delete(handler as Handler<never>);
+  }
+
+  emit<K extends keyof BusEvents>(event: K, payload: BusEvents[K]): void {
+    const set = this.map.get(event as string);
+    if (!set) return;
+    for (const handler of Array.from(set)) {
+      try {
+        (handler as Handler<BusEvents[K]>)(payload);
+      } catch (error) {
+        // Шина не должна ронять игру из-за одного подписчика.
+        console.error(`[bus] обработчик события "${String(event)}" упал`, error);
+      }
+    }
+  }
+
+  clear(): void {
+    this.map.clear();
+  }
+}
+
+export const bus = new TypedBus();
+
+/** Удобные шорткаты для частых событий. */
+export const emitToast = (text: string, tone: 'info' | 'good' | 'bad' | 'gold' = 'info') =>
+  bus.emit('toast', { text, tone });
+export const emitSfx = (name: string) => bus.emit('sfx', { name });
+export const emitAnalytics = (name: string, payload?: Record<string, unknown>) =>
+  bus.emit('analytics', { name, payload });
+export const askSkrepka = (line: string, mood: SkrepkaMood = 'talk') =>
+  bus.emit('skrepka:say', { line, mood });
