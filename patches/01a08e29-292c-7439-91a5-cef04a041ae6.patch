@@ -0,0 +1,293 @@
+#!/usr/bin/env python3
+"""
+build_assets.py — сборка арта SIGNAL ARENA из исходных листов.
+
+Зачем инструмент вместо «просто положить картинки»:
+  1) исходники — большие листы-концепты (1408×768, по 10 карт в листе);
+     рантайму нужны отдельные кадры стабильного размера;
+  2) все имена кадров берутся из данных игры (src/data/cards.ts, entities.ts),
+     поэтому рассинхрон между артом и данными невозможен: инструмент падает,
+     если карта ссылается на несуществующий кадр;
+  3) вес: webp вместо jpeg/png — приложение остаётся лёгким для 3G.
+
+Запуск:  python3 tools/art/build_assets.py [--check]
+Вывод:   public/art/…  (+ contact sheet в tools/art/_preview/ при --check)
+"""
+
+from __future__ import annotations
+
+import argparse
+import re
+import sys
+from pathlib import Path
+
+from PIL import Image, ImageEnhance
+
+ROOT = Path(__file__).resolve().parents[2]
+SRC = ROOT / "art" / "source"
+OUT = ROOT / "public" / "art"
+PREVIEW = ROOT / "tools" / "art" / "_preview"
+
+SHEETS = {
+    "reading": SRC / "cards_reading.jpg",
+    "defense": SRC / "cards_defense.jpg",
+    "decision": SRC / "cards_decision.jpg",
+    "protocol": SRC / "cards_protocol.jpg",
+    # Историческое имя файла: лист защитных карт назывался «another_character».
+    "cards": SRC / "cards_defense.jpg",
+}
+
+# Геометрия листов (измерена по исходникам): 5 колонок × 2 ряда.
+# У листа протоколов карточки шире и подписи выше — своя сетка.
+SHEET_GEOM = {
+    "reading": {"x0": 40, "y0": 104, "cw": 238, "ch": 300, "colp": 272.5, "rowp": 332, "top": 50},
+    "defense": {"x0": 40, "y0": 104, "cw": 238, "ch": 300, "colp": 272.5, "rowp": 332, "top": 50},
+    "decision": {"x0": 40, "y0": 104, "cw": 238, "ch": 300, "colp": 272.5, "rowp": 332, "top": 50},
+    "protocol": {"x0": 35, "y0": 114, "cw": 278, "ch": 296, "colp": 273.5, "rowp": 338, "top": 56},
+}
+ART_INSET = {"x": 8, "bottom": 14}
+
+# Кадр карты → ячейка листа (row, col). Соответствие смысловое, не порядковое.
+CARD_CELLS: dict[str, tuple[str, int, int]] = {
+    "reading_01": ("reading", 0, 0),
+    "reading_02": ("reading", 0, 1),
+    "reading_03": ("reading", 0, 2),
+    "reading_04": ("reading", 0, 3),
+    "reading_05": ("reading", 0, 4),
+    "reading_06": ("reading", 1, 1),
+    "reading_07": ("reading", 1, 2),
+    "reading_08": ("reading", 1, 4),
+    "defense_01": ("defense", 0, 0),
+    "defense_02": ("defense", 0, 1),
+    "defense_03": ("defense", 0, 2),
+    "defense_04": ("defense", 0, 3),
+    "defense_05": ("defense", 0, 4),
+    "defense_06": ("defense", 1, 0),
+    "defense_07": ("defense", 1, 2),
+    "defense_08": ("defense", 1, 4),
+    "decision_01": ("decision", 0, 0),
+    "decision_03": ("decision", 0, 2),
+    "decision_04": ("decision", 0, 3),
+    "decision_05": ("decision", 0, 4),
+    "decision_06": ("decision", 1, 0),
+    "decision_07": ("decision", 1, 1),
+    "decision_08": ("decision", 1, 2),
+    "decision_09": ("decision", 1, 3),
+    "decision_10": ("decision", 1, 4),
+    "protocol_01": ("protocol", 0, 0),
+    "protocol_02": ("protocol", 0, 1),
+    "protocol_03": ("protocol", 0, 2),
+    "protocol_04": ("protocol", 0, 3),
+    "protocol_05": ("protocol", 0, 4),
+    "protocol_06": ("protocol", 1, 1),
+    "protocol_07": ("protocol", 1, 2),
+    "protocol_08": ("protocol", 1, 3),
+}
+
+# Сущности: исходник-иллюстрация 1408×768, существо в центре.
+ENTITY_FILES = {
+    "entity_fomo": "enemy.fomo_wraith.jpg",
+    "entity_leverage": "enemy.leverage_goblin.jpg",
+    "entity_revenge": "enemy.revenge_wraith.jpg",
+    "entity_hubris": "enemy.hubris_dragon.jpg",
+    "entity_titan": "enemy.headline_titan.jpg",
+}
+
+CARD_OUT = (300, 300)
+ENTITY_OUT = (320, 320)
+SKREPKA_OUT = (360, 360)
+
+
+def parse_ids(path: Path, pattern: str) -> list[str]:
+    return re.findall(pattern, path.read_text(encoding="utf-8"))
+
+
+def guard_sources() -> None:
+    missing = [str(p) for p in SHEETS.values()] + [str(SRC / name) for name in ENTITY_FILES.values()]
+    missing = [p for p in dict.fromkeys(missing) if not Path(p).exists()]
+    if missing:
+        print("Не найдены исходники:", *missing, sep="\n  ")
+        sys.exit(2)
+
+
+def crop_card(sheet: Image.Image, sheet_name: str, row: int, col: int) -> Image.Image:
+    geom = SHEET_GEOM[sheet_name]
+    x = int(geom["x0"] + col * geom["colp"])
+    y = int(geom["y0"] + row * geom["rowp"])
+    art = sheet.crop(
+        (
+            x + ART_INSET["x"],
+            y + geom["top"],
+            x + geom["cw"] - ART_INSET["x"],
+            y + geom["ch"] - ART_INSET["bottom"],
+        )
+    )
+    # Квадрат из центра области: в интерфейсе кадр рисуется «по площади»,
+    # квадрат теряет меньше смысла, чем произвольный прямоугольник.
+    side = min(art.size)
+    left = (art.width - side) // 2
+    top = (art.height - side) // 2
+    return art.crop((left, top, left + side, top + side)).resize(CARD_OUT, Image.LANCZOS)
+
+
+def center_square(image: Image.Image, side_ratio: float = 0.62, y_shift: float = 0.0) -> Image.Image:
+    side = int(image.width * side_ratio)
+    x = (image.width - side) // 2
+    y = int((image.height - side) / 2 + image.height * y_shift)
+    y = max(0, min(image.height - side, y))
+    return image.crop((x, y, x + side, y + side))
+
+
+def tone(image: Image.Image, *, brightness: float = 1.0, saturation: float = 1.0) -> Image.Image:
+    result = image
+    if brightness != 1.0:
+        result = ImageEnhance.Brightness(result).enhance(brightness)
+    if saturation != 1.0:
+        result = ImageEnhance.Color(result).enhance(saturation)
+    return result
+
+
+def save(image: Image.Image, path: Path, quality: int = 84) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    image.convert("RGB").save(path, "WEBP", quality=quality, method=5)
+
+
+def build_cards() -> list[str]:
+    cards_source = (ROOT / "src" / "data" / "cards.ts").read_text(encoding="utf-8")
+    ids = re.findall(r"\n    id: '([a-z0-9_]+)',", cards_source)
+    arts = re.findall(r"\n    art: '([a-z0-9_]+)',", cards_source)
+    if len(ids) != len(arts):
+        print("cards.ts: число id и art не совпадает", len(ids), len(arts))
+        sys.exit(3)
+
+    problems: list[str] = []
+    written: list[str] = []
+    sheets: dict[str, Image.Image] = {}
+    for art in arts:
+        cell = CARD_CELLS.get(art)
+        if cell is None:
+            problems.append(art)
+            continue
+        sheet_name, row, col = cell
+        if sheet_name not in sheets:
+            sheets[sheet_name] = Image.open(SHEETS[sheet_name]).convert("RGB")
+        frame = crop_card(sheets[sheet_name], sheet_name, row, col)
+        path = OUT / "cards" / f"{art}.webp"
+        save(frame, path, quality=86)
+        written.append(art)
+
+    if problems:
+        print("Нет ячейки для кадров:", sorted(set(problems)))
+        sys.exit(4)
+    print(f"карты: {len(written)} кадров")
+    return written
+
+
+def build_entities() -> list[Path]:
+    results: list[Path] = []
+    for key, filename in ENTITY_FILES.items():
+        source = Image.open(SRC / filename).convert("RGB")
+        frame = center_square(source, 0.56).resize(ENTITY_OUT, Image.LANCZOS)
+        path = OUT / "entities" / f"{key}.webp"
+        save(frame, path, quality=86)
+        results.append(path)
+    print(f"сущности: {len(results)} портретов")
+    return results
+
+
+def build_skrepka() -> list[Path]:
+    """Образ Скрепки неизменен: один рисунок, четыре состояния прибора."""
+    source_path = SRC / "skrepka.png"
+    if not source_path.exists():
+        mirrors = sorted(SRC.glob("*character*.png"))
+        if not mirrors:
+            print("Скрепка: исходник не найден, игра соберёт аварийный арт кодом")
+            return []
+        source_path = mirrors[0]
+    source = Image.open(source_path).convert("RGB")
+    frame = center_square(source, 0.72, y_shift=0.06).resize(SKREPKA_OUT, Image.LANCZOS)
+
+    moods = {
+        "skrepka_idle": dict(brightness=1.0, saturation=1.0),
+        "skrepka_talk": dict(brightness=1.06, saturation=1.05),
+        "skrepka_alarm": dict(brightness=0.96, saturation=1.25),
+        "skrepka_proud": dict(brightness=1.08, saturation=0.92),
+    }
+    results: list[Path] = []
+    for key, params in moods.items():
+        path = OUT / "skrepka" / f"{key}.webp"
+        save(tone(frame, **params), path, quality=88)
+        results.append(path)
+    print(f"скрепка: {len(results)} состояния (образ не меняется, только тон прибора)")
+    return results
+
+
+def build_ui() -> list[Path]:
+    """Иконки приложения, обложка для соцсетей и фон хаба."""
+    results: list[Path] = []
+    fomo = Image.open(SRC / ENTITY_FILES["entity_fomo"]).convert("RGB")
+
+    backdrop = fomo.resize((720, 393), Image.LANCZOS).crop((0, 0, 720, 393))
+    backdrop = tone(backdrop, brightness=0.42, saturation=0.7)
+    save(backdrop, OUT / "ui" / "hub_backdrop.webp", quality=80)
+    results.append(OUT / "ui" / "hub_backdrop.webp")
+
+    og = Image.new("RGB", (1200, 630), (4, 7, 15))
+    art = center_square(fomo, 0.52).resize((630, 630), Image.LANCZOS)
+    art = tone(art, brightness=0.62, saturation=0.85)
+    og.paste(art, (-60, 0))
+    gradient = Image.new("L", (620, 630), 0)
+    for x in range(620):
+        value = int(255 * (x / 620) ** 0.8)
+        for y in range(630):
+            gradient.putpixel((x, y), value)
+    og.paste(Image.new("RGB", (620, 630), (4, 7, 15)), (580, 0), gradient)
+    save(og, OUT / "ui" / "og.webp", quality=86)
+    results.append(OUT / "ui" / "og.webp")
+
+    icon_src = center_square(fomo, 0.62)
+    for size in (192, 512):
+        icon = tone(icon_src, brightness=0.9).resize((size, size), Image.LANCZOS)
+        path = ROOT / "public" / f"icon-{size}.png"
+        icon.save(path, "PNG", optimize=True)
+        results.append(path)
+    print(f"интерфейс: {len(results)} файлов (обложка, фон, иконки)")
+    return results
+
+
+def contact_sheet(paths: list[Path], name: str, columns: int = 6, cell: int = 150) -> None:
+    rows = (len(paths) + columns - 1) // columns
+    sheet = Image.new("RGB", (columns * cell, rows * (cell + 18)), (10, 14, 28))
+    for index, path in enumerate(paths):
+        image = Image.open(path).convert("RGB").resize((cell - 8, cell - 8), Image.LANCZOS)
+        x = (index % columns) * cell + 4
+        y = (index // columns) * (cell + 18) + 4
+        sheet.paste(image, (x, y))
+    PREVIEW.mkdir(parents=True, exist_ok=True)
+    sheet.save(PREVIEW / f"{name}.png")
+    print(f"превью: {PREVIEW / f'{name}.png'}")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Сборка арта SIGNAL ARENA")
+    parser.add_argument("--check", action="store_true", help="дополнительно собрать контактные листы")
+    args = parser.parse_args()
+
+    guard_sources()
+    cards = build_cards()
+    entities = build_entities()
+    skrepka = build_skrepka()
+    ui = build_ui()
+
+    if args.check:
+        contact_sheet([OUT / "cards" / f"{art}.webp" for art in cards], "cards")
+        contact_sheet(entities, "entities", columns=5, cell=200)
+        contact_sheet(skrepka + ui, "misc", columns=4, cell=200)
+
+    total = sum(1 for _ in (OUT).rglob("*.webp"))
+    size = sum(path.stat().st_size for path in OUT.rglob("*.webp")) / 1024
+    print(f"всего кадров: {total}, вес: {size:.0f} КБ")
+
+
+if __name__ == "__main__":
+    main()
