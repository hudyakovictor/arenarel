+/**
+ * Проверка данных: игра держится на таблицах, и таблицы должны сходиться.
+ * Здесь ловятся битые ссылки между картами, уликами, сценариями и сущностями.
+ */
+
+import { describe, expect, it } from 'vitest';
+
+import { CARDS, CARDS_BY_ID, CARD_CLASS_LABEL } from '../../src/data/cards';
+import { CLUES, CLUES_BY_ID } from '../../src/data/clues';
+import { ENTITIES, entityById } from '../../src/data/entities';
+import { SCENARIOS, scenarioById } from '../../src/data/scenarios';
+import { COSMETICS, COSMETICS_BY_ID } from '../../src/data/cosmetics';
+import { LESSONS } from '../../src/data/lessons';
+import { NOISE } from '../../src/data/noise';
+import { QUESTS } from '../../src/data/quests';
+import { ACHIEVEMENTS } from '../../src/data/achievements';
+import { RANKS, energyForRank, rankForXp } from '../../src/data/ranks';
+import { SEASON } from '../../src/data/season';
+
+describe('колода', () => {
+  it('33 карты, идентификаторы уникальны', () => {
+    expect(CARDS.length).toBe(33);
+    expect(new Set(CARDS.map((card) => card.id)).size).toBe(33);
+  });
+
+  it('решений на одно больше: у выхода всегда есть третий путь', () => {
+    const counts = new Map<string, number>();
+    for (const card of CARDS) counts.set(card.cardClass, (counts.get(card.cardClass) ?? 0) + 1);
+    expect(counts.get('reading')).toBe(8);
+    expect(counts.get('defense')).toBe(8);
+    expect(counts.get('protocol')).toBe(8);
+    expect(counts.get('decision')).toBe(9);
+    expect(Object.keys(CARD_CLASS_LABEL).sort()).toEqual([...counts.keys()].sort());
+  });
+
+  it('у каждой карты есть арт, эффект и текст', () => {
+    for (const card of CARDS) {
+      expect(card.art.length).toBeGreaterThan(0);
+      expect(card.text.length).toBeGreaterThan(10);
+      expect(card.flavor.length).toBeGreaterThan(0);
+      expect(Object.keys(card.effect).length).toBeGreaterThan(0);
+    }
+  });
+});
+
+describe('сущности и сценарии', () => {
+  it('12 сущностей: крупные, рейдовые и мелкий шум', () => {
+    expect(ENTITIES.length).toBe(12);
+    expect(ENTITIES.filter((entity) => entity.rank === 'major').length).toBeGreaterThanOrEqual(3);
+    expect(ENTITIES.filter((entity) => entity.rank === 'raid').length).toBeGreaterThanOrEqual(2);
+  });
+
+  it('у каждой сущности есть слабое место среди карт и «корм» среди карт', () => {
+    for (const entity of ENTITIES) {
+      expect(CARDS_BY_ID[entity.weakness], `${entity.id}: weakness ${entity.weakness}`).toBeTruthy();
+      expect(CARDS_BY_ID[entity.feedsOn], `${entity.id}: feedsOn ${entity.feedsOn}`).toBeTruthy();
+    }
+  });
+
+  it('20 сценариев, у каждого корректные ссылки', () => {
+    expect(SCENARIOS.length).toBe(20);
+    for (const scenario of SCENARIOS) {
+      expect(entityById(scenario.entityId), `${scenario.id}: entity`).toBeTruthy();
+      expect(scenario.clueIds.length).toBeGreaterThanOrEqual(3);
+      for (const clueId of scenario.clueIds) {
+        expect(CLUES_BY_ID[clueId], `${scenario.id}: clue ${clueId}`).toBeTruthy();
+      }
+      expect(scenario.noise.length).toBeGreaterThanOrEqual(2);
+      for (const noise of scenario.noise) {
+        expect(noise.holdLabel.length).toBeGreaterThan(0);
+        expect(noise.breakLabel.length).toBeGreaterThan(0);
+        expect(noise.correct === 'hold' || noise.correct === 'break').toBe(true);
+      }
+      expect(scenario.waveform).toBeTruthy();
+      expect(scenario.waveform.pre.length).toBeGreaterThan(4);
+      expect(scenario.waveform.post.length).toBeGreaterThan(2);
+      for (const seal of ['wait', 'enter', 'exit'] as const) {
+        expect(scenario.outcomes[seal]?.title, `${scenario.id}: outcome ${seal}`).toBeTruthy();
+      }
+    }
+  });
+
+  it('сценарии покрывают три уровня сложности', () => {
+    const tiers = new Set(SCENARIOS.map((scenario) => scenario.tier));
+    expect([...tiers].sort()).toEqual([1, 2, 3]);
+  });
+
+  it('шум описан для всех сценариев и не повторяет подписи', () => {
+    expect(NOISE.length).toBeGreaterThanOrEqual(20);
+    for (const event of NOISE) {
+      expect(event.whisper.length).toBeGreaterThan(5);
+    }
+  });
+});
+
+describe('улики', () => {
+  it('50 улик с весом и объяснением', () => {
+    expect(CLUES.length).toBe(50);
+    expect(new Set(CLUES.map((clue) => clue.id)).size).toBe(50);
+    for (const clue of CLUES) {
+      expect(clue.weight).toBeGreaterThan(0);
+      expect(clue.why.length).toBeGreaterThan(10);
+      expect(clue.text.length).toBeGreaterThan(10);
+    }
+  });
+
+  it('каждая улика указывает на существующую сущность или на любую', () => {
+    for (const clue of CLUES) {
+      if (clue.pointsTo === 'any') continue;
+      expect(entityById(clue.pointsTo), `${clue.id}: pointsTo ${clue.pointsTo}`).toBeTruthy();
+    }
+  });
+});
+
+describe('витрина, разборы, сезон', () => {
+  it('косметика: дороже нуля, идентификаторы уникальны, стартовые бесплатны', () => {
+    expect(new Set(COSMETICS.map((item) => item.id)).size).toBe(COSMETICS.length);
+    for (const item of COSMETICS) expect(item.cost).toBeGreaterThanOrEqual(0);
+    expect(COSMETICS_BY_ID.skrepka_classic?.cost).toBe(0);
+  });
+
+  it('пять разборов — по одному на критерий', () => {
+    expect(LESSONS.length).toBe(5);
+    expect(new Set(LESSONS.map((lesson) => lesson.criterion)).size).toBe(5);
+    for (const lesson of LESSONS) expect(lesson.body.length).toBeGreaterThanOrEqual(2);
+  });
+
+  it('задания и достижения измеримы', () => {
+    expect(QUESTS.length).toBeGreaterThanOrEqual(6);
+    for (const quest of QUESTS) expect(quest.target).toBeGreaterThan(0);
+    expect(ACHIEVEMENTS.length).toBeGreaterThanOrEqual(8);
+    for (const achievement of ACHIEVEMENTS) {
+      expect(achievement.levels.length).toBeGreaterThan(0);
+      expect(achievement.reward.length).toBe(achievement.levels.length);
+    }
+  });
+
+  it('ранги растут по опыту, а сезонные пороги — по возрастанию', () => {
+    expect(RANKS.length).toBe(5);
+    for (let index = 1; index < RANKS.length; index += 1) {
+      expect(RANKS[index]!.xp).toBeGreaterThan(RANKS[index - 1]!.xp);
+      expect(energyForRank(RANKS[index]!.rank)).toBeGreaterThan(energyForRank(RANKS[index - 1]!.rank));
+    }
+    expect(rankForXp(0).rank).toBe(1);
+    expect(rankForXp(999999).rank).toBe(5);
+    for (let index = 1; index < SEASON.tiers.length; index += 1) {
+      expect(SEASON.tiers[index]!.xp).toBeGreaterThan(SEASON.tiers[index - 1]!.xp);
+    }
+  });
+});
