+    })
+    .setOrigin(0.5);
+  const rankTitle = scene.add
+    .text(SAFE.left + badgeSize / 2, HUD_HEIGHT / 2 + 14, 'РАНГ', { fontFamily: FONT.ui, fontSize: '7px', color: CSS.dim, fontStyle: '700' })
+    .setOrigin(0.5);
+  container.add([rankNumeral, rankTitle]);
+
+  const name = scene.add
+    .text(SAFE.left + badgeSize + 12, 12, 'ОХОТНИК', textStyle('bodyBold', { fontSize: '12px' }))
+    .setOrigin(0, 0);
+  container.add(name);
+
+  const xpBg = scene.add.rectangle(SAFE.left + badgeSize + 12, 34, 150, 7, 0x0a1330, 1).setOrigin(0, 0.5);
+  xpBg.setStrokeStyle(1, COLORS.line, 0.25);
+  const xpFill = scene.add.rectangle(SAFE.left + badgeSize + 13, 34, 6, 5, COLORS.cyan, 1).setOrigin(0, 0.5);
+  const xpText = scene.add
+    .text(SAFE.left + badgeSize + 170, 34, '0 / 450', { fontFamily: FONT.mono, fontSize: '9px', color: CSS.dim })
+    .setOrigin(0, 0.5);
+  container.add([xpBg, xpFill, xpText]);
+
+  const signalIcon = icon(scene, 'signal', 14, COLORS.gold, 1.8);
+  signalIcon.setPosition(width - SAFE.right - 74, 18);
+  const signalText = scene.add
+    .text(width - SAFE.right, 18, '0', { fontFamily: FONT.display, fontSize: '14px', color: CSS.gold })
+    .setOrigin(1, 0.5);
+  container.add([signalIcon, signalText]);
+
+  const streakIcon = icon(scene, 'flame', 12, COLORS.orange, 1.6);
+  streakIcon.setPosition(width - SAFE.right - 30, 42);
+  const streakText = scene.add
+    .text(width - SAFE.right, 42, '0', { fontFamily: FONT.display, fontSize: '12px', color: CSS.orange })
+    .setOrigin(1, 0.5);
+  const energyRow = scene.add.container(width - SAFE.right - 60, 42);
+  container.add([streakIcon, streakText, energyRow]);
+
+  const refresh = () => {
+    const profile = store.profile;
+    const rank = rankForXp(profile.xp);
+    const roman = ['I', 'II', 'III', 'IV', 'V'][Math.min(4, rank.rank - 1)] ?? 'I';
+    rankNumeral.setText(roman);
+    rankNumeral.setColor(`#${rank.color.toString(16).padStart(6, '0')}`);
+    badge.setStrokeStyle(1.5, rank.color, 0.6);
+    rankTitle.setText(rank.title.split(' ')[0]!.slice(0, 9));
+    name.setText(profile.name);
+    const progress = rankProgress(profile.xp);
+    xpFill.displayWidth = Math.max(4, 148 * progress);
+    const next = RANKS.find((r) => r.rank === rank.rank + 1);
+    xpText.setText(next ? `${profile.xp} / ${next.xp}` : 'МАКСИМУМ');
+    signalText.setText(`${profile.signal}`);
+    streakText.setText(`${profile.streak}`);
+
+    energyRow.removeAll(true);
+    const cap = 4 + profile.rank;
+    const dotSize = 5;
+    for (let i = 0; i < Math.min(cap, 9); i++) {
+      const filled = i < profile.energy;
+      const dot = scene.add.circle(i * (dotSize + 3), 0, dotSize / 2, filled ? COLORS.cyan : 0x22314f, 1);
+      if (filled) {
+        dot.setStrokeStyle(1, COLORS.cyan, 0.8);
+      }
+      energyRow.add(dot);
+    }
+  };
+
+  refresh();
+  const unsubscribe = store.subscribe(refresh);
+  container.once('destroy', unsubscribe);
+  return { container, refresh };
+}
