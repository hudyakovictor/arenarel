@@ -0,0 +1,33 @@
+/**
+ * haptics.ts — тактильный отклик.
+ * Вибрация не должна быть ни навязчивой, ни декоративной:
+ * она подтверждает печать, удар и вскрытие.
+ */
+
+export type HapticName = 'tap' | 'good' | 'bad' | 'hit' | 'seal' | 'reveal' | 'levelup';
+
+const PATTERNS: Record<HapticName, number | number[]> = {
+  tap: 8,
+  good: [12, 30, 18],
+  bad: [40, 40, 40],
+  hit: [24, 30, 24],
+  seal: [10, 20, 60],
+  reveal: [16, 24, 16, 24, 40],
+  levelup: [12, 40, 12, 40, 60],
+};
+
+class Haptics {
+  enabled = true;
+  private supported = typeof navigator !== 'undefined' && typeof navigator.vibrate === 'function';
+
+  vibrate(pattern: HapticName): void {
+    if (!this.enabled || !this.supported) return;
+    try {
+      navigator.vibrate(PATTERNS[pattern]);
+    } catch {
+      this.supported = false;
+    }
+  }
+}
+
+export const haptics = new Haptics();
