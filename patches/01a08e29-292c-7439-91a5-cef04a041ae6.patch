+++ b/src/ui/kit.ts
@@ -0,0 +1,686 @@
+/**
+ * kit.ts — интерфейсный набор SIGNAL ARENA на базе RexUI.
+ * Правило игры: каждый элемент либо что-то сообщает, либо что-то решает. Ничего декоративного.
+ * Правило кода: одинаковые вещи выглядят одинаково на всех экранах.
+ */
+
+import Phaser from 'phaser';
+import { rex, safeImage, type RexShape } from './rex';
+
+/** safeImage отдаёт либо картинку, либо нарисованную заглушку-контейнер. */
+type SafeArt = Phaser.GameObjects.Image | Phaser.GameObjects.Container;
+import { ALPHA, COLORS, CSS, EASE, FONT, FS, RADIUS, TEXT_STYLES, shift, textStyle } from '../game/theme';
+import { TIME, TOUCH_MIN } from '../game/design';
+import { store } from '../core/store';
+import { audio } from '../core/audio';
+import { haptics } from '../core/haptics';
+
+export type ButtonVariant = 'primary' | 'gold' | 'ghost' | 'danger' | 'soft' | 'dark';
+
+export interface ButtonHandle {
+  container: Phaser.GameObjects.Container;
+  setLabel(text: string): void;
+  setEnabled(value: boolean): void;
+  setVisible(value: boolean): void;
+  setPosition(x: number, y: number): void;
+  setAlpha(value: number): void;
+  setColor(color: number): void;
+  destroy(): void;
+  readonly width: number;
+  readonly height: number;
+}
+
+const VARIANT_STYLE: Record<ButtonVariant, { fill: number; alpha: number; stroke?: number; text: string }> = {
+  primary: { fill: COLORS.cyan, alpha: 1, text: '#04070f' },
+  gold: { fill: COLORS.gold, alpha: 1, text: '#1a1206' },
+  danger: { fill: COLORS.red, alpha: 1, text: '#180407' },
+  ghost: { fill: COLORS.card, alpha: 0.35, stroke: COLORS.line, text: '#f2f7ff' },
+  soft: { fill: COLORS.card2, alpha: 0.95, stroke: COLORS.line, text: '#f2f7ff' },
+  dark: { fill: COLORS.bg1, alpha: 0.92, stroke: COLORS.line, text: '#8fa1c0' },
+};
+
+export function reduceMotion(): boolean {
+  return store.state.settings.reduceMotion;
+}
+
+function feedback(scene: Phaser.Scene, target: Phaser.GameObjects.Container, kind: 'tap' | 'seal' = 'tap'): void {
+  audio.play(kind === 'tap' ? 'click' : 'seal');
+  haptics.vibrate(kind);
+  if (reduceMotion()) return;
+  scene.tweens.add({
+    targets: target,
+    scale: { from: 0.97, to: 1 },
+    duration: TIME.tap + 60,
+    ease: EASE.back,
+  });
+}
+
+/**
+ * Кнопка. Высота по умолчанию — больше минимальной зоны касания (TOUCH_MIN).
+ */
+export function button(
+  scene: Phaser.Scene,
+  opts: {
+    x: number;
+    y: number;
+    w?: number;
+    h?: number;
+    text: string;
+    variant?: ButtonVariant;
+    onTap?: () => void;
+    icon?: string;
+    subtitle?: string;
+    fontSize?: number;
+    depth?: number;
+    enabled?: boolean;
+    radius?: number;
+  },
+): ButtonHandle {
+  const width = opts.w ?? 260;
+  const height = opts.h ?? 56;
+  const variant: ButtonVariant = opts.variant ?? 'primary';
+  const style = VARIANT_STYLE[variant];
+  const container = scene.add.container(opts.x, opts.y);
+  container.setDepth(opts.depth ?? 0);
+
+  const glow = scene.add.image(0, 0, 'tex_glow').setDisplaySize(width * 1.25, height * 2.2);
+  glow.setTint(style.fill);
+  glow.setAlpha(variant === 'primary' || variant === 'gold' || variant === 'danger' ? 0.22 : 0.08);
+  glow.setBlendMode(Phaser.BlendModes.ADD);
+  container.add(glow);
+
+  const bg = rex(scene).add.roundRectangle(0, 0, width, height, opts.radius ?? RADIUS.button, style.fill, style.alpha) as RexShape;
+  if (style.stroke !== undefined) bg.setStrokeStyle(1.5, style.stroke, ALPHA.lineStrong);
+  container.add(bg as unknown as Phaser.GameObjects.GameObject);
+
+  if (variant === 'primary' || variant === 'gold' || variant === 'danger') {
+    const highlight = scene.add.rectangle(0, -height / 2 + 2, width - 12, 2, 0xffffff, 0.4).setOrigin(0.5, 0);
+    container.add(highlight);
+  }
+
+  const labelY = opts.subtitle ? -8 : 0;
+  const label = scene.add
+    .text(0, labelY, opts.text, textStyle('button', { fontSize: `${opts.fontSize ?? 15}px`, color: style.text }))
+    .setOrigin(0.5);
+  container.add(label);
+
+  if (opts.icon) {
+    const icon = scene.add
+      .text(-width / 2 + 22, 0, opts.icon, { fontFamily: FONT.display, fontSize: '16px', color: style.text })
+      .setOrigin(0.5);
+    label.setX(6);
+    container.add(icon);
+  }
+
+  if (opts.subtitle) {
+    const sub = scene.add
+      .text(0, 12, opts.subtitle, textStyle('micro', { color: variant === 'ghost' || variant === 'dark' ? CSS.dim : '#04070f' }))
+      .setOrigin(0.5)
+      .setAlpha(0.75);
+    container.add(sub);
+  }
+
+  container.setSize(width, height);
+  container.setInteractive(
+    new Phaser.Geom.Rectangle(-width / 2, -height / 2, width, height),
+    Phaser.Geom.Rectangle.Contains,
+  );
+
+  let enabled = opts.enabled !== false;
+  const setEnabled = (value: boolean) => {
+    enabled = value;
+    container.setAlpha(value ? 1 : 0.45);
+    if (value) container.setInteractive(new Phaser.Geom.Rectangle(-width / 2, -height / 2, width, height), Phaser.Geom.Rectangle.Contains);
+    else container.disableInteractive();
+  };
+
+  container.on('pointerdown', () => {
+    if (!enabled) return;
+    container.setScale(0.97);
+  });
+  container.on('pointerup', () => {
+    if (!enabled) return;
+    container.setScale(1);
+    feedback(scene, container);
+    opts.onTap?.();
+  });
+  container.on('pointerout', () => container.setScale(1));
+
+  if (opts.enabled === false) setEnabled(false);
+
+  return {
+    container,
+    setLabel: (text: string) => label.setText(text),
+    setEnabled,
+    setVisible: (value: boolean) => container.setVisible(value),
+    setPosition: (x: number, y: number) => container.setPosition(x, y),
+    setAlpha: (value: number) => container.setAlpha(value),
+    setColor: (color: number) => {
+      bg.setFillStyle(color, 1);
+      glow.setTint(color);
+    },
+    destroy: () => container.destroy(true),
+    get width() {
+      return width;
+    },
+    get height() {
+      return height;
+    },
+  };
+}
+
+/** Панель: скруглённая поверхность с опциональным заголовком и свечением. */
+export function panel(
+  scene: Phaser.Scene,
+  opts: {
+    x: number;
+    y: number;
