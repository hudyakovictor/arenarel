+++ b/src/game/scenes/LessonScene.ts
@@ -0,0 +1,232 @@
+/**
+ * LessonScene — разборы: пять принципов, из которых состоит вся игра.
+ * Читается за 40–60 секунд. Ни одного «урока на 40 экранов».
+ */
+
+import Phaser from 'phaser';
+import { BaseScene } from './BaseScene';
+import { button, chip, heading, panel, paragraph } from '../../ui/kit';
+import { pager, toast, topBar } from '../../ui/parts';
+import { COLORS, CSS, FONT } from '../theme';
+import { CENTER, DEPTH, SAFE } from '../design';
+import { store } from '../../core/store';
+import { LESSONS, type LessonDef } from '../../data/lessons';
+
+const CRITERION_LABEL: Record<LessonDef['criterion'], string> = {
+  context: 'КОНТЕКСТ',
+  evidence: 'УЛИКИ',
+  protocol: 'СТОЙКА',
+  risk: 'РИСК',
+  composure: 'САМООБЛАДАНИЕ',
+};
+
+const CRITERION_COLOR: Record<LessonDef['criterion'], number> = {
+  context: COLORS.cyan,
+  evidence: COLORS.green,
+  protocol: COLORS.purple,
+  risk: COLORS.gold,
+  composure: COLORS.orange,
+};
+
+export class LessonScene extends BaseScene {
+
+  constructor() {
+    super('lesson');
+  }
+  private openId: string | null = null;
+  private page = 0;
+  private content?: Phaser.GameObjects.Container;
+
+  init(data: { id?: string } = {}): void {
+    this.openId = data?.id ?? null;
+  }
+
+  protected override accent(): number {
+    return COLORS.purple;
+  }
+
+  protected override build(): void {
+    topBar(this);
+    this.content = this.add.container(0, 0).setDepth(DEPTH.content);
+    this.onCleanup(store.subscribe(() => this.render()));
+    this.render();
+    this.fadeInCamera();
+  }
+
+  private render(): void {
+    const root = this.content;
+    if (!root) return;
+    root.removeAll(true);
+    if (this.openId) this.renderDetail(root, this.openId);
+    else this.renderList(root);
+  }
+
+  private renderList(root: Phaser.GameObjects.Container): void {
+    const width = this.scale.width;
+    const hunts = store.state.profile.hunts;
+
+    const title = heading(this, SAFE.left, 92, 'РАЗБОРЫ', { size: 14, color: COLORS.text });
+    const sub = paragraph(this, SAFE.left, 112, 'Пять принципов. Каждый связан с критерием оценки решения.', { size: 9, color: COLORS.dim, width: width - 40 });
+    sub.setOrigin(0, 0);
+    root.add([title, sub]);
+
+    const perPage = 4;
+    const pages = Math.max(1, Math.ceil(LESSONS.length / perPage));
+    if (this.page >= pages) this.page = pages - 1;
+    LESSONS.slice(this.page * perPage, (this.page + 1) * perPage).forEach((lesson, index) => {
+      const y = 176 + index * 116 + 44;
+      const locked = hunts < lesson.unlockedByHunt;
+      const seen = Boolean(store.state.flags[`lesson_${lesson.id}`]);
+      const color = CRITERION_COLOR[lesson.criterion];
+      const row = panel(this, {
+        x: CENTER.x,
+        y,
+        w: width - 36,
+        h: 100,
+        radius: 14,
+        fill: seen ? COLORS.card : COLORS.bg2,
+        fillAlpha: 0.86,
+        stroke: seen ? color : COLORS.line,
+        strokeAlpha: seen ? 0.45 : 0.16,
+      });
+      const tag = chip(this, -(width - 36) / 2 + 52, -30, CRITERION_LABEL[lesson.criterion], color, { fontSize: 8 });
+      const lessonTitle = this.add.text(-((width - 36) / 2) + 16, -12, locked ? 'ЗАКРЫТО' : lesson.title, {
+        fontFamily: FONT.display,
+        fontSize: '12px',
+        color: locked ? CSS.dim : CSS.text,
+      });
+      const lead = this.add.text(-((width - 36) / 2) + 16, 12, locked ? `Откроется после ${lesson.unlockedByHunt} охот` : lesson.lead, {
+        fontFamily: FONT.ui,
+        fontSize: '9px',
+        color: CSS.dim,
+        wordWrap: { width: width - 76, useAdvancedWrap: true },
+      });
+      row.add([tag.container, lessonTitle, lead]);
+      if (!locked) {
+        row.setInteractive(new Phaser.Geom.Rectangle(-(width - 36) / 2, -50, width - 36, 100), Phaser.Geom.Rectangle.Contains);
+        row.on('pointerup', () => {
+          this.openId = lesson.id;
+          this.render();
+        });
+      }
+      if (seen) {
+        const done = chip(this, (width - 36) / 2 - 46, 32, 'ПРОЙДЕН', COLORS.dim, { fontSize: 8 });
+        row.add(done.container);
+      }
+      root.add(row);
+    });
+
+    root.add(
+      pager(this, {
+        x: CENTER.x,
+        y: 176 + 4 * 116 + 8,
+        page: this.page,
+        pages,
+        color: COLORS.purple,
+        onChange: (page) => {
+          this.page = page;
+          this.render();
+        },
+      }),
+    );
+
+    const back = button(this, {
+      x: CENTER.x,
+      y: this.scale.height - 44,
+      w: width - 40,
+      h: 46,
+      text: 'НАЗАД',
+      variant: 'soft',
+      fontSize: 11,
+      onTap: () => this.go('hub'),
+    });
+    back.container.setDepth(DEPTH.hud);
+  }
+
+  private renderDetail(root: Phaser.GameObjects.Container, id: string): void {
+    const width = this.scale.width;
+    const lesson = LESSONS.find((item) => item.id === id);
+    if (!lesson) {
+      this.openId = null;
+      this.render();
+      return;
+    }
+    const color = CRITERION_COLOR[lesson.criterion];
+    const bodyPanel = panel(this, {
+      x: CENTER.x,
+      y: 300,
+      w: width - 36,
+      h: 340,
+      fill: COLORS.card,
+      glow: color,
+      glowAlpha: 0.1,
+    });
+    const tag = chip(this, -(width - 36) / 2 + 52, -146, CRITERION_LABEL[lesson.criterion], color, { fontSize: 8 });
+    const title = this.add.text(-((width - 36) / 2) + 16, -118, lesson.title, {
+      fontFamily: FONT.display,
+      fontSize: '15px',
+      color: CSS.text,
+      wordWrap: { width: width - 76, useAdvancedWrap: true },
+    });
+    const lead = this.add.text(-((width - 36) / 2) + 16, -84, lesson.lead, {
+      fontFamily: FONT.ui,
+      fontSize: '11px',
+      color: `#${color.toString(16).padStart(6, '0')}`,
+      wordWrap: { width: width - 76, useAdvancedWrap: true },
+      lineSpacing: 4,
+    });
+    bodyPanel.add([tag.container, title, lead]);
+
+    let y = -40;
+    lesson.body.forEach((text) => {
+      const para = paragraph(this, -((width - 36) / 2) + 16, y, text, { size: 10, color: COLORS.muted, width: width - 76, lineSpacing: 5 });
+      para.setOrigin(0, 0);
+      bodyPanel.add(para);
+      y += para.height + 12;
+    });
+    root.add(bodyPanel);
+
+    const practice = panel(this, { x: CENTER.x, y: 520, w: width - 36, h: 92, fill: COLORS.bg2, fillAlpha: 0.86, stroke: color, strokeAlpha: 0.35 });
+    const practiceTitle = heading(this, -((width - 36) / 2) + 16, -26, 'ПРАКТИКА', { size: 9, color: color });
+    const practiceText = paragraph(this, -((width - 36) / 2) + 16, -6, lesson.practice, {
+      size: 10,
+      color: COLORS.text,
+      width: width - 76,
+      lineSpacing: 4,
+    });
+    practiceText.setOrigin(0, 0);
+    practice.add([practiceTitle, practiceText]);
+    root.add(practice);
+
+    const back = button(this, {
+      x: CENTER.x - 78,
+      y: this.scale.height - 44,
+      w: 148,
+      h: 46,
+      text: 'К СПИСКУ',
+      variant: 'soft',
+      fontSize: 11,
+      onTap: () => {
+        this.openId = null;
+        this.render();
+      },
+    });
+    const apply = button(this, {
+      x: CENTER.x + 90,
+      y: this.scale.height - 44,
+      w: 168,
+      h: 46,
+      text: 'ПОНЯТНО',
+      variant: 'primary',
+      fontSize: 11,
+      onTap: () => {
+        store.state.flags[`lesson_${lesson.id}`] = 1;
+        toast(this, 'ПРИНЦИП ПРИНЯТ', 'good');
+        this.openId = null;
+        this.render();
+      },
+    });
+    back.container.setDepth(DEPTH.hud);
+    apply.container.setDepth(DEPTH.hud);
+  }
+}
