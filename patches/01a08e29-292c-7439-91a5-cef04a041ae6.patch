+export interface WaveformHandle {
+  container: Phaser.GameObjects.Container;
+  setData(spec: WaveformSpec): void;
+  printPre(duration?: number): void;
+  stamp(): void;
+  printPost(seal: Seal | null, duration?: number, from?: number, to?: number): void;
+  setPlayerLine(values: number[], color: number): void;
+  clearPlayerLine(): void;
+  reset(): void;
+}
+
+/**
+ * Аналоговая лента самописца. Это не свечной график и не биржевой стакан:
+ * прибор печатает историю, а охотник уже поставил печать.
+ */
+export function waveformView(
+  scene: Phaser.Scene,
+  opts: { x: number; y: number; w: number; h: number; accent?: number; depth?: number },
+): WaveformHandle {
+  const container = scene.add.container(opts.x, opts.y).setDepth(opts.depth ?? 0);
+  const accent = opts.accent ?? COLORS.cyan;
+  const { w, h } = opts;
+
+  const paper = scene.add.rectangle(0, 0, w, h, COLORS.bg2, 0.85);
+  paper.setStrokeStyle(1.4, COLORS.line, 0.35);
+  container.add(paper);
+
+  const dots = scene.add.tileSprite(0, 0, w - 2, h - 2, 'tex_grid').setAlpha(0.4);
+  container.add(dots);
+
+  const line = scene.add.graphics();
+  const playerLine = scene.add.graphics();
+  const head = scene.add.rectangle(0, 0, 2, h - 8, COLORS.cyan, 0.9);
+  const headGlow = scene.add.image(0, 0, 'tex_glow').setDisplaySize(40, h).setTint(COLORS.cyan).setAlpha(0.4).setBlendMode(Phaser.BlendModes.ADD);
+  head.setVisible(false);
+  headGlow.setVisible(false);
+
+  const stampLine = scene.add.rectangle(0, 0, 2, h, COLORS.red, 0.9).setVisible(false);
+  const stampMark = scene.add.image(0, 0, 'tex_stampRing').setDisplaySize(h * 0.55, h * 0.55).setAlpha(0).setVisible(false);
+  const stampLabel = scene.add
+    .text(0, -h / 2 + 10, 't₀', { fontFamily: FONT.mono, fontSize: '10px', color: CSS.red })
+    .setOrigin(0.5, 0)
+    .setVisible(false);
+
+  const axisLabels = scene.add.container(0, 0);
+  const leftLabel = scene.add.text(-w / 2 + 6, h / 2 - 12, 'ЗАПИСЬ ДО t₀', { fontFamily: FONT.ui, fontSize: '8px', color: CSS.dim, fontStyle: '700' }).setOrigin(0, 0.5).setAlpha(0.9);
+  const rightLabel = scene.add.text(w / 2 - 6, h / 2 - 12, 'ПЕЧАТЬ БУДУЩЕГО', { fontFamily: FONT.ui, fontSize: '8px', color: CSS.dim, fontStyle: '700' }).setOrigin(1, 0.5).setAlpha(0.9);
+  axisLabels.add([leftLabel, rightLabel]);
+
+  container.add([dots as unknown as Phaser.GameObjects.GameObject, playerLine, line, axisLabels, headGlow, head, stampLine, stampMark, stampLabel]);
+
+  let spec: WaveformSpec | null = null;
+  let progress = 0;
+  let postProgress = 0;
+  let t0x = 0;
+
+  const toX = (index: number, total: number) => -w / 2 + 8 + ((w - 16) * index) / Math.max(1, total - 1);
+  const toY = (value: number) => h / 2 - 12 - value * (h - 26);
+
+  const redraw = () => {
+    line.clear();
+    if (!spec) return;
+    const pre = spec.pre;
+    const post = spec.post;
+
+    // Лента до t₀
+    const preCount = Math.max(1, Math.floor(pre.length * progress));
+    line.lineStyle(2, accent, 0.95);
+    line.beginPath();
+    for (let i = 0; i < preCount; i++) {
+      const x = toX(i, pre.length + post.length);
+      const y = toY(pre[i] ?? 0.5);
+      if (i === 0) line.moveTo(x, y);
+      else line.lineTo(x, y);
+    }
+    line.strokePath();
+
+    // Продолжение после печати
+    if (postProgress > 0) {
+      const total = pre.length + post.length;
+      const startIndex = pre.length - 1;
+      const drawn = Math.max(1, Math.floor(post.length * postProgress));
+      line.lineStyle(2, COLORS.gold, 0.95);
+      line.beginPath();
+      const startX = toX(startIndex, total);
+      const startY = toY(pre[pre.length - 1] ?? 0.5);
+      line.moveTo(startX, startY);
+      for (let i = 0; i < drawn; i++) {
+        const x = toX(pre.length + i, total);
+        const y = toY(post[i] ?? 0.5);
+        line.lineTo(x, y);
+      }
+      line.strokePath();
+    }
+  };
+
+  const setData = (next: WaveformSpec) => {
+    spec = next;
+    progress = 0;
+    postProgress = 0;
+    t0x = toX(next.pre.length - 1, next.pre.length + next.post.length);
+    redraw();
+    stampLine.setPosition(t0x, 0);
+    stampMark.setPosition(t0x, 0);
+    stampLabel.setPosition(t0x, -h / 2 + 10);
+    head.setPosition(-w / 2 + 8, 0);
+  };
+
+  const printPre = (duration = 1500) => {
+    head.setVisible(true);
+    headGlow.setVisible(true);
+    progress = 0;
+    const counter = { v: 0 };
+    scene.tweens.add({
+      targets: counter,
+      v: 1,
+      duration,
+      ease: 'Linear',
+      onUpdate: () => {
+        progress = counter.v;
+        redraw();
+        const x = -w / 2 + 8 + (t0x + w / 2 - 8) * counter.v;
+        head.setPosition(x, 0);
+        headGlow.setPosition(x, 0);
+        audio.play('print');
+      },
+      onComplete: () => {
+        head.setVisible(false);
+        headGlow.setVisible(false);
+      },
+    });
+  };
+
+  const stamp = () => {
+    stampLine.setVisible(true);
+    stampMark.setVisible(true);
+    stampLabel.setVisible(true);
+    stampMark.setAlpha(0);
+    stampMark.setScale(1.6);
+    audio.play('stamp');
+    haptics.vibrate('seal');
+    scene.tweens.add({ targets: stampMark, alpha: 0.85, scale: 1, duration: 420, ease: EASE.back });
+    scene.tweens.add({ targets: stampMark, alpha: 0.35, duration: 900, delay: 600 });
+    scene.cameras.main.shake(160, 0.004);
+  };
+
+  const printPost = (seal: Seal | null, duration = 1400, from = 0, to = 1) => {
+    head.setVisible(true);
+    headGlow.setVisible(true);
+    const counter = { v: from };
+    const total = (spec?.pre.length ?? 0) + (spec?.post.length ?? 0);
+    scene.tweens.add({
+      targets: counter,
+      v: to,
+      duration,
+      ease: 'Sine.easeOut',
+      onUpdate: () => {
+        postProgress = counter.v;
+        redraw();
+        const startIndex = (spec?.pre.length ?? 1) - 1;
+        const x = toX(startIndex, total) + (w / 2 - 8 - toX(startIndex, total)) * counter.v;
+        head.setPosition(x, 0);
+        headGlow.setPosition(x, 0);
+        if (counter.v < 0.98) audio.play('print');
+      },
+      onComplete: () => {
+        head.setVisible(false);
+        headGlow.setVisible(false);
+        void seal;
+      },
+    });
+  };
+
+  const setPlayerLine = (values: number[], color: number) => {
+    playerLine.clear();
+    if (!spec) return;
+    const total = spec.pre.length + spec.post.length;
+    playerLine.lineStyle(2, color, 0.7);
+    playerLine.beginPath();
+    let index = spec.pre.length - 1;
+    playerLine.moveTo(toX(index, total), toY(spec.pre[spec.pre.length - 1] ?? 0.5));
+    for (const v of values) {
+      index += 1;
+      playerLine.lineTo(toX(index, total), toY(v));
+    }
+    playerLine.strokePath();
+  };
+
+  const clearPlayerLine = () => playerLine.clear();
+
+  const reset = () => {
+    spec = null;
+    progress = 0;
+    postProgress = 0;
+    line.clear();
+    playerLine.clear();
+    stampLine.setVisible(false);
+    stampMark.setVisible(false);
+    stampLabel.setVisible(false);
+    head.setVisible(false);
+    headGlow.setVisible(false);
+  };
+
+  return { container, setData, printPre, stamp, printPost, setPlayerLine, clearPlayerLine, reset };
+}
+
+export interface HoldHandle {
+  container: Phaser.GameObjects.Container;
+  setEnabled(value: boolean): void;
+  setLabel(text: string): void;
+}
+
+/** «Проявить улику»: удержание с кольцом прогресса — тактильный ритуал вместо кнопки. */
+export function holdToReveal(
+  scene: Phaser.Scene,
+  opts: {
+    x: number;
+    y: number;
+    size?: number;
+    label?: string;
+    duration?: number;
+    color?: number;
+    onComplete: () => void;
+    onCancel?: () => void;
+  },
+): HoldHandle {
+  const size = opts.size ?? 76;
+  const color = opts.color ?? COLORS.cyan;
+  const container = scene.add.container(opts.x, opts.y);
+  let enabled = true;
+
+  const glow = scene.add.image(0, 0, 'tex_glow').setDisplaySize(size * 2, size * 2).setTint(color).setAlpha(0.16).setBlendMode(Phaser.BlendModes.ADD);
+  container.add(glow);
+
+  const bg = rex(scene).add.roundRectangle(0, 0, size, size, size / 2, COLORS.bg2, 0.95) as RexShape;
+  bg.setStrokeStyle(1.5, COLORS.line, 0.3);
+  container.add(bg as unknown as Phaser.GameObjects.GameObject);
+
+  const progress = rex(scene).add.circularProgress({
+    x: 0,
+    y: 0,
+    radius: size / 2 + 6,
+    trackColor: 0x22314f,
+    barColor: color,
+    centerColor: 0x0,
+    value: 0,
+    antialias: true,
+  });
+  progress.setAlpha(0.95);
+  container.add(progress as unknown as Phaser.GameObjects.GameObject);
+
+  const iconHolder = icon(scene, 'scan', 22, color, 2);
+  iconHolder.setPosition(0, -6);
+  const label = scene.add
+    .text(0, size / 3, opts.label ?? 'ДЕРЖИ', { fontFamily: FONT.ui, fontSize: '9px', color: CSS.muted, fontStyle: '700' })
+    .setOrigin(0.5);
+  container.add([iconHolder, label]);
+
+  let tween: Phaser.Tweens.Tween | null = null;
+  const duration = opts.duration ?? 1000;
+
+  const stop = (completed: boolean) => {
+    tween?.stop();
+    tween = null;
+    if (!completed) {
+      progress.setValue(0);
+      if (opts.onCancel) opts.onCancel();
+    }
+  };
+
+  const hit = scene.add.circle(0, 0, size / 2 + 10, 0xffffff, 0.001).setInteractive({ useHandCursor: true });
+  hit.on('pointerdown', () => {
+    if (!enabled) return;
+    audio.play('tick');
+    haptics.vibrate('tap');
+    const counter = { v: 0 };
+    tween = scene.tweens.add({
+      targets: counter,
+      v: 1,
+      duration,
+      ease: 'Linear',
+      onUpdate: () => {
+        progress.setValue(counter.v);
+        if (counter.v > 0.5 && Math.floor(counter.v * 10) % 3 === 0) audio.play('print');
+      },
+      onComplete: () => {
+        progress.setValue(1);
+        audio.play('reveal');
+        haptics.vibrate('reveal');
+        opts.onComplete();
+      },
+    });
+  });
+  hit.on('pointerup', () => stop(false));
+  hit.on('pointerout', () => stop(false));
+  container.add(hit);
+
+  return {
+    container,
+    setEnabled: (value: boolean) => {
+      enabled = value;
+      container.setAlpha(value ? 1 : 0.4);
+    },
+    setLabel: (text: string) => label.setText(text),
+  };
+}
+
+export interface ConfirmOptions {
+  title: string;
+  text: string;
+  confirmLabel?: string;
+  cancelLabel?: string;
+  tone?: 'default' | 'danger';
+}
+
+/** Диалог подтверждения на RexUI: возвращает промис, работает и на тапах, и на жестах. */
+export function confirmDialog(scene: Phaser.Scene, opts: ConfirmOptions): Promise<boolean> {
+  const rexUI = rex(scene);
+  const width = Math.min(360, scene.scale.width - 40);
+  const tone = opts.tone === 'danger' ? COLORS.red : COLORS.cyan;
+
+  const confirmBtn = rexUI.add.label({
+    name: 'confirm',
+    background: rexUI.add.roundRectangle(0, 0, 140, 46, RADIUS.button, tone, 1),
+    text: scene.add.text(0, 0, (opts.confirmLabel ?? 'ПОДТВЕРДИТЬ').toUpperCase(), textStyle('button', { fontSize: '12px', color: '#04070f' })),
+    space: { left: 14, right: 14, top: 10, bottom: 10 },
+  });
+  const cancelBtn = rexUI.add.label({
+    name: 'cancel',
+    background: rexUI.add.roundRectangle(0, 0, 130, 46, RADIUS.button, COLORS.card2, 0.95).setStrokeStyle(1.4, COLORS.line, 0.4),
+    text: scene.add.text(0, 0, (opts.cancelLabel ?? 'ОТМЕНА').toUpperCase(), textStyle('button', { fontSize: '12px' })),
+    space: { left: 14, right: 14, top: 10, bottom: 10 },
+  });
+
+  const dialog = rexUI.add.dialog({
+    x: scene.scale.width / 2,
+    y: scene.scale.height / 2,
+    width,
+    background: rexUI.add.roundRectangle(0, 0, 100, 100, RADIUS.card, COLORS.card, 0.99).setStrokeStyle(1.6, tone, 0.5),
+    title: scene.add.text(0, 0, opts.title.toUpperCase(), textStyle('h3', { fontSize: '14px' })),
+    content: scene.add.text(0, 0, opts.text, textStyle('body', { fontSize: '12px', lineSpacing: 4 })),
+    actions: [cancelBtn, confirmBtn],
+    space: { title: 14, content: 12, action: 10, left: 18, right: 18, top: 18, bottom: 18 },
+    align: { actions: 'right' },
+  });
+  dialog.setDepth(DEPTH.dialog);
+  dialog.layout();
+
+  return (rexUI.modalPromise?.(dialog as unknown as Phaser.GameObjects.GameObject) as Promise<unknown>).then(
+    (value) => value === 'confirm' || value === confirmBtn,
+  );
+}
+
+/** Строка критерия DQI для разбора: название, значение, полоса, пояснения. */
+export function criterionRow(
+  scene: Phaser.Scene,
+  opts: { x: number; y: number; w: number; label: string; value: number; max: number; color: number; lines?: string[]; delay?: number },
+): Phaser.GameObjects.Container {
+  const container = scene.add.container(opts.x, opts.y);
+  const label = scene.add.text(0, 0, opts.label, { fontFamily: FONT.ui, fontSize: '10px', color: CSS.muted, fontStyle: '700' }).setOrigin(0, 0);
+  const value = scene.add
+    .text(opts.w, 0, `${opts.value}/${opts.max}`, { fontFamily: FONT.mono, fontSize: '11px', color: `#${opts.color.toString(16).padStart(6, '0')}` })
+    .setOrigin(1, 0);
+  const barBg = scene.add.rectangle(0, 18, opts.w, 6, 0x0a1330, 1).setOrigin(0, 0.5);
+  const bar = scene.add.rectangle(0, 18, 2, 6, opts.color, 1).setOrigin(0, 0.5);
+  container.add([label, value, barBg, bar]);
+
+  const target = Math.max(2, (opts.w * opts.value) / opts.max);
+  if (store.state.settings.reduceMotion) {
+    bar.displayWidth = target;
+  } else {
+    bar.displayWidth = 2;
+    scene.tweens.add({ targets: bar, displayWidth: target, duration: 520, delay: opts.delay ?? 0, ease: EASE.out });
+  }
+
+  if (opts.lines?.length) {
+    let y = 30;
+    for (const line of opts.lines.slice(0, 3)) {
+      const text = scene.add.text(0, y, `· ${line}`, {
+        fontFamily: FONT.ui,
+        fontSize: '9px',
+        color: CSS.dim,
+        wordWrap: { width: opts.w, useAdvancedWrap: true },
+      });
+      container.add(text);
+      y += text.height + 3;
+    }
+  }
+  return container;
+}
+
+export { button, chip, toastFn as toast, RARITY, FS, CENTER };
