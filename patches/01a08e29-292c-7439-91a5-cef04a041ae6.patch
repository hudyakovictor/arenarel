+/**
+ * cards.ts — 33 протокола охотника. Нечётность здесь не случайна: у решения всегда есть третий путь.
+ * Карты не «дают прибыль». Они меняют правила оценки решения — то есть учат думать, а не угадывать.
+ * Рука — 4 карты. Одна из них закрепляется как стойка охоты.
+ */
+
+import type { CardClass, Clue, RiskSeal, Seal } from '../core/types';
+
+export interface CardEffect {
+  /** Дополнительные сканирования улик. */
+  scanBonus?: number;
+  /** Бонус к весу улик определённого типа. */
+  clueWeightBonus?: Partial<Record<Clue['kind'], number>>;
+  /** Плоские бонусы к критериям. */
+  contextBonus?: number;
+  evidenceBonus?: number;
+  riskBonus?: number;
+  composureBonus?: number;
+  protocolBonus?: number;
+  /** Дополнительное время на ответ в атаке шума (мс). */
+  whisperTimeBonus?: number;
+  /** +бонус к самообладанию за каждую открытую улику толпы. */
+  composurePerCrowdClue?: number;
+  /** Бонус при конкретной печати t₀. */
+  bonusIfSeal?: { seal: Seal; value: number };
+  /** Бонус за отказ от входа. */
+  bonusIfNotEntered?: number;
+  /** Бонус, если печать риска верна. */
+  bonusIfRiskCorrect?: number;
+  /** Бонус, если развито 3+ улики. */
+  bonusIfEvidence3?: number;
+  /** Бонус, если игрок не сорвался ни разу. */
+  bonusIfNoBreak?: number;
+  /** Полностью гасит первую атаку шума. */
+  blockFirstWhisper?: boolean;
+  /** +бонус, если предыдущая охота была провалом. */
+  bonusAfterLoss?: number;
+  /** Минимально допустимая печать риска (не даёт «отпустить» лимит). */
