@@ -0,0 +1,111 @@
+/**
+ * rng.ts — детерминированный генератор.
+ *
+ * Правило игры: ни один элемент охоты не зависит от Math.random.
+ * Один и тот же сид даёт одну и ту же охоту у всех игроков — это позволяет
+ * сравнивать решения, а не удачу.
+ */
+
+/** FNV-1a: строка → 32-битный сид. */
+export function fnv1a(value: string): number {
+  let hash = 0x811c9dc5;
+  for (let index = 0; index < value.length; index += 1) {
+    hash ^= value.charCodeAt(index);
+    hash = Math.imul(hash, 0x01000193) >>> 0;
+  }
+  return hash >>> 0;
+}
+
+/** mulberry32: быстрый и предсказуемый PRNG. */
+export function mulberry32(seed: number): () => number {
+  let state = seed >>> 0;
+  return () => {
+    state = (state + 0x6d2b79f5) >>> 0;
+    let t = state;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+export class Rng {
+  readonly seed: string;
+  private readonly next: () => number;
+
+  constructor(seed: string | number) {
+    this.seed = String(seed);
+    this.next = mulberry32(typeof seed === 'number' ? seed >>> 0 : fnv1a(this.seed));
+  }
+
+  /** Дробное число [0, 1). */
+  float(): number {
+    return this.next();
+  }
+
+  /** Целое в диапазоне [min, max] включительно. */
+  int(min: number, max: number): number {
+    if (max < min) return min;
+    return min + Math.floor(this.next() * (max - min + 1));
+  }
+
+  chance(probability: number): boolean {
+    return this.next() < probability;
+  }
+
+  pick<T>(items: readonly T[]): T {
+    if (!items.length) throw new Error(`Rng(${this.seed}): пустой набор`);
+    return items[Math.min(items.length - 1, Math.floor(this.next() * items.length))]!;
+  }
+
+  /** Перемешивание Фишера — Йетса без мутации входа. */
+  shuffle<T>(items: readonly T[]): T[] {
+    const copy = [...items];
+    for (let index = copy.length - 1; index > 0; index -= 1) {
+      const swap = Math.floor(this.next() * (index + 1));
+      [copy[index], copy[swap]] = [copy[swap]!, copy[index]!];
+    }
+    return copy;
+  }
+
+  /** Выбор с весами: [{ item, weight }] → item. */
+  weighted<T>(entries: readonly { item: T; weight: number }[]): T {
+    const total = entries.reduce((sum, entry) => sum + Math.max(0, entry.weight), 0);
+    if (total <= 0) return this.pick(entries).item;
+    let roll = this.next() * total;
+    for (const entry of entries) {
+      roll -= Math.max(0, entry.weight);
+      if (roll <= 0) return entry.item;
+    }
+    return entries[entries.length - 1]!.item;
+  }
+
+  /** Производный генератор: разные подсистемы не мешают друг другу. */
+  derive(tag: string): Rng {
+    return new Rng(`${this.seed}::${tag}`);
+  }
+}
+
+/** День в UTC: ключ суточных событий одинаков для всех часовых поясов. */
+export function dayKey(date: Date = new Date()): string {
+  const year = date.getUTCFullYear();
+  const month = `${date.getUTCMonth() + 1}`.padStart(2, '0');
+  const day = `${date.getUTCDate()}`.padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
+
+/** Неделя в UTC по ISO-8601: 2026-W37. */
+export function weekKey(date: Date = new Date()): string {
+  const target = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));
+  const dayNumber = (target.getUTCDay() + 6) % 7;
+  target.setUTCDate(target.getUTCDate() - dayNumber + 3);
+  const firstThursday = new Date(Date.UTC(target.getUTCFullYear(), 0, 4));
+  const firstDayNumber = (firstThursday.getUTCDay() + 6) % 7;
+  firstThursday.setUTCDate(firstThursday.getUTCDate() - firstDayNumber + 3);
+  const week = 1 + Math.round((target.getTime() - firstThursday.getTime()) / (7 * 86400000));
+  return `${target.getUTCFullYear()}-W${`${week}`.padStart(2, '0')}`;
+}
+
+/** Сид конкретной подсистемы на конкретный день. */
+export function dailySeed(kind: string, date: Date = new Date()): string {
+  return `${kind}:${dayKey(date)}`;
+}
