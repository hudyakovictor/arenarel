+/** Архетип охотника читается по привычке ставить печати — и по её отсутствию. */
+function readArchetype(): { title: string; text: string; advice: string; color: number } {
+  const profile = store.state.profile;
+  const total = Math.max(1, profile.seals.wait + profile.seals.enter + profile.seals.exit);
+  const waitShare = profile.seals.wait / total;
+  const enterShare = profile.seals.enter / total;
+  const breakRate = profile.holds + profile.breaks > 0 ? profile.breaks / (profile.holds + profile.breaks) : 0;
+  const avg = profile.hunts ? profile.sumDqi / profile.hunts : 0;
+
+  if (breakRate > 0.4) {
+    return {
+      title: 'ИМПУЛЬСИВНЫЙ ТИП',
+      text: 'Ты видишь рынок быстрее, чем выдерживаешь его. Протокол у тебя заканчивается раньше, чем рынок начинает говорить.',
+      advice: 'стойка с защитой от шума и лимит 0.5% на следующую охоту',
+      color: COLORS.red,
+    };
+  }
+  if (waitShare > 0.65) {
+    return {
+      title: 'НАБЛЮДАТЕЛЬ',
+      text: 'Ты сохраняешь капитал лучше, чем участвуешь. Это дороже, чем кажется: рынок платит за решения, а не за ожидание.',
+      advice: 'войти на следующей охоте, если улик три и больше',
+      color: COLORS.gold,
+    };
+  }
+  if (enterShare > 0.6 && avg < 65) {
+    return {
+      title: 'ОХОТНИК БЕЗ СЕТИ',
+      text: 'Ты входишь часто и объясняешь это контекстом. Контекст у тебя есть. Протокола — нет.',
+      advice: 'печать «ВЫЙТИ» в случаях, где сейчас выбираешь вход',
+      color: COLORS.orange,
+    };
+  }
+  if (avg >= 75) {
+    return {
+      title: 'ЧИСТЫЙ ПРОТОКОЛ',
+      text: 'Твои решения не зависят от исхода. Именно так выглядит охотник, которого рынку трудно зацепить.',
+      advice: 'пробовать ежедневные охоты с множителем ×2',
+      color: COLORS.green,
+    };
+  }
+  return {
+    title: 'ФОРМИРУЮЩИЙСЯ ПРОТОКОЛ',
+    text: 'У тебя есть привычка проверять себя. Пока это ещё не стиль, но уже не случайность.',
+    advice: 'пройти разбор по критерию, где снимаешь больше всего баллов',
+    color: COLORS.cyan,
+  };
+}
