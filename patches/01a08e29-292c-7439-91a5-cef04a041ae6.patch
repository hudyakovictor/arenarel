@@ -0,0 +1,122 @@
+/**
+ * main.ts — вход в SIGNAL ARENA.
+ * Здесь: загрузка шрифтов, создание игры, обработка ошибок и снятие завесы загрузки.
+ */
+
+import './styles/global.css';
+import '@fontsource/russo-one/cyrillic-400.css';
+import '@fontsource/russo-one/latin-400.css';
+import '@fontsource/manrope/cyrillic-400.css';
+import '@fontsource/manrope/cyrillic-600.css';
+import '@fontsource/manrope/cyrillic-700.css';
+import '@fontsource/manrope/cyrillic-800.css';
+import '@fontsource/manrope/latin-400.css';
+import '@fontsource/manrope/latin-600.css';
+import '@fontsource/manrope/latin-700.css';
+import '@fontsource/manrope/latin-800.css';
+import '@fontsource/jetbrains-mono/cyrillic-500.css';
+import '@fontsource/jetbrains-mono/latin-500.css';
+
+import Phaser from 'phaser';
+import { createGameConfig } from './game/config';
+import { BootScene } from './game/scenes/BootScene';
+import { TitleScene } from './game/scenes/TitleScene';
+import { HubScene } from './game/scenes/HubScene';
+import { HuntScene } from './game/scenes/HuntScene';
+import { CodexScene } from './game/scenes/CodexScene';
+import { DeckScene } from './game/scenes/DeckScene';
+import { ProfileScene } from './game/scenes/ProfileScene';
+import { ShopScene } from './game/scenes/ShopScene';
+import { SettingsScene } from './game/scenes/SettingsScene';
+import { LessonScene } from './game/scenes/LessonScene';
+import { store } from './core/store';
+import { audio } from './core/audio';
+import { haptics } from './core/haptics';
+import { analytics } from './core/analytics';
+import { setLang } from './core/i18n';
+import { hideBootVeil, setBootProgress, showBootError } from './game/boot-overlay';
+
+declare global {
+  interface Window {
+    __SIGNAL_ARENA__?: {
+      game: Phaser.Game;
+      version: string;
+    };
+  }
+}
+
+const errorBox = document.getElementById('boot-error');
+
+function showFatal(message: string): void {
+  showBootError(message);
+  void errorBox;
+}
+
+async function waitForFonts(): Promise<void> {
+  const fonts = (document as Document & { fonts?: FontFaceSet }).fonts;
+  if (!fonts) return;
+  const specs = ['700 16px Manrope', '400 16px "Russo One"', '500 16px "JetBrains Mono"'];
+  try {
+    await Promise.race([
+      Promise.all(specs.map((spec) => fonts.load(spec).catch(() => undefined))),
+      new Promise((resolve) => window.setTimeout(resolve, 2500)),
+    ]);
+    await Promise.race([fonts.ready, new Promise((resolve) => window.setTimeout(resolve, 1500))]);
+  } catch {
+    // шрифты — не повод не играть: система подставит свой
+  }
+}
+
+async function bootstrap(): Promise<void> {
+  setBootProgress(0.15, 'аналоговый протокол инициализации…');
+  store.init();
+  setLang(store.state.settings.lang);
+  analytics.setEnabled(store.state.settings.analytics);
+  haptics.enabled = store.state.settings.haptics;
+  audio.setVolumes(store.state.settings.sound, store.state.settings.music);
+
+  await waitForFonts();
+  setBootProgress(0.45, 'проявляем улики…');
+
+  const scenes = [
+    BootScene,
+    TitleScene,
+    HubScene,
+    HuntScene,
+    CodexScene,
+    DeckScene,
+    ProfileScene,
+    ShopScene,
+    SettingsScene,
+    LessonScene,
+  ];
+
+  const game = new Phaser.Game(createGameConfig(scenes));
+  window.__SIGNAL_ARENA__ = { game, version: '1.0.0' };
+
+  window.addEventListener(
+    'pointerdown',
+    () => {
+      audio.unlock();
+      audio.setVolumes(store.state.settings.sound, store.state.settings.music);
+    },
+    { once: true },
+  );
+
+  window.addEventListener('error', (event) => {
+    console.error('[signal-arena]', event.error ?? event.message);
+  });
+
+  // Первый жест — единственный способ разблокировать звук в браузере.
+  document.addEventListener('visibilitychange', () => {
+    if (document.hidden) game.sound.pauseAll();
+    else game.sound.resumeAll();
+  });
+}
+
+bootstrap().catch((error: unknown) => {
+  console.error(error);
+  showFatal(
+    'Прибор не запустился. Обнови страницу — аналоговый сигнал иногда требует второго включения.',
+  );
+});
