+/**
+ * HubScene — главный экран охотника.
+ * Правило интерфейса: на экране одновременно не больше шести смысловых блоков.
+ */
+
+import Phaser from 'phaser';
+import { BaseScene } from './BaseScene';
+import { button, chip, heading, panel, paragraph } from '../../ui/kit';
+import { confirmDialog } from '../../ui/parts';
+import { bottomNav, skrepkaWindow, toast, topBar, type NavKey } from '../../ui/parts';
+import { icon } from '../../ui/icons';
+import { COLORS, CSS, EASE, FONT } from '../theme';
+import { CENTER, DEPTH, SAFE, TIME } from '../design';
+import { store } from '../../core/store';
+import { dailyScenario, nextStoryScenario, weeklyProgress } from '../../core/modes';
+import { entityById } from '../../data/entities';
+import { QUESTS_BY_ID } from '../../data/quests';
+import { skrepkaLine } from '../../data/skrepka';
+import { emitAnalytics } from '../../core/EventBus';
+import { audio } from '../../core/audio';
+import { rankForXp } from '../../data/ranks';
+import type { HuntMode } from '../../core/types';
+
+export class HubScene extends BaseScene {
+
+  constructor() {
+    super('hub');
+  }
+  private skrepka?: ReturnType<typeof skrepkaWindow>;
+  private content?: Phaser.GameObjects.Container;
+
+  protected override accent(): number {
+    return COLORS.cyan;
+  }
+
+  protected override build(): void {
+    this.fadeInCamera();
+    emitAnalytics('scene_hub');
+    topBar(this);
+    bottomNav(this, 'hunt', (key) => this.navigate(key));
+
+    this.content = this.add.container(0, 0).setDepth(DEPTH.content);
+    this.renderHub();
+
+    this.skrepka = skrepkaWindow(this, {
+      x: this.scale.width - SAFE.right - 46,
+      y: this.scale.height - 158,
+      size: 84,
+      depth: DEPTH.hud,
+    });
+    this.time.delayedCall(700, () => {
+      const line = skrepkaLine('hub', store.todayKey());
+      this.skrepka?.say(line.text, line.mood, 4600);
+    });
+
+    const unsubscribe = store.subscribe(() => this.renderHub());
+    this.events.once(Phaser.Scenes.Events.SHUTDOWN, unsubscribe);
+  }
+
+  private navigate(key: NavKey): void {
+    if (key === 'hunt') return;
+    const map: Record<NavKey, string> = {
+      hunt: 'hub',
+      codex: 'codex',
+      deck: 'deck',
+      profile: 'profile',
+    };
+    this.go(map[key]);
+  }
+
+  private renderHub(): void {
+    this.content?.removeAll(true);
+    const width = this.scale.width;
+    const top = 74;
+    const story = nextStoryScenario(store.state);
+    const entity = entityById(story.entityId);
+    const daily = dailyScenario();
+    const weekly = weeklyProgress(store.state);
+
+    // ── Главное дело ───────────────────────────────────────────────
+    const mainPanel = panel(this, {
+      x: CENTER.x,
+      y: top + 116,
+      w: width - 36,
+      h: 232,
+      fill: COLORS.card,
+      glow: COLORS.cyan,
+      glowAlpha: 0.1,
+    });
+    this.content?.add(mainPanel);
+
+    const label = heading(this, -((width - 36) / 2) + 18, -80, 'СЛЕДУЮЩАЯ ОХОТА', {
+      size: 10,
+      color: COLORS.cyan,
+    });
