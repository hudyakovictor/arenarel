+/**
+ * types.ts — общий словарь игры.
+ * Всё, что пересекает границы модулей, описано здесь.
+ */
+
+export type HuntMode = 'tutorial' | 'story' | 'daily' | 'weekly' | 'free';
+export type Seal = 'wait' | 'enter' | 'exit';
+export type RiskSeal = 'shield' | 'standard' | 'bold' | 'allin';
+export type CardClass = 'reading' | 'defense' | 'decision' | 'protocol';
+export type SkrepkaMood = 'idle' | 'talk' | 'smug' | 'alarm' | 'proud';
+export type EntityRank = 'minor' | 'major' | 'raid';
+
+export interface Clue {
+  id: string;
+  text: string;
+  why: string;
+  pointsTo: string;
+  weight: number;
+  kind: 'structure' | 'volume' | 'crowd' | 'news' | 'risk' | 'time';
+}
+
+export interface NoiseEvent {
+  id: string;
+  whisper: string;
+  holdLabel: string;
+  breakLabel: string;
+  correct: 'hold' | 'break';
+  pressure: number;
+}
+
+export interface PreShape {
+  points: number[];
+  bias: number;
+  volatility: number;
+}
+
+export interface WaveformSpec {
+  id: string;
+  label: string;
+  pre: PreShape;
+  /** Разная развязка для каждой печати: ждать / войти / выйти. */
+  post: Record<Seal, number[]>;
+}
+
+export interface HuntScenario {
+  id: string;
+  title: string;
+  headline: string;
+  subline: string;
+  entityId: string;
+  tier: 1 | 2 | 3;
+  market: string;
+  context: {
+    phase: string;
+    volatility: number;
+    trend: number;
+    crowd: number;
+  };
+  clueIds: string[];
+  traps: string[];
+  noise: NoiseEvent[];
+  waveform: WaveformSpec;
+  outcomes: Record<Seal, { title: string; body: string }>;
+  /** Немедленная сцена — то, что игрок видит перед решением. */
+  scene: string;
+  truth: { protocol: string; risk: RiskSeal; seal: Seal };
+  xp: number;
+  signal: number;
+  brokenText: string;
+}
+
+export interface PlayerProfile {
+  id: string;
+  name: string;
+  created: number;
+  rank: number;
+  xp: number;
+  signal: number;
+  hunts: number;
+  reveals: number;
+  streak: number;
+  bestStreak: number;
+  bestDqi: number;
+  sumDqi: number;
+  lastHuntDay: string;
+  energy: number;
+  energyDay: string;
+  seals: Record<Seal, number>;
+  cardsPlayed: Record<string, number>;
+  clueScans: number;
+  cluesDeveloped: number;
+  holds: number;
+  breaks: number;
+}
+
+export interface CodexEntry {
+  entityId: string;
+  seen: number;
+  revealed: boolean;
+  firstSeenAt: number;
+  revealedAt?: number;
+}
+
+export interface HuntRecord {
+  id: string;
+  at: number;
+  dqi: number;
+  seal: Seal;
+  risk: RiskSeal;
+  protocol: string;
+  entityId: string;
+  revealed: boolean;
+  mode: HuntMode;
+  held: number;
+  broke: number;
+}
+
+export type QuestKind = 'hunt' | 'dqi' | 'reveal' | 'hold' | 'clue' | 'signal';
+
+export interface QuestDef {
+  id: string;
+  kind: QuestKind;
+  title: string;
+  target: number;
+  reward: { xp: number; signal: number };
+}
+
+export interface QuestProgress {
+  id: string;
+  progress: number;
+  done: boolean;
+  claimed: boolean;
+}
+
+export interface DqiBreakdown {
+  context: number;
+  evidence: number;
+  protocol: number;
+  risk: number;
+  composure: number;
+}
+
+export interface DqiResult {
+  total: number;
+  breakdown: DqiBreakdown;
+  revealed: boolean;
+  penalties: string[];
+  bonuses: string[];
+  tier: 'perfect' | 'clean' | 'weak' | 'fail';
+}
+
+export interface Settings {
+  sound: number;
+  music: number;
+  haptics: boolean;
+  crt: boolean;
+  reduceMotion: boolean;
+  lang: 'ru' | 'en';
+  analytics: boolean;
+}
+
+export interface Cosmetics {
+  owned: string[];
+  theme: string;
+  frame: string;
+  skrepka: string;
+  stamp: string;
+}
+
+export interface SeasonState {
+  id: string;
+  xp: number;
+  claimed: string[];
+}
+
+export interface SaveData {
+  version: number;
+  profile: PlayerProfile;
+  codex: Record<string, CodexEntry>;
+  deck: string[];
+  hand: string[];
+  quests: { day: string; items: QuestProgress[] };
+  achievements: Record<string, number>;
+  history: HuntRecord[];
+  settings: Settings;
+  cosmetics: Cosmetics;
+  season: SeasonState;
+  flags: Record<string, number | string>;
+}
+
+export interface HuntRunState {
+  scenario: HuntScenario;
+  mode: HuntMode;
+  developedClueIds: string[];
+  scanBudget: number;
+  protocolId: string | null;
+  risk: RiskSeal | null;
+  seal: Seal | null;
+  held: number;
+  broke: number;
+  brokenAt: number | null;
+}
