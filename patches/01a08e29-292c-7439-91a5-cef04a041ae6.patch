+/**
+ * scenarios.ts — дела охотника.
+ * Каждое дело: бриф, пять улик, три атаки шума, правильная печать и исторический исход.
+ * Никакой генерации в рантайме: то, что случилось, случилось одинаково у всех охотников.
+ */
+
+import type { HuntScenario, MarketPhase, NoiseEvent, RiskSeal, Seal, WaveformSpec } from '../core/types';
+import { NOISE_BY_ID } from './noise';
+import { buildWaveform, type PreShape } from './waveforms';
+
+interface HuntSeed {
+  id: string;
+  title: string;
+  tier: 1 | 2 | 3;
+  entityId: string;
+  headline: string;
+  subline: string;
+  phase: MarketPhase;
+  volatility: number;
+  trend: -1 | 0 | 1;
+  crowd: number;
+  clues: string[];
+  noise: string[];
+  seal: Seal;
+  protocol: string;
+  traps: string[];
+  press: PreShape;
+  riskReason?: string;
+  outcomes: Record<Seal, [title: string, body: string]>;
+  broken: string;
+  lesson: string;
+}
+
+const REWARD_BY_TIER: Record<1 | 2 | 3, { xp: number; signal: number }> = {
+  1: { xp: 90, signal: 45 },
+  2: { xp: 160, signal: 80 },
+  3: { xp: 260, signal: 140 },
+};
+
+function riskFor(volatility: number): RiskSeal {
+  return volatility >= 70 ? 'shield' : 'standard';
+}
+
+function riskReasonFor(volatility: number): string {
+  if (volatility >= 70) {
+    return `Волатильность ${volatility} — здесь даже 1% превращается в приключение. Верная печать: 0.5%.`;
+  }
+  return `Волатильность ${volatility}: структура читается, рынок ведёт себя по правилам. Верная печать: 1%.`;
+}
+
+function hunt(seed: HuntSeed): HuntScenario {
+  const risk = riskFor(seed.volatility);
+  const noise: NoiseEvent[] = seed.noise
+    .map((n) => NOISE_BY_ID[n])
+    .filter((n): n is NoiseEvent => Boolean(n));
+  while (noise.length < 3) noise.push(NOISE_BY_ID['n_generic_doubt']!);
+  const waveform: WaveformSpec = buildWaveform(seed.id, seed.press, seed.seal);
+  return {
+    id: seed.id,
+    title: seed.title,
+    tier: seed.tier,
+    mode: 'story',
+    entityId: seed.entityId,
+    headline: seed.headline,
+    subline: seed.subline,
+    context: { phase: seed.phase, volatility: seed.volatility, trend: seed.trend, crowd: seed.crowd },
+    clueIds: seed.clues,
+    risk,
+    riskReason: seed.riskReason ?? riskReasonFor(seed.volatility),
+    riskCorrect: risk === 'shield' ? 'ЛИМИТ 0.5%' : 'ЛИМИТ 1%',
+    riskTooLoose: 'Больше риска, чем оправдывает обстановка.',
+    riskTooLooseBad: 'Лимит превышен: рынок получил право на твою ошибку.',
+    noise,
+    truth: { seal: seed.seal, protocol: seed.protocol, traps: seed.traps },
+    outcomes: {
+      enter: { title: seed.outcomes.enter[0], body: seed.outcomes.enter[1] },
+      wait: { title: seed.outcomes.wait[0], body: seed.outcomes.wait[1] },
+      exit: { title: seed.outcomes.exit[0], body: seed.outcomes.exit[1] },
+    },
+    brokenText: seed.broken,
+    lesson: seed.lesson,
+    waveform,
+    reward: REWARD_BY_TIER[seed.tier],
+  };
+}
+
+export const SCENARIOS: HuntScenario[] = [
+  hunt({
+    id: 'h01',
