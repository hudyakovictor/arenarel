+/**
+ * BootScene — прогрев прибора: процедурные текстуры, арт (если он собран), переход к титулу.
+ * Отсутствие любого ассета не останавливает игру: аварийная арт-система нарисует всё кодом.
+ */
+
+import Phaser from 'phaser';
+import { generateTextures } from '../textures';
+import { ensureArtFallbacks } from '../procedural';
+import { COLORS, FONT } from '../theme';
+import { CENTER, DESIGN_HEIGHT, DESIGN_WIDTH } from '../design';
+import { hideBootVeil, setBootProgress } from '../boot-overlay';
+import { store } from '../../core/store';
+import { audio } from '../../core/audio';
+
+const IMAGE_ASSETS: [string, string][] = [
+  ['entity_fomo', 'art/entities/fomo_wraith.webp'],
+  ['entity_leverage', 'art/entities/leverage_goblin.webp'],
+  ['entity_revenge', 'art/entities/revenge_wraith.webp'],
+  ['entity_hubris', 'art/entities/hubris_dragon.webp'],
+  ['entity_titan', 'art/entities/headline_titan.webp'],
+  ['skrepka_idle', 'art/skrepka/skrepka_idle.webp'],
+  ['skrepka_talk', 'art/skrepka/skrepka_talk.webp'],
+  ['skrepka_alarm', 'art/skrepka/skrepka_alarm.webp'],
+  ['skrepka_proud', 'art/skrepka/skrepka_proud.webp'],
+  ['hub_backdrop', 'art/ui/hub_backdrop.webp'],
+];
+
+export class BootScene extends Phaser.Scene {
+  constructor() {
+    super('boot');
+  }
+
+  init(): void {
+    // Мягкая обработка отсутствующих файлов: игра продолжает загрузку.
+    this.load.on(Phaser.Loader.Events.FILE_LOAD_ERROR, (file: Phaser.Loader.File) => {
+      console.warn('[boot] ассет не найден, включаем аварийный арт:', file.key);
+    });
+  }
+
+  preload(): void {
+    setBootProgress(0.5, 'прогреваем аналоговую схему…');
+    this.load.on(Phaser.Loader.Events.PROGRESS, (value: number) => {
+      setBootProgress(0.5 + value * 0.42);
+    });
+    for (const [key, path] of IMAGE_ASSETS) this.load.image(key, path);
+    this.load.atlas('cards', 'art/cards/cards.webp', 'art/cards/cards.json');
+  }
+
+  create(): void {
+    setBootProgress(0.94, 'проявляем улики…');
+    generateTextures(this);
+    ensureArtFallbacks(this);
+
+    this.add.rectangle(CENTER.x, CENTER.y, DESIGN_WIDTH, DESIGN_HEIGHT, COLORS.bg1).setOrigin(0.5);
+    this.add
+      .text(CENTER.x, CENTER.y, 'SIGNAL ARENA', { fontFamily: FONT.display, fontSize: '26px', color: '#22d8f5' })
+      .setOrigin(0.5)
+      .setAlpha(0.22);
+
+    audio.setVolumes(store.state.settings.sound, store.state.settings.music);
+    setBootProgress(1, 'приёмник готов');
+    hideBootVeil();
+    this.time.delayedCall(140, () => this.scene.start('title'));
+  }
+}
