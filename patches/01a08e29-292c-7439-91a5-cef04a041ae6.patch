+
+function roman(rank: number): string {
+  return ['I', 'II', 'III', 'IV', 'V'][Math.min(4, Math.max(0, rank - 1))] ?? 'I';
+}
+
+function dqiColor(dqi: number): number {
+  if (dqi >= 85) return COLORS.gold;
+  if (dqi >= 70) return COLORS.green;
+  if (dqi >= 55) return COLORS.cyan;
+  if (dqi >= 40) return COLORS.orange;
+  return COLORS.red;
+}
+
+function shortDate(at: number): string {
+  const date = new Date(at);
+  const day = `${date.getDate()}`.padStart(2, '0');
+  const month = `${date.getMonth() + 1}`.padStart(2, '0');
+  return `${day}.${month}`;
+}
