+    container.add(glowImg);
+  }
+  const rect = rex(scene).add.roundRectangle(
+    0,
+    0,
+    opts.w,
+    opts.h,
+    radius,
+    opts.fill ?? COLORS.card,
+    opts.fillAlpha ?? ALPHA.surface,
