+/**
+ * waveforms.ts — «аналоговая лента» охоты.
+ * Это не график с биржи и не свечи: это лента самописца, которая печатает историческое будущее.
+ * Форма ленты детерминирована: одинаковый сезон → одинаковая история у всех охотников.
+ */
+
+import { Rng } from '../core/rng';
+import type { Seal, WaveformSpec } from '../core/types';
+
+export type PreShape = 'grind' | 'meltup' | 'dump' | 'chop' | 'spike' | 'fakeout_up' | 'fakeout_down';
+
+const PRESETS: Record<PreShape, { start: number; drift: number; noise: number; spike?: number; spikeAt?: number }> = {
+  grind: { start: 0.52, drift: 0.06, noise: 0.03 },
+  meltup: { start: 0.34, drift: 0.5, noise: 0.05 },
+  dump: { start: 0.7, drift: -0.45, noise: 0.05 },
+  chop: { start: 0.5, drift: 0.0, noise: 0.09 },
+  spike: { start: 0.45, drift: 0.08, noise: 0.04, spike: 0.28, spikeAt: 0.72 },
+  fakeout_up: { start: 0.4, drift: 0.32, noise: 0.05, spike: -0.1, spikeAt: 0.85 },
+  fakeout_down: { start: 0.62, drift: -0.3, noise: 0.06, spike: 0.18, spikeAt: 0.8 },
+};
+
+const POST_BY_SEAL: Record<Seal, { drift: number; noise: number }> = {
+  enter: { drift: 0.42, noise: 0.05 },
+  exit: { drift: -0.42, noise: 0.06 },
+  wait: { drift: 0.02, noise: 0.12 },
+};
+
+function series(
+  rng: Rng,
+  count: number,
+  start: number,
+  drift: number,
+  noise: number,
+  spike?: { at: number; power: number },
+): number[] {
+  const out: number[] = [];
+  let value = start;
+  for (let i = 0; i < count; i++) {
+    const t = i / Math.max(1, count - 1);
+    value += drift / count + (rng.float(-1, 1) * noise);
+    if (spike && Math.abs(t - spike.at) < 0.5 / count) value += spike.power;
+    out.push(clamp01(value));
+  }
+  return out;
+}
+
+function clamp01(v: number): number {
+  return Math.max(0.06, Math.min(0.94, Number(v.toFixed(4))));
+}
+
+/**
+ * Собирает ленту: до t₀ — по пресету сценария, после t₀ — по правильной печати.
+ * Если игрок выбрал не ту печать, разбор покажет его версию ленты отдельно.
+ */
+export function buildWaveform(seed: string, pre: PreShape, truth: Seal): WaveformSpec {
+  const rng = new Rng(`wave:${seed}`);
+  const preset = PRESETS[pre];
+  const post = POST_BY_SEAL[truth];
+  const preSeries = series(
+    rng,
+    16,
+    preset.start,
+    preset.drift,
+    preset.noise,
+    preset.spike !== undefined && preset.spikeAt !== undefined ? { at: preset.spikeAt, power: preset.spike } : undefined,
+  );
+  const last = preSeries[preSeries.length - 1] ?? 0.5;
+  const postSeries = series(rng, 14, last, post.drift, post.noise);
+  return { pre: preSeries, post: postSeries };
+}
+
+/** Лента глазами игрока: то, что он увидел бы, выбрав другую печать. */
+export function alternateWaveform(spec: WaveformSpec, seal: Seal, seed: string): number[] {
+  const rng = new Rng(`alt:${seed}:${seal}`);
+  const last = spec.pre[spec.pre.length - 1] ?? 0.5;
+  const post = POST_BY_SEAL[seal];
+  return series(rng, 14, last, post.drift, post.noise);
+}
+
+export const SEAL_LABEL: Record<Seal, string> = {
+  enter: 'ВОЙТИ',
+  wait: 'ЖДАТЬ',
+  exit: 'ВЫЙТИ',
+};
+
+export const SEAL_HINT: Record<Seal, string> = {
+  enter: 'Закрепить решение в рынке',
+  wait: 'Не участвовать, сохранить лимит',
+  exit: 'Развернуть или выйти из логики',
+};
