@@ -0,0 +1,151 @@
+/**
+ * rex.ts — доступ к RexUI из сцен.
+ *
+ * Почему шим: пакет phaser4-rex-plugins отдаёт рантайм в `templates/ui/ui-plugin.js`,
+ * а его d.ts не экспортирует класс как модуль (внутри — `declare class` без export).
+ * Поэтому мы описываем только тот контракт RexUI, который реально используем:
+ * это честнее, чем подключать типы через `any`, и защищает от опечаток в фабриках.
+ */
+
+import Phaser from 'phaser';
+
+export type RexConfig = Record<string, unknown>;
+
+export interface RexGameObject extends Phaser.GameObjects.GameObject {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+  setPosition(x: number, y: number): this;
+  setDepth(value: number): this;
+  setAlpha(value: number): this;
+  setVisible(value: boolean): this;
+  setScale(x: number, y?: number): this;
+  setSize(width: number, height: number): this;
+  setInteractive(config?: unknown): this;
+  layout(): this;
+  getElement(name: string): Phaser.GameObjects.GameObject | null;
+  setElementPosition?(name: string, x: number, y: number): this;
+  on(event: string, fn: (...args: unknown[]) => void, context?: unknown): this;
+  once(event: string, fn: (...args: unknown[]) => void, context?: unknown): this;
+  destroy(fromScene?: boolean): void;
+  setScrollFactor(x: number, y?: number): this;
+  setClassName?(name: string): this;
+}
+
+export interface RexShape extends RexGameObject {
+  setFillStyle(color: number, alpha?: number): this;
+  setStrokeStyle(lineWidth: number, color: number, alpha?: number): this;
+  setRadius(radius: number): this;
+}
+
+export interface RexSizer extends RexGameObject {
+  add(child: Phaser.GameObjects.GameObject, config?: RexConfig): this;
+  addSpace(value?: number): this;
+  removeAll(destroy?: boolean): this;
+  clear(destroy?: boolean): this;
+  setChildPosition?(child: Phaser.GameObjects.GameObject, x: number, y: number): this;
+}
+
+export interface RexPanel extends RexGameObject {
+  setChildrenInteractive?(config?: RexConfig): this;
+  scrollTo?(y: number, t?: number): this;
+  getScroller?(): { scrollTo(y: number, t?: number): void };
+  tweenChild?(config: RexConfig): unknown;
+}
+
+export interface RexProgress extends RexGameObject {
+  setValue(value: number): this;
+  getValue(): number;
+  setBarColor(color: number): this;
+}
+
+export interface RexTabs extends RexSizer {
+  setTabPosition(index: number): this;
+  getCurrentTabIndex(): number;
+}
+
+export interface RexSlider extends RexGameObject {
+  setValue(value: number, min?: number, max?: number): this;
+  getValue(): number;
+  setEnable(value: boolean): this;
+}
+
+export interface RexToggle extends RexGameObject {
+  setValue(value: boolean): this;
+  getValue(): boolean;
+}
+
+export interface RexTextBox extends RexGameObject {
+  setText(text: string): this;
+  setTypingSpeed(speed: number): this;
+  start(text: string, speed?: number): this;
+  stop(): this;
+}
+
+export interface RexUIPlugin {
+  add: {
+    roundRectangle: (
+      x: number,
+      y: number,
+      width: number,
+      height: number,
+      radiusConfig?: number | RexConfig,
+      fillColor?: number,
+      fillAlpha?: number,
+    ) => RexShape;
+    label: (config?: RexConfig) => RexGameObject;
+    sizer: (config?: RexConfig) => RexSizer;
+    gridSizer: (config?: RexConfig) => RexSizer;
+    fixWidthSizer: (config?: RexConfig) => RexSizer;
+    overlaySizer: (config?: RexConfig) => RexSizer;
+    scrollablePanel: (config?: RexConfig) => RexPanel;
+    dialog: (config?: RexConfig) => RexGameObject;
+    toast: (config?: RexConfig) => RexGameObject;
+    tabs: (config?: RexConfig) => RexTabs;
+    buttons: (config?: RexConfig) => RexSizer;
+    slider: (config?: RexConfig) => RexSlider;
+    toggleSwitch: (config?: RexConfig) => RexToggle;
+    textbox: (config?: RexConfig) => RexTextBox;
+    circularProgress: (config?: RexConfig) => RexProgress;
+  };
+  modalPromise?: (gameObject: Phaser.GameObjects.GameObject) => Promise<unknown>;
+  modalClose?: (gameObject: Phaser.GameObjects.GameObject) => void;
+  fadeIn?: (gameObject: Phaser.GameObjects.GameObject, duration?: number) => void;
+  fadeOutDestroy?: (gameObject: Phaser.GameObjects.GameObject, duration?: number) => void;
+  getTopmostSizer?: (gameObject: Phaser.GameObjects.GameObject) => RexSizer | null;
+}
+
+/** Достаёт RexUI-плагин сцены, не падая при отсутствии (например, в тестовом окружении). */
+export function rex(scene: Phaser.Scene): RexUIPlugin {
+  const plugin = (scene as unknown as { rexUI?: RexUIPlugin }).rexUI;
+  if (!plugin) {
+    throw new Error('[rex] плагин rexUI не зарегистрирован в конфиге игры');
+  }
+  return plugin;
+}
+
+export function hasRex(scene: Phaser.Scene): boolean {
+  return Boolean((scene as unknown as { rexUI?: RexUIPlugin }).rexUI);
+}
+
+/** Безопасная картинка: если арта нет — рисуем процедурный заполнитель. */
+export function safeImage(
+  scene: Phaser.Scene,
+  x: number,
+  y: number,
+  key: string,
+  fallbackColor = 0x111f42,
+  fallbackGlyph = '◈',
+): Phaser.GameObjects.GameObject {
+  if (scene.textures.exists(key)) {
+    return scene.add.image(x, y, key);
+  }
+  const container = scene.add.container(x, y);
+  const rect = scene.add.rectangle(0, 0, 64, 64, fallbackColor, 1).setStrokeStyle(1, 0x82a5d2, 0.3);
+  const glyph = scene.add
+    .text(0, 0, fallbackGlyph, { fontFamily: '"Russo One", sans-serif', fontSize: '22px', color: '#8fa1c0' })
+    .setOrigin(0.5);
+  container.add([rect, glyph]);
+  return container;
+}
