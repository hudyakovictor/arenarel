+/**
+ * Постраничная навигация: точки + стрелки.
+ * Используется вместо бесконечной прокрутки там, где важно не перегружать экран.
+ */
+export function pager(
+  scene: Phaser.Scene,
+  opts: { x: number; y: number; page: number; pages: number; onChange: (page: number) => void; color?: number },
+): Phaser.GameObjects.Container {
+  const container = scene.add.container(opts.x, opts.y);
+  const color = opts.color ?? COLORS.cyan;
+  if (opts.pages <= 1) return container;
+
+  const prev = scene.add
+    .text(-58, 0, '‹', { fontFamily: FONT.ui, fontSize: '20px', color: opts.page > 0 ? CSS.text : CSS.dim })
+    .setOrigin(0.5)
+    .setAlpha(opts.page > 0 ? 1 : 0.35);
+  const next = scene.add
+    .text(58, 0, '›', { fontFamily: FONT.ui, fontSize: '20px', color: opts.page < opts.pages - 1 ? CSS.text : CSS.dim })
+    .setOrigin(0.5)
+    .setAlpha(opts.page < opts.pages - 1 ? 1 : 0.35);
+  const prevHit = scene.add.rectangle(-58, 0, 44, 44, 0xffffff, 0.001).setInteractive({ useHandCursor: true });
+  const nextHit = scene.add.rectangle(58, 0, 44, 44, 0xffffff, 0.001).setInteractive({ useHandCursor: true });
+  prevHit.on('pointerup', () => {
+    if (opts.page > 0) opts.onChange(opts.page - 1);
+  });
+  nextHit.on('pointerup', () => {
+    if (opts.page < opts.pages - 1) opts.onChange(opts.page + 1);
+  });
+  container.add([prev, next, prevHit, nextHit]);
+
+  const total = opts.pages;
+  const step = 12;
+  const startX = -((total - 1) * step) / 2;
+  for (let index = 0; index < total; index += 1) {
+    const active = index === opts.page;
+    const dot = scene.add.circle(startX + index * step, 0, active ? 4 : 2.6, active ? color : COLORS.dim, active ? 1 : 0.6);
+    container.add(dot);
+  }
+  return container;
+}
