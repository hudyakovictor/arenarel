+<!doctype html>
+<html lang="ru">
+  <head>
+    <meta charset="UTF-8" />
+    <meta
+      name="viewport"
+      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
+    />
+    <title>SIGNAL ARENA — охота на сущности рынка</title>
+    <meta
+      name="description"
+      content="SIGNAL ARENA — вертикальная игра-охота: находи сущности рынка, собирай улики, ставь печать t₀. Не терминал. Не биржа. Расследование."
+    />
+    <meta name="theme-color" content="#04070f" />
+    <meta name="apple-mobile-web-app-capable" content="yes" />
+    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
+    <meta name="mobile-web-app-capable" content="yes" />
+    <link rel="manifest" href="./manifest.webmanifest" />
+    <link rel="icon" href="./favicon.svg" type="image/svg+xml" />
+    <style>
+      *,
+      *::before,
+      *::after {
+        box-sizing: border-box;
+      }
+      html,
+      body {
+        margin: 0;
+        padding: 0;
+        height: 100%;
+        background: #01030a;
+        color: #f2f7ff;
+        overflow: hidden;
+        -webkit-tap-highlight-color: transparent;
+        -webkit-touch-callout: none;
+        user-select: none;
+        -webkit-user-select: none;
+        font-family: 'Manrope', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
+      }
+      body {
+        background:
+          radial-gradient(900px 600px at 50% -10%, rgba(34, 216, 245, 0.1), transparent 60%),
+          radial-gradient(700px 600px at 95% 110%, rgba(179, 136, 255, 0.09), transparent 60%),
+          radial-gradient(700px 500px at -5% 90%, rgba(52, 211, 153, 0.06), transparent 60%),
+          #01030a;
+        display: grid;
+        place-items: center;
+        touch-action: manipulation;
+      }
+      #stage {
+        position: relative;
+        width: min(100vw, calc(100dvh * 9 / 16));
+        height: min(100dvh, calc(100vw * 16 / 9));
+        max-width: 520px;
+        max-height: 100dvh;
+        overflow: hidden;
+        background: #04070f;
+        isolation: isolate;
+      }
+      @media (min-width: 560px) and (min-height: 700px) {
+        #stage {
+          border-radius: 40px;
+          box-shadow:
+            0 0 0 10px #0a0f1e,
+            0 0 0 11px rgba(130, 165, 210, 0.22),
+            0 40px 120px rgba(0, 0, 0, 0.85),
+            0 0 90px rgba(34, 216, 245, 0.08);
+        }
+      }
+      #game-root,
+      #game-root canvas {
+        display: block;
+        width: 100% !important;
+        height: 100% !important;
+      }
+      #game-root canvas {
+        touch-action: none;
+      }
+
+      /* ============ boot veil ============ */
+      #boot-veil {
+        position: absolute;
+        inset: 0;
+        z-index: 40;
+        display: grid;
+        place-items: center;
+        background:
+          radial-gradient(420px 320px at 50% 34%, rgba(34, 216, 245, 0.16), transparent 70%),
+          linear-gradient(180deg, #070d1f, #04070f 70%);
+        transition: opacity 0.55s ease, visibility 0.55s ease;
+      }
+      #boot-veil.is-hidden {
+        opacity: 0;
+        visibility: hidden;
+        pointer-events: none;
+      }
+      .veil-inner {
+        display: flex;
+        flex-direction: column;
+        align-items: center;
+        gap: 18px;
+        padding: 0 28px;
+        text-align: center;
+      }
+      .veil-mark {
+        font-family: 'Russo One', system-ui, sans-serif;
+        font-size: clamp(30px, 9.5vw, 46px);
+        letter-spacing: 0.06em;
+        line-height: 0.94;
+        background: linear-gradient(180deg, #ffffff 20%, #22d8f5 120%);
+        -webkit-background-clip: text;
+        background-clip: text;
+        color: transparent;
+        text-shadow: 0 0 40px rgba(34, 216, 245, 0.25);
+      }
+      .veil-sub {
+        font-size: 11px;
+        font-weight: 800;
+        letter-spacing: 0.28em;
+        text-transform: uppercase;
+        color: #8fa1c0;
+      }
+      .veil-bar {
+        width: 210px;
+        height: 6px;
+        border-radius: 99px;
+        background: #0a1330;
+        border: 1px solid rgba(130, 165, 210, 0.2);
+        overflow: hidden;
+      }
+      .veil-bar > i {
+        display: block;
+        height: 100%;
+        width: 8%;
+        border-radius: inherit;
+        background: linear-gradient(90deg, #0e7490, #22d8f5);
+        transition: width 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
+      }
+      .veil-note {
+        font-family: 'JetBrains Mono', ui-monospace, monospace;
+        font-size: 10px;
+        letter-spacing: 0.08em;
+        color: #5a6c8a;
+        min-height: 14px;
+      }
+      #boot-error {
+        max-width: 320px;
+        font-size: 12px;
+        line-height: 1.5;
+        color: #fb4d6d;
+        display: none;
+      }
+
+      /* ============ landscape guard (mobile) ============ */
+      #rotate-guard {
+        position: fixed;
+        inset: 0;
+        z-index: 60;
+        display: none;
+        place-items: center;
+        background: #01030a;
+        text-align: center;
+        padding: 24px;
+      }
+      #rotate-guard .rg-in {
+        display: flex;
+        flex-direction: column;
+        gap: 14px;
+        align-items: center;
+      }
+      #rotate-guard .rg-phone {
+        width: 54px;
+        height: 96px;
+        border-radius: 12px;
+        border: 2px solid #22d8f5;
+        animation: rotate-hint 2.4s ease-in-out infinite;
+      }
+      @keyframes rotate-hint {
+        0%,
+        40% {
+          transform: rotate(0deg);
+        }
+        60%,
+        100% {
+          transform: rotate(90deg);
+        }
+      }
+      @media (orientation: landscape) and (max-height: 520px) {
+        #rotate-guard {
+          display: grid;
+        }
+      }
+    </style>
+  </head>
+  <body>
+    <div id="stage">
+      <div id="game-root"></div>
+
+      <div id="boot-veil">
+        <div class="veil-inner">
+          <div class="veil-mark">SIGNAL<br />ARENA</div>
+          <div class="veil-sub">охота на сущности рынка</div>
+          <div class="veil-bar"><i id="boot-progress"></i></div>
+          <div class="veil-note" id="boot-note">аналоговый протокол инициализации…</div>
+          <div id="boot-error"></div>
+        </div>
+      </div>
+    </div>
+
+    <div id="rotate-guard">
+      <div class="rg-in">
+        <div class="rg-phone"></div>
+        <div style="font-weight: 800; letter-spacing: 0.2em; font-size: 12px; color: #8fa1c0">
+          ПОВЕРНИ ТЕЛЕФОН
+        </div>
+        <div style="font-size: 12px; color: #5a6c8a; max-width: 260px">
+          Охотник смотрит в вертикаль. Горизонталь — для тех, кто ещё верит в новости.
+        </div>
+      </div>
+    </div>
+
+    <noscript>
+      <div style="padding: 24px; text-align: center">
+        Для расследования нужен JavaScript. Аналоговый сигнал уже в пути.
+      </div>
+    </noscript>
+
+    <script type="module" src="/src/main.ts"></script>
+  </body>
+</html>
