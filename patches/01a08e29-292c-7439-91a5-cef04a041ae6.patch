new file mode 100644
index 0000000..85f603f
--- /dev/null
+++ b/src/core/save.ts
@@ -0,0 +1,167 @@
+/**
+ * save.ts — версионированное сохранение.
+ * Приватность: всё живёт локально (localStorage), ничего не уходит на сервер.
+ * Аналоговый сигнал не покидает приёмник.
+ */
+
+import type { SaveData, Settings } from './types';
+
+export const SAVE_KEY = 'signal-arena/save/v1';
+export const SAVE_VERSION = 1;
+
+const memory = new Map<string, string>();
+
+function storageAvailable(): boolean {
+  try {
+    const probe = '__sa_probe__';
+    window.localStorage.setItem(probe, '1');
+    window.localStorage.removeItem(probe);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+const hasLocalStorage = (): boolean => typeof window !== 'undefined' && !!window.localStorage;
+
+function read(key: string): string | null {
+  if (hasLocalStorage() && storageAvailable()) return window.localStorage.getItem(key);
+  return memory.get(key) ?? null;
+}
+
+function write(key: string, value: string): void {
+  if (hasLocalStorage() && storageAvailable()) {
+    try {
+      window.localStorage.setItem(key, value);
+      return;
+    } catch {
+      // квота кончилась — падаем в память, игра не должна ломаться
+    }
+  }
+  memory.set(key, value);
+}
+
+export function defaultSettings(): Settings {
+  return {
+    sound: 0.8,
+    music: 0.45,
+    haptics: true,
+    crt: true,
+    reduceMotion: false,
+    lang: 'ru',
+    analytics: true,
+  };
+}
+
+export function createNewSave(now = Date.now()): SaveData {
+  const suffix = Math.random().toString(36).slice(2, 6).toUpperCase();
+  return {
+    version: SAVE_VERSION,
+    profile: {
+      id: `hunter-${now.toString(36)}`,
+      name: `ОХОТНИК-${suffix}`,
+      created: now,
+      rank: 1,
+      xp: 0,
+      signal: 0,
+      hunts: 0,
+      reveals: 0,
+      streak: 0,
+      bestStreak: 0,
+      bestDqi: 0,
+      sumDqi: 0,
+      lastHuntDay: '',
+      energy: 5,
+      energyDay: '',
+      seals: { enter: 0, wait: 0, exit: 0 },
+      cardsPlayed: {},
+      clueScans: 0,
+      cluesDeveloped: 0,
+      holds: 0,
+      breaks: 0,
+    },
+    codex: {},
+    deck: ['reading_higher_tf', 'defense_daily_risk', 'decision_stay_out', 'protocol_evidence_only'],
+    hand: ['reading_higher_tf', 'defense_daily_risk', 'decision_stay_out', 'protocol_evidence_only'],
+    quests: { day: '', items: [] },
+    achievements: {},
+    history: [],
+    settings: defaultSettings(),
+    cosmetics: {
+      owned: ['theme_signal', 'frame_none', 'skrepka_classic', 'stamp_cyan', 'tape_classic'],
+      theme: 'theme_signal',
+      frame: 'frame_none',
+      skrepka: 'skrepka_classic',
+      stamp: 'stamp_cyan',
+    },
+    season: { id: 'season-01', xp: 0, claimed: [] },
+    flags: {},
+  };
+}
+
+/** Миграции сохранений. Каждая версия добавляет шаг, старые данные не теряются. */
+function migrate(data: SaveData): SaveData {
+  const base = createNewSave();
+  const merged: SaveData = {
+    ...base,
+    ...data,
+    profile: { ...base.profile, ...data.profile },
+    settings: { ...base.settings, ...data.settings },
+    cosmetics: { ...base.cosmetics, ...data.cosmetics },
+    season: { ...base.season, ...data.season },
+    quests: data.quests ?? base.quests,
+    codex: data.codex ?? {},
+    achievements: data.achievements ?? {},
+    history: Array.isArray(data.history) ? data.history.slice(-80) : [],
+    deck: data.deck?.length ? data.deck : base.deck,
+    hand: data.hand?.length ? data.hand.slice(0, 4) : base.hand.slice(0, 4),
+    flags: data.flags ?? {},
+  };
+  merged.version = SAVE_VERSION;
+  return merged;
+}
+
+export function loadSave(): SaveData {
+  const raw = read(SAVE_KEY);
+  if (!raw) return createNewSave();
+  try {
+    const parsed = JSON.parse(raw) as SaveData;
+    if (!parsed || typeof parsed !== 'object' || !parsed.profile) return createNewSave();
+    return migrate(parsed);
+  } catch {
+    // Битое сохранение не должно превращаться в чёрный экран.
+    console.warn('[save] не удалось прочитать сохранение, начинаем новое дело');
+    return createNewSave();
+  }
+}
+
+export function persistSave(data: SaveData): void {
+  write(SAVE_KEY, JSON.stringify(data));
+}
+
+export function wipeSave(): void {
+  write(SAVE_KEY, '');
+  if (hasLocalStorage() && storageAvailable()) {
+    try {
+      window.localStorage.removeItem(SAVE_KEY);
+    } catch {
+      // ignore
+    }
+  }
+  memory.delete(SAVE_KEY);
+}
+
+/** Экспорт сохранения в строку — игрок владеет своими данными. */
+export function exportSave(data: SaveData): string {
+  return JSON.stringify({ ...data, exportedAt: Date.now() });
+}
+
+export function importSave(json: string): SaveData | null {
+  try {
+    const parsed = JSON.parse(json) as SaveData;
+    if (!parsed || typeof parsed !== 'object' || !parsed.profile) return null;
+    return migrate(parsed);
+  } catch {
+    return null;
+  }
+}
diff --git a/src/core/scoring.ts b/src/core/scoring.ts
new file mode 100644
index 0000000..32c35fa
--- /dev/null
+++ b/src/core/scoring.ts
@@ -0,0 +1,292 @@
+/**
+ * scoring.ts — DQI (Decision Quality Index), 0..100.
+ * Игра оценивает не прибыль, а качество решения: контекст, улики, протокол, риск, самообладание.
+ * Все модификаторы прозрачны и перечисляются в разборе.
+ */
+
+import type { Clue, DqiBreakdown, DqiResult, HuntScenario, NoiseEvent, RiskSeal, Seal } from './types';
+import { cardById, type CardDef } from '../data/cards';
+import { clueById } from '../data/clues';
+
+export interface DqiInput {
+  scenario: HuntScenario;
+  developedClueIds: string[];
+  stanceId: string | null;
+  hand: string[];
+  risk: RiskSeal | null;
+  seal: Seal | null;
+  /** Ответы на атаки шума: true — игрок удержал протокол. */
+  responses: { event: NoiseEvent; correct: boolean }[];
+  previousHuntFailed: boolean;
+}
+
+export interface CriterionExplain {
+  key: keyof DqiBreakdown;
+  label: string;
+  value: number;
+  max: number;
+  lines: string[];
+}
+
+export interface DqiExplain extends DqiResult {
+  criteria: CriterionExplain[];
+  appliedCards: string[];
+  signalMultiplier: number;
+}
+
+const MAX_PER_CRITERION = 20;
+
+const RISK_ORDER: RiskSeal[] = ['shield', 'standard', 'bold', 'allin'];
+
+const RISK_TITLE: Record<RiskSeal, string> = {
+  shield: '0.5%',
+  standard: '1%',
+  bold: '5%',
+  allin: 'ВСЁ',
+};
+
+const SEAL_TITLE: Record<Seal, string> = {
+  wait: 'ЖДАТЬ',
+  enter: 'ВОЙТИ',
+  exit: 'ВЫЙТИ',
+};
+
+const SUPPORT_TARGET: Record<CardDef['cardClass'], keyof DqiBreakdown> = {
+  reading: 'evidence',
+  defense: 'composure',
+  decision: 'risk',
+  protocol: 'protocol',
+};
+
+function clampCriterion(value: number): number {
+  return Math.max(0, Math.min(MAX_PER_CRITERION, Math.round(value)));
+}
+
+function clueWeight(clue: Clue, stance: CardDef | null): number {
+  let weight = clue.weight;
+  const bonus = stance?.effect.clueWeightBonus?.[clue.kind];
+  if (bonus) weight += bonus;
+  return weight;
+}
+
+/** Основной расчёт качества решения. Чистая функция — покрыта тестами. */
+export function computeDqi(input: DqiInput): DqiExplain {
+  const { scenario } = input;
+  const stance = cardById(input.stanceId);
+  const hand = input.hand.map((id) => cardById(id)).filter((card): card is CardDef => Boolean(card));
+  const appliedCards: string[] = [];
+  const bonuses: string[] = [];
+  const penalties: string[] = [];
+
+  // ── КОНТЕКСТ: сколько разных сторон рынка ты вообще проверил ──
+  const developed = input.developedClueIds.map((id) => clueById(id)).filter((clue): clue is Clue => Boolean(clue));
+  const kinds = new Set(developed.map((clue) => clue.kind));
+  let context = 3 + kinds.size * 3.2;
+  const contextLines: string[] = [`видов улик: ${kinds.size} из 5`];
+  if (scenario.context.volatility >= 70) {
+    context += 2;
+    contextLines.push('волатильность выше 70 — контекст наказан');
+  }
+  if (kinds.has('crowd') && scenario.context.crowd >= 75) {
+    context += 3;
+    contextLines.push('толпа и её уверенность прочитаны');
+  }
+  context = clampCriterion(context);
+
+  // ── УЛИКИ: вес открытого против веса дела ──
+  const maxWeight = scenario.clueIds.reduce((sum, id) => {
+    const clue = clueById(id);
+    return sum + (clue ? clueWeight(clue, stance) : 0);
+  }, 0);
+  const gotWeight = developed.reduce((sum, clue) => sum + clueWeight(clue, stance), 0);
+  let evidence = maxWeight > 0 ? (gotWeight / maxWeight) * 20 : 0;
+  const evidenceLines: string[] = [`вес улик: ${Math.round(gotWeight)} из ${Math.round(maxWeight)}`];
+
+  for (const card of hand) {
+    const target = SUPPORT_TARGET[card.cardClass];
+    const flat = card.effect[`${target}Bonus` as 'contextBonus' | 'evidenceBonus' | 'riskBonus' | 'composureBonus' | 'protocolBonus'];
+    if (flat) {
+      appliedCards.push(card.id);
+      if (target === 'evidence') evidence += flat;
+      if (target === 'context') context = clampCriterion(context + flat + 0.5);
+      if (target === 'risk') evidenceLines.push(`«${card.short}» поддержал расчёт`);
+    }
+  }
+  if (cardById(input.stanceId)?.effect.evidenceBonus) {
+    evidence += cardById(input.stanceId)!.effect.evidenceBonus!;
+  }
+  if (developed.length >= 3 && (stance?.effect.bonusIfEvidence3 || hand.some((card) => card.effect.bonusIfEvidence3))) {
+    const bonus = stance?.effect.bonusIfEvidence3 ?? hand.find((card) => card.effect.bonusIfEvidence3)?.effect.bonusIfEvidence3 ?? 0;
+    evidence += bonus;
+    bonuses.push(`три улики в деле: +${bonus} к уликам`);
+  }
+  evidence = clampCriterion(evidence);
+  context = clampCriterion(context);
+
+  // ── ПРОТОКОЛ: стойка против того, что действительно вскрывает сущность ──
+  const truthProtocol = scenario.truth.protocol;
+  const stanceId = input.stanceId;
+  const stanceCounters = Boolean(stance?.effect.counters?.includes(scenario.entityId));
+  let protocol = 0;
+  const protocolLines: string[] = [];
+  if (!stance) {
+    protocol = 2;
+    protocolLines.push('стойка не выбрана — решение принимал случай');
+  } else if (stanceId === truthProtocol) {
+    protocol = 18 + (stanceCounters ? 2 : 0);
+    protocolLines.push(`стойка «${stance.short}» — именно она вскрывает ${scenario.title}`);
+  } else if (stanceCounters) {
+    protocol = 14;
+    protocolLines.push(`«${stance.short}» работает против этой сущности`);
+  } else if (stance.cardClass === 'protocol') {
+    protocol = 11;
+    protocolLines.push(`«${stance.short}» — протокол, но не для этого случая`);
+  } else if (stance.cardClass === 'decision') {
+    protocol = 8;
+    protocolLines.push(`«${stance.short}» — решение без процедуры`);
+  } else {
+    protocol = 5;
+    protocolLines.push(`«${stance.short}» не про процедуру охоты`);
+  }
+  if (stance?.effect.protocolBonus) protocol += stance.effect.protocolBonus;
+  for (const card of hand) {
+    if (!card.effect.protocolBonus) continue;
+    protocol += card.effect.protocolBonus;
+    appliedCards.push(card.id);
+  }
+  protocol = clampCriterion(protocol);
+
+  // ── РИСК: лимит до входа, а не после убытка ──
+  let risk = 0;
+  const riskLines: string[] = [];
+  if (!input.risk) {
+    risk = 0;
+    riskLines.push('лимит не поставлен');
+  } else {
+    const truthIndex = RISK_ORDER.indexOf(scenario.truth.risk);
+    const myIndex = RISK_ORDER.indexOf(input.risk);
+    const distance = Math.abs(truthIndex - myIndex);
+    risk = distance === 0 ? 20 : distance === 1 ? 13 : distance === 2 ? 6 : 1;
+    riskLines.push(`лимит ${RISK_TITLE[input.risk]} против верного ${RISK_TITLE[scenario.truth.risk]}`);
+    if (myIndex > truthIndex) riskLines.push('лимит выше нужного — это уже не расчёт');
+    if (myIndex < truthIndex) riskLines.push('лимит ниже нужного — ты боялся рынка, а не читал его');
+    if (input.risk === scenario.truth.risk && (stance?.effect.bonusIfRiskCorrect || hand.some((card) => card.effect.bonusIfRiskCorrect))) {
+      const bonus = stance?.effect.bonusIfRiskCorrect ?? hand.find((card) => card.effect.bonusIfRiskCorrect)?.effect.bonusIfRiskCorrect ?? 0;
+      risk += bonus;
+      bonuses.push(`верный лимит: +${bonus}`);
+    }
+    if (input.risk === 'allin') {
+      penalties.push('вход «всем» — не решение, а надежда');
+    }
+  }
+  risk = clampCriterion(risk);
+
+  // ── САМООБЛАДАНИЕ: сколько атак шума ты выдержал ──
+  const total = Math.max(1, input.responses.length || scenario.noise.length);
+  const held = input.responses.filter((response) => response.correct).length;
+  const composureLines: string[] = [`выдержано ${held} из ${total}`];
+  let composure = (held / total) * 20;
+  for (const card of hand) {
+    const bonus = card.effect.composureBonus;
+    if (bonus) {
+      composure += bonus;
+      appliedCards.push(card.id);
+    }
+    if (card.effect.composurePerCrowdClue) {
+      const crowdClues = developed.filter((clue) => clue.kind === 'crowd').length;
+      if (crowdClues) {
+        composure += card.effect.composurePerCrowdClue * crowdClues;
+        appliedCards.push(card.id);
+        composureLines.push(`улики толпы усилили защиту: +${card.effect.composurePerCrowdClue * crowdClues}`);
+      }
+    }
+    if (card.effect.blockFirstWhisper && input.responses.length && !input.responses[0]!.correct) {
+      composure += 5;
+      appliedCards.push(card.id);
+      composureLines.push('первая атака погашена картой');
+    }
+  }
+  if (held === input.responses.length && input.responses.length > 0 && stance?.effect.bonusIfNoBreak) {
+    composure += stance.effect.bonusIfNoBreak;
+  }
+  for (const card of hand) {
+    if (card.effect.bonusIfNoBreak && held === input.responses.length) {
+      composure += card.effect.bonusIfNoBreak;
+      appliedCards.push(card.id);
+    }
+  }
+  composure = clampCriterion(composure);
+
+  // ── бонусы за самостоятельное решение не входить ──
+  if (input.seal === 'wait' && (stance?.effect.bonusIfNotEntered || hand.some((card) => card.effect.bonusIfNotEntered))) {
+    const bonus = stance?.effect.bonusIfNotEntered ?? hand.find((card) => card.effect.bonusIfNotEntered)?.effect.bonusIfNotEntered ?? 0;
+    context = clampCriterion(context + bonus / 2);
+    risk = clampCriterion(risk + bonus / 2);
+    bonuses.push(`отказ от входа по правилу: +${bonus}`);
+  }
+  if (input.previousHuntFailed && (stance?.effect.bonusAfterLoss || hand.some((card) => card.effect.bonusAfterLoss))) {
+    const bonus = stance?.effect.bonusAfterLoss ?? hand.find((card) => card.effect.bonusAfterLoss)?.effect.bonusAfterLoss ?? 0;
+    composure = clampCriterion(composure + bonus);
+    bonuses.push(`работа над ошибкой после провала: +${bonus}`);
+  }
+
+  // ── штрафы: игра судит привычку, а не исход ──
+  if (!developed.length) penalties.push('ни одной улики не открыто');
+  if (input.seal === 'enter' && scenario.truth.seal === 'wait') penalties.push('вход там, где сущность ждала твоего импульса');
+  if (input.responses.filter((response) => !response.correct).length >= Math.ceil(total / 2)) {
+    penalties.push('протокол сорван больше половины атак');
+    composure = clampCriterion(composure - 3);
+  }
+  if (input.risk === 'allin') risk = clampCriterion(risk - 3);
+
+  const breakdown: DqiBreakdown = {
+    context,
+    evidence,
+    protocol,
+    risk,
+    composure,
+  };
+  const raw = Object.values(breakdown).reduce((sum, value) => sum + value, 0);
+  const total100 = Math.max(0, Math.min(100, Math.round(raw)));
+
+  const criteria: CriterionExplain[] = [
+    { key: 'context', label: 'КОНТЕКСТ', value: context, max: MAX_PER_CRITERION, lines: contextLines },
+    { key: 'evidence', label: 'УЛИКИ', value: evidence, max: MAX_PER_CRITERION, lines: evidenceLines },
+    { key: 'protocol', label: 'СТОЙКА', value: protocol, max: MAX_PER_CRITERION, lines: protocolLines },
+    { key: 'risk', label: 'РИСК', value: risk, max: MAX_PER_CRITERION, lines: riskLines },
+    { key: 'composure', label: 'САМООБЛАДАНИЕ', value: composure, max: MAX_PER_CRITERION, lines: composureLines },
+  ];
+
+  const tier: DqiResult['tier'] = total100 >= 85 ? 'perfect' : total100 >= 70 ? 'clean' : total100 >= 40 ? 'weak' : 'fail';
+
+  const signalMultiplier = stance?.effect.signalMultiplier ?? 1;
+
+  return {
+    total: total100,
+    breakdown,
+    revealed: total100 >= 55,
+    penalties,
+    bonuses,
+    tier,
+    criteria,
+    appliedCards: [...new Set(appliedCards)],
+    signalMultiplier,
+  };
+}
+
+/** Подпись печати t₀. */
+export function sealLabel(seal: Seal | null): string {
+  return seal ? SEAL_TITLE[seal] : 'БЕЗ ПЕЧАТИ';
+}
+
+/** Подпись лимита риска. */
+export function riskLabel(risk: RiskSeal | null): string {
+  return risk ? RISK_TITLE[risk] : 'БЕЗ ЛИМИТА';
+}
+
+export const RISK_HINT: Record<RiskSeal, string> = {
+  shield: 'Тихий лимит для громкого рынка',
+  standard: 'Обычай охотника',
+  bold: 'Ставка вместо расчёта',
+  allin: 'Печать глупца',
+};
diff --git a/src/core/store.ts b/src/core/store.ts
new file mode 100644
index 0000000..2b701ef
--- /dev/null
+++ b/src/core/store.ts
@@ -0,0 +1,328 @@
+/**
+ * store.ts — состояние игры и единственная точка его изменения.
+ * Сцены читают store.state и подписываются на изменения; пишут — только через методы.
+ */
+
+import { bus, emitAnalytics } from './EventBus';
+import { createNewSave, loadSave, persistSave, exportSave, importSave, wipeSave } from './save';
+import {
+  ENERGY_REFILL_COST,
+  applyHuntResult,
+  claimQuestIn,
+  energyCap,
+  ensureDailyQuests,
+  evaluateAchievements,
+  refreshEnergy,
+  type HuntOutcome,
+} from './progression';
+import type { DqiExplain } from './scoring';
+import type { HuntMode, HuntRunState, SaveData, Settings } from './types';
+import { CARDS_BY_ID } from '../data/cards';
+import { COSMETICS_BY_ID } from '../data/cosmetics';
+import { RANKS } from '../data/ranks';
+import { dayKey } from './rng';
+
+export interface HuntCompletionInput {
+  run: HuntRunState;
+  dqi: DqiExplain;
+  mode: HuntMode;
+}
+
+const ARCHIVE_PASS_PRICE = 900;
+const ARCHIVE_PASS_DAYS = 30;
+
+class Store {
+  private data: SaveData = createNewSave();
+  private listeners = new Set<() => void>();
+  private initialised = false;
+
+  get state(): SaveData {
+    return this.data;
+  }
+
+  get profile() {
+    return this.data.profile;
+  }
+
+  init(now = new Date()): void {
+    this.data = loadSave();
+    ensureDailyQuests(this.data, now);
+    refreshEnergy(this.data.profile, now);
+    evaluateAchievements(this.data);
+    this.initialised = true;
+    this.touch(false);
+    bus.emit('state:changed', undefined);
+  }
+
+  get isReady(): boolean {
+    return this.initialised;
+  }
+
+  subscribe(listener: () => void): () => void {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  }
+
+  private touch(persist = true): void {
+    if (persist) persistSave(this.data);
+    for (const listener of Array.from(this.listeners)) {
+      try {
+        listener();
+      } catch (error) {
+        console.error('[store] подписчик упал', error);
+      }
+    }
+    bus.emit('state:changed', undefined);
+  }
+
+  // ─────────────────────────── профиль ───────────────────────────
+
+  setName(name: string): void {
+    const clean = name.trim().slice(0, 18);
+    if (!clean) return;
+    this.data.profile.name = clean.toUpperCase();
+    this.touch();
+  }
+
+  setSetting<K extends keyof Settings>(key: K, value: Settings[K]): void {
+    this.data.settings[key] = value;
+    this.touch();
+  }
+
+  // ─────────────────────────── энергия ───────────────────────────
+
+  canHunt(mode: HuntMode): { ok: boolean; reason: string } {
+    const profile = this.data.profile;
+    if (this.data.flags.tutorial === 0) return { ok: true, reason: '' };
+    if (mode === 'tutorial' || mode === 'weekly') return { ok: true, reason: '' };
+    if (this.hasArchivePass() && mode === 'free') return { ok: true, reason: '' };
+    if (profile.energy > 0) return { ok: true, reason: '' };
+    return { ok: false, reason: 'ЭНЕРГИЯ ИСЧЕРПАНА. Паника бесплатна, охота — нет.' };
+  }
+
+  spendEnergy(): boolean {
+    const profile = this.data.profile;
+    if (profile.energy <= 0) return false;
+    profile.energy -= 1;
+    this.touch();
+    return true;
+  }
+
+  refillEnergy(): boolean {
+    const profile = this.data.profile;
+    const cap = energyCap(profile);
+    if (profile.energy >= cap) return false;
+    if (profile.signal < ENERGY_REFILL_COST) return false;
+    profile.signal -= ENERGY_REFILL_COST;
+    profile.energy = cap;
+    emitAnalytics('energy_refill', { cost: ENERGY_REFILL_COST });
+    this.touch();
+    return true;
+  }
+
+  get energyRefillCost(): number {
+    return ENERGY_REFILL_COST;
+  }
+
+  hasArchivePass(): boolean {
+    return Number(this.data.flags.archive_pass ?? 0) > Date.now();
+  }
+
+  // ─────────────────────────── охота ───────────────────────────
+
+  completeHunt(input: HuntCompletionInput): HuntOutcome {
+    const outcome = applyHuntResult(this.data, {
+      run: input.run,
+      dqi: input.dqi,
+      mode: input.mode,
+    });
+    this.data.flags.hunts_total = Number(this.data.flags.hunts_total ?? 0) + 1;
+    if (input.mode === 'tutorial') this.data.flags.tutorial = 1;
+    bus.emit('hunt:finished', {
+      huntId: input.run.scenario.id,
+      dqi: input.dqi.total,
+      revealed: input.dqi.revealed,
+    });
+    // Карты за ранг и за вскрытые сущности выдаются автоматически.
+    outcome.grantedCards = [...this.grantRankCards(), ...this.grantCodexCards()];
+    for (const cardId of outcome.grantedCards) {
+      const card = CARDS_BY_ID[cardId];
+      if (card) bus.emit('card:unlocked', { cardId });
+    }
+    if (input.dqi.revealed) bus.emit('codex:unlocked', { entityId: input.run.scenario.entityId });
+    if (outcome.rankUp) bus.emit('profile:levelup', { rank: outcome.rankUp.rank });
+    for (const questId of outcome.questsCompleted) bus.emit('quest:completed', { questId });
+    for (const achievement of outcome.achievementsUnlocked) bus.emit('achievement:unlocked', { achievementId: achievement.id });
+    this.touch();
+    return outcome;
+  }
+
+  grantRankCards(): string[] {
+    const rank = this.data.profile.rank;
+    const granted: string[] = [];
+    for (const card of Object.values(CARDS_BY_ID)) {
+      if (!card.unlock) continue;
+      if (card.unlock.type === 'rank' && rank >= card.unlock.rank && !this.data.deck.includes(card.id)) {
+        this.data.deck.push(card.id);
+        granted.push(card.id);
+        bus.emit('card:unlocked', { cardId: card.id });
+      }
+    }
+    return granted;
+  }
+
+  /** Карты, открываемые вскрытием сущности: кодекс — не только коллекция, но и доступ. */
+  grantCodexCards(): string[] {
+    const revealed = new Set(
+      Object.values(this.data.codex)
+        .filter((entry) => entry.revealed)
+        .map((entry) => entry.entityId),
+    );
+    const granted: string[] = [];
+    for (const card of Object.values(CARDS_BY_ID)) {
+      if (card.unlock?.type !== 'codex') continue;
+      if (!revealed.has(card.unlock.entityId)) continue;
+      if (this.data.deck.includes(card.id)) continue;
+      this.data.deck.push(card.id);
+      granted.push(card.id);
+      bus.emit('card:unlocked', { cardId: card.id });
+    }
+    return granted;
+  }
+
+  // ─────────────────────────── колода ───────────────────────────
+
+  buyCard(cardId: string): boolean {
+    const card = CARDS_BY_ID[cardId];
+    if (!card || !card.unlock || card.unlock.type !== 'signal') return false;
+    if (this.data.deck.includes(cardId)) return false;
+    if (this.data.profile.signal < card.unlock.cost) return false;
+    this.data.profile.signal -= card.unlock.cost;
+    this.data.deck.push(cardId);
+    bus.emit('card:unlocked', { cardId });
+    emitAnalytics('card_bought', { cardId, cost: card.unlock.cost });
+    this.touch();
+    return true;
+  }
+
+  setHand(cardIds: string[]): void {
+    const valid = cardIds.filter((id) => this.data.deck.includes(id) && CARDS_BY_ID[id]);
+    this.data.hand = valid.slice(0, 4);
+    this.touch();
+  }
+
+  toggleHandCard(cardId: string): void {
+    if (!this.data.deck.includes(cardId)) return;
+    const hand = this.data.hand;
+    if (hand.includes(cardId)) {
+      if (hand.length <= 1) return;
+      this.data.hand = hand.filter((id) => id !== cardId);
+    } else {
+      this.data.hand = [...hand, cardId].slice(-4);
+    }
+    this.touch();
+  }
+
+  // ─────────────────────────── кодекс ───────────────────────────
+
+  codexEntry(entityId: string) {
+    return this.data.codex[entityId];
+  }
+
+  get revealedCount(): number {
+    return Object.values(this.data.codex).filter((entry) => entry.revealed).length;
+  }
+
+  // ─────────────────────────── задания ───────────────────────────
+
+  claimQuest(questId: string): boolean {
+    const ok = claimQuestIn(this.data, questId);
+    if (ok) {
+      bus.emit('quest:completed', { questId });
+      this.touch();
+    }
+    return ok;
+  }
+
+  // ─────────────────────────── косметика ───────────────────────────
+
+  buyCosmetic(id: string): boolean {
+    const item = COSMETICS_BY_ID[id];
+    if (!item || this.data.cosmetics.owned.includes(id)) return false;
+    if (this.data.profile.signal < item.cost) return false;
+    this.data.profile.signal -= item.cost;
+    this.data.cosmetics.owned.push(id);
+    this.equipCosmetic(id);
+    emitAnalytics('cosmetic_bought', { id, cost: item.cost });
+    this.touch();
+    return true;
+  }
+
+  equipCosmetic(id: string): boolean {
+    const item = COSMETICS_BY_ID[id];
+    if (!item || !this.data.cosmetics.owned.includes(id)) return false;
+    const cosmetics = this.data.cosmetics;
+    if (item.slot === 'theme') cosmetics.theme = id;
+    if (item.slot === 'frame') cosmetics.frame = id;
+    if (item.slot === 'skrepka') cosmetics.skrepka = id;
+    if (item.slot === 'stamp') cosmetics.stamp = id;
+    this.touch();
+    return true;
+  }
+
+  purchaseArchivePass(): boolean {
+    const price = ARCHIVE_PASS_PRICE;
+    if (this.data.profile.signal < price) return false;
+    this.data.profile.signal -= price;
+    this.data.flags.archive_pass = Date.now() + ARCHIVE_PASS_DAYS * 86400000;
+    emitAnalytics('archive_pass', { price });
+    this.touch();
+    return true;
+  }
+
+  // ─────────────────────────── сезон ───────────────────────────
+
+  claimSeasonReward(id: string, xpThreshold: number, reward: { xp?: number; signal?: number }): boolean {
+    if (this.data.season.claimed.includes(id)) return false;
+    if (this.data.season.xp < xpThreshold) return false;
+    this.data.season.claimed.push(id);
+    this.data.profile.xp += reward.xp ?? 0;
+    this.data.profile.signal += reward.signal ?? 0;
+    this.touch();
+    return true;
+  }
+
+  // ─────────────────────────── сервис ───────────────────────────
+
+  rankTitle(): string {
+    return RANKS.find((rank) => rank.rank === this.data.profile.rank)?.title ?? 'НОВИЧОК';
+  }
+
+  todayKey(): string {
+    return dayKey();
+  }
+
+  exportJson(): string {
+    return exportSave(this.data);
+  }
+
+  importJson(json: string): boolean {
+    const parsed = importSave(json);
+    if (!parsed) return false;
+    this.data = parsed;
+    ensureDailyQuests(this.data);
+    refreshEnergy(this.data.profile);
+    this.touch();
+    return true;
+  }
+
+  hardReset(): void {
+    wipeSave();
+    this.data = createNewSave();
+    ensureDailyQuests(this.data);
+    refreshEnergy(this.data.profile);
+    this.touch();
+  }
+}
+
+export const store = new Store();
