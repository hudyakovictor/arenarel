+    { text: 'Вскрытые сущности перестают быть страшными. Остаются неприятными.', mood: 'smug' },
+  ],
+  deck: [
+    { text: 'В руке четыре карты. Ты живёшь или умираешь от того, какие именно.', mood: 'talk' },
+    { text: 'Карты не делают тебя умным. Они делают тебя предсказуемым для себя самого. Это ценнее.', mood: 'talk' },
+  ],
+  shop: [
+    { text: 'Тут нет преимущества за деньги. Только внешний вид. Это принципиально.', mood: 'talk' },
+    { text: 'Косметика не влияет на качество решений. В отличие от сна.', mood: 'smug' },
+  ],
+  noEnergy: [
+    { text: 'Приёмник перегрелся. Паника бесплатна, охота — нет.', mood: 'alarm' },
+    { text: 'Энергия закончилась. Она вернётся завтра. Рынок тоже — к сожалению.', mood: 'talk' },
+  ],
+  aiQuestion: [
+    { text: 'Нет. Я аналоговый. У меня даже драйверов нет — только характер.', mood: 'smug' },
+    { text: 'ИИ? Мальчик мой, я старше нейросети на три реформы и один кризис.', mood: 'smug' },
+    { text: 'Я не думаю. Я помню. Иногда это надёжнее.', mood: 'talk' },
+  ],
+  idleTap: [
+    { text: 'Я всё ещё здесь. Мне некуда загружаться.', mood: 'idle' },
+    { text: 'Нажми ещё раз, если хочешь. Аналоговое терпение бесконечно.', mood: 'idle' },
+    { text: 'В 2004 я помогал расставлять абзацы. Это было честнее.', mood: 'smug' },
+  ],
+  weekly: [
+    { text: 'Дело недели: три охоты, одна последовательность. Сущности уже знают.', mood: 'talk' },
+  ],
+  closedMarket: [
+    { text: 'Рынок закрыт. Хорошее время посмотреть в журнал и не понравиться себе.', mood: 'talk' },
+  ],
+};
+
+const lastIndex: Record<string, number> = {};
+
+/** Ротация без немедленных повторов — персонаж не должен заедать. */
+export function skrepkaLine(context: keyof typeof SKREPKA | string, seed?: string): SkrepkaLine {
+  const bank = SKREPKA[context] ?? SKREPKA['hub']!;
+  if (bank.length === 1) return bank[0]!;
+  const rng = new Rng(seed ?? `${context}:${Date.now()}`);
+  let index = rng.int(0, bank.length - 1);
+  if (lastIndex[context] === index) index = (index + 1) % bank.length;
+  lastIndex[context] = index;
+  return bank[index]!;
+}
+
+export function skrepkaForDqi(dqi: number, seed?: string): SkrepkaLine {
+  const key = dqi >= 85 ? 'verdictPerfect' : dqi >= 70 ? 'verdictStrong' : dqi >= 55 ? 'verdictReveal' : dqi >= 40 ? 'verdictWeak' : 'verdictFail';
+  return skrepkaLine(key, seed);
+}
+
+export const SKREPKA_NAME = 'СКРЕПКА';
+export const SKREPKA_SUBTITLE = 'аналоговый ассистент · не ИИ';
