+/**
+ * TitleScene — титул и первый контакт со Скрепкой.
+ * Задача экрана: за три секунды объяснить, что это не терминал и не биржа.
+ */
+
+import Phaser from 'phaser';
+import { BaseScene } from './BaseScene';
+import { button, heading, paragraph } from '../../ui/kit';
+import { skrepkaWindow, waveformView } from '../../ui/parts';
+import { icon } from '../../ui/icons';
+import { COLORS, CSS, EASE, FONT } from '../theme';
+import { CENTER, DEPTH, SAFE } from '../design';
+import { store } from '../../core/store';
+import { SKREPKA_INTRO } from '../../data/skrepka';
+import { audio } from '../../core/audio';
+import { analytics } from '../../core/analytics';
+import { buildWaveform } from '../../data/waveforms';
+
+export class TitleScene extends BaseScene {
+
+  constructor() {
+    super('title');
+  }
+  private skrepka?: ReturnType<typeof skrepkaWindow>;
+
+  protected override accent(): number {
+    return COLORS.cyan;
+  }
+
+  protected override build(): void {
+    this.fadeInCamera();
+    analytics.track('scene_title');
+    const width = this.scale.width;
+    const height = this.scale.height;
+    const hasSave = store.profile.hunts > 0;
+
+    // Лента самописца как визуальный девиз: рынок уже что-то печатает.
+    const strip = waveformView(this, {
+      x: CENTER.x,
+      y: height * 0.3,
+      w: width - 60,
+      h: 118,
+      accent: COLORS.cyan,
+      depth: DEPTH.content,
+    });
+    strip.setData(buildWaveform('title', 'grind', 'wait'));
+    strip.printPre(1800);
+    this.time.delayedCall(1900, () => strip.stamp());
+    this.time.delayedCall(2300, () => strip.printPost('wait', 1600));
+
+    const title = this.add
+      .text(CENTER.x, height * 0.5, 'SIGNAL\nARENA', {
+        fontFamily: FONT.display,
+        fontSize: '44px',
+        color: CSS.text,
+        align: 'center',
+        lineSpacing: 2,
+      })
+      .setOrigin(0.5)
+      .setDepth(DEPTH.content);
+    if (!store.state.settings.reduceMotion) {
+      title.setScale(0.92);
+      this.tweens.add({ targets: title, scale: 1, duration: 900, ease: EASE.back });
+    }
+
+    const glow = this.add
+      .image(CENTER.x, height * 0.5, 'tex_glow')
+      .setDisplaySize(width * 1.2, 260)
+      .setTint(COLORS.cyan)
+      .setAlpha(0.16)
+      .setBlendMode(Phaser.BlendModes.ADD)
+      .setDepth(DEPTH.ambient);
+
+    const tagline = heading(this, CENTER.x, height * 0.5 + 74, 'НЕ ТЕРМИНАЛ. НЕ БИРЖА. ОХОТА.', {
+      size: 11,
+      color: COLORS.muted,
+      align: 'center',
+    });
+    tagline.setDepth(DEPTH.content);
+    tagline.setAlpha(0.9);
+
+    const subtitle = paragraph(this, CENTER.x, height * 0.5 + 96, 'сущности рынка выходят на охоту', {
+      size: 12,
+      color: COLORS.dim,
+      align: 'center',
+    });
+    subtitle.setOrigin(0.5, 0);
+    subtitle.setDepth(DEPTH.content);
+
+    const startBtn = button(this, {
+      x: CENTER.x,
+      y: height * 0.74,
+      w: 262,
+      h: 60,
+      text: hasSave ? 'ПРОДОЛЖИТЬ ДЕЛО' : 'НАЧАТЬ ОХОТУ',
+      variant: 'primary',
+      depth: DEPTH.content,
+      onTap: () => this.enterHub(),
+    });
+
+    const hint = paragraph(this, CENTER.x, height * 0.74 + 44, hasSave ? `ОХОТ: ${store.profile.hunts} · РАНГ ${store.profile.rank}` : 'приёмник уже включён', {
+      size: 10,
+      color: COLORS.dim,
+      align: 'center',
+      mono: true,
+    });
+    hint.setOrigin(0.5, 0);
+    hint.setDepth(DEPTH.content);
+
+    // Шестерня настроек — тихо, в углу, не отвлекая
+    const gear = icon(this, 'gear', 22, COLORS.dim, 1.6);
+    gear.setPosition(width - SAFE.right - 12, SAFE.top + 16);
+    gear.setDepth(DEPTH.hud);
+    const gearHit = this.add
+      .rectangle(gear.x, gear.y, 46, 46, 0xffffff, 0.001)
+      .setInteractive({ useHandCursor: true })
+      .setDepth(DEPTH.hud);
+    gearHit.on('pointerup', () => this.go('settings'));
+
+    this.skrepka = skrepkaWindow(this, {
+      x: width - SAFE.right - 46,
+      y: height - 118,
+      size: 84,
+      depth: DEPTH.hud,
+      greeting: !hasSave,
+    });
+
+    // Знакомство: три реплики, затем тишина. Больше нигде игра не объясняет себя так подробно.
+    if (!hasSave && !store.state.flags.intro_done) {
+      SKREPKA_INTRO.forEach((line, index) => {
+        this.time.delayedCall(1200 + index * 5200, () => this.skrepka?.say(line.text, line.mood, 5000));
+      });
+      this.time.delayedCall(1200 + SKREPKA_INTRO.length * 5200, () => {
+        store.state.flags.intro_done = 1;
+      });
+    } else {
+      this.time.delayedCall(900, () =>
+        this.skrepka?.say(hasSave ? 'Прибор помнит тебя. Сущности — тоже.' : 'Я пришёл из прошлого, чтобы помочь тебе в будущем.', 'talk', 4200),
+      );
+    }
+
+    this.animateIn([title, tagline, subtitle, startBtn.container], 90, 18);
+    void glow;
+    void hint;
+    void this.skrepka;
+    this.input.once('pointerdown', () => audio.unlock());
+  }
+
+  private enterHub(): void {
+    audio.play('seal');
+    this.go('hub');
+  }
+}
