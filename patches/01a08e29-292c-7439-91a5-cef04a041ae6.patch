+export type NavKey = 'hunt' | 'codex' | 'deck' | 'profile';
+
+const NAV_ITEMS: { key: NavKey; label: string; icon: 'target' | 'book' | 'cards' | 'profile' }[] = [
+  { key: 'hunt', label: 'ОХОТА', icon: 'target' },
+  { key: 'codex', label: 'КОДЕКС', icon: 'book' },
+  { key: 'deck', label: 'КОЛОДА', icon: 'cards' },
+  { key: 'profile', label: 'ПРОФИЛЬ', icon: 'profile' },
+];
+
+/** Нижняя навигация: четыре пункта, крупные зоны касания. */
+const NAV_SCENE: Record<NavKey, string> = { hunt: 'hub', codex: 'codex', deck: 'deck', profile: 'profile' };
+
+export function bottomNav(scene: Phaser.Scene, active: NavKey, onSelect?: (key: NavKey) => void): Phaser.GameObjects.Container {
+  const width = scene.scale.width;
+  const height = NAV_HEIGHT;
+  const y = scene.scale.height - height;
+  const container = scene.add.container(0, y).setDepth(DEPTH.hud);
+  const bg = rex(scene).add.roundRectangle(width / 2, height / 2, width + 40, height + 20, { tl: 22, tr: 22, bl: 0, br: 0 }, COLORS.bg1, 0.96) as RexShape;
+  bg.setStrokeStyle(1, COLORS.line, 0.25);
+  container.add(bg as unknown as Phaser.GameObjects.GameObject);
+
+  NAV_ITEMS.forEach((item, index) => {
+    const cellW = width / NAV_ITEMS.length;
+    const cx = cellW * index + cellW / 2;
+    const isActive = item.key === active;
+    const color = isActive ? COLORS.cyan : COLORS.dim;
+    const iconHolder = icon(scene, item.icon, 20, color, 1.8);
+    iconHolder.setPosition(cx, 26);
+    const label = scene.add
+      .text(cx, 50, item.label, { fontFamily: FONT.ui, fontSize: '9px', color: isActive ? CSS.cyan : CSS.dim, fontStyle: '700' })
+      .setOrigin(0.5);
+    const hit = scene.add
+      .rectangle(cx, height / 2, cellW, height, 0xffffff, 0)
+      .setInteractive({ useHandCursor: true });
+    if (isActive) {
+      const underline = scene.add.rectangle(cx, 8, 26, 2.5, COLORS.cyan, 1).setOrigin(0.5);
+      const glow = scene.add.image(cx, 8, 'tex_glow').setDisplaySize(60, 24).setTint(COLORS.cyan).setAlpha(0.5).setBlendMode(Phaser.BlendModes.ADD);
+      container.add([glow, underline]);
+    }
+    hit.on('pointerup', () => {
+      if (isActive) return;
+      audio.play('click');
+      haptics.vibrate('tap');
+      if (onSelect) onSelect(item.key);
+      else scene.scene.start(NAV_SCENE[item.key]);
+    });
+    container.add([iconHolder, label, hit]);
+  });
+
+  return container;
+}
