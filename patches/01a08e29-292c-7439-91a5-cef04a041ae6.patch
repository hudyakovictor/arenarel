+
+function phaseText(phase: string): string {
+  switch (phase) {
+    case 'euphoria':
+      return 'ЭЙФОРИЯ';
+    case 'panic':
+      return 'ПАНИКА';
+    case 'chop':
+      return 'ФЛЭТ';
+    case 'accumulation':
+      return 'НАКОПЛЕНИЕ';
+    case 'markup':
+      return 'РОСТ';
+    case 'markdown':
+      return 'ПАДЕНИЕ';
+    default:
+      return 'НЕЯСНО';
+  }
+}
+
+function phaseColor(phase: string): number {
+  switch (phase) {
+    case 'euphoria':
+      return COLORS.gold;
+    case 'panic':
+      return COLORS.red;
+    case 'chop':
+      return COLORS.muted;
+    case 'accumulation':
+      return COLORS.green;
+    case 'markup':
+      return COLORS.green;
+    case 'markdown':
+      return COLORS.red;
+    default:
+      return COLORS.muted;
+  }
+}
