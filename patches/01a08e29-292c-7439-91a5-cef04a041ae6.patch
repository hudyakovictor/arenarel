+export function noiseFor(entityId: string): NoiseEvent[] {
+  const own = NOISE.filter((n) => n.id.includes(entityKey(entityId)));
+  return [...own, ...GENERIC_IDS.map((id) => NOISE_BY_ID[id]!).filter(Boolean)];
