+/** Всплывающая подсказка в стиле прибора. */
+export function toast(scene: Phaser.Scene, text: string, tone: 'info' | 'good' | 'bad' | 'gold' = 'info'): void {
+  const color = tone === 'good' ? COLORS.green : tone === 'bad' ? COLORS.red : tone === 'gold' ? COLORS.gold : COLORS.cyan;
+  const y = scene.scale.height - 140;
+  const container = scene.add.container(scene.scale.width / 2, y).setDepth(1500);
+  const label = scene.add
+    .text(0, 0, text.toUpperCase(), {
+      fontFamily: FONT.ui,
+      fontSize: '11px',
+      fontStyle: '700',
+      color: CSS.text,
+      align: 'center',
+      wordWrap: { width: scene.scale.width - 80 },
+    })
+    .setOrigin(0.5);
+  const bg = rex(scene).add.roundRectangle(0, 0, label.width + 34, label.height + 20, RADIUS.small + 6, COLORS.card2, 0.97) as RexShape;
+  bg.setStrokeStyle(1.5, color, 0.8);
+  container.add([bg as unknown as Phaser.GameObjects.GameObject, label]);
+  container.setAlpha(0);
+  container.setY(y + 20);
+
+  scene.tweens.add({ targets: container, alpha: 1, y, duration: TIME.base, ease: EASE.out });
+  scene.time.delayedCall(2200, () => {
+    scene.tweens.add({
+      targets: container,
+      alpha: 0,
+      y: y - 16,
+      duration: TIME.base,
+      ease: EASE.in,
+      onComplete: () => container.destroy(true),
+    });
+  });
+}
