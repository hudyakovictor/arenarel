@@ -0,0 +1,63 @@
+* {
+  box-sizing: border-box;
+  -webkit-tap-highlight-color: transparent;
+}
+
+html,
+body,
+#shell,
+#game {
+  width: 100%;
+  height: 100%;
+  margin: 0;
+}
+
+body {
+  overflow: hidden;
+  background:
+    radial-gradient(900px 640px at 50% -10%, rgba(34, 216, 245, 0.13), transparent 60%),
+    radial-gradient(680px 680px at 120% 110%, rgba(179, 136, 255, 0.10), transparent 60%),
+    #01030a;
+  color: #f2f7ff;
+  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  touch-action: none;
+  user-select: none;
+  -webkit-user-select: none;
+}
+
+#shell {
+  display: grid;
+  place-items: center;
+  padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
+}
+
+#game {
+  width: min(100vw, calc(100dvh * 9 / 16));
+  height: min(100dvh, calc(100vw * 16 / 9));
+  max-width: 540px;
+  max-height: 960px;
+  position: relative;
+  filter: drop-shadow(0 35px 90px rgba(0, 0, 0, 0.65));
+}
+
+#game canvas {
+  width: 100% !important;
+  height: 100% !important;
+  display: block;
+  border-radius: clamp(0px, 7vw, 34px);
+}
+
+@media (max-width: 560px) {
+  #shell { padding: 0; }
+  #game {
+    width: 100vw;
+    height: 100dvh;
+    max-width: none;
+    max-height: none;
+  }
+  #game canvas { border-radius: 0; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  #game { filter: none; }
+}
