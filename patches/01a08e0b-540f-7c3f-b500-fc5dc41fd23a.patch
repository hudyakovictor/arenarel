+++ b/src/game/scoring.ts
@@ -0,0 +1,123 @@
+import type { DecisionKey, Mission, RiskKey } from './data';
+
+export interface ScoreInput {
+  mission: Mission;
+  opened: string[];
+  skillId?: string;
+  decision?: DecisionKey;
+  risk: RiskKey;
+}
+
+export interface ScoreBreakdown {
+  total: number;
+  criteria: [number, number, number, number];
+  hp: number;
+  stars: number;
+  victory: boolean;
+  title: string;
+}
+
+export function enemyHp(input: ScoreInput): number {
+  const { mission, opened, skillId, decision, risk } = input;
+  let hp = 100;
+
+  opened.forEach((id) => {
+    const clue = mission.clues.find((c) => c.id === id);
+    if (!clue) return;
+    hp -= clue.damage;
+    if (clue.feeds) hp += 5;
+  });
+
+  const skill = mission.skills.find((s) => s.id === skillId);
+  if (skill) {
+    hp -= 7;
+    const counters = skill.counterTo.filter((id) => opened.includes(id)).length;
+    hp -= counters * 6;
+    if (skill.id === mission.correctSkill) hp -= 10;
+  }
+
+  if (decision === mission.correctDecision) hp -= 12;
+  if (decision === 'C') hp += 18;
+  if (risk === '2') hp += 14;
+
+  return clamp(Math.round(hp), 0, 100);
+}
+
+export function panicPressure(input: ScoreInput): number {
+  const { mission, opened, skillId, decision, risk } = input;
+  let pressure = 28;
+
+  opened.forEach((id) => {
+    const clue = mission.clues.find((c) => c.id === id);
+    if (!clue) return;
+    pressure += clue.feeds ? 22 : -5;
+  });
+
+  if (decision === 'C') pressure += 24;
+  if (risk === '2') pressure += 18;
+
+  const skill = mission.skills.find((s) => s.id === skillId);
+  if (skill?.id === mission.correctSkill) pressure -= 18;
+
+  return clamp(Math.round(pressure), 0, 100);
+}
+
+export function computeScore(input: ScoreInput): ScoreBreakdown {
+  const { mission, opened, skillId, risk } = input;
+  const decision = input.decision ?? 'C';
+  const base = mission.baseScores[decision] ?? 20;
+  const evidenceRaw = opened.reduce((sum, id) => sum + (mission.clues.find((c) => c.id === id)?.evidence ?? 0), 0);
+  const evidenceBonus = Math.min(28, Math.round(evidenceRaw * 0.72));
+  const skill = mission.skills.find((s) => s.id === skillId);
+  const counterHits = skill ? skill.counterTo.filter((id) => opened.includes(id)).length : 0;
+  const skillBonus = skill ? (skill.id === mission.correctSkill ? 18 : 8 + counterHits * 3) : -12;
+  const riskBonus = mission.safeRisk.includes(risk) ? (risk === '0' && decision === 'D' ? 12 : 8) : risk === '2' ? -28 : -8;
+  const cluePenalty = opened.length < mission.requiredClues ? -18 : 0;
+  const badPenalty = decision === 'C' ? -18 : 0;
+
+  const total = clamp(Math.round(base + evidenceBonus + skillBonus + riskBonus + cluePenalty + badPenalty), 5, 100);
+  const criteria: [number, number, number, number] = [
+    clamp(Math.round((opened.length / mission.clues.length) * 100), 0, 100),
+    clamp(skill ? Math.round((skill.id === mission.correctSkill ? 88 : 58) + counterHits * 8) : 20, 0, 100),
+    clamp(mission.safeRisk.includes(risk) ? (risk === '0' ? 95 : 84) : risk === '2' ? 18 : 46, 0, 100),
+    clamp(decision === mission.correctDecision ? 92 : decision === 'C' ? 12 : 58, 0, 100)
+  ];
+  const hp = enemyHp(input);
+  const victory = total >= 55;
+  const stars = total >= 88 ? 3 : total >= 70 ? 2 : total >= 55 ? 1 : 0;
+  const title = total >= 90
+    ? 'ЛЕГЕНДАРНЫЙ РАЗБОР'
+    : total >= 75
+      ? 'ЧИСТЫЙ ДИАГНОЗ'
+      : total >= 55
+        ? 'ОШИБКА ЗАКРЫТА'
+        : total >= 35
+          ? 'РЫНОК ПРИНЯЛ ТВОЁ РЕШЕНИЕ'
+          : 'СИСТЕМА ПОБЛАГОДАРИЛА';
+
+  return { total, criteria, hp, stars, victory, title };
+}
+
+export function perfectInput(mission: Mission): ScoreInput {
+  return {
+    mission,
+    opened: mission.clues.map((c) => c.id),
+    skillId: mission.correctSkill,
+    decision: mission.correctDecision,
+    risk: mission.safeRisk[0]
+  };
+}
+
+export function recklessInput(mission: Mission): ScoreInput {
+  return {
+    mission,
+    opened: [],
+    skillId: undefined,
+    decision: 'C',
+    risk: '2'
+  };
+}
+
+function clamp(value: number, min: number, max: number): number {
+  return Math.max(min, Math.min(max, value));
+}
