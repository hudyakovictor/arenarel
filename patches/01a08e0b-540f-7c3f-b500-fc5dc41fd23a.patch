+      fontSize: '9px',
+      color: this.hex(C.muted),
+      fontStyle: 'bold'
+    }).setOrigin(0, 0.5);
+    t.setResolution(Math.min(window.devicePixelRatio || 1, 2));
+    this.root.add(t);
+  }
