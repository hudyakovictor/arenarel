+  private drawPulseMap(
+    x: number,
+    y: number,
+    w: number,
+    h: number,
+    pulse: number[],
+    future: number[] = [],
+    futureVisible = 0,
+    includeFutureFrame = false,
+    accent = C.cyan,
+    target?: Phaser.GameObjects.Graphics
+  ): void {
+    const g = target ?? this.add.graphics();
+    if (!target) this.root.add(g);
+
+    g.fillStyle(0x030816, 0.94).fillRoundedRect(x, y, w, h, 18);
+    g.lineStyle(1, C.line, 0.16).strokeRoundedRect(x, y, w, h, 18);
+    g.lineStyle(1, C.line, 0.08);
+    for (let i = 1; i < 4; i += 1) g.lineBetween(x + 16, y + (h * i) / 4, x + w - 16, y + (h * i) / 4);
+    for (let i = 1; i < 6; i += 1) g.lineBetween(x + (w * i) / 6, y + 16, x + (w * i) / 6, y + h - 16);
+
+    const all = pulse.concat(future.slice(0, futureVisible));
+    const min = Math.min(...pulse, ...future) - 4;
+    const max = Math.max(...pulse, ...future) + 4;
+    const preEnd = pulse.length - 1;
+    const totalSteps = pulse.length + (includeFutureFrame ? future.length : futureVisible) - 1;
+    const px = (i: number) => x + 20 + (i / Math.max(1, totalSteps)) * (w - 40);
+    const py = (v: number) => y + h - 22 - ((v - min) / Math.max(1, max - min)) * (h - 44);
+
+    g.lineStyle(4, accent, 1);
+    g.beginPath();
+    pulse.forEach((v, i) => {
+      if (i === 0) g.moveTo(px(i), py(v)); else g.lineTo(px(i), py(v));
+    });
+    g.strokePath();
+
+    for (let i = 0; i < pulse.length; i += 3) {
+      g.fillStyle(i === preEnd ? C.gold : accent, i === preEnd ? 1 : 0.9).fillCircle(px(i), py(pulse[i]), i === preEnd ? 6 : 4);
+    }
+
+    const t0x = px(preEnd);
+    g.lineStyle(2, C.gold, 0.9).lineBetween(t0x, y + 12, t0x, y + h - 12);
+    g.fillStyle(C.gold, 1).fillTriangle(t0x - 7, y + 18, t0x + 7, y + 18, t0x, y + 31);
+    if (!target) {
+      this.addMapLabel(g, x + 18, y + 16, 'SIGNAL SIGIL');
+      this.addMapLabel(g, t0x + 8, y + 30, 't₀');
+    }
+
+    if (includeFutureFrame) {
+      const lockX = px(preEnd + future.length);
+      g.lineStyle(1, C.line, 0.18).lineBetween(lockX, y + 20, lockX, y + h - 20);
+      if (futureVisible === 0) {
+        g.fillStyle(C.bg, 0.62).fillRoundedRect(t0x + 10, y + 28, x + w - t0x - 30, h - 56, 16);
+        if (!target) this.addMapLabel(g, t0x + 32, y + h / 2 - 6, 'FUTURE LOCKED');
+      }
+    }
+
+    if (futureVisible > 0) {
+      g.lineStyle(4, C.gold, 1);
+      g.beginPath();
+      const start = pulse[pulse.length - 1];
+      g.moveTo(px(preEnd), py(start));
+      future.slice(0, futureVisible).forEach((v, i) => g.lineTo(px(preEnd + i + 1), py(v)));
+      g.strokePath();
+      future.slice(0, futureVisible).forEach((v, i) => {
+        g.fillStyle(i === futureVisible - 1 ? C.red : C.gold, 1).fillCircle(px(preEnd + i + 1), py(v), i === futureVisible - 1 ? 6 : 4);
+      });
+    }
+
+    if (!target) {
