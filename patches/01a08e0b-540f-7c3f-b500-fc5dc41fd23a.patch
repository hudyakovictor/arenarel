+  private completeDailyContract(id: string): void {
+    this.ensureDaily();
+    if (this.save.daily.completed[id]) return;
+    const contract = this.dailyContracts().find((c) => c.id === id);
+    if (!contract) return;
+    this.save.daily.completed[id] = true;
+    this.save.xp += contract.rewardXp;
+    this.save.credits += contract.rewardCredits;
+  }
+
+  private applyDailyContracts(score: ScoreBreakdown): void {
+    if (!this.run) return;
+    this.completeDailyContract('close-error');
+    if (this.run.risk !== '2') this.completeDailyContract('safe-risk');
+    if (this.run.opened.size >= this.run.mission.clues.length) this.completeDailyContract('full-evidence');
+    if (score.total >= 90) this.completeDailyContract('close-error');
+  }
+
+  private averageStat(key: keyof Pick<PlayerStats, 'evidence' | 'principle' | 'risk' | 'control'>): number {
+    const runs = Math.max(1, this.save.stats.runs);
+    return Math.round(this.save.stats[key] / runs);
+  }
+
+  private applyReward(score: ScoreBreakdown): void {
+    if (!this.run || this.run.rewarded) return;
+    this.run.rewarded = true;
+    const m = this.run.mission;
+    const oldBest = this.save.best[m.id] ?? 0;
+    this.save.best[m.id] = Math.max(oldBest, score.total);
+    const reward = Math.round(score.total * 1.35) + score.stars * 12;
+    const creditReward = score.victory ? 25 : 8;
+    this.save.xp += reward;
+    this.save.credits += creditReward;
+    this.save.stats.runs += 1;
+    this.save.stats.wins += score.victory ? 1 : 0;
+    this.save.stats.perfects += score.total >= 90 ? 1 : 0;
+    this.save.stats.evidence += score.criteria[0];
+    this.save.stats.principle += score.criteria[1];
+    this.save.stats.risk += score.criteria[2];
+    this.save.stats.control += score.criteria[3];
+    this.applyDailyContracts(score);
+    this.save.tutorialDone = true;
+    if (score.victory) {
+      this.save.codex[m.enemyKey] = true;
+      this.save.codex[m.protocolId] = true;
+      if (this.run.skillId) this.save.codex[this.run.skillId] = true;
+    }
+    const today = this.localDateKey();
+    if (this.save.lastClosedDate !== today) {
+      const yesterday = new Date();
+      yesterday.setDate(yesterday.getDate() - 1);
+      this.save.streak = this.save.lastClosedDate === this.localDateKey(yesterday) ? this.save.streak + 1 : 1;
+      this.save.lastClosedDate = today;
+    }
+    this.persist();
+  }
