diff --git a/scripts/product-audit.mjs b/scripts/product-audit.mjs
new file mode 100644
index 0000000..c138296
--- /dev/null
+++ b/scripts/product-audit.mjs
@@ -0,0 +1,66 @@
+import fs from 'node:fs';
+import path from 'node:path';
+
+const root = process.cwd();
+const read = (p) => fs.readFileSync(path.join(root, p), 'utf8');
+const exists = (p) => fs.existsSync(path.join(root, p));
+const fail = (msg) => {
+  console.error(`✕ ${msg}`);
+  process.exitCode = 1;
+};
+const pass = (msg) => console.log(`✓ ${msg}`);
+
+const pkg = JSON.parse(read('package.json'));
+const main = read('src/main.ts');
+const scene = read('src/game/ArenaScene.ts');
+const data = read('src/game/data.ts');
+const scoring = read('src/game/scoring.ts');
+const html = read('index.html');
+
+if (pkg.dependencies?.phaser?.includes('4.')) pass('Phaser 4 dependency locked'); else fail('Phaser 4 dependency missing');
+if (pkg.dependencies?.['phaser3-rex-plugins']) pass('rexUI dependency present'); else fail('rexUI dependency missing');
+if (/width:\s*540/.test(main) && /height:\s*960/.test(main)) pass('9:16 scene size 540×960'); else fail('9:16 scene config missing');
+if (/Phaser\.WEBGL/.test(main)) pass('WebGL renderer requested'); else fail('WebGL renderer not requested');
+if (/rexUI/.test(main) && /ui-plugin\.js/.test(main)) pass('rexUI scene plugin registered'); else fail('rexUI plugin not registered');
+if (/maximum-scale=1\.0/.test(html) && /viewport-fit=cover/.test(html)) pass('mobile viewport configured'); else fail('mobile viewport incomplete');
+
+const missionMatch = data.match(/export const missions: Mission\[\] = ([\s\S]*?);\n\nexport const riskLabels/);
+if (!missionMatch) fail('missions array not parseable');
+const missions = missionMatch ? Function(`const missions = ${missionMatch[1]}; return missions;`)() : [];
+const missionCount = missions.length;
+if (missionCount >= 10) pass(`${missionCount} deterministic missions`); else fail('not enough missions');
+const missionIds = new Set(missions.map((m) => m.id));
+if (missionIds.size === missionCount) pass('mission ids unique'); else fail('duplicate mission ids');
+const invalidMissions = missions.filter((m) => {
+  const clueIds = new Set(m.clues.map((c) => c.id));
+  const skillIds = new Set(m.skills.map((s) => s.id));
+  const decisionKeys = new Set(m.decisions.map((d) => d.key));
+  return m.clues.length < 4
+    || m.skills.length !== 3
+    || m.decisions.length !== 4
+    || !skillIds.has(m.correctSkill)
+    || !decisionKeys.has(m.correctDecision)
+    || m.requiredClues > m.clues.length
+    || !m.safeRisk.length
+    || m.future.length < 10
+    || m.pulse.length < 12
+    || m.skills.some((s) => s.counterTo.some((id) => !clueIds.has(id)));
+});
+if (invalidMissions.length === 0) pass('mission content contracts valid'); else fail(`invalid mission contracts: ${invalidMissions.map((m) => m.id).join(', ')}`);
+if (/forward-after-answer/.test(scene) && /Будущее/.test(scene)) pass('forward-after-answer loop present'); else fail('forward-after-answer loop missing');
+if (/Style Vault/.test(read('README.md')) && /cosmetic/i.test(scene)) pass('cosmetic-first monetization present'); else fail('cosmetic-first loop missing');
+if (/dailyContracts/.test(scene) && /decision dna/i.test(scene)) pass('daily retention and mastery profile present'); else fail('daily retention/profile loop missing');
+if (/export function computeScore/.test(scoring) && /perfectInput/.test(scoring) && /recklessInput/.test(scoring)) pass('pure scoring engine extracted'); else fail('scoring engine not extracted');
+if (/private track\(/.test(scene) && /mission_started/.test(scene) && /result_reached/.test(scene) && /cosmetic_bought/.test(scene)) pass('local analytics event spine present'); else fail('analytics event spine missing');
+if (/showSettings/.test(scene) && /UserSettings/.test(scene) && /Высокий контраст/.test(scene)) pass('accessibility settings present'); else fail('accessibility settings missing');
+if (/tutorialHint/.test(scene) && /tutorialDone/.test(scene) && /НАВИГАТОР НОВИЧКА/.test(scene)) pass('first-run tutorial hints present'); else fail('first-run tutorial hints missing');
+if (!/orderbook|стакан|paperMoney|demo account/i.test(scene)) pass('terminal mechanics not present in scene'); else fail('terminal mechanics leaked into scene');
+
+const assetDir = path.join(root, 'src/assets');
+const totalAssets = fs.readdirSync(assetDir).reduce((sum, f) => sum + fs.statSync(path.join(assetDir, f)).size, 0);
+if (totalAssets < 1.6 * 1024 * 1024) pass(`mobile assets optimized ${(totalAssets / 1024 / 1024).toFixed(2)} MB`); else fail(`assets too heavy ${(totalAssets / 1024 / 1024).toFixed(2)} MB`);
+
+if (exists('public/manifest.webmanifest') && exists('public/icon.svg')) pass('PWA manifest and icon present'); else fail('PWA assets missing');
+
+if (process.exitCode) process.exit(process.exitCode);
+console.log('Signal Arena product audit passed. Паника под контролем. План найден.');
diff --git a/scripts/scoring-tests.ts b/scripts/scoring-tests.ts
new file mode 100644
index 0000000..1007731
--- /dev/null
+++ b/scripts/scoring-tests.ts
@@ -0,0 +1,65 @@
+import { computeScore, enemyHp, panicPressure, perfectInput, recklessInput } from '../src/game/scoring';
+import type { Mission } from '../src/game/data';
+
+const fixture: Mission = {
+  id: 'test-fomo',
+  act: 'Test',
+  title: 'Fixture',
+  subtitle: 'Fixture',
+  enemyKey: 'fixture',
+  enemyName: 'Fixture Wraith',
+  enemyRole: 'test',
+  enemyQuote: 'test',
+  objective: 'test',
+  pair: 'TEST',
+  timeframe: '1H',
+  difficulty: 'test',
+  bgKey: 'fixture',
+  accent: 0x22d8f5,
+  protocolId: 'fixture-protocol',
+  requiredClues: 2,
+  correctSkill: 'discipline',
+  correctDecision: 'D',
+  safeRisk: ['0', '05'],
+  baseScores: { A: 55, B: 45, C: 12, D: 78 },
+  pulse: [1, 2, 3],
+  future: [2, 1, 0],
+  clues: [
+    { id: 'evidence', icon: '◉', eyebrow: 'test', title: 'Evidence', body: 'body', punch: 'punch', damage: 18, evidence: 14 },
+    { id: 'feed', icon: '☷', eyebrow: 'test', title: 'Feed', body: 'body', punch: 'punch', damage: 8, evidence: 8, feeds: true },
+    { id: 'risk', icon: '⬣', eyebrow: 'test', title: 'Risk', body: 'body', punch: 'punch', damage: 15, evidence: 12 }
+  ],
+  skills: [
+    { id: 'discipline', type: 'defense', icon: '⬣', title: 'Discipline', mantra: 'mantra', body: 'body', counterTo: ['evidence', 'feed', 'risk'] },
+    { id: 'almost', type: 'read', icon: '◉', title: 'Almost', mantra: 'mantra', body: 'body', counterTo: ['evidence'] },
+    { id: 'wrong', type: 'decision', icon: '□', title: 'Wrong', mantra: 'mantra', body: 'body', counterTo: [] }
+  ],
+  decisions: [
+    { key: 'A', icon: 'A', title: 'A', body: 'A' },
+    { key: 'B', icon: 'B', title: 'B', body: 'B' },
+    { key: 'C', icon: 'C', title: 'C', body: 'C', bad: true },
+    { key: 'D', icon: 'D', title: 'D', body: 'D' }
+  ],
+  verdicts: { win: 'win', lose: 'lose', journal: 'journal' }
+};
+
+const perfect = computeScore(perfectInput(fixture));
+const reckless = computeScore(recklessInput(fixture));
+const partial = computeScore({ mission: fixture, opened: ['evidence', 'feed'], skillId: 'almost', decision: 'A', risk: '05' });
+
+assert(perfect.total >= 90, `perfect score too low: ${perfect.total}`);
+assert(perfect.stars === 3, `perfect stars expected 3, got ${perfect.stars}`);
+assert(perfect.victory, 'perfect input should be victory');
+assert(enemyHp(perfectInput(fixture)) < 35, 'perfect input should heavily damage enemy');
+assert(reckless.total <= 20, `reckless score too high: ${reckless.total}`);
+assert(!reckless.victory, 'reckless input should fail');
+assert(panicPressure(recklessInput(fixture)) > panicPressure(perfectInput(fixture)), 'reckless pressure should be higher than perfect pressure');
+assert(partial.total > reckless.total && partial.total < perfect.total, 'partial score should sit between reckless and perfect');
+
+console.log('Scoring tests passed. Ошибка теперь считается, а не гадает.');
+
+function assert(condition: unknown, message: string): asserts condition {
+  if (!condition) {
+    throw new Error(message);
+  }
+}
