+        fontFamily: 'Inter, Arial, sans-serif',
+        fontSize: '10px',
+        color: this.hex(C.dim),
+        fontStyle: 'bold'
+      }).setOrigin(1, 0.5);
+      label.setResolution(Math.min(window.devicePixelRatio || 1, 2));
+      this.root.add(label);
+    }
+  }
+
+  private addMapLabel(g: Phaser.GameObjects.Graphics, x: number, y: number, _label: string): void {
